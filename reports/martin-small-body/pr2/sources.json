  "facts": [
    {
      "id": "MSB2-1",
      "claim": "Body size, style, fret/body joint and scale are distinct observations. Measure the individual guitar; later replicas and replaced parts can reproduce earlier appointments.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/martin-guitar-model-numbers/",
        "https://www.joesvintageguitarsaz.com/martin-guitar-dating-guide/"
      ]
    },
    {
      "id": "MSB2-2",
      "claim": "Routine model stamping from around October 1930; earlier serial-only blocks; annual serial entries are year-end totals and do not certify originality.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/martin-neck-block-stamps/",
        "https://www.joesvintageguitarsaz.com/martin-serial-and-model-numbers/",
        "https://www.martinguitar.com/support-serial-number-lookup.html"
      ]
    },
    {
      "id": "MSB2-3",
      "claim": "The 1934 OM/000 transition includes long-to-short scale, with nominal reference lengths around 25.4 and 24.9 inches. Documented 000-28 57851 supports the existence of a short-scale T-fret/T-bar group in 1934.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/post/martin-om-28-authentication-guide/",
        "https://www.martinguitar.com/blog-categories/from-the-factory/blog-061026-the-1933-martin-OM-45-that-went-to-war.html",
        "https://theguitarphile.com/1934-martin-000-28-guitar-serial-number-57851/"
      ]
    },
    {
      "id": "MSB2-4",
      "claim": "Herringbone survived the late-1944 end of scalloping. X position and brace profile differ; 0/00 and 000 schedules must not be conflated with one another or with all twelve-fret layouts.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/prewar-martin-guitar-guide/",
        "https://www.joesvintageguitarsaz.com/post/martin-0-00-000-history-authentication-value-guide/",
        "https://www.joesvintageguitarsaz.com/martin-guitar-dating-guide/"
      ]
    },
    {
      "id": "MSB2-5",
      "claim": "Late-1934 steel T-bars, wartime ebony substitutions, the 1967 square-tube change and later adjustable systems require individual examination. Hidden cross-sections cannot be established from an exterior photo.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/martin-guitar-dating-guide/",
        "https://www.joesvintageguitarsaz.com/prewar-martin-guitar-guide/"
      ]
    },
    {
      "id": "MSB2-6",
      "claim": "Style 28 uses spruce and rosewood with period-specific trim. Standard Brazilian-to-Indian rosewood transition around 1969/1970; grain color alone cannot establish species or original wood.",
      "sources": [
        "https://www.joesvintageguitarsaz.com/martin-guitar-dating-guide/",
        "https://www.joesvintageguitarsaz.com/post/martin-0-00-000-history-authentication-value-guide/"
      ]
    },
    {
      "id": "MSB2-7",
      "claim": "Early Style 17 can use spruce and rosewood; the all-mahogany 2-17 appears from 1922. Some wartime 0-15 headstock facings use tortoise-pattern Fiberloid.",
      "sources": [
        "https://www.vintagemartin.com/styles15_17_18.html",
        "https://www.joesvintageguitarsaz.com/martin-guitar-dating-guide/"
      ]
