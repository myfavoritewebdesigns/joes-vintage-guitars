# Cloudflare Pages headers.
#
# HTML caching is intentionally NOT overridden: Pages serves HTML with
# "Cache-Control: public, max-age=0, must-revalidate" by default, which is the
# short-cache behavior we want. Only long-lived static assets get overrides.
#
# No Content-Security-Policy on purpose: the lite-youtube CDN assets and the
# Instagram embeds would need careful allowlisting and testing first.

# Baseline security headers on every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# Hashed build output: content-addressed filenames, safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Site images and fonts are NOT content-hashed, so no "immutable": a file
# replaced under the same name (the planned pre-launch image compression, a
# font swap) must be able to revalidate. Long cache, but recoverable.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=2592000

# Decoder tool scripts: not content-hashed, so keep staleness to an hour.
/scripts/*
  Cache-Control: public, max-age=3600

# Internal v2 serial-tool test page: keep out of search engines at the edge
# too (the page also sets meta robots noindex and is sitemap-excluded).
/fender-serial-tool-v2/
  X-Robots-Tag: noindex

# Condensed serial-page rebuild preview: noindex at the edge as well
# (meta robots noindex + sitemap-excluded on the page too).
/fender-serial-hub-preview/
  X-Robots-Tag: noindex

# Fender serial guide spoke (pot codes) preview: noindex at the edge too
# (meta robots noindex + sitemap-excluded on the page too).
/fender-pot-codes/
  X-Robots-Tag: noindex

/fender-neck-dates/
  X-Robots-Tag: noindex

/fender-body-dates/
  X-Robots-Tag: noindex

/fender-pickup-dates/
  X-Robots-Tag: noindex
