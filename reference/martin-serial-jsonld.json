    {
        "@context":  "https://schema.org",
        "@graph":  [
                       {
                           "@type":  "HowTo",
                           "name":  "How to Decode Martin Guitar Serial Numbers",
                           "description":  "Learn how to locate and read Martin serial numbers on the neck block inside the soundhole to determine the year of manufacture.",
                           "image":  "https://www.joesvintageguitarsaz.com/wp-content/uploads/2026/01/Model-Name-Serial-Number-Martin.jpg",
                           "step":  [
                                        {
                                            "@type":  "HowToStep",
                                            "name":  "Locate the Serial Number",
                                            "text":  "Look inside the soundhole for the neck block — the heavy piece of wood where the neck joins the body. The serial number is stamped there on all vintage Martin acoustic guitars.",
                                            "url":  "https://www.joesvintageguitarsaz.com/post/martin-serial-and-model-numbers/#where-to-find-your-martin-guitar-model-and-serial-number"
                                        },
                                        {
                                            "@type":  "HowToStep",
                                            "name":  "Identify the Model Number",
                                            "text":  "The top stamp on the neck block is the model number (e.g., D-28). Note that Martin guitars made before October 1930 do not have a model number stamped.",
                                            "url":  "https://www.joesvintageguitarsaz.com/post/martin-serial-and-model-numbers/#where-to-find-your-martin-guitar-model-and-serial-number"
                                        },
                                        {
                                            "@type":  "HowToStep",
                                            "name":  "Match the Serial Number to the Chart",
                                            "text":  "Use the lower stamp (the serial number) and cross-reference it against the production year chart, which covers every year from 1898 to 2024.",
                                            "url":  "https://www.joesvintageguitarsaz.com/post/martin-serial-and-model-numbers/#serial-number-chart"
                                        }
                                    ],
                           "totalTime":  "PT5M"
                       },
