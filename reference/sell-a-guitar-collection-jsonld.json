        "mainEntity":  [
                           {
                               "@type":  "Question",
                               "name":  "How Can Appraisal Experts Determine My Guitar Collection\u0027s Price \u0026 Value?",
                               "acceptedAnswer":  {
                                                      "@type":  "Answer",
                                                      "text":  "When you bring your guitar in for appraisal, I will inspect your guitar carefully. Its make and model, the age, condition, and any unique features the guitar has will be considered as I determine its value. You will receive a written appraisal detailing my assessment and findings, along with the determined value of your guitar so you can make an informed decision for moving forward with keeping or selling it."
                                                  }
                           },
                           {
                               "@type":  "Question",
                               "name":  "How Long Will The Process Of Selling My Vintage Guitar Collection Take?",
                               "acceptedAnswer":  {
                                                      "@type":  "Answer",
                                                      "text":  "When you visit Joe’s Vintage Guitar for an appraisal and assessment, I do everything I can to make the process quick, painless, and risk-free for you. I share as much information as I can without overwhelming you, and take my time understanding the guitar’s history and sentimental value to you personally. If you are ready to sell it, the actual process is relatively quick and simple."
                                                  }
                           },
                           {
                               "@type":  "Question",
                               "name":  "Will I Have To Pay For Shipping Taxes To Sell My Vintage Guitar Collection?",
                               "acceptedAnswer":  {
                                                      "@type":  "Answer",
                                                      "text":  "When I purchase your guitar, all expected fees and information are up front. I will never surprise you with hidden shipping fees or unexpected taxes, because I want the process to be painless and easy for you. We will take the utmost care as we package and ship your vintage guitar to my inventory. Feel free to text or call me for more details about the shipping process!"
                                                  }
                           },
                           {
                               "@type":  "Question",
                               "name":  "Can I Sell My Guitar Collection On Consignment Or Trade It For Other Guitars?",
                               "acceptedAnswer":  {
                                                      "@type":  "Answer",
                                                      "text":  "Consignment comes with a few risks, but depending on your guitar I am willing to offer the opportunity to you. I want you to have a guitar that you love, so if you are interested in trading your guitar for one from my inventory, let’s talk! I am flexible and ready to work with you to ensure a fair trade experience for all involved."
                                                  }
                           },
                           {
                               "@type":  "Question",
                               "name":  "Is There A Warranty Or Return Policy After Buying Or Selling My Guitar Collection?",
                               "acceptedAnswer":  {
                                                      "@type":  "Answer",
                                                      "text":  "I love guitars and want you to love yours too! If you purchase a guitar from my inventory and feel there was missing information, or you are simply unhappy with your purchase, please reach out to me! I will do everything possible to make it right for you."
                                                  }
                           }
