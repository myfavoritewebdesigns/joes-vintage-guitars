    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What do Gibson serial numbers tell me about my guitar?", "acceptedAnswer": { "@type": "Answer", "text": "Gibson serial numbers can reveal the year of manufacture, the factory location, and the production sequence. For guitars made after 1977, the 8-digit format encodes the specific day of the year it was built." } },
        { "@type": "Question", "name": "Where is the serial number on a Gibson guitar?", "acceptedAnswer": { "@type": "Answer", "text": "On most Gibson guitars, the serial number is stamped or inked on the back of the headstock. On vintage acoustics and hollow-body electrics, it may appear on an interior paper label visible through the soundhole or f-holes." } },
        { "@type": "Question", "name": "How do I decode a Gibson Custom Shop serial number?", "acceptedAnswer": { "@type": "Answer", "text": "Gibson Custom Shop serial numbers use a CS prefix followed by the last digit of the production year and a production rank number. Historic Reissue Les Pauls use the first digit to indicate the vintage year being reissued. SG and other reissues use an impressed format where the last digit is the model year code." } },
        { "@type": "Question", "name": "How do I decode a Gibson Les Paul Classic serial number?", "acceptedAnswer": { "@type": "Answer", "text": "Les Paul Classic guitars made from 1989 to 1999 use the first digit as the last digit of the production year. From 2000 to 2014, the first two digits are the last two digits of the production year. There is no Made in USA stamp on most examples before 2007." } }
      ]
