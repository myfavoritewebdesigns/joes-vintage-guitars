        { "@type": "HowToStep", "position": 1, "name": "Choose Serial Number or FON", "text": "Determine whether you have a serial number or a Factory Order Number (FON)." },
        { "@type": "HowToStep", "position": 2, "name": "Enter your number", "text": "Type your Gibson serial number or FON into the decoder field and click Decode Number." },
        { "@type": "HowToStep", "position": 3, "name": "Identify where the number is located", "text": "Select where your serial number appears: on the interior label, ink-stamped on the headstock, or stamped into the wood." },
        { "@type": "HowToStep", "position": 4, "name": "Answer any follow-up questions", "text": "For overlapping eras, the tool will ask clarifying questions such as label color or whether a MADE IN USA stamp is present." },
        { "@type": "HowToStep", "position": 5, "name": "Review your result", "text": "The tool returns the estimated year your Gibson was manufactured based on Gibson's published serialization records." }
