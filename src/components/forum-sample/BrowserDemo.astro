---
import { categories, threads } from '../../data/forum-sample';
---
<template id="local-post-template">
  <article class="forum-card p-5 sm:p-6" data-browser-post>
    <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
      <div class="flex items-center gap-3"><span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-stone-100 text-xs font-bold text-stone-700">S1</span><div><a href="/forum-sample/u/sample-member-1/" class="text-sm font-semibold hover:underline">Sample Member 1</a><span class="mt-1 block w-fit rounded border border-stone-200 bg-stone-50 px-1.5 py-0.5 text-[10px] font-semibold text-stone-600">Demo Account</span></div></div>
      <time class="text-xs text-stone-500"></time>
    </div>
    <p data-local-body class="whitespace-pre-wrap text-[15px]"></p><p class="mt-4 text-xs font-semibold text-[#74382d]">Saved in your browser only</p>
  </article>
</template>
<template id="local-row-template">
  <article class="border-b border-stone-200 bg-amber-50/40 p-5" data-browser-row>
    <h2 class="mb-3 text-lg"><a data-local-link class="text-[#74382d] hover:underline"></a></h2>
    <div class="flex flex-wrap items-center gap-2 text-xs"><span aria-hidden="true" class="flex size-8 items-center justify-center rounded-full bg-stone-100 font-bold">S1</span><a href="/forum-sample/u/sample-member-1/" class="font-semibold hover:underline">Sample Member 1</a><span class="rounded border border-stone-200 bg-white px-1.5 py-0.5">Demo Account</span><span data-local-count class="text-stone-600"></span></div>
    <p class="mt-3 text-xs text-stone-500">Last activity <time></time></p><p class="mt-1 text-xs font-semibold text-[#74382d]">Saved in your browser only</p>
  </article>
</template>
<script is:inline define:vars={{ categorySlugs: categories.map((category) => category.slug), seededSlugs: threads.map((thread) => thread.slug) }}>
  (() => {
    const prefix = 'vgf-sample:';
    const query = (selector, root = document) => root.querySelector(selector);
    const load = (key) => {
      try { const data = JSON.parse(localStorage.getItem(prefix + key) || '[]'); return Array.isArray(data) ? data : []; }
      catch { return []; }
    };
    const validText = (value, limit) => typeof value === 'string' && value.trim().length > 0 && value.length <= limit;
    const validPost = (post) => post && validText(post.body, 3000) && typeof post.date === 'string' && Number.isFinite(Date.parse(post.date));
    const localThreads = () => load('threads').filter((thread) => validPost(thread) && validText(thread.title, 120) && typeof thread.id === 'string' && /^local-[a-f0-9-]+$/.test(thread.id) && categorySlugs.includes(thread.category));
    const replies = (id) => load('replies:' + id).filter(validPost);
    const save = (key, items, status) => {
      try { localStorage.setItem(prefix + key, JSON.stringify(items)); return true; }
      catch { status.textContent = 'Could not save. Browser storage may be blocked or full. Your text is still in the form.'; return false; }
    };
    const dateLabel = (date) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(date));
    const setDate = (element, date) => { element.dateTime = date; element.textContent = dateLabel(date); };
    const postElement = (post) => {
      const fragment = query('#local-post-template').content.cloneNode(true);
      query('[data-local-body]', fragment).textContent = post.body;
      setDate(query('time', fragment), post.date);
      return fragment;
    };
    const enable = (form) => form.querySelectorAll('input, textarea, select, button').forEach((control) => { control.disabled = false; });
    const values = (form, fields) => {
      const result = {};
      for (const name of fields) {
        const control = form.elements.namedItem(name);
        control.setCustomValidity(control.value.trim() ? '' : 'Please add some text.');
        result[name] = control.value.trim();
      }
      return form.reportValidity() ? result : null;
    };
    document.querySelectorAll('input, textarea').forEach((control) => control.addEventListener('input', () => control.setCustomValidity('')));
    const categoryList = query('[data-category-threads]');
    if (categoryList) {
      localThreads().filter((thread) => thread.category === categoryList.dataset.categoryThreads).reverse().forEach((thread) => {
        const fragment = query('#local-row-template').content.cloneNode(true);
        const link = query('[data-local-link]', fragment);
        link.textContent = thread.title;
        link.href = '/forum-sample/new-thread/?thread=' + encodeURIComponent(thread.id);
        const savedReplies = replies(thread.id);
        query('[data-local-count]', fragment).textContent = savedReplies.length + (savedReplies.length === 1 ? ' reply' : ' replies');
        setDate(query('time', fragment), savedReplies.at(-1)?.date || thread.date);
        categoryList.prepend(fragment);
      });
    }
    const renderReplies = (id, container) => {
      container.querySelectorAll('[data-browser-post]').forEach((element) => element.remove());
      replies(id).forEach((post) => container.append(postElement(post)));
      const counter = query('[data-reply-count]');
      if (counter) counter.textContent = Number(counter.dataset.seeded) + replies(id).length;
    };
    const seededPosts = query('[data-posts]');
    if (seededPosts) renderReplies(seededPosts.dataset.thread, seededPosts);
    const threadForm = query('[data-thread-form]');
    const showLocal = (thread) => {
      query('[data-create-thread]').hidden = true;
      query('[data-local-thread]').hidden = false;
      query('[data-local-title]').textContent = thread.title;
      query('[data-local-category]').href = '/forum-sample/c/' + thread.category + '/';
      const container = query('[data-local-posts]');
      container.replaceChildren();
      container.append(postElement(thread));
      replies(thread.id).forEach((post) => container.append(postElement(post)));
      query('[data-reply-form]').dataset.thread = thread.id;
    };
    if (threadForm) {
      enable(threadForm);
      const params = new URLSearchParams(location.search);
      if (categorySlugs.includes(params.get('category'))) threadForm.elements.namedItem('category').value = params.get('category');
      const local = localThreads().find((thread) => thread.id === params.get('thread'));
      if (local) showLocal(local);
      else if (params.has('thread')) query('[data-status]', threadForm).textContent = 'This browser-saved thread was not found. You can create a new demo thread below.';
      threadForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const fields = values(threadForm, ['title', 'body']);
        if (!fields || !categorySlugs.includes(threadForm.elements.namedItem('category').value)) return;
        const thread = { ...fields, id: 'local-' + crypto.randomUUID(), category: threadForm.elements.namedItem('category').value, date: new Date().toISOString() };
        if (!save('threads', [thread, ...localThreads()], query('[data-status]', threadForm))) return;
        history.pushState(null, '', '?thread=' + encodeURIComponent(thread.id));
        showLocal(thread);
        query('[data-local-title]').tabIndex = -1;
        query('[data-local-title]').focus();
      });
      window.addEventListener('popstate', () => location.reload());
    }
    const replyForm = query('[data-reply-form]');
    if (replyForm) {
      enable(replyForm);
      replyForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const fields = values(replyForm, ['body']);
        const id = replyForm.dataset.thread;
        if (!fields || !(seededSlugs.includes(id) || localThreads().some((thread) => thread.id === id))) return;
        const status = query('[data-status]', replyForm);
        const post = { body: fields.body, date: new Date().toISOString() };
        if (!save('replies:' + id, [...replies(id), post], status)) return;
        if (seededPosts) renderReplies(id, seededPosts);
        else showLocal(localThreads().find((thread) => thread.id === id));
        replyForm.reset();
        status.textContent = 'Saved in your browser only';
      });
    }
    const pitchForm = query('[data-pitch-form]');
    if (pitchForm) {
      enable(pitchForm);
      pitchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!values(pitchForm, ['name', 'site', 'topic', 'pitch'])) return;
        query('[data-status]', pitchForm).textContent = 'Thanks, this is a sample, so nothing was sent.';
        pitchForm.reset();
      });
    }
  })();
</script>
