---
// Adapted from JVG's LicensedImage: one transform drives src and ImageObject.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageOrigin, imageLicense } from '../config/image-license';

interface Props { src: ImageMetadata; alt: string; emitSchema?: boolean; widths?: number[]; sizes?: string; }
const { src, alt, emitSchema = true, widths = [360, 720, 1080], sizes = '(max-width: 639px) calc(100vw - 64px), 360px' } = Astro.props;
const built = await getImage({
  src, width: Math.min(720, src.width), widths: widths.filter(width => width <= src.width),
  format: 'webp', quality: 82,
});
const imageObject = {
  '@context': 'https://schema.org', '@type': 'ImageObject',
  '@id': `${new URL(built.src, imageOrigin).href}#image`,
  contentUrl: new URL(built.src, imageOrigin).href,
  width: built.attributes.width, height: built.attributes.height, caption: alt,
  license: imageLicense.photoLicenseUrl, acquireLicensePage: imageLicense.photoLicenseUrl,
  creditText: imageLicense.creditText, copyrightNotice: imageLicense.copyrightNotice,
  creator: { '@type': 'Person', name: imageLicense.creatorName },
};
---
<img {...built.attributes} src={built.src} srcset={built.srcSet.attribute}
  sizes={sizes} alt={alt} loading="lazy" decoding="async" />
{emitSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(imageObject)} />}
