---
import '../styles/serial-questions.css';
---
<form class="gu-tool" id="gsl-tool" aria-labelledby="gsl-heading">
 <h2 id="gsl-heading">Guild Serial Number Decoder</h2>
 <p>Enter your serial number exactly as it appears on the headstock or label. Check supported vintage ranges and Tacoma or New Hartford date codes.</p>
 <label for="gsl-input">Serial Number</label><input id="gsl-input" name="serial" type="text" maxlength="32" placeholder="For Example, 74329 Or TJ037016" autocomplete="off" spellcheck="false" aria-describedby="gsl-help" required/>
 <button class="gu-button" id="gsl-decode" type="submit">Look Up My Guild</button>
 <small id="gsl-help">The decoder works out the serial system from the format and asks a follow-up question only when the answer changes the result. <a href="/guild-labels-and-serial-number-locations/">Find the complete serial and label</a>.</small>
 <div class="gu-examples" role="group" aria-label="Try a serial example"><span>Try An Example:</span><button type="button" data-serial="74329">74329</button><button type="button" data-serial="AD355">AD355</button><button type="button" data-serial="TJ037016">TJ037016</button></div>
 <div id="gsl-result" class="gu-result" role="status" aria-live="polite" aria-atomic="true"></div>
 <noscript><p>The calculator needs JavaScript. All <a href="#part1">numeric charts</a> and <a href="/guild-model-prefix-serial-number-charts/">model charts</a> remain available below.</p></noscript>
</form>
<script>
 import {lookupGuild} from '../lib/guild-decoder';
 import {renderSerialQuestions,keepEarlierAnswers} from '../lib/serial-questions';
 const form=document.querySelector<HTMLFormElement>('#gsl-tool'),input=document.querySelector<HTMLInputElement>('#gsl-input'),output=document.querySelector<HTMLElement>('#gsl-result');
 // Answers belong to one serial; a new serial starts with no answers.
 let serial='',answers:Record<string,string>={};
 function decode(focusKey?:string){
  if(!output)return;
  const r=lookupGuild(serial,answers);
  const title=document.createElement('strong'),p=document.createElement('p'),a=document.createElement('a');
  title.textContent=r.title;p.textContent=r.detail;a.textContent=r.link;a.href=r.href;
  const questions=renderSerialQuestions(r.questions,(key,value)=>{answers=keepEarlierAnswers(r.questions,answers,key,value);decode(key);});
  output.replaceChildren(...[title,p,questions,a].filter((node):node is HTMLElement=>node!==null));
  if(focusKey)output.querySelector<HTMLButtonElement>(`.sq-choice[data-key="${focusKey}"][aria-pressed="true"]`)?.focus();
 }
 function run(){if(!input)return;if(input.value!==serial){serial=input.value;answers={};}decode();}
 form?.addEventListener('submit',e=>{e.preventDefault();run()});
 form?.querySelectorAll<HTMLButtonElement>('[data-serial]').forEach(button=>button.addEventListener('click',()=>{if(!input)return;input.value=button.dataset.serial||'';run();input.focus()}));
</script>
