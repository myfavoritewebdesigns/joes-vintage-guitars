---
import type { ImageMetadata } from "astro";
import LicensedImage from "./primitives/LicensedImage.astro";
import { SITE_URL } from "../config/site";

import heroPhoto from "../assets/images/gibson-serial/gibson-nickel-hardware-1962-gibson-sg-standard-scaled.jpg";
import customPhoto from "../assets/images/gibson-serial/1972-gibson-sg-custom.jpg";
import cherryPhoto from "../assets/images/gibson-serial/gibson-sg-standard-cherry-finish-close-up.jpg";
import pelhamPhoto from "../assets/images/gibson-serial/gibson-pelham-blue-sg.jpg";
import walnutPhoto from "../assets/images/gibson-serial/gibson-sg-walnut-finish.jpg";
import tobaccoPhoto from "../assets/images/gibson-serial/1975-gibson-sg-tobacco-burst.jpg";
import sidewaysPhoto from "../assets/images/gibson-serial/gibson-sg-sideways-vibrola-example-scaled.jpg";
import lyrePhoto from "../assets/images/gibson-serial/gibson-sg-maestro-lyre-vibrola.jpg";
import shortMaestroPhoto from "../assets/images/gibson-serial/gibson-small-maestro-vibrola.jpg";
import bigsbyPhoto from "../assets/images/gibson-serial/gibson-sg-factory-bigsby-1972-sg-custom.jpg";
import p90SpecialPhoto from "../assets/images/gibson-serial/gibson-sg-special-soapbar-p-90-pickups.jpg";
import miniSpecialPhoto from "../assets/images/gibson-serial/1973-gibson-sg-special-with-mini-humbuckers.jpg";
import juniorPhoto from "../assets/images/gibson-sg-family-guide/1960s-gibson-sg-junior.webp";
import juniorBridgePhoto from "../assets/images/gibson-sg-family-guide/1960s-gibson-sg-junior-lightning-bridge.webp";
import juniorBackPhoto from "../assets/images/gibson-sg-family-guide/1964-gibson-sg-junior-full-body-back.webp";
import juniorHeadstockPhoto from "../assets/images/gibson-sg-family-guide/1964-gibson-sg-junior-headstock-back-tuners-serial.webp";
import juniorFretboardPhoto from "../assets/images/gibson-sg-family-guide/1964-gibson-sg-junior-neck-fretboard-detail.webp";
import specialComparisonPhoto from "../assets/images/gibson-sg-family-guide/1970-gibson-sg-special-comparison.webp";
import standardComparisonPhoto from "../assets/images/gibson-sg-family-guide/early-60s-gibson-sg-standard-comparison.webp";

interface GuidePhoto {
  src: ImageMetadata;
  alt: string;
}

const canonicalPath = "/post/vintage-gibson-sg-family-guide/";
const pageUrl = `${SITE_URL}${canonicalPath}`;
const heading = "Vintage Gibson SG Models";

const models: Array<GuidePhoto & { name: string; signal: string; details: string; caption: string }> = [
  {
    name: "SG Junior",
    signal: "One dog-ear P-90",
    details: "I look for dot inlays, no fingerboard binding, one volume control, one tone control, and a wrapover bridge. Those details make the student model easy to identify.",
    src: juniorPhoto,
    alt: "1960s Gibson SG Junior body with one dog-ear P-90 pickup, two controls, and a wraparound bridge",
    caption: "1960s SG Junior · one pickup, two knobs, dot markers",
  },
  {
    name: "SG Special",
    signal: "Two pickups, usually P-90s",
    details: "I place the Special between the Junior and Standard. Early examples have two soapbar P-90s and dot markers. Some early 1970s Specials received mini-humbuckers.",
    src: specialComparisonPhoto,
    alt: "1970 Gibson SG Special in cherry with two P-90 pickups, large pickguard, and short vibrato",
    caption: "1970 SG Special · two P-90s, large guard, simple trim",
  },
  {
    name: "SG Standard",
    signal: "Two humbuckers",
    details: "I look for a bound rosewood fingerboard, crown inlays, four controls, and two full-size humbuckers. Gibson sold the earliest examples under the Les Paul name.",
    src: standardComparisonPhoto,
    alt: "Early 1960s Gibson SG Standard in cherry with two humbuckers, crown inlays, and Maestro vibrato",
    caption: "Early 1960s SG Standard · two humbuckers and bound board",
  },
  {
    name: "SG Custom",
    signal: "Three humbuckers",
    details: "I identify the top model by its three pickups, ebony fingerboard with block inlays, multi-ply binding, split-diamond headstock, and gold hardware.",
    src: customPhoto,
    alt: "1972 Gibson SG Custom with three humbuckers, block inlays, and gold hardware",
    caption: "1972 SG Custom · three pickups, blocks, gold hardware",
  },
];

const modelRows = [
  ["SG Junior", "1 dog-ear P-90", "Dots; no binding", "Wrapover bridge", "Two knobs"],
  ["SG Special", "2 soapbar P-90s; early 1970s minis", "Dots; simple trim", "Wrapover or vibrato", "Four knobs and switch"],
  ["SG Standard", "2 humbuckers", "Bound board; crowns", "Stopbar or vibrato", "Four knobs and switch"],
  ["SG Custom", "3 humbuckers", "Ebony; blocks; multi-ply trim", "Vibrato or later options", "Four knobs and switch"],
];

const eras = [
  {
    years: "1961 to 1962",
    title: "The Les Paul/SG Transition",
    copy: "The pointed double-cutaway body replaced the familiar single-cut Les Paul shape. Standards and Customs were sold as Les Paul models, and Juniors also retained Les Paul branding. These are the earliest and most sought-after SG-bodied instruments.",
    tags: ["Small angel-wing guard", "22nd-fret neck joint", "Nickel hardware"],
  },
  {
    years: "1963 to 1965",
    title: "The Classic Small-Guard SG",
    copy: "The SG name was established across the line. Maestro-style vibrolas became closely associated with Standards and Customs, while Juniors and Specials kept their direct P-90 character. Nut widths begin to narrow during 1965.",
    tags: ["SG name established", "Small guard", "Early Patent Number pickups"],
  },
  {
    years: "1966 to 1969",
    title: "The Batwing Period",
    copy: "The large pickguard moved around the pickups and became the fastest visual clue for a later 1960s SG. Narrow 1 9/16-inch nuts, T-Top humbuckers, chrome hardware, and a changed neck joint help separate these from the early small-guard instruments.",
    tags: ["Large batwing guard", "Narrower nut", "T-Top era"],
  },
  {
    years: "1969 to 1975",
    title: "The Early Norlin Transition",
    copy: "Three-piece mahogany necks and a volute became important construction clues. Walnut joined cherry in the finish palette, and the catalog briefly made room for the SG Deluxe, SG Pro, and the budget SG-100, SG-200, and SG-250 series.",
    tags: ["Three-piece mahogany neck", "Volute", "Walnut option"],
  },
  {
    years: "1971 to 1972",
    title: "The Experimental Catalog",
    copy: "Familiar names briefly gave way to SG Deluxe, SG Pro, SG-100, SG-200, and SG-250. Front-mounted control plates, altered pickup layouts, and unusual hardware make this short run visually distinct from both 1960s and later 1970s SGs.",
    tags: ["Deluxe and Pro names", "Control plates", "Short production runs"],
  },
  {
    years: "1975 to 1984",
    title: "Mid- and Late-Norlin SGs",
    copy: "Some necks moved to three-piece maple, hardware kept evolving, and the TP-6 fine-tuning tailpiece appeared from 1977. Standard, Custom, Special, and derivative model names overlap across a period best dated by construction plus electronics.",
    tags: ["Some maple necks", "TP-6 from 1977", "Multiple variants"],
  },
];

const valueFactors = [
  ["Exact Model and Era", "I value an early SG/Les Paul Standard in a different market from a 1970s SG Standard, even when both guitars are original."],
  ["Original Finish", "Natural cherry fade isn’t damage. I treat a refinish, overspray, or color change as a major value issue."],
  ["Pickups and Electronics", "I look for original PAF, Patent Number, or P-90 pickups and an undisturbed wiring harness."],
  ["Breaks and Repairs", "I see headstock and neck joint repairs often. The quality and visibility matter, but any break affects collector value."],
  ["Hardware and Plastics", "I check that the tuners, bridge, vibrato, pickguard, knobs, and pickup rings match the claimed production period."],
  ["Color, Case, and History", "I consider documented custom colors, the correct case, receipts, family photographs, and a clear ownership story."],
];

const faqs = [
  {
    question: "Is a 1961 Gibson SG Actually a Les Paul?",
    answer: "Yes. The body is the design we now call the SG, but Gibson initially sold the Standard and Custom under the Les Paul name. Early Juniors also kept Les Paul branding. By 1963, the SG name was established across the family.",
  },
  {
    question: "What Is the Difference Between an SG Junior and SG Special?",
    answer: "A vintage SG Junior has one dog-ear P-90 at the bridge and two controls. A vintage SG Special has two soapbar P-90s, a selector switch, and four controls. Both are plainer than a Standard.",
  },
  {
    question: "Does an SG Serial Number Prove the Year?",
    answer: "No. Gibson reused and overlapped serial ranges during the 1960s. I check the number against the pickguard, neck joint, nut width, hardware, pickup codes, pot codes, and construction.",
  },
  {
    question: "Does a Repaired Headstock Make a Vintage SG Worthless?",
    answer: "No, but it changes the market. A clean, stable repair can make a good player’s guitar. I still value it below an otherwise equal unbroken example.",
  },
  {
    question: "Which Vintage SG Models Are Worth the Most?",
    answer: "Early Les Paul branded Standards and Customs usually sit near the top. I still judge each guitar by its originality, condition, finish, pickups, repairs, and history.",
  },
  {
    question: "When Did Gibson Add a Volute to the SG?",
    answer: "I start seeing volutes around the 1969 transition into early Norlin production. Gibson changes overlapped, so I compare the volute with the neck construction, Made in USA stamp, hardware, finish, and electronics.",
  },
  {
    question: "Did Vintage SG Specials Come With Humbuckers?",
    answer: "Yes, but the factory exception is the mini-humbucker version found on some early 1970s examples. The classic early SG Special has two soapbar P-90s. I still check that the pickup routes, pickguard, and the rest of the guitar agree with the claimed model and year.",
  },
  {
    question: "Is Pelham Blue an Original Vintage SG Color?",
    answer: "Yes. I see Pelham Blue on a small number of 1960s SGs, and it’s far less common than cherry. I check a valuable custom color claim under the guard and with ultraviolet light for original lacquer, fading, overspray, and finish work.",
  },
];

const internalGuides = [
  { title: "Gibson PAF and Patent Number Pickup Guide", copy: "Identify PAF, Patent Number, and T-Top pickups by their construction, decals, hardware, and era.", href: "/post/gibson-paf-patent-number-pickup-guide/" },
  { title: "Gibson Serial Number Decoder", copy: "Use my decoder as a starting point, then verify the guitar’s physical features.", href: "/how-to-read-gibson-serial-numbers/" },
  { title: "Gibson Production and Shipping Totals", copy: "Compare recorded SG Standard, Custom, Special, and Junior shipments by year.", href: "/post/gibson-shipping-totals-1948-1979/" },
  { title: "Les Paul Junior Authentication Guide", copy: "Follow the Junior from the 1954 slab body through the 1961 SG transition.", href: "/post/gibson-les-paul-junior-guide/" },
  { title: "How Gibson Year Affects Value", copy: "See where the 1960s transition and Norlin years fit in the larger Gibson market.", href: "/post/how-the-year-of-manufacture-of-your-vintage-gibson-guitar-affects-its-price/" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq-schema`,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article class="sgf-page">
    <header class="sgf-hero">
      <div class="sgf-hero__copy">
        <nav class="sgf-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span>Vintage Gibson SG</span>
        </nav>
        <p class="sgf-eyebrow">The Complete Collector’s Field Guide</p>
        <h1>{heading}</h1>
        <p class="sgf-hero__subtitle">Junior, Special, Standard and Custom</p>
        <p class="sgf-hero__dek">In this photograph-led guide, I cover the SG family from the first Les Paul-branded guitars through the Norlin years. I’ll show you what defines each model, which parts fit each era, and what I inspect before I buy, sell, or value one.</p>
        <div class="sgf-byline"><span>JD</span><p><strong>By <a href="/about-me/">Joe Dampt</a></strong><small>Vintage Gibson specialist</small></p></div>
      </div>
      <figure class="sgf-hero__image">
        <LicensedImage src={heroPhoto} alt="1962 Gibson SG Standard with original nickel hardware" width={1400} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>1962 SG/Les Paul Standard with nickel hardware.</figcaption>
      </figure>
    </header>

    <section class="sgf-quick-answer" aria-labelledby="sgf-quick-answer-title">
      <span class="sgf-answer-number">01</span>
      <div>
        <p class="sgf-eyebrow">Identify the Family First</p>
        <h2 id="sgf-quick-answer-title">Four Core Models. Four Different Visual Signatures.</h2>
        <p>I divide the vintage SG family into four core models: the <strong>Junior, Special, Standard, and Custom</strong>. I start with pickup count and type, confirm the fingerboard trim and controls, then date the guitar from its neck, pickguard, hardware, finish, serial number, and electronics. My <a href="/how-to-read-gibson-serial-numbers/">complete Gibson SG dating reference</a> provides the serial tables and model-by-model details for the final cross-check.</p>
        <div class="sgf-fact-strip" aria-label="Guide coverage">
          <span><strong>4</strong> core models</span><span><strong>6</strong> production eras</span><span><strong>19</strong> field photographs</span><span><strong>1961 to 1984</strong> field-guide range</span>
        </div>
      </div>
    </section>

    <div class="sgf-article-grid">
      <aside class="sgf-toc" aria-label="Table of contents">
        <p>In This Guide</p>
        <ol>
          <li><a href="#models">Model Comparison</a></li><li><a href="#standard">SG Standard</a></li><li><a href="#custom">SG Custom</a></li><li><a href="#special">SG Special</a></li><li><a href="#junior">SG Junior</a></li><li><a href="#timeline">Production Timeline</a></li><li><a href="#hardware">Hardware Atlas</a></li><li><a href="#identify">Dating and Authentication</a></li><li><a href="#value">Value and Research</a></li><li><a href="#faq">Common Questions</a></li>
        </ol>
        <a class="sgf-toc__help" href="/sell-my-gibson-guitar/">Need Help Identifying Yours?</a>
      </aside>

      <div class="sgf-article-body">
        <section id="models" class="sgf-section">
          <p class="sgf-kicker">Start Here</p>
          <h2>How to Tell the Four Vintage SG Models Apart</h2>
          <p>I use Gibson’s familiar student-to-deluxe hierarchy to sort the thin double-cutaway models. The Junior is spare. The Special adds a second pickup. The Standard moves to humbuckers and dressier trim. The Custom sits at the top with three pickups, gold hardware, and the most elaborate appointments. Browse <a href="/blog/">my vintage Gibson model guides</a> for more instrument-by-instrument research.</p>
          <div class="sgf-model-grid">
            {models.map((model, index) => (
              <article class="sgf-model-card">
                <figure>
                  <LicensedImage src={model.src} alt={model.alt} width={900} loading="lazy" decoding="async" />
                  <figcaption>{model.caption}</figcaption>
                </figure>
                <div class="sgf-model-card__copy"><span>0{index + 1}</span><h3>{model.name}</h3><strong>{model.signal}</strong><p>{model.details}</p></div>
              </article>
            ))}
          </div>
          <div class="sgf-table-wrap">
            <table>
              <caption>Fast visual comparison of the core vintage SG family</caption>
              <thead><tr><th scope="col">Model</th><th scope="col">Pickups</th><th scope="col">Fingerboard</th><th scope="col">Typical Tailpiece</th><th scope="col">Controls</th></tr></thead>
              <tbody>{modelRows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>
          <div class="sgf-note"><strong>1961 to 1963 Naming Trap</strong><p>Gibson still sold the earliest SG-shaped instruments as Les Paul models. An early guitar can have the body we call an SG without saying “SG” anywhere on it. My <a href="/post/gibson-les-paul-junior-guide/">Les Paul Junior evolution guide</a> documents that transition on the one-pickup model. I put more weight on construction and original features than the wording on a truss-rod cover.</p></div>
        </section>

        <section id="standard" class="sgf-section sgf-model-section">
          <div class="sgf-dossier-heading"><span>01</span><div><p class="sgf-kicker">Two Humbuckers</p><h2>Gibson SG Standard</h2></div></div>
          <p class="sgf-lead">The Standard is the guitar most players picture when someone says “vintage SG”: two full-size humbuckers, four controls, a bound rosewood fingerboard with crown inlays, and cherry-finished mahogany. I use the hardware and neck details to separate one decade from another, then compare them with my <a href="/how-to-read-gibson-serial-numbers/">SG Standard dating charts</a> before assigning a year.</p>
          <div class="sgf-dossier-layout">
            <div>
              <h3>What Makes It a Standard</h3>
              <ul class="sgf-feature-list">
                <li><strong>Two full-size humbuckers.</strong> <a href="/post/gibson-paf-patent-number-pickup-guide/">PAFs and Patent Number pickups</a> can appear on the earliest 1961 to 1962 guitars, followed by T-Tops.</li>
                <li><strong>Bound rosewood fingerboard.</strong> Crown or trapezoid-style inlays separate it from the dot-marker Junior and Special.</li>
                <li><strong>Four knobs and a selector.</strong> The familiar two-volume, two-tone Gibson control layout remains a core clue.</li>
                <li><strong>Model- and era-correct bridge.</strong> Stopbars, sideways units, Maestro vibratos, and later hardware must agree with the date.</li>
              </ul>
              <dl class="sgf-spec-ledger">
                <div><dt>1961 to 1962</dt><dd>Les Paul/SG name, one-piece mahogany neck, 1 11/16-inch nut, no volute</dd></div>
                <div><dt>1963 to 1964</dt><dd>SG name established; one-piece neck; early Patent Number pickup period</dd></div>
                <div><dt>1965 to 1969</dt><dd>Narrower 1 9/16-inch nut; T-Top transition; large guard from the later 1960s</dd></div>
                <div><dt>1969 to 1975</dt><dd>Three-piece mahogany neck, volute, and walnut finish option</dd></div>
                <div><dt>1975 to 1984</dt><dd>Some three-piece maple necks; TP-6 fine-tuner tailpiece from 1977</dd></div>
              </dl>
            </div>
            <figure class="sgf-model-photo"><LicensedImage src={cherryPhoto} alt="Vintage Gibson SG Standard cherry finish close-up" width={900} loading="lazy" decoding="async" /><figcaption><strong>Finish Evidence</strong> Transparent cherry lets the mahogany grain remain visible. Protected areas often retain the strongest red.</figcaption></figure>
          </div>
          <div class="sgf-subsection-heading"><p class="sgf-kicker">Finish Atlas</p><h3>Color Can Rule an Era In or Out</h3><p>Cherry spans the whole story, so it can’t date a guitar by itself. Rarer colors are more useful once I’ve confirmed the original lacquer.</p></div>
          <div class="sgf-photo-grid sgf-photo-grid--three">
            <figure class="sgf-evidence-photo"><LicensedImage src={pelhamPhoto} alt="Rare 1960s Gibson SG in Pelham Blue" width={700} loading="lazy" decoding="async" /><figcaption><strong>Pelham Blue</strong><span>A scarce 1960s factory color. Check fading, protected areas, and UV response before paying a custom-color premium.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={walnutPhoto} alt="Norlin-era Gibson SG in walnut finish" width={700} loading="lazy" decoding="async" /><figcaption><strong>Walnut</strong><span>Closely associated with the early Norlin era; it immediately argues against a pre-1969 claim.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={tobaccoPhoto} alt="1975 Gibson SG in Tobacco Burst finish" width={700} loading="lazy" decoding="async" /><figcaption><strong>Tobacco Burst</strong><span>An uncommon 1970s finish, shown here on a 1975 SG.</span></figcaption></figure>
          </div>
          <div class="sgf-two-tables">
            <div class="sgf-table-wrap"><table><caption>Standard pickup framework</caption><thead><tr><th scope="col">Period</th><th scope="col">Expected Pickup Family</th></tr></thead><tbody><tr><th scope="row">1961 to 1962</th><td>PAF, with early Patent Number overlap</td></tr><tr><th scope="row">1962 to 1965</th><td>Patent Number humbuckers</td></tr><tr><th scope="row">1965 to 1975</th><td>T-Top era</td></tr></tbody></table></div>
            <div class="sgf-table-wrap"><table><caption>Standard neck framework</caption><thead><tr><th scope="col">Period</th><th scope="col">Construction Clue</th></tr></thead><tbody><tr><th scope="row">1961 to 1969</th><td>One-piece mahogany; no volute</td></tr><tr><th scope="row">1969 to 1975</th><td>Three-piece mahogany; volute</td></tr><tr><th scope="row">1975 to 1984</th><td>Some three-piece maple necks</td></tr></tbody></table></div>
          </div>
        </section>

        <section id="custom" class="sgf-section sgf-model-section">
          <div class="sgf-dossier-heading"><span>02</span><div><p class="sgf-kicker">Three Humbuckers</p><h2>Gibson SG Custom</h2></div></div>
          <div class="sgf-dossier-layout sgf-dossier-layout--reverse">
            <figure class="sgf-model-photo sgf-model-photo--tall"><LicensedImage src={customPhoto} alt="1972 Gibson SG Custom with three pickups and gold hardware" width={900} loading="lazy" decoding="async" /><figcaption><strong>1972 SG Custom</strong> Three pickups, gold hardware, and deluxe trim identify the Custom before the serial number is read.</figcaption></figure>
            <div>
              <p>I identify the top-line SG by its three humbuckers, gold-plated hardware, ebony fingerboard with block inlays, multi-ply binding, and split-diamond headstock ornament. Gibson introduced it in 1961 as the Les Paul Custom. Early Polaris White examples are easy to recognize, while walnut and ebony appear later.</p>
              <h3>The Fastest Custom Checks</h3>
              <ul class="sgf-feature-list"><li><strong>Three pickups.</strong> That’s the clearest difference from the two-humbucker Standard.</li><li><strong>Gold hardware.</strong> Natural plating wear can expose nickel underneath. Uniform bright plating deserves a closer look.</li><li><strong>Deluxe trim.</strong> Ebony board, block inlays, multi-ply binding, and the headstock diamond should read as one coherent package.</li><li><strong>Original routing.</strong> Pull the guard before assuming a three-pickup conversion is a factory Custom.</li></ul>
            </div>
          </div>
          <div class="sgf-era-cards"><article><span>1961 to 1963</span><h3>Les Paul Custom</h3><p>Three PAFs, a one-piece mahogany neck, gold hardware, deluxe binding, and typically Polaris White. These are the earliest and most collectible.</p></article><article><span>1963 to 1969</span><h3>SG Name, Evolving Hardware</h3><p>Patent Number pickups give way to T-Tops. The nut narrows after 1965, and Grover Rotomatics become common around the later 1960s.</p></article><article><span>1969 to 1980</span><h3>Norlin Construction</h3><p>Three-piece necks, volutes, walnut or ebony finish options, and later TP-6 hardware separate these from the early white Customs.</p></article></div>
        </section>

        <section id="special" class="sgf-section sgf-model-section">
          <div class="sgf-dossier-heading"><span>03</span><div><p class="sgf-kicker">Two Pickups, Simpler Trim</p><h2>Gibson SG Special</h2></div></div>
          <p class="sgf-lead">I place the classic SG Special between the Junior and Standard. It has two pickups and four controls, but it keeps dot inlays and simpler trim. Early examples use two soapbar P-90s. Some early 1970s Specials received mini-humbuckers, as documented in my <a href="/how-to-read-gibson-serial-numbers/">Gibson SG model guide</a>.</p>
          <div class="sgf-photo-grid sgf-photo-grid--two">
            <figure class="sgf-evidence-photo"><LicensedImage src={p90SpecialPhoto} alt="Vintage Gibson SG Special with two soapbar P-90 pickups" width={900} loading="lazy" decoding="async" /><figcaption><strong>The Classic Special</strong><span>Two soapbar P-90s, a selector switch, and four controls. The Junior uses one dog-ear P-90 instead.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={miniSpecialPhoto} alt="1973 Gibson SG Special with black-cover mini-humbuckers" width={900} loading="lazy" decoding="async" /><figcaption><strong>1973 Transition</strong><span>Black-cover mini-humbuckers show why pickup type has to be read together with the pickguard, controls, neck, and serial evidence.</span></figcaption></figure>
          </div>
          <div class="sgf-era-cards"><article><span>1961 to 1963</span><h3>Les Paul Special / SG Body</h3><p>Two soapbar P-90s, thin one-piece mahogany neck, no volute, and cherry, white, or scarce TV Yellow finishes.</p></article><article><span>1963 to 1971</span><h3>The P-90 SG Special</h3><p>The SG name is established, while the two-soapbar layout remains the model’s strongest visual signature. Later guitars follow the larger-pickguard transition.</p></article><article><span>Early 1970s</span><h3>Mini-Humbucker Variation</h3><p>Mini-humbuckers appear on some early 1970s Specials. I don’t reject one by pickup type alone, but I inspect the routes because later pickup swaps are common.</p></article></div>
        </section>

        <section id="junior" class="sgf-section sgf-model-section">
          <div class="sgf-dossier-heading"><span>04</span><div><p class="sgf-kicker">One Pickup, One Purpose</p><h2>Gibson SG Junior</h2></div></div>
          <div class="sgf-junior-panel"><div><p class="sgf-kicker">The Quickest SG to Recognize</p><h3>One Dog-Ear P-90. Two Knobs. No Binding.</h3><p>Gibson’s student model entered the SG shape in 1961 but kept the Les Paul Junior name through 1962. In my <a href="/post/gibson-les-paul-junior-guide/">complete Gibson Les Paul Junior guide</a>, I follow that evolution from the 1954 slab body into the SG transition. I identify an SG Junior by its thin pointed body, single bridge-position dog-ear P-90, wrapover bridge, dot markers, and two-control layout.</p></div><div class="sgf-junior-facts"><span><strong>1961 to 1963</strong>Thinnest body, Les Paul-to-SG naming transition, one-piece mahogany neck</span><span><strong>1963 to 1965</strong>SG name established; some guitars use a small vibrato</span><span><strong>1966 to 1969</strong>Thicker neck feel; white joins cherry; still no volute</span><span><strong>1969 to 1971</strong>Three-piece mahogany neck and volute before discontinuation</span></div></div>
          <div class="sgf-photo-grid sgf-photo-grid--two"><figure class="sgf-evidence-photo"><LicensedImage src={juniorPhoto} alt="1960s Gibson SG Junior body with one dog-ear P-90 and two controls" width={900} loading="lazy" decoding="async" /><figcaption><strong>The Junior Layout</strong><span>One bridge-position dog-ear P-90, one volume, and one tone control make the model readable before the serial number is checked.</span></figcaption></figure><figure class="sgf-evidence-photo"><LicensedImage src={juniorBridgePhoto} alt="1960s Gibson SG Junior dog-ear P-90 and compensated lightning-bolt wraparound bridge" width={900} loading="lazy" decoding="async" /><figcaption><strong>Pickup and Bridge Evidence</strong><span>The dog-ear pickup and compensated wraparound bridge belong to the Junior vocabulary; added Tune-o-matic posts would require an explanation.</span></figcaption></figure></div>
          <div class="sgf-note"><strong>Junior Bridge Check</strong><p>A period SG Junior should make sense around a wrapover bridge. An ABR-1 or Tune-o-matic can indicate a conversion, altered body, or misidentified guitar. Look for post holes, plugs, and finish disturbance.</p></div>
          <a class="sgf-inline-guide" href="/post/gibson-les-paul-junior-guide/">Follow the Junior from 1954 through the 1961 SG transition</a>
        </section>

        <section id="timeline" class="sgf-section">
          <p class="sgf-kicker">The Whole Family</p><h2>Vintage Gibson SG Production Timeline</h2>
          <p>Factory changes overlap, so I treat these as working eras rather than strict January-to-December rules. A transitional guitar can carry features from both sides of a date line. Pair this timeline with my <a href="/post/gibson-shipping-totals-1948-1979/">Gibson SG production and shipping totals</a> to see how Standard, Custom, Special, and Junior output changed by year.</p>
          <div class="sgf-timeline">{eras.map((era) => <article><div class="sgf-timeline__year">{era.years}</div><div><h3>{era.title}</h3><p>{era.copy}</p><div class="sgf-tags">{era.tags.map((tag) => <span>{tag}</span>)}</div></div></article>)}</div>
          <div class="sgf-offshoots"><h3>Short-Lived 1970s SG Offshoots</h3><p><strong>SG Deluxe and SG Pro:</strong> transitional models with hardware and control layouts that don’t follow the earlier Standard/Special template.</p><p><strong>SG-100, SG-200, and SG-250:</strong> budget models from the early 1970s; pickup count and front-mounted electronics help tell them apart.</p><p><strong>SG I, II, and III:</strong> later numbered variants that belong to the wider SG family. I wouldn’t represent one as a Standard, Special, Junior, or Custom.</p></div>
        </section>

        <section id="hardware" class="sgf-section">
          <p class="sgf-kicker">Hardware Atlas</p><h2>Four SG Vibratos That Change the Identification</h2>
          <p>Tailpiece type is one of the most visible dating clues. It’s also one of the easiest parts to replace. I study the unit’s footprint, screw holes, bridge, plating, and finish shadows to decide whether it has always been on that guitar. Then I compare the whole instrument with my <a href="/how-to-read-gibson-serial-numbers/">complete Gibson serial number guide</a>.</p>
          <div class="sgf-photo-grid sgf-photo-grid--two">
            <figure class="sgf-evidence-photo"><LicensedImage src={sidewaysPhoto} alt="1961 to 1962 Gibson SG sideways vibrola" width={900} loading="lazy" decoding="async" /><figcaption><strong>Sideways Vibrola · 1961 to 1962</strong><span>The ornate side-pull mechanism is a signature of the earliest high-trim SG/Les Paul period.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={lyrePhoto} alt="1963 to 1966 Gibson SG Maestro Lyre vibrola" width={900} loading="lazy" decoding="async" /><figcaption><strong>Maestro Lyre · Commonly 1963 to 1966</strong><span>The long engraved cover became one of the defining visual details of a classic mid-1960s Standard or Custom.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={shortMaestroPhoto} alt="1960s Gibson SG short Maestro vibrola" width={900} loading="lazy" decoding="async" /><figcaption><strong>Short Maestro · Commonly 1963 to 1966</strong><span>A compact factory vibrato whose screw pattern and finish shadow should match the body.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={bigsbyPhoto} alt="1972 Gibson SG Custom with factory-fitted Bigsby vibrato" width={900} loading="lazy" decoding="async" /><figcaption><strong>Factory Bigsby · 1972 Example</strong><span>Documented on some Norlin-era SGs. Factory provenance matters because later Bigsby additions are common.</span></figcaption></figure>
          </div>
        </section>

        <section id="identify" class="sgf-section">
          <p class="sgf-kicker">Visual Dating</p><h2>How I Identify an Unknown SG</h2>
          <p>I start with features that require permanent woodwork, then move toward parts that can be changed with a screwdriver. I check the serial number near the end of the sequence. Once the physical evidence agrees, I use my <a href="/how-to-read-gibson-serial-numbers/">free Gibson serial number decoder</a> to test the date.</p>
          <div class="sgf-photo-grid sgf-photo-grid--three">
            <figure class="sgf-evidence-photo"><LicensedImage src={juniorHeadstockPhoto} alt="Back of a 1964 Gibson SG Junior headstock showing serial number and strip tuners" width={700} loading="lazy" decoding="async" /><figcaption><strong>Serial and Tuner Footprint</strong><span>Read the stamped number alongside the tuner style, screw holes, lacquer texture, and any shadow left by earlier hardware.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={juniorBackPhoto} alt="Back of a 1964 Gibson SG Junior showing the neck heel and mahogany body" width={700} loading="lazy" decoding="async" /><figcaption><strong>Neck Heel and Body</strong><span>The heel, neck joint, mahogany construction, bevels, and protected finish help test whether the claimed era is physically coherent.</span></figcaption></figure>
            <figure class="sgf-evidence-photo"><LicensedImage src={juniorFretboardPhoto} alt="1964 Gibson SG Junior unbound rosewood fingerboard with dot markers" width={700} loading="lazy" decoding="async" /><figcaption><strong>Fingerboard Trim</strong><span>Dot markers and an unbound board support Junior identification. Wear or a missing inlay is a condition issue, not a different model.</span></figcaption></figure>
          </div>
          <div class="sgf-inspection-list">
            <article><span>1</span><div><h3>Establish the Model</h3><p>Count the pickups, identify their type, and confirm the control layout, fingerboard markers, binding, and headstock trim.</p></div></article>
            <article><span>2</span><div><h3>Read the Body and Pickguard</h3><p>Small guard, large batwing guard, control plate, bevel shape, and neck-joint position narrow the production era before a number is decoded.</p></div></article>
            <article><span>3</span><div><h3>Measure the Nut and Study the Neck</h3><p>Early guitars are generally 1 11/16 inches at the nut. Many 1965 to 1969 examples narrow to about 1 9/16. One-piece versus three-piece construction and a volute are major clues.</p></div></article>
            <article><span>4</span><div><h3>Match the Bridge and Vibrato</h3><p>Wrapover, sideways, Lyre, short Maestro, Bigsby, stopbar, and TP-6 systems belong to different models and periods. Extra or plugged holes record earlier hardware.</p></div></article>
            <article><span>5</span><div><h3>Inspect the Pickups and Harness</h3><p>Baseplates, stickers, patent markings, lead wire, pot date codes, capacitors, and untouched solder should support the claimed era together.</p></div></article>
            <article><span>6</span><div><h3>Look for Repairs and Finish Work</h3><p>Check the headstock, neck heel, pickup routes, tuner footprints, and protected finish under guards. UV light can expose overspray and touch-up.</p></div></article>
            <article><span>7</span><div><h3>Cross-Check the Serial Number</h3><p>Only after the guitar has an evidence-based model and era should the headstock number, Made in USA stamp, and production references be used to test the conclusion.</p></div></article>
          </div>
          <a class="sgf-inline-guide" href="/how-to-read-gibson-serial-numbers/">Decode the number and compare the complete SG dating charts</a>
        </section>

        <section id="authentication" class="sgf-section">
          <p class="sgf-kicker">Before Buying or Selling</p><h2>Vintage SG Authentication Checklist</h2>
          <p>I’ve seen plenty of light, playable SGs with repairs or modifications earned through years of use. That history can still leave you with a wonderful instrument, but the description and price must reflect it. If the clues don’t line up, send me the photographs through my <a href="/free-appraisal/">free vintage guitar appraisal</a> for a second look.</p>
          <div class="sgf-checklist">
            <div><span aria-hidden="true">✓</span><p>Photograph the full front and back before removing any parts; document every screw and finish shadow as found.</p></div>
            <div><span aria-hidden="true">✓</span><p>Inspect the back of the headstock and the neck heel under strong side light for glue lines, overspray, or a change in lacquer texture.</p></div>
            <div><span aria-hidden="true">✓</span><p>Remove the pickguard when permission allows and look for enlarged pickup routes, plugged bridge holes, and added vibrato holes.</p></div>
            <div><span aria-hidden="true">✓</span><p>Confirm that pickup baseplates, stickers, leads, solder joints, pot date codes, and capacitors agree with one another.</p></div>
            <div><span aria-hidden="true">✓</span><p>Compare tuner footprints and screw holes. Replaced tuners are common even when vintage-looking replacements are installed.</p></div>
            <div><span aria-hidden="true">✓</span><p>Check cherry or custom-color finish in protected areas. Original aging should make physical sense around guards and hardware.</p></div>
            <div><span aria-hidden="true">✓</span><p>Record the case, paperwork, receipts, and old photographs. Provenance can support both authentication and value.</p></div>
          </div>
          <blockquote class="sgf-pullquote"><strong>A Serial Number Is Evidence, Not a Verdict.</strong><p>I expect the body, neck, finish, hardware, and electronics on a vintage Gibson to tell the same story.</p></blockquote>
        </section>

        <section id="value" class="sgf-section">
          <p class="sgf-kicker">Collector Value</p><h2>What Makes One Vintage SG Worth More Than Another?</h2>
          <p>I use the model and year to establish the market category. Finish, originality, condition, repairs, and documentation decide where an individual guitar sits inside it. My <a href="/post/how-the-year-of-manufacture-of-your-vintage-gibson-guitar-affects-its-price/">vintage Gibson value-by-year guide</a> explains the wider market context. If you’re ready for an offer, go directly to <a href="/sell-my-gibson-guitar/">Sell My Gibson</a>.</p>
          <div class="sgf-value-grid">{valueFactors.map(([title, copy], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
          <div class="sgf-value-callout"><span aria-hidden="true">✓</span><div><h3>A Repaired SG Can Still Be a Very Good Guitar</h3><p>A stable professional repair and clear pricing can make a broken-and-repaired SG an excellent player. I don’t value it like an otherwise equivalent unbroken collector example.</p></div></div>
        </section>

        <section id="guides" class="sgf-section">
          <p class="sgf-kicker">Use the Complete Research Set</p><h2>Keep Researching on Joe’s Vintage Guitars</h2>
          <p>I use these resources from the <a href="/">Joe’s Vintage Guitars home page</a> to move from broad SG identification to pickup authentication, serial-number cross-checking, production context, year-based value, and the earlier Junior story.</p>
          <div class="sgf-guide-grid">{internalGuides.map((guide) => <a href={guide.href}><strong>{guide.title}</strong><p>{guide.copy}</p><span>Read the Guide</span></a>)}</div>
        </section>

        <section id="faq" class="sgf-section">
          <p class="sgf-kicker">Common Questions</p><h2>Vintage Gibson SG FAQ</h2>
          <div class="sgf-faq-list">{faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
        </section>

        <section class="sgf-sources">
          <h2>About the Photographs and Research</h2>
          <p>The photographs come from guitars I’ve documented at <a href="/">Joe’s Vintage Guitars</a> and in my <a href="/how-to-read-gibson-serial-numbers/">Gibson serial number and dating guide</a>. I cross-check production context with my <a href="/post/gibson-shipping-totals-1948-1979/">Gibson shipping totals</a>. Factory changes overlap, so I don’t treat any single feature as proof of a production year.</p>
        </section>
      </div>
    </div>

    <section class="sgf-final-cta">
      <div><p class="sgf-eyebrow">Have a Vintage SG?</p><h2>Let’s Figure Out Exactly What You Have.</h2><p>Send me clear photos of the front, back, headstock, serial number, pickups, controls, and case for a free appraisal. If you decide to move forward, I can also make a direct offer for your vintage Gibson.</p></div>
