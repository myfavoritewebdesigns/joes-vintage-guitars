---
const live = 'https://www.joesvintageguitarsaz.com';

const resourceGroups = [
  {
    title: 'Les Paul And Solidbody Articles',
    links: [
      ['Les Paul Junior', `${live}/post/gibson-les-paul-junior-guide/`],
      ['Les Paul TV Model', `${live}/post/gibson-les-paul-tv-model-guide/`],
      ['Les Paul Value Guide', `${live}/vintage-gibson-les-paul-market-value-guide/`],
      ['Gibson Firebird', `${live}/post/gibson-firebird-history-authentication-value/`],
      ['1971 Flying V Medallion', `${live}/post/gibson-flying-v-medallion-guide/`],
    ],
  },
  {
    title: 'ES Family Deep Dives',
    links: [
      ['1959 ES-335', `${live}/post/1959-gibson-es-335-authentication-guide/`],
      ['1962 ES-335', `${live}/post/1962-gibson-es-335-guide/`],
      ['1966 ES-335', `${live}/post/1966-gibson-es-335-authentication-guide/`],
      ['1968 ES-335', `${live}/post/1968-gibson-es-335-guide/`],
      ['ES-345', `${live}/post/gibson-es-345-history-value/`],
      ['1959 ES-355', `${live}/post/1959-gibson-es-355-history-value/`],
    ],
  },
  {
    title: 'Other Model Guides',
    links: [
      ['Gibson Byrdland', `${live}/post/gibson-byrdland-authentication-guide/`],
      ['Gibson ES-225', `${live}/post/gibson-es-225-guide/`],
      ['Gibson ES-125', `${live}/post/gibson-es-125-guide/`],
      ['Gibson ES-175', `${live}/post/gibson-es-175-evolution-and-specifications/`],
      ['Gibson J-200', `${live}/post/gibson-j200-model-history-authentication-guide/`],
    ],
  },
  {
    title: 'Research And Next Steps',
    links: [
      ['What A Serial Number Can’t Tell You', `${live}/post/what-a-serial-number-cant-tell-you/`],
      ['Gibson Shipping Totals, 1948 To 1979', `${live}/post/gibson-shipping-totals-1948-1979/`],
      ['Sell My Gibson', `${live}/sell-my-gibson-guitar/`],
      ['Request A Free Appraisal', `${live}/free-appraisal/`],
    ],
  },
];
---

<section id="dating-guides" class="mx-auto max-w-[88rem] px-5 py-14 lg:px-10">
  <span id="more-gibson-resources" class="legacy-anchor" aria-hidden="true"></span>
  <div class="rounded-[2rem] border border-rule bg-cream p-7 md:p-10">
    <div class="resource-intro">
      <div>
        <p class="eyebrow">Further Reading</p>
        <h2 class="section-title">More Gibson Resources</h2>
      </div>
      <p>Use these focused articles after choosing the main model, parts or features guide above.</p>
    </div>
    <div class="resource-grid">
      {resourceGroups.map(group => (
        <article class="resource-card">
          <h3>{group.title}</h3>
          <ul>{group.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .resource-intro { display: grid; gap: 1rem 3rem; align-items: end; }
  .resource-intro > p { max-width: 38rem; font-size: 1.05rem; line-height: 1.7; color: color-mix(in srgb, var(--color-ink) 74%, transparent); }
  .resource-grid { display: grid; gap: 1rem; margin-top: 2rem; }
  .resource-card { border-top: 1px solid var(--color-rule); padding-top: 1rem; }
  .resource-card h3 { color: var(--color-wine-dark); font-family: var(--font-display); font-size: 1.35rem; line-height: 1.25; }
  .resource-card ul { display: grid; gap: .55rem; margin-top: .85rem; }
  .resource-card a { color: var(--color-wine-dark); font-weight: 700; text-decoration: underline; text-underline-offset: .2em; }
  .resource-card a:hover { color: var(--color-wine); }
  @media (min-width: 700px) {
    .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .resource-intro { grid-template-columns: minmax(0, 1fr) minmax(22rem, .85fr); }
    .resource-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
