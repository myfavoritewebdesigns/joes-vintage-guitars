---
/**
 * Hero block for non-homepage pages (sell-my-fender, about-me, blog, contact, etc.).
 *
 * Renders eyebrow + H1 + subhead over a configurable background (photo, color, or both).
 * Use the `cta` named slot for buttons (typically the Button primitive); use the
 * `breadcrumbs` slot for breadcrumb navigation if the page needs it.
 *
 * Example:
 *   <PageHero
 *     eyebrow="Sell My Guitar"
 *     title="Sell Your Vintage Fender Guitar"
 *     subhead="Top dollar, fast payment, no hassle."
 *     bgImage="/images/hero-fender.jpg"
 *   >
 *     <Button slot="cta" href={hrefs.tel} variant="cream" size="lg">{contact.phone}</Button>
 *     <Button slot="cta" href="/contact-me/" variant="cream" size="lg">Contact Now</Button>
 *   </PageHero>
 *
 * Layout matches the homepage Hero's center-aligned style and padding so the
 * site feels coherent across pages. Pass `align="left"` for editorial-style
 * pages (e.g. blog posts) where the H1 should hang left.
 */
interface Props {
  /** Small uppercase rust label rendered above the H1. */
  eyebrow?: string;
  /** Main page heading. Rendered as an <h1>. */
  title: string;
  /** Optional subheading rendered below the H1 (also acts as a secondary <h2> for SEO). */
  subhead?: string;
  /** Treat subhead as an <h2> (default) or as a paragraph. */
  subheadTag?: "h2" | "p";
  /** Opt-in escape hatch for callers who need entity-encoded markup in the title (e.g. &rsquo;). */
  titleHtml?: boolean;
  /** Same opt-in for the subhead. */
  subheadHtml?: boolean;
  /** Background image URL (rendered as `background-image`). Optional. */
  bgImage?: string;
  /** Solid background color (CSS color or CSS variable). Defaults to dark rust. */
  bgColor?: string;
  /** Dim photos with a dark vignette so light text remains legible. Defaults to true when bgImage is set. */
  vignette?: boolean;
  /** Text color of the heading + subhead. Defaults to white (for dark backgrounds). */
  textColor?: string;
  /** Alignment of the heading content. */
  align?: "center" | "left";
  /** Vertical padding. "lg" matches the homepage hero; "md" is shorter for inner pages. */
  size?: "md" | "lg";
}

const {
  eyebrow,
  title,
  subhead,
  subheadTag = "h2",
  titleHtml = false,
  subheadHtml = false,
  bgImage,
  bgColor = "var(--color-brand-rust-dark)",
  vignette = !!bgImage,
  textColor = "#fff",
  align = "center",
  size = "md",
} = Astro.props;

const SubheadTag = subheadTag;
const hasCta = Astro.slots.has("cta");

// WebP upgrade for the CSS-background hero. Keyed by bgImage so a WebP (and
// mobile variant) is only swapped in for images we've verified have those
// siblings shipped in public/images. To upgrade a new hero image, ship a
// matching .webp (and optional -mobile.webp) next to it and add an entry here.
const HERO_VARIANTS: Record<string, { webp: string; mobile?: string }> = {
  "/images/hero-background.jpg": {
    webp: "/images/hero-background.webp",
    mobile: "/images/hero-background-mobile.webp",
  },
};
const heroVariant = bgImage ? HERO_VARIANTS[bgImage] : undefined;

// background-image is applied in the scoped <style> below via these custom
// properties so we can layer an image-set() WebP swap plus a mobile media
// query (an inline style attribute can't hold a media query). Browsers that
// don't support image-set() fall back to the plain url() declaration.
const bgVars = bgImage
  ? [
      `--hero-bg:url('${bgImage}')`,
      heroVariant?.webp
        ? `--hero-bg-set:image-set(url('${heroVariant.webp}') type('image/webp'), url('${bgImage}') type('image/jpeg'))`
        : "",
      heroVariant?.mobile ? `--hero-bg-mobile:url('${heroVariant.mobile}')` : "",
    ]
      .filter(Boolean)
      .join(";") + ";"
  : "";
---

<section
  class:list={["jvg-page-hero", `jvg-page-hero--${align}`, `jvg-page-hero--${size}`]}
  style={`background-color:${bgColor};${bgVars}color:${textColor};`}
>
  {vignette && <div class="jvg-page-hero__vignette" aria-hidden="true"></div>}

  <div class="jvg-page-hero__inner">
    <slot name="breadcrumbs" />

    {eyebrow && <span class="jvg-page-hero__eyebrow">{eyebrow}</span>}

    {titleHtml
      ? <h1 class="jvg-page-hero__title" set:html={title} />
      : <h1 class="jvg-page-hero__title">{title}</h1>}

    {subhead && (subheadHtml
      ? <SubheadTag class="jvg-page-hero__subhead" set:html={subhead} />
      : <SubheadTag class="jvg-page-hero__subhead">{subhead}</SubheadTag>
    )}

    {hasCta && (
      <div class="jvg-page-hero__cta">
        <slot name="cta" />
      </div>
    )}
  </div>
</section>

<style>
  .jvg-page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    /* Plain url() first as the universal fallback, then the image-set() WebP
       swap (the var falls back to the plain url() when no WebP variant exists,
       and to nothing for color-only heroes). */
    background-image: var(--hero-bg);
    background-image: var(--hero-bg-set, var(--hero-bg));
  }
  @media (max-width: 768px) {
    .jvg-page-hero {
      background-image: var(--hero-bg-mobile, var(--hero-bg-set, var(--hero-bg)));
    }
  }
  .jvg-page-hero--md { padding: clamp(140px, 14vw, 200px) 16px clamp(40px, 6vw, 70px); }
  .jvg-page-hero--lg { padding: clamp(160px, 18vw, 280px) 16px clamp(40px, 6vw, 80px); }

  .jvg-page-hero__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.3) 40%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.3) 40%);
    pointer-events: none;
  }

  .jvg-page-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    color: inherit;
  }
  .jvg-page-hero--center .jvg-page-hero__inner { text-align: center; }
  .jvg-page-hero--left .jvg-page-hero__inner { text-align: left; }

  .jvg-page-hero__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    /* Bright rust pops against both dark photo bgs and the default dark rust bgColor. */
    color: var(--color-brand-cream);
    margin-bottom: 14px;
  }
  .jvg-page-hero__title {
    /* Live site uses the system sans stack (not Oswald) for internal page H1s. */
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.2;
    margin: 0;
    text-wrap: balance;
    color: inherit;
  }
  .jvg-page-hero__subhead {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(19px, 2.4vw, 28px);
    line-height: 1.3;
    margin: 18px auto 0;
    color: var(--color-brand-brown-tan);
    max-width: 900px;
    text-wrap: balance;
  }
  .jvg-page-hero--left .jvg-page-hero__subhead { margin-left: 0; margin-right: 0; }

  .jvg-page-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 32px;
  }
  .jvg-page-hero--center .jvg-page-hero__cta { justify-content: center; }
  .jvg-page-hero--left .jvg-page-hero__cta { justify-content: flex-start; }
</style>
