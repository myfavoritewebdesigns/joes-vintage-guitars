---
interface Props { title: string; maker: string; year: string; week: string; makerMeaning: string; yearMeaning: string; weekMeaning: string; note?: string; }
const { title, maker, year, week, makerMeaning, yearMeaning, weekMeaning, note } = Astro.props;
const groups = [[maker, 'maker', makerMeaning], [year, 'year', yearMeaning], [week, 'week', weekMeaning]];
---
<figure class="pot-code-diagram">
  <h3>{title}</h3>
  <div class="pot-code-diagram__groups">
    {groups.map(([digits, kind, meaning]) => <div class={`pot-code-diagram__group pot-code-diagram__group--${kind}`}><div class="pot-code-diagram__digits">{digits}</div><p>{meaning}</p></div>)}
  </div>
  {note && <figcaption>{note}</figcaption>}
</figure>
<style>
  .pot-code-diagram { margin: 0; padding: clamp(1rem, 3vw, 1.75rem); background: #4a3427; border-radius: 1rem; color: white; }
  h3 { margin: 0 0 1.25rem; font-family: var(--font-display); font-size: 1.4rem; line-height: 1.3; color: white; }
  .pot-code-diagram__groups { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: .6rem; }
  .pot-code-diagram__group { min-width: 0; }
  .pot-code-diagram__digits { padding: .75rem .25rem; border-radius: .45rem; text-align: center; font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.75rem); letter-spacing: .06em; line-height: 1.4; }
  .pot-code-diagram__group--maker .pot-code-diagram__digits { background: var(--color-gold); color: #2a2013; }
  .pot-code-diagram__group--year .pot-code-diagram__digits { background: #a03a1e; }
  .pot-code-diagram__group--week .pot-code-diagram__digits { background: rgba(255,255,255,.13); }
  p { margin: .7rem 0 0; font-size: .875rem; line-height: 1.45; color: var(--color-gold-light); }
  figcaption { margin-top: 1.25rem; border-top: 1px solid #ffffff30; padding-top: 1rem; font-size: 1rem; }
</style>
