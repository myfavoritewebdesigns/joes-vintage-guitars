---
/**
 * Reusable FAQ section component — wood-textured cream box with arrow
 * clip-path, rust-orange offset backdrop, circular toggle icons.
 *
 * Props (all optional — defaults match the homepage's original copy):
 *   faqs        — array of { q, a, id? }. Each `id` (if provided) lands on the
 *                 <details> element AND the heading inside it so external
 *                 anchor links (e.g. /sell-my-fender-guitar/#toggle_xyz) work.
 *   mainTitle   — H3 main text (default "FAQs About")
 *   subTitle    — H3 sub-text inside .sub-t span (default "Our Guitar Buying Services")
 *   sectionId   — id attribute on the <section> (default "faq")
 *   openFirst   — open the first item by default (default false; matches homepage)
 */
export interface FAQItem {
  q: string;
  a: string;
  id?: string;
}
interface Props {
  faqs?: FAQItem[];
  mainTitle?: string;
  subTitle?: string;
  sectionId?: string;
  openFirst?: boolean;
}

const DEFAULT_FAQS: FAQItem[] = [
  {
    q: "What Are The Considerations You Have To Determine A Guitar's Price &amp; Value?",
    a: "When appraising a guitar, there are several things that you need to take into consideration in order to determine its value. This includes the make and model of the guitar, its age, condition, and any unique features or history that it might have. This can be rather tricky, so don't hesitate to contact me for a FREE appraisal! I offer appraisals across the U.S. and Canada.",
  },
  {
    q: "Can I Sell My Guitar On Consignment Or Trade It For Another One?",
    a: "I'm always happy to listen to your trade offers. We do offer consignment!",
  },
  {
    q: "How Do I Receive The Money For My Vintage Guitar?",
    a: "I can often travel to you and pay cash in person for your guitar. I am always out and about buying guitars all over the U.S. If coming to you is not possible, I can pay via money order, Venmo, PayPal, Cashapp, Zelle, bank transfer, etc.",
  },
  {
    q: "Will I Have To Pay For Shipping To Sell A Guitar?",
    a: "If meeting to sell your guitar is not possible, I can arrange a professional, prepaid packing and shipping service.",
  },
  {
    q: "How Do You Estimate The Value Of A Guitar?",
    a: "Estimating the value of a vintage guitar involves a meticulous assessment of multiple factors. First, I examine the brand, model, and production year, as these characteristics significantly influence worth. Condition is paramount, assessing wear, modifications, and originality, as pristine, all-original guitars tend to fetch higher prices. Historical significance, provenance, and documented authenticity can also elevate value. Market demand and recent comparable sales provide essential context, while consulting experienced appraisers and fellow collectors is crucial for a precise valuation that considers the unique attributes of each vintage guitar.",
  },
  {
    q: "How Can I Tell When A Guitar Was Made?",
    a: "As a vintage guitar collector, determining the age of a guitar is an exciting part of the hobby. There are several key techniques I rely on to establish a guitar's age. Firstly, I scrutinize the serial number, a critical piece of information. For many vintage guitars, manufacturers have a serial number system that can be traced back to production dates. It's essential to consult reliable resources and reference books specific to the brand or model to decode these serial numbers accurately. Secondly, I thoroughly examine the guitar's features and hardware. Changes in design, materials, and logo styles over the years can provide valuable clues about its production era. Thirdly, I inspect the label inside the guitar, which often includes the date of manufacture. However, labels can sometimes be missing or misleading, so additional research is usually necessary. Finally, I rely on the collective knowledge of the vintage guitar community. Online forums, collector groups, and expert opinions can provide invaluable insights and help corroborate the guitar's age.",
  },
  {
    q: "Do You Sell Instruments Via Reverb?",
    a: "Yes, as a guitar dealer, I sell instruments on Reverb. If you're interested in purchasing a guitar or have any questions about our inventory, please feel free to ask, and I'll be happy to assist you.",
  },
  {
    q: "What Other Brands Of Guitars Does Joe's Vintage Guitars Buy?",
    a: "I'm always on the lookout for a wide range of guitar brands to add to my collection. While I have a particular interest in renowned names like Fender, Gibson, Martin, and Rickenbacker, I'm also keen on discovering unique and rare pieces from various makers. I buy and sell across the U.S. and Canada, so if you have a guitar you're considering selling, feel free to reach out to me directly at 602-900-6635. I'd love to hear about what you have and discuss whether it could be a great addition to my collection.",
  },
];

const {
  faqs = DEFAULT_FAQS,
  mainTitle = "FAQs About",
  subTitle = "Our Guitar Buying Services",
  sectionId = "faq",
  openFirst = false,
} = Astro.props;
---

<section id={sectionId} class="faqr-sct">
  <div class="faqr-sct__inner">
    <div class="faqr-col">
      <div class="faqr-col__inner">
        <h3 class="faqr-sct__h3">
          {mainTitle} <span class="sub-t">{subTitle}</span>
        </h3>

        <div class="faqr-accordion">
          {faqs.map((item, i) => (
            <details class="faqr-toggle" id={item.id} open={openFirst && i === 0}>
              <summary>
                <span class="faqr-toggle__icon" aria-hidden="true">
                  <span class="faqr-toggle__plus"></span>
                  <span class="faqr-toggle__minus"></span>
                </span>
                <span class="fusion-toggle-heading" set:html={item.q}></span>
              </summary>
              <div class="faqr-toggle__body" set:html={item.a}></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* faqr v2 — full rebuild matching live design */
  /* Outer section — dark brown gradient + faq-bg.jpg overlay */
  .faqr-sct {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 100px 5%;
    background-color: #23140a;
    background-image:
      linear-gradient(180deg, rgba(35, 20, 10, 0.78) 0%, rgba(90, 62, 39, 0.78) 100%),
      url("/images/faq-bg.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .faqr-sct__inner {
    max-width: 1144px;
    margin: 0 auto;
    position: relative;
  }

  /* Inner column — wood texture bg, cream backdrop, downward-arrow clip-path
     + rust-orange offset backdrop showing through the top via ::before */
  .faqr-col {
    position: relative;
    padding: 0 5%;
  }
  /* Offset rust backdrop behind the cream box, exposed at the top edge */
  .faqr-col::before {
    content: "";
    position: absolute;
    width: 96%;
    height: 106%;
    top: -3%;
    left: 2%;
    background-color: var(--color-brand-rust-bright);
    clip-path: polygon(100% 0, 100% 98%, 50% 100%, 0 98%, 0 0);
    z-index: 0;
  }
  /* The cream/wood-textured box itself */
  .faqr-col__inner {
    position: relative;
    z-index: 1;
    padding: 5% 5% 8%;
    background-color: var(--color-brand-cream);
    background-image: url("/images/faq-wooder-bg.jpg");
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    clip-path: polygon(100% 0, 100% 98%, 50% 100%, 0 98%, 0 0);
  }

  /* Heading */
  .faqr-sct__h3 {
    position: relative;
    margin: 0 auto 40px;
    padding-bottom: 22px;
    font-family: "Oswald", sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 3vw, 40px);
    color: var(--color-brand-rust-dark);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
    line-height: 1.15;
    width: fit-content;
    max-width: 100%;
  }
  /* 4px rust underline */
  .faqr-sct__h3::after {
    content: "";
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 0;
    border-top: 4px solid var(--color-brand-rust-dark);
  }
  .sub-t {
    display: inline-block;
    margin-left: 10px;
    padding-left: 14px;
    border-left: 2px solid var(--color-brand-rust-bright);
    font-family: "Open Sans", sans-serif;
    font-weight: 600;
    font-size: 0.55em;
    color: #333;
    text-transform: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: middle;
  }

  /* Accordion */
  .faqr-accordion {
    max-width: 920px;
    margin: 0 auto;
  }
  .faqr-toggle {
    border-bottom: 1px solid rgba(104, 36, 18, 0.18);
  }
  .faqr-toggle:first-child {
    border-top: 1px solid rgba(104, 36, 18, 0.18);
  }
  .faqr-toggle summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    transition: background 0.15s;
  }
  .faqr-toggle summary::-webkit-details-marker { display: none; }
  .faqr-toggle summary::marker { content: ""; }
  .faqr-toggle summary:hover { background: rgba(255, 255, 255, 0.25); }
  .faqr-toggle__icon {
    position: relative;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-brand-rust-bright);
    box-shadow: 0 2px 6px rgba(104, 36, 18, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .faqr-toggle__plus,
  .faqr-toggle__minus {
    position: absolute;
    top: 50%;
    left: 50%;
    background: #fff;
    transition: opacity 0.2s, transform 0.2s;
  }
  .faqr-toggle__plus {
    width: 12px;
    height: 2px;
    transform: translate(-50%, -50%);
  }
  .faqr-toggle__plus::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 12px;
    background: #fff;
    transform: translate(-50%, -50%);
  }
  .faqr-toggle__minus {
    width: 12px;
    height: 2px;
    transform: translate(-50%, -50%);
    opacity: 0;
  }
  .faqr-toggle[open] .faqr-toggle__plus { opacity: 0; }
  .faqr-toggle[open] .faqr-toggle__minus { opacity: 1; }

  .fusion-toggle-heading {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 700;
    font-size: clamp(15px, 2vw, 18px);
    color: var(--color-brand-rust-dark);
    line-height: 1.4;
  }

  .faqr-toggle__body {
    padding: 4px 4px 24px 46px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-brand-charcoal);
  }

  @media (max-width: 700px) {
    .faqr-sct { padding: 60px 1% 70px; }
    .faqr-col { padding: 0 1%; }
    .faqr-col__inner { padding: 8% 6% 14%; }
    .faqr-col::before { height: 106%; top: -3%; }
    .sub-t {
      display: block;
      margin: 8px 0 0;
      padding-left: 0;
      border-left: none;
      font-size: 0.5em;
    }
    .faqr-toggle__body { padding-left: 42px; }
  }
</style>
