---
import { hrefs, phoneIconPath, mailIconPath, smsIconPath } from "../config/site";
---

<aside class="floating-ctas fixed bottom-6 right-4 z-40 flex flex-col gap-3" aria-label="Quick contact">
  <a
    href={hrefs.sms}
    aria-label="Text us"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-rust-bright text-white shadow-lg transition hover:bg-brand-rust-dark"
  >
    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true"><path d={smsIconPath} /></svg>
    <span class="floating-ctas__label">Text</span>
  </a>
  <a
    href={hrefs.tel}
    aria-label="Call us"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-rust-bright text-white shadow-lg transition hover:bg-brand-rust-dark"
  >
    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true"><path d={phoneIconPath} /></svg>
    <span class="floating-ctas__label">Call</span>
  </a>
  <a
    href={hrefs.mailto}
    aria-label="Email us"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-rust-bright text-white shadow-lg transition hover:bg-brand-rust-dark"
  >
    <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true"><path d={mailIconPath} /></svg>
    <span class="floating-ctas__label">Email</span>
  </a>
</aside>

<style>
  .floating-ctas__label { display: none; }

  @media (max-width: 600px) {
    /* Keep display specificity below the existing per-page hiding selectors. */
    :where(.floating-ctas) {
      inset: auto 0 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--color-brand-rust-dark, #682412);
    }
    .floating-ctas > a {
      width: 100%;
      height: 48px;
      min-height: 48px;
      gap: 8px;
      border-radius: 0;
      background: transparent;
      color: #fff;
      box-shadow: none;
    }
    .floating-ctas > a + a { border-left: 1px solid #ffffff66; }
    .floating-ctas__label { display: inline; }
    :global(body[data-jvg-quick-contact-visible]:has(aside[aria-label="Quick contact"]:not([hidden]))) {
      padding-bottom: var(--jvg-quick-contact-space);
    }
    :global(html:has(body[data-jvg-quick-contact-visible])) {
      scroll-padding-bottom: var(--jvg-quick-contact-space);
    }
  }
</style>

<script>
  const aside = document.querySelector<HTMLElement>('.floating-ctas');
  if (aside) {
    const mobile = window.matchMedia('(max-width: 600px)');
    const updateSpace = () => {
      // Measuring the rendered box also detects display:none from page/focus rules.
      const height = mobile.matches && !aside.hidden ? aside.getBoundingClientRect().height : 0;
      document.documentElement.style.setProperty('--jvg-quick-contact-space', `${height}px`);
      document.body.toggleAttribute('data-jvg-quick-contact-visible', height > 0);
    };
    new ResizeObserver(updateSpace).observe(aside);
    mobile.addEventListener('change', updateSpace);
    updateSpace();
  }
</script>
