---
import { Image } from "astro:assets";
import hero from "../assets/blog/martin-0-00-000-history-authentication-value-guide/martin-00-18-1920s.jpg";
import martin18 from "../assets/blog/martin-0-00-000-history-authentication-value-guide/martin-000-18-1960.jpg";
import martin21 from "../assets/blog/martin-0-00-000-history-authentication-value-guide/martin-000-21-1956.jpg";
import martin28 from "../assets/blog/martin-0-00-000-history-authentication-value-guide/martin-000-28.jpg";

const models = [
  ["Style 15", "0-15 · 00-15 · 000-15", "All-mahogany, austere trim, rosewood board and bridge; prized for dry, direct fundamentals."],
  ["Style 17", "0-17 · 00-17 · 000-17", "The all-mahogany economy family. Black or dark finishes appear in important periods."],
  ["Style 18", "0-18 · 00-18 · 000-18", "Spruce over mahogany with restrained trim: the benchmark small-body Martin workhorse."],
  ["Style 18K", "0-18K · 00-18K · 000-18K", "Koa construction. Early K models may have been built for Hawaiian playing."],
  ["Style 21", "0-21 · 00-21 · 000-21 · 00-21NY", "Rosewood with quieter trim than Style 28. The 12-fret 00-21 is a connoisseur favorite."],
  ["Style 28", "0-28 · 00-28 · 000-28", "Spruce over rosewood. Classic pre-1947 examples carry herringbone top trim."],
  ["Gut and Classical 28", "00-28G · 00-28C · 000-28C", "Gut-string and classical families with different necks, bridges, bracing, and intended tension."],
  ["Styles 30 and 34", "0-30 · 0-34 · scarce early pairings", "Elaborate 19th-century marquetry and pearl vocabulary; exact period details determine identity."],
  ["Styles 40 and 40H", "00-40H · rare early Style 40", "Pearl-trim lineage. The 00-40H was built for Hawaiian play and conversions require scrutiny."],
  ["Styles 42 and 45", "0-42 · 00-42 · 000-42 · 0-45 · 00-45 · 000-45", "Pearl flagships. Style 45 extends decoration to the back and sides; prewar 000-45s sit at the summit."],
];

const eras = [
  ["Before 1898", "Pre-Serial", "Labels, address stamps, outline, bracing, neck joint, bridge, and marquetry must agree. Many instruments predate formal model names."],
  ["1898 to 1915", "Serial Era, Gut-String Design", "Serial numbers begin, but most guitars remain intended for gut. Delicate tops and small bridge plates demand conservative setup."],
  ["1916 to 1929", "Hawaiian Steel to Spanish Steel", "Steel appears through Hawaiian orders, then Spanish steel regulation spreads by style: 17 around 1922, 18 around 1923, and 28 around 1926."],
  ["1929 to 1934", "The OM Revolution", "The OM establishes long scale, 14 frets, and modern neck access. Bar frets and ebony neck reinforcement mark much of the era."],
  ["1934 to 1938", "The Peak Prewar Recipe", "T-frets and steel T-bars arrive. Forward-positioned scalloped X-bracing, red spruce, hide glue, and light construction drive demand."],
  ["1939 to 1944", "Rear-Shifted, Still Scalloped", "The X moves rearward, but braces remain scalloped. Wartime material substitutions create distinctive neck and tuner combinations."],
  ["Late 1944 to 1946", "Tapered Braces and Spruce Transition", "Scalloping ends, tapered braces appear, and red spruce gives way to Sitka during 1946. Transitional examples vary."],
  ["1947 to 1964", "Postwar Classics", "Sitka becomes standard and builds gradually grow more robust. Excellent instruments generally trade below comparable prewar examples."],
  ["1965 to 1969", "Factory and Rosewood Transition", "The short saddle arrives, maple replaces the small rosewood bridge plate in 1968, and standard Brazilian rosewood ends in 1969."],
  ["1970s and Later", "Heavier Builds and Revivals", "Larger bridge plates appear. Later Vintage, Authentic, New Yorker, Custom Shop, and limited models must be judged by actual specifications."],
];

const checks = [
  ["Stamp and Serial", "Read the complete model and serial stamp. Earlier instruments may use a serial stamp, backstrip stamp, headstock stamp, or label."],
  ["Outline and Neck Joint", "Measure lower bout, body length, depth, scale, and nut. Confirm 12-fret or 14-fret geometry, headstock, and heel."],
  ["Woods", "Inspect top, back, sides, neck, fingerboard, and bridge. Never identify Brazilian rosewood or red spruce from one photograph."],
  ["Bracing and Bridge Plate", "Use a mirror, light, or internal camera. Verify X position, carving, tone bars, plate wood, plate size, glue, and patches."],
  ["Finish Under Light", "Black-light response, pore fill, checking, color beneath hardware, and protected edges can expose refinish, overspray, or touch-up."],
  ["Bridge and Pickguard", "Check footprint, thickness, belly orientation, pin spacing, saddle slot, shrinkage, curling, and surrounding finish."],
  ["Neck and Frets", "Bar versus T-frets, ebony rod versus steel T-bar, neck carve, nut, and evidence of a reset should agree with the year."],
  ["Tuners and Hardware", "Match plates, gears, posts, bushings, buttons, screw spacing, pins, nut, saddle, and endpin to the period."],
  ["Repairs", "Map cracks, cleats, patches, replaced braces, top distortion, neck work, finish work, and altered wood."],
  ["Provenance", "Receipts, photographs, the case, family history, and factory records should support the physical evidence, not override it."],
];
---

<article class="martin-guide">
  <section class="mg-hero" id="top">
    <div class="mg-wrap mg-hero__copy">
      <p class="mg-eyebrow">The Collector's Field Guide · 1850s to Today</p>
      <h1>Martin 0, 00 &amp; 000</h1>
      <p class="mg-dek">Three small-bodied Martins. More than a century of changes. Here is how I read the woods, trim, neck joint, bracing, tuners, and repairs, and what those details mean when it is time to buy, sell, or appraise one.</p>
      <div class="mg-actions"><a href="#models">Read the Guide</a><a href="/free-appraisal/">Appraise My Martin</a></div>
    </div>
    <div class="mg-wrap mg-hero__grid">
      <figure><Image src={hero} alt="Vintage 1920s Martin 00-18 from the Joe's Vintage Guitars archive" width={1000} priority /><figcaption>1920s Martin 00-18 · Joe's Archive</figcaption></figure>
      <aside class="mg-quick"><b>Start Here</b><p><strong>0</strong> Concert · intimate and focused</p><p><strong>00</strong> Grand Concert · balanced and responsive</p><p><strong>000</strong> Auditorium · broadest voice and headroom</p><small>Body size comes before the hyphen. Style and trim come after it.</small></aside>
    </div>
  </section>

  <section class="mg-intro mg-wrap">
    <p class="mg-drop">Every guitar has a story, but the model stamp only tells you the first sentence. A 1929 12-fret 000-28, a 1935 14-fret 000-28, and a 1965 000-28 share a basic name, but not their architecture, materials, response, or market. I start with the stamp and serial number, then read the guitar itself.</p>
    <aside><b>A Note From Joe</b><br />Martin built one-offs, employee instruments, prototypes, and special orders. An undocumented custom must be authenticated by its features and factory records, not forced into a catalog box.</aside>
  </section>

  <section class="mg-section mg-wrap" id="models">
    <header class="mg-section-head"><span>01</span><div><p>Decode the Stamp</p><h2>The Model Families</h2></div></header>
    <p class="mg-lead">The number before the hyphen identifies body size. The number after it identifies style, traditionally controlling woods and ornament. The style number began as a price, but became Martin's durable specification language. Not every size and style was offered every year.</p>
    <div class="mg-models">{models.map(([style, names, detail]) => <div class="mg-model"><h3>{style}</h3><code>{names}</code><p>{detail}</p></div>)}</div>
    <aside class="mg-note"><h3>Suffixes Change the Story</h3><p><b>K</b> koa · <b>H</b> Hawaiian · <b>G</b> gut-string · <b>C</b> classical · <b>NY</b> New Yorker · <b>S</b> special or custom, and sometimes later 12-fret usage · <b>E</b> factory electronics. Treat the complete stamp as the model.</p></aside>
  </section>

  <section class="mg-photo-band">
    <figure><Image src={martin21} alt="1956 Martin 000-21 from the Joe's Vintage Guitars archive" width={800} /><figcaption>1956 000-21 · Rosewood, Modest Trim</figcaption></figure>
    <blockquote>Size predicts feel and air volume. Style predicts wood and ornament. <em>Year predicts structure.</em></blockquote>
    <figure><Image src={martin18} alt="1960 Martin 000-18 from the Joe's Vintage Guitars archive" width={800} /><figcaption>1960 000-18 · Spruce and Mahogany</figcaption></figure>
  </section>

  <section class="mg-section mg-wrap mg-split" id="geometry">
    <div><header class="mg-section-head"><span>02</span><div><p>Geometry Matters</p><h2>0 vs. 00 vs. 000</h2></div></header>
      <div class="mg-sizes"><div><b>0 · Concert</b><strong>About 13 1/2 in.</strong><p>Fast, focused attack and surprising depth for its width.</p></div><div><b>00 · Grand Concert</b><strong>About 14 1/8 in.</strong><p>The balanced middle ground, especially loved in 12-fret form.</p></div><div><b>000 · Auditorium</b><strong>About 15 in.</strong><p>More top area, bass reach, and headroom. The 14-fret outline is shared with the OM.</p></div></div>
    </div>
    <aside class="mg-note mg-fret-note"><h3>12 Frets or 14?</h3><p>A 12-fret neck joins at the 12th fret. The body is usually longer, the shoulders slope, and the headstock is often slotted. Its bridge sits nearer the top's acoustical center, often favoring bloom and warmth.</p><p>A 14-fret neck changes the body and bridge geometry, usually adds a solid headstock, and offers modern upper-fret access with quicker articulation.</p><p><b>OM Versus 000:</b> both use the 000 outline. The classic OM is long scale at about 25.4 inches; most later standard 000s use a shorter scale near 24.9 inches. Measure before labeling.</p></aside>
  </section>

  <section class="mg-section mg-dark" id="timeline"><div class="mg-wrap">
    <header class="mg-section-head"><span>03</span><div><p>Construction Chronology</p><h2>The Years That Change Everything</h2></div></header>
    <div class="mg-timeline">{eras.map(([date, title, detail]) => <div class="mg-era"><time>{date}</time><div><h3>{title}</h3><p>{detail}</p></div></div>)}</div>
    <p class="mg-era-note">The X-brace position did not change on every size at once. The 0 and 00 shift around 1935 to 1936; the important 000 change comes around mid-1938. Production transitions can overlap, so the individual guitar wins every argument.</p>
  </div></section>

  <section class="mg-section mg-wrap" id="woods">
    <header class="mg-section-head"><span>04</span><div><p>Voice, Scarcity, Identity</p><h2>Woods, Trim &amp; Hardware</h2></div></header>
    <div class="mg-columns"><div><h3>Top Woods</h3><p><b>Red spruce</b>, commonly called Adirondack in the vintage market, is associated with the most desirable pre-1946 steel-string Martins. <b>Sitka spruce</b> becomes normal during 1946. A distinctive group of 1953 tops is often described as Engelmann or government-surplus spruce. Color alone is not identification.</p><h3>Back and Sides</h3><p><b>Mahogany</b> defines Styles 15, 17, and 18. <b>Brazilian rosewood</b> defines classic Styles 21, 28, 42, and 45 through 1969 standard production. <b>East Indian rosewood</b> follows. <b>Koa</b> appears in K models and special runs. Early production can also include maple, Gonçalo Alves, and veneers.</p></div><div><h3>Trim as Evidence</h3><p>Count purfling lines and inspect rosette, binding, backstrip, end graft, fingerboard inlay, headstock treatment, and pearl boundaries as one system. Pre-1947 Style 28 herringbone is important, but herringbone alone proves nothing.</p><h3>Bridges and Bridge Plates</h3><p>Early guitars can carry pyramid bridges. Belly bridges become normal in the 1930s. Long through-saddles precede the mid-1960s short drop-in saddle. Small original rosewood bridge plates differ dramatically from oversized repairs; Martin changes to maple in 1968 and later plates grow larger.</p></div></div>
  </section>

  <section class="mg-section mg-wrap" id="authenticate">
    <header class="mg-section-head"><span>05</span><div><p>Inspect in Sequence</p><h2>Authentication Field Checklist</h2></div></header>
    <div class="mg-checks">{checks.map(([title, detail], index) => <div><i>{index + 1}</i><h3>{title}</h3><p>{detail}</p></div>)}</div>
    <aside class="mg-warning"><b>Never string by model name alone.</b> A 1920s Martin may be gut-braced, built for Hawaiian steel, or converted later. Have the top, bracing, bridge plate, bridge, and neck angle evaluated before choosing tension.</aside>
  </section>

  <section class="mg-section mg-dark" id="tuners"><div class="mg-wrap">
    <header class="mg-section-head"><span>06</span><div><p>Small Parts, Large Clues</p><h2>Tuners and Dating Details</h2></div></header>
    <div class="mg-columns"><div><h3>Read the Footprint</h3><p>Look for extra screw holes, altered post holes, finish shadows, mismatched bushings, and plate outlines. Early instruments may have engraved plates with ivory or pearl buttons. Later guitars can carry Waverly or Grover open gears, wartime Kluson variants, and postwar enclosed machines.</p></div><div><h3>Match the Whole Assembly</h3><p>Button material, plate shape, gear orientation, screw spacing, plating, and stamped markings all matter. Clean tuners are not automatically original, and tarnished tuners are not automatically old. A correct-looking replacement remains a replacement.</p></div></div>
  </div></section>

  <section class="mg-section mg-wrap" id="value">
    <header class="mg-section-head"><span>07</span><div><p>Market Logic, Not Wishful Pricing</p><h2>Desirability and Value</h2></div></header>
    <p class="mg-lead">Collector demand generally centers on original prewar steel-string examples. The late 1920s through 1938 combine light construction, red spruce, hide glue, scalloped bracing, and modern geometry. The years 1939 through 1944 remain exceptionally desirable. Late 1944 through 1946 is a feature-sensitive transition.</p>
    <div class="mg-values"><div><h3>Era Premium</h3><p>Prewar pearl Styles 42 and 45 lead, followed by prewar herringbone Style 28. Wartime examples and pre-1969 Brazilian rosewood remain strong. Clean postwar mahogany guitars can be more accessible.</p></div><div><h3>Originality</h3><p>Original finish, bridge, bridge plate, tuners, pickguard, and unaltered wood are decisive. A professional neck reset or refret can preserve value; a refinish, retop, shaved bridge, or oversized plate usually cannot.</p></div><div><h3>Condition and Sound</h3><p>Cracks, distortion, neck angle, brace work, repair quality, setup, and musical response all matter. A clean year does not outrank an earlier guitar with honest professional maintenance by default.</p></div><div><h3>Responsible Pricing</h3><p>Start with recent sold examples of the same size, style, year band, and condition. Asking prices show expectations, not market value. Adjust for rarity, originality, structure, sound, provenance, and timing.</p></div></div>
    <div class="mg-formula"><span>Comparable Sales</span><b>×</b><span>Era and Rarity</span><b>×</b><span>Originality</span><b>×</b><span>Condition and Sound</span><b>=</b><strong>Defensible Range</strong></div>
  </section>

  <section class="mg-closing mg-wrap"><div><p class="mg-eyebrow">The Collector's Rule</p><h2>Buy the Guitar in Front of You, Not the Legend Attached to It.</h2><p>The best small Martins combine honest structure, period-correct details, and a voice worth preserving. A serial number gives me a starting year. The wood, bracing, bridge plate, finish, hardware, and tool marks tell me the rest.</p><div class="mg-actions"><a href="/free-appraisal/">Ask Joe About Your Martin</a><a href="/sell-my-martin-guitar/">Sell My Martin</a></div></div><figure><Image src={martin28} alt="Vintage Martin 000-28 from the Joe's Vintage Guitars archive" width={800} /><figcaption>Archive Example · Martin 000-28</figcaption></figure></section>

  <section class="mg-sources"><div class="mg-wrap"><h2>Reference Desk</h2><p>Core historical reference: <a href="https://www.vintagemartin.com/" rel="noopener" target="_blank">VintageMartin.com</a>. Cross-check serials and current nomenclature with C. F. Martin &amp; Co. This is a research guide, not a certificate of authenticity or appraisal; measurements and changeovers can overlap by batch.</p></div></section>
</article>

<style>
