gin-bottom:20px}.mg-quick p{border-top:1px solid #ffffff4d;padding:17px 0;margin:0}.mg-quick strong{display:block;font-size:40px;line-height:1}.mg-quick small{margin-top:20px;line-height:1.55}.mg-intro,.mg-section{padding-block:76px}.mg-intro{display:grid;grid-template-columns:1.55fr .75fr;gap:68px}.mg-drop{font-size:21px;line-height:1.65;margin:0}.mg-drop:first-letter{float:left;font-size:82px;line-height:.72;padding:12px 10px 0 0;color:var(--rust);font-weight:900}.mg-intro aside{border-left:4px solid var(--gold);padding-left:24px;font-size:14px;line-height:1.75}.mg-section-head{display:flex;gap:18px;align-items:flex-start;margin-bottom:30px}.mg-section-head>span{border:1px solid currentColor;border-radius:50%;width:34px;height:34px;display:grid;place-items:center;font-size:10px;flex:none}.mg-section-head h2{font-family:var(--font-display,Oswald),sans-serif;font-size:clamp(40px,5.7vw,69px);line-height:.98;letter-spacing:-.035em;margin:7px 0 0}.mg-lead{font-size:19px;line-height:1.65;max-width:880px}.mg-models{border-top:1px solid var(--line);margin-top:42px}.mg-model{display:grid;grid-template-columns:170px 310px 1fr;gap:25px;padding:24px 0;border-bottom:1px solid var(--line)}.mg-model h3{font-size:21px;margin:0}.mg-model code{font-size:12px;line-height:1.7;color:var(--rust);font-weight:700}.mg-model p{font-size:14px;line-height:1.6;margin:0}.mg-note{margin-top:34px;background:#e2d6bf;padding:30px;border-top:3px solid var(--gold)}.mg-note h3{font-family:var(--font-display,Oswald),sans-serif;font-size:28px;margin:0 0 12px}.mg-note p{line-height:1.7}.mg-photo-band{display:grid;grid-template-columns:1fr .72fr 1fr;min-height:500px;background:var(--dark)}.mg-photo-band figure :global(img){width:100%;height:100%;object-fit:cover;filter:grayscale(.7) contrast(1.08)}.mg-photo-band blockquote{margin:0;padding:48px;color:#f5efdf;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:29px;line-height:1.35;font-weight:750}.mg-photo-band em{color:var(--gold)}.mg-split{display:grid;grid-template-columns:1.2fr .8fr;gap:70px}.mg-sizes>div{display:grid;grid-template-columns:1fr 145px 1.5fr;gap:18px;padding:25px 0;border-top:1px solid var(--line)}.mg-sizes strong{color:var(--rust)}.mg-sizes p{font-size:14px;line-height:1.55;margin:0}.mg-fret-note{height:max-content;margin-top:75px}.mg-dark{width:100%;background:var(--dark);color:#f4efe3}.mg-dark .mg-section-head,.mg-dark .mg-section-head p{color:var(--gold)}.mg-timeline{border-top:1px solid #55514a}.mg-era{display:grid;grid-template-columns:180px 1fr;gap:35px;border-bottom:1px solid #55514a;padding:24px 0}.mg-era time{color:var(--gold);font-weight:800}.mg-era h3{font-size:23px;margin:0 0 8px}.mg-era p,.mg-dark p{color:#cec7ba;line-height:1.65;margin:0}.mg-era-note{margin-top:30px!important;border-left:3px solid var(--gold);padding-left:20px}.mg-columns,.mg-values{display:grid;grid-template-columns:1fr 1fr;gap:35px 70px}.mg-columns h3,.mg-values h3{font-family:var(--font-display,Oswald),sans-serif;font-size:27px;margin:28px 0 10px}.mg-columns p,.mg-values p{line-height:1.75}.mg-checks{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.mg-checks>div{padding:28px 34px 28px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:38px 1fr;column-gap:12px}.mg-checks i{grid-row:1/3;color:var(--rust);font-size:21px;font-weight:800}.mg-checks h3{margin:0 0 8px;font-size:20px}.mg-checks p{grid-column:2;font-size:14px;line-height:1.6;margin:0}.mg-warning{margin-top:34px;border:2px solid var(--rust);padding:22px 26px;color:#692a1c;line-height:1.6}.mg-values>div{border-top:2px solid var(--gold)}.mg-formula{display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-top:48px;padding:25px;border:1px solid var(--line)}.mg-formula span{background:#e2d6bf;padding:10px 13px}.mg-formula b{color:var(--rust)}.mg-closing{padding-block:80px;display:grid;grid-template-columns:1.2fr .8fr;gap:70px;align-items:center}.mg-closing h2{font-family:var(--font-display,Oswald),sans-serif;font-size:clamp(42px,5.6vw,72px);line-height:1;letter-spacing:-.035em;margin:15px 0 24px}.mg-closing p{font-size:18px;line-height:1.7}.mg-closing figure :global(img){width:100%;height:520px;object-fit:cover;filter:saturate(.78)}.mg-sources{background:#dfd2b8;padding:55px 0}.mg-sources h2{font-family:var(--font-display,Oswald),sans-serif;font-size:35px;margin:0 0 12px}.mg-sources p{line-height:1.8;margin:0}.mg-sources a{color:#872e19;font-weight:700}
