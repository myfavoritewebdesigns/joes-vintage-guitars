---
import LicensedImage from "./primitives/LicensedImage.astro";
import heroPhoto from "../assets/blog/gibson-es-225-guide/1956-gibson-es-225-1.jpg";
import joePortrait from "../assets/images/fender-sn/about-me-joe-1.jpg";

const toc = [
  ["#quick-identification", "Quick Identification"],
  ["#model-decoder", "Model Variations"],
  ["#year-by-year", "Year by Year"],
  ["#shipping-totals", "Shipping Totals"],
  ["#specifications", "Specifications"],
  ["#natural-finish", "Natural Finish"],
  ["#1959-transition", "1959 Transition"],
  ["#authentication", "Authentication"],
  ["#red-flags", "Red Flags"],
  ["#comparison", "Similar Gibsons"],
  ["#photo-archive", "Photo Archive"],
  ["#sound-and-ownership", "Sound and Ownership"],
  ["#modern-reissue", "Modern Reissue"],
  ["#faq", "FAQ"],
  ["#appraisal-photos", "Appraisal Photos"],
];
---

<article class="es225-guide">
  <header class="es225-hero">
    <figure aria-hidden="true">
      <LicensedImage src={heroPhoto} alt="1956 Gibson ES-225TD sunburst photographed at Joe's Vintage Guitars" width={1800} loading="eager" fetchpriority="high" />
    </figure>
    <div class="es225-hero-shade" aria-hidden="true"></div>
    <div class="es225-hero-copy">
      <nav aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><a href="/category/specific-model-highlights/">Specific Model Highlights</a>
      </nav>
      <p class="es225-eyebrow">Joe's Field Guide <span>·</span> Original Run 1955 to 1959</p>
      <h1>The Complete Gibson ES-225 Model Guide</h1>
      <p class="es225-dek">Models, factory transitions, original specifications, and the physical clues that separate an honest ES-225 from a parts guitar, conversion, or refinish.</p>
      <div class="es225-actions">
        <a href="#quick-identification">Start Identifying Your Guitar</a>
        <a href="/free-appraisal/">Appraise My ES-225</a>
      </div>
    </div>
  </header>

  <div class="es225-paper">
    <div class="es225-layout">
      <aside class="es225-rail" aria-label="Article navigation">
        <nav>
          <p>On This Page</p>
          <ol>
            {toc.map(([href, label], index) => (
              <li><a href={href}><span>{String(index + 1).padStart(2, "0")}</span>{label}</a></li>
            ))}
          </ol>
          <a class="es225-rail-cta" href="/free-appraisal/">Free Appraisal</a>
        </nav>
      </aside>

      <main class="article-body blog-prose">
        <slot />
      </main>
    </div>
  </div>

  <aside class="es225-author" aria-label="About the author">
    <LicensedImage src={joePortrait} alt="Joe Dampt of Joe's Vintage Guitars" width={180} loading="lazy" />
    <div>
      <p class="es225-author-label">Written By</p>
      <h2>Joe Dampt</h2>
      <p>Joe is a vintage-guitar dealer and lifelong collector who specializes in documenting, authenticating, and buying original American guitars. This guide is built from factory records, period literature, and guitars inspected by Joe's Vintage Guitars.</p>
      <a href="/about-me/">About Joe</a>
    </div>
  </aside>
</article>

<style>
  .es225-guide {
    --rust: #682412;
    --rust-bright: #963b23;
    --brown: #3e2a14;
    --gold: #c9ab81;
    --paper: #f4efe6;
    --line: #d9cdbd;
    --ink: #2a2d33;
    color: var(--ink);
    background: #fff;
    overflow: clip;
  }

  .es225-hero {
    position: relative;
    min-height: min(760px, 86vh);
    display: grid;
    align-items: end;
    background: #1d130e;
    color: #fff;
    overflow: hidden;
  }

  .es225-hero > figure { position: absolute; inset: 0; margin: 0; }
  .es225-hero > figure :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 58% 48%; border-radius: 0; }
  .es225-hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(18,9,5,.95), rgba(35,18,8,.67) 48%, rgba(14,8,4,.12) 82%), linear-gradient(0deg, rgba(18,9,5,.78), transparent 52%); }
  .es225-hero-copy { position: relative; z-index: 1; width: min(1220px, calc(100% - 48px)); margin: auto; padding: 58px 0 76px 260px; box-sizing: border-box; }
  .es225-hero nav { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 48px; color: #e1d5c5; font-size: 12px; }
  .es225-hero a { color: inherit; }
  .es225-eyebrow { margin: 0; color: var(--gold); font: 700 12px/1.4 var(--font-display, Oswald), sans-serif; letter-spacing: .17em; text-transform: uppercase; }
  .es225-eyebrow span { padding: 0 .3em; }
  .es225-hero h1 { max-width: 930px; margin: 14px 0 22px; color: #fff; font: 600 clamp(54px, 7vw, 96px)/.94 var(--font-display, Oswald), sans-serif; letter-spacing: -.035em; text-wrap: balance; }
  .es225-dek { max-width: 790px; margin: 0; color: #f6f0e8; font-size: clamp(18px, 2vw, 23px); line-height: 1.5; }
  .es225-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .es225-actions a { padding: 15px 20px; border: 1px solid #d8b37e; background: var(--rust); font: 700 12px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .es225-actions a + a { background: rgba(20,10,5,.38); }

  .es225-paper { padding: 0 0 92px; background: linear-gradient(90deg, #eee6da 0, #f8f4ed 18%, #fff 18%, #fff 100%); }
  .es225-layout { width: min(1260px, calc(100% - 48px)); margin: auto; display: grid; grid-template-columns: 205px minmax(0, 880px); gap: clamp(46px, 6vw, 78px); align-items: start; }
  .es225-rail { min-width: 0; align-self: stretch; }
  .es225-rail nav { position: sticky; top: 24px; padding: 64px 0 40px; }
  .es225-rail p { margin: 0 0 18px; color: var(--rust); font: 700 13px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .es225-rail ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid #cdbda7; }
  .es225-rail li { margin: 0; border-bottom: 1px solid #cdbda7; }
  .es225-rail li a { display: grid; grid-template-columns: 25px 1fr; gap: 7px; padding: 8px 2px; color: #473c32; font-size: 12px; line-height: 1.25; text-decoration: none; }
  .es225-rail li a:hover { color: var(--rust); }
  .es225-rail li span { color: #987a5a; font: 600 10px/1.5 var(--font-display, Oswald), sans-serif; letter-spacing: .08em; }
  .es225-rail-cta { display: block; margin-top: 22px; padding: 12px 14px; background: var(--rust); color: #fff; font: 700 11px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .08em; text-align: center; text-decoration: none; text-transform: uppercase; }

  .article-body { min-width: 0; padding: 76px 0 24px; counter-reset: guide-section; color: var(--ink); font-size: 18px; line-height: 1.72; }
  .article-body :global(> style) { display: none; }
  .article-body :global(> p:nth-of-type(-n + 4)) { max-width: 820px; font-size: 20px; line-height: 1.68; }
  .article-body :global(p) { margin: 0 0 1.2em; }
  .article-body :global(a) { color: var(--rust-bright); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .article-body :global(a:hover) { color: var(--rust); }
  .article-body :global(strong) { color: var(--brown); }

  .article-body :global(h2) {
    counter-increment: guide-section;
    margin: 94px 0 25px;
    padding-top: 27px;
    border-top: 1px solid var(--line);
    border-bottom: 0;
    color: var(--rust);
    font: 600 clamp(38px, 4.4vw, 57px)/1.02 var(--font-display, Oswald), sans-serif;
    letter-spacing: -.025em;
    scroll-margin-top: 95px;
    text-wrap: balance;
  }
  .article-body :global(h2::before) { content: "FIELD NOTE " counter(guide-section, decimal-leading-zero); display: block; margin-bottom: 12px; color: #987a5a; font: 700 11px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .15em; }
  .article-body :global(h3) { margin: 42px 0 12px; padding-left: 18px; border-left: 4px solid var(--rust-bright); color: var(--brown); font: 600 25px/1.15 var(--font-display, Oswald), sans-serif; letter-spacing: -.01em; }
  .article-body :global(h4) { margin: 32px 0 10px; color: var(--brown); font: 600 20px/1.2 var(--font-display, Oswald), sans-serif; }

  .article-body :global(.es225-facts) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 38px 0; padding: 1px; background: var(--line); }
  .article-body :global(.es225-facts > div) { min-height: 145px; padding: 23px; background: var(--paper); color: #50443a; font-size: 15px; line-height: 1.45; }
  .article-body :global(.es225-facts span) { display: block; margin-bottom: 7px; color: #765a3b; font: 700 10px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .article-body :global(.es225-facts strong) { display: block; margin-bottom: 8px; color: var(--rust); font: 600 25px/1.1 var(--font-display, Oswald), sans-serif; }
  .article-body :global(.es225-note) { position: relative; margin: 36px 0; padding: 26px 30px 27px 34px; border-left: 5px solid var(--rust-bright); background: #eee4d3; color: #3d352c; }
  .article-body :global(.es225-note strong) { display: block; margin-bottom: 5px; color: var(--rust); font: 700 15px/1.2 var(--font-display, Oswald), sans-serif; letter-spacing: .04em; text-transform: uppercase; }

  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 1.5em; padding-left: 1.45em; }
  .article-body :global(li) { margin-bottom: .55em; }
  .article-body :global(#quick-identification + p + ul) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 28px 0 30px; padding: 1px; background: var(--line); list-style: none; }
  .article-body :global(#quick-identification + p + ul li) { min-height: 118px; margin: 0; padding: 21px 23px; background: #faf7f1; }
  .article-body :global(#quick-identification + p + ul strong) { display: block; margin-bottom: 5px; color: var(--rust); font: 600 19px/1.2 var(--font-display, Oswald), sans-serif; }

  .article-body :global(table) { width: 100%; margin: 32px 0; border-collapse: collapse; font-size: 15px; line-height: 1.42; }
  .article-body :global(th), .article-body :global(td) { padding: 15px 14px; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  .article-body :global(thead th) { background: var(--rust); color: #fff; font: 600 14px/1.2 var(--font-display, Oswald), sans-serif; letter-spacing: .025em; }
  .article-body :global(tbody tr:nth-child(even)) { background: #f7f1e8; }
  .article-body :global(#model-decoder + p + table) { box-shadow: 0 18px 50px rgba(45,28,17,.13); }
  .article-body :global(#model-decoder + p + table tbody tr:nth-child(odd)) { background: #2b2927; color: #f5eee5; }
  .article-body :global(#model-decoder + p + table tbody tr:nth-child(even)) { background: #373330; color: #f5eee5; }
  .article-body :global(#model-decoder + p + table strong) { color: #e4be8b; }

  .article-body :global(figure) { margin: 34px 0; overflow: hidden; background: #201c19; box-shadow: 0 16px 42px rgba(30,19,12,.14); }
  .article-body :global(figure p) { margin: 0; }
  .article-body :global(figure img) { display: block; width: 100%; max-height: 760px; object-fit: contain; background: #171412; border-radius: 0; }
  .article-body :global(figcaption) { margin: 0; padding: 15px 19px 17px; background: #201c19; color: #fff; font-size: 14px; font-style: normal; line-height: 1.5; text-align: left; }
  .article-body :global(figcaption strong) { color: #e4be8b; }

  .article-body :global(details) { margin: 0; padding: 20px 0; border-top: 1px solid var(--line); }
  .article-body :global(details:last-of-type) { border-bottom: 1px solid var(--line); }
  .article-body :global(summary) { cursor: pointer; color: var(--brown); font: 600 20px/1.3 var(--font-display, Oswald), sans-serif; list-style-position: outside; }
  .article-body :global(details p) { margin: 14px 0 2px; padding-left: 22px; color: #4b443d; }

  .article-body :global(#appraisal-photos + ol) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 28px 0; padding: 1px; background: var(--line); list-style: none; counter-reset: photo-list; }
  .article-body :global(#appraisal-photos + ol li) { counter-increment: photo-list; display: grid; grid-template-columns: 34px 1fr; gap: 12px; margin: 0; padding: 17px 19px; background: #faf7f1; }
  .article-body :global(#appraisal-photos + ol li::before) { content: counter(photo-list, decimal-leading-zero); color: var(--rust-bright); font: 700 13px/1.5 var(--font-display, Oswald), sans-serif; }
  .article-body :global(#appraisal-photos ~ p:last-child) { margin: 42px 0 0; padding: 34px 36px; background: var(--rust); color: #fff; font-size: 20px; line-height: 1.55; }
  .article-body :global(#appraisal-photos ~ p:last-child a) { color: #f0d2a8; font-weight: 700; }

  .es225-author { width: min(920px, calc(100% - 48px)); margin: 0 auto 96px; display: grid; grid-template-columns: 132px 1fr; gap: 30px; padding: 36px; border-top: 5px solid var(--rust); background: var(--paper); }
  .es225-author :global(img) { width: 132px; height: 132px; object-fit: cover; border-radius: 50%; }
  .es225-author-label { margin: 1px 0 5px; color: #876a4a; font: 700 10px/1 var(--font-display, Oswald), sans-serif; letter-spacing: .15em; text-transform: uppercase; }
  .es225-author h2 { margin: 0 0 9px; color: var(--rust); font: 600 29px/1 var(--font-display, Oswald), sans-serif; }
  .es225-author p { margin: 0 0 10px; line-height: 1.55; }
  .es225-author a { color: var(--rust); font-weight: 700; }

  @media (max-width: 1050px) {
    .es225-hero-copy { padding-left: 0; }
    .es225-paper { background: #fff; }
    .es225-layout { width: min(880px, calc(100% - 48px)); display: block; }
    .es225-rail { display: none; }
  }

  @media (max-width: 700px) {
    .es225-hero { min-height: 650px; }
    .es225-hero-copy { width: min(100% - 36px, 1220px); padding: 45px 0 52px; }
    .es225-hero nav { margin-bottom: 34px; }
    .es225-hero h1 { font-size: clamp(47px, 14vw, 68px); }
    .es225-actions { display: grid; }
    .es225-actions a { text-align: center; }
    .es225-layout { width: min(100% - 36px, 880px); }
    .article-body { padding-top: 56px; font-size: 17px; }
    .article-body :global(> p:nth-of-type(-n + 4)) { font-size: 18px; }
    .article-body :global(h2) { margin-top: 72px; font-size: clamp(35px, 10vw, 47px); }
    .article-body :global(.es225-facts), .article-body :global(#quick-identification + p + ul), .article-body :global(#appraisal-photos + ol) { grid-template-columns: 1fr; }
    .article-body :global(table) { display: block; max-width: 100%; overflow-x: auto; white-space: normal; }
    .article-body :global(th), .article-body :global(td) { min-width: 130px; }
    .article-body :global(.es225-note), .article-body :global(#appraisal-photos ~ p:last-child) { padding: 24px; }
    .es225-author { width: min(100% - 36px, 920px); grid-template-columns: 1fr; padding: 28px; }
  }
</style>
