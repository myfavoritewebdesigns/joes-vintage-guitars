---
import MartinGuideLayout from '../layouts/MartinGuideLayout.astro';
import MartinPhoto from './MartinPhoto.astro';
import MartinPhotoViewer from './MartinPhotoViewer.astro';
import { martinGuides, martinImage, martinFeatureTimeline, martinTunerTimeline, type MartinGuide } from '../data/martin-guides';
import { SITE_URL } from '../config/site';
interface Props { guide: MartinGuide; }
const { guide } = Astro.props;
const canonical = `/${guide.slug}/`;
const socialImage = martinImage(guide.cardImage);
const schema = [
  {'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/#organization'},datePublished:'2026-10-02',dateModified:'2026-10-02'},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:guide.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
];
---
<MartinGuideLayout title={guide.title} description={guide.description} canonical={canonical} structuredData={schema} ogImage={`${SITE_URL}${socialImage.src}`} ogImageWidth={socialImage.width} ogImageHeight={socialImage.height} ogImageAlt={`${guide.shortTitle} detail on a Martin guitar`}>
  <section class="mtn-hero"><div class="mtn-wrap">
    <p class="mtn-kicker">Martin Identification / {guide.shortTitle}</p><h1>{guide.title}</h1>
    <p class="mtn-lede">{guide.intro}</p><p class="mtn-byline">By <a href="/about-me/">Joe Dampt</a> · Updated October 2, 2026</p>
    <nav class="mtn-toc" aria-label="On this page">{guide.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}</nav>
    <a href="/martin-serial-and-model-numbers/#decoder" class="mtn-button">Look Up Your Serial Number</a>
  </div></section>
  {guide.slug === 'martin-tuner-dating-guide' && <section class="mtn-section"><div class="mtn-wrap"><h2>Martin Tuner Timeline</h2><p>These reference periods apply to particular hardware families and models. They overlap, and replacement gears can appear on a guitar of any age.</p><div class="mtn-table-scroll"><table><thead><tr><th scope="col">Period</th><th scope="col">Hardware Family</th><th scope="col">Detail To Check</th></tr></thead><tbody>{martinTunerTimeline.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div><p>Compare the dated examples in <a href="https://vintagemartin.com/tuners.html">Robert Corwin’s Martin tuner study</a> for model-specific details.</p></div></section>}
  {guide.slug === 'martin-physical-features-dating-guide' && <section class="mtn-section"><div class="mtn-wrap"><h2>Martin Construction Timeline</h2><p>These are broad changes for the relevant standard models. Compare the exact model and inspect repairs before applying a date.</p><div class="mtn-table-scroll"><table><thead><tr><th scope="col">Period</th><th scope="col">Change To Compare</th><th scope="col">Limit Of The Clue</th></tr></thead><tbody>{martinFeatureTimeline.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div><p>References: <a href="https://www.guitarhq.com/martin.html">Vintage Guitars Info production chronology</a>, <a href="https://www.martinguitar.com/faqs.html">Martin’s rosewood history</a>, and <a href="https://www.martinguitar.com/news-070226-martin-guitar-introduces-the-HD-28-semiquincentennial.html">Martin’s HD-28 history</a>.</p></div></section>}
  {guide.sections.map((section,index)=><section class:list={['mtn-section',{'mtn-section--tint':index%2===1}]} id={section.id}><div class="mtn-wrap">
    <div class="mtn-section-head">{section.period && <p class="mtn-kicker">{section.period}</p>}<h2>{section.title}</h2></div>
    {section.paragraphs.map(text=><p>{text}</p>)}
    {section.points && <ul>{section.points.map(text=><li>{text}</li>)}</ul>}
    {section.photos && <div class:list={['mtn-photo-grid',{'jvg-img2':section.photos.length>1}]}>{section.photos.map(photo=><MartinPhoto src={martinImage(photo.file)} {...photo} />)}</div>}
    {section.link && <p><a href={section.link.href}>{section.link.label}</a></p>}
  </div></section>)}
  <section class="mtn-section"><div class="mtn-wrap"><h2>Frequently Asked Questions</h2>{guide.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
  <section class="mtn-section mtn-section--tint"><div class="mtn-wrap mtn-split"><div><h2>Check The Rest Of The Guitar</h2><p>A matching detail supports an identification. It doesn’t establish every part’s originality. Compare the serial, model, construction and repair history together.</p><ul>{martinGuides.filter(g=>g.slug!==guide.slug).map(g=><li><a href={`/${g.slug}/`}>{g.title}</a></li>)}</ul><p><a href="/free-appraisal/martin/">Send Joe Photos For A Martin Appraisal</a></p></div><div><h2>Sources And Photo Notes</h2><p>Shop and listing photographs illustrate the visible details of those instruments. A dated guitar may still have replacement parts. Source links identify the examples used here.</p><ul class="mtn-source-list">{guide.sources.map(s=><li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul></div></div></section>
  <MartinPhotoViewer />
</MartinGuideLayout>
