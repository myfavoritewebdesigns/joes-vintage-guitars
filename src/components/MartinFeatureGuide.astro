---
import MartinGuideLayout from '../layouts/MartinGuideLayout.astro';
import MartinPhotoGallery from './MartinPhotoGallery.astro';
import MartinModelDecoder from './MartinModelDecoder.astro';
import MartinPhotoViewer from './MartinPhotoViewer.astro';
import { martinGuides, martinImage, martinFeatureTimeline, martinTunerTimeline, type MartinGuide } from '../data/martin-guides';
import { SITE_URL } from '../config/site';
interface Props { guide: MartinGuide; }
const { guide } = Astro.props;
const canonical = `/${guide.slug}/`;
const socialImage = martinImage(guide.cardImage);
const updated = { date: '2026-10-06', label: 'October 6, 2026' };
const schema = [
  {'@context':'https://schema.org','@type':'Article',headline:guide.title,description:guide.description,image:{'@type':'ImageObject',contentUrl:SITE_URL+socialImage.src,width:socialImage.width,height:socialImage.height,caption:guide.cardCaption || guide.sections.flatMap(s=>s.photos || []).find(p=>p.file===guide.cardImage)?.caption || guide.cardText},mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/#organization'},datePublished:guide.published || (guide.slug==='martin-guitar-model-numbers'?'2026-10-05':'2026-10-02'),dateModified:updated.date},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:guide.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}
];
---
<MartinGuideLayout title={guide.title} description={guide.description} canonical={canonical} structuredData={schema} ogImage={`${SITE_URL}${socialImage.src}`} ogImageWidth={socialImage.width} ogImageHeight={socialImage.height} ogImageAlt={`${guide.shortTitle} detail on a Martin guitar`}>
  <section class="mtn-hero"><div class="mtn-wrap">
    <p class="mtn-kicker">Martin Identification / {guide.shortTitle}</p><h1>{guide.title}</h1>
    <p class="mtn-lede">{guide.intro}</p><p class="mtn-byline">By <a href="/about-me/">Joe Dampt</a> · Updated {updated.label}</p>
    <nav class="mtn-toc" aria-label="On this page">{guide.slug === 'martin-guitar-model-numbers' && <><a href="#model-decoder">Model Decoder</a><a href="#body-sizes">Body Sizes</a><a href="#style-numbers">Style Numbers</a></>}{guide.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}{guide.timeline && <a href="#guide-timeline">Construction Timeline</a>}</nav>
    <a href="/martin-serial-and-model-numbers/#decoder" class="mtn-button">Look Up Your Serial Number</a>
  </div></section>
  {guide.slug === 'martin-guitar-model-numbers' && <MartinModelDecoder />}
  {guide.slug === 'martin-tuner-dating-guide' && <section class="mtn-section"><div class="mtn-wrap"><h2>Martin Tuner Timeline</h2><p>Martin used several tuner designs at the same time. Match the period and model in the table, then check the mounting holes for evidence of replacements.</p><div class="mtn-table-scroll"><table><caption class="sr-only">Martin Tuner Timeline</caption><thead><tr><th scope="col">Period</th><th scope="col">Hardware Family</th><th scope="col">Detail To Check</th></tr></thead><tbody>{martinTunerTimeline.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div><p>Compare the dated examples in <a href="https://vintagemartin.com/tuners.html">Robert Corwin’s Martin tuner study</a> for model-specific details.</p></div></section>}

  {guide.sections.map((section,index)=><section class:list={['mtn-section',{'mtn-section--tint':index%2===1}]} id={section.id}>{section.anchorIds?.map(id=><span id={id} aria-hidden="true"></span>)}<div class="mtn-wrap">
    <div class="mtn-section-head">{section.period && <p class="mtn-kicker">{section.period}</p>}<h2>{section.title}</h2></div>
    {section.paragraphs.map(text=><p>{text}</p>)}
    {section.points && <ul>{section.points.map(text=><li>{text}</li>)}</ul>}
    {section.photos && <MartinPhotoGallery photos={section.photos} />}
    {section.link && <p><a href={section.link.href}>{section.link.label}</a></p>}
  </div></section>)}
  {guide.slug === 'martin-guitar-dating-guide' && <section class="mtn-section"><div class="mtn-wrap"><h2>Martin Construction Timeline</h2><p>Use this timeline with the exact model’s specifications. Several changes overlapped, and repairs can alter the bridge, braces or other parts you’re comparing.</p><div class="mtn-table-scroll"><table><caption class="sr-only">Martin Construction Timeline</caption><thead><tr><th scope="col">Period</th><th scope="col">Change To Compare</th><th scope="col">Exceptions And Repairs</th></tr></thead><tbody>{martinFeatureTimeline.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div><p>References: <a href="https://www.guitarhq.com/martin.html">Vintage Guitars Info production chronology</a>, <a href="https://www.martinguitar.com/faqs.html">Martin’s rosewood history</a>, <a href="https://www.martinguitar.com/news-070226-martin-guitar-introduces-the-HD-28-semiquincentennial.html">Martin’s HD-28 history</a>, and <a href="https://www.martin-gitarren.de/files/downloads/martinstory.pdf">The Martin Story, pages 11 and 12</a>.</p></div></section>}
  {guide.timeline && <section class="mtn-section" id="guide-timeline"><div class="mtn-wrap"><h2>{guide.timeline.title}</h2><p>{guide.timeline.intro}</p><div class="mtn-table-scroll"><table><caption class="sr-only">{guide.timeline.title}</caption><thead><tr><th scope="col">Period</th><th scope="col">Change To Compare</th><th scope="col">Exceptions And Repairs</th></tr></thead><tbody>{guide.timeline.rows.map(row=><tr>{row.map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div></div></section>}
  <section class="mtn-section"><div class="mtn-wrap"><h2>Frequently Asked Questions</h2>{guide.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
  <section class="mtn-section mtn-section--tint"><div class="mtn-wrap mtn-split"><div><h2>Related Martin Dating Guides</h2><p>Check the serial and model stamp alongside the logo, tuners and construction. The guides below have photos of each area.</p><ul>{martinGuides.filter(g=>g.slug!==guide.slug).map(g=><li><a href={`/${g.slug}/`}>{g.title}</a></li>)}</ul><p>If a stamp, logo or part doesn’t fit the guitar, use the <a href="/how-to-spot-a-fake-martin/">Martin counterfeit identification guide</a> to check the whole instrument.</p><p><a href="/free-appraisal/martin/">Send Joe Photos For A Martin Appraisal</a></p></div><div><h2>Photo Credits And Dating References</h2><p>The photo captions link to the guitar’s article or public listing where available. Dates for listed guitars follow those records; captions note known repairs and any parts we haven’t confirmed as original.</p><ul class="mtn-source-list">{guide.sources.map(s=><li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}</ul></div></div></section>
  <MartinPhotoViewer />
</MartinGuideLayout>
