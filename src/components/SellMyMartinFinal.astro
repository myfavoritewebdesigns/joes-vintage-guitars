            <p>{guide.buying}</p>
            <a class="smm-guide-card__primary" href={guide.url}>{guide.action}</a>
          </div>
        </li>
      ))}
    </ul>
    <a class="smm-all-guides" href="/blog/">Browse All Guitar Articles</a>
  </section>

  <section class="smm-section smm-reviews" id="our-clients-testimonials">
    <header class="smm-heading"><p class="smm-eyebrow">Reviews From Sellers</p><h2>What People Say After Selling Me a Guitar</h2><p>These reviews are from people who sold guitars to me. Click any one to read the original review on Google.</p></header>
    <figure class="smm-review-story"><LicensedImage src={sellerPhoto} alt="A Martin owner holding her vintage acoustic guitar" width={520} loading="lazy" /><figcaption>A Martin owner with the vintage acoustic guitar she shared with Joe.</figcaption></figure>
    <div class="smm-review-grid">
      {reviews.map((review) => (
        <a class="smm-review-card" href={review.url} target="_blank" rel="noopener noreferrer">
