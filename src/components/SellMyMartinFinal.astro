---
import LicensedImage from "./primitives/LicensedImage.astro";
import Button from "./primitives/Button.astro";
import LeadForm from "./LeadForm.astro";
import ContactSection from "./ContactSection.astro";
import { resolveImage } from "../lib/images";
import { contact, hrefs } from "../config/site";
import martinTestimonials from "../../reference/martin-testimonials.json";

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FAQItem[];
}

const { faqs } = Astro.props;
const reviewUrl = (name: string) =>
  martinTestimonials.find((review) => review.name === name)?.link ?? hrefs.googleReviews;

const reviews = [
  { name: "Adrienne Young", detail: "Sold a 1920s Martin", quote: "Fair, courteous, gracious and trustworthy.", url: reviewUrl("Adrienne Young") },
  { name: "Tony Michaud", detail: "Received a Martin D-18 appraisal", quote: "They took the time to look at the photos of my Martin D18 and emailed back an appraisal.", url: reviewUrl("Tony Michaud") },
  { name: "Larry Hattier", detail: "Sold a loved vintage guitar", quote: "He made a very fair offer immediately!", url: reviewUrl("Larry Hattier") },
  { name: "Bobbie Jo Kelly Greene", detail: "Sold three inherited vintage guitars", quote: "He offered me an excellent price, & helped me through the process of getting them to him.", url: reviewUrl("Bobbie Jo Kelly Greene") },
  { name: "Marie Coyle", detail: "Sold an inherited guitar collection", quote: "His offer was fair and we appreciated how quickly our brother's collection was moved from another state.", url: reviewUrl("Marie Coyle") },
  { name: "Jessica Hammond", detail: "Compared several offers before selling", quote: "The entire process of selling/shipping is flawless, simple and time saving.", url: reviewUrl("Jessica Hammond") },
];

const shippingReviews = [
  { name: "Jessica Hammond", quote: "The entire process of selling/shipping is flawless, simple and time saving.", url: reviewUrl("Jessica Hammond") },
  { name: "Larry Hattier", quote: "The shipping process following was very straightforward.", url: reviewUrl("Larry Hattier") },
  { name: "Bobbie Jo Kelly Greene", quote: "Within 20 minutes the guitar's were on there way to him & the money was in my account.", url: reviewUrl("Bobbie Jo Kelly Greene") },
];

const ownerStories = [
  {
    title: "One Family From New: A 1946 Martin D-28",
    detail: "One Family, Apache Junction",
    summary: "The original owner's grandson shared this herringbone D-28 and the family connection that stayed with it.",
    url: "/post/one-family-1946-martin-d-28/",
    image: resolveImage("/images/blog/one-family-1946-martin-d-28/1946-martin-d-28-original-owners-grandson.jpeg")!,
    imageAlt: "The original owner's grandson holding the family's 1946 Martin D-28",
  },
  {
    title: "Linda Gayle's One-Owner 1949 Martin 0-18",
    detail: "One Owner, Iowa",
    summary: "Linda toured Iowa, played on local radio and kept this small Martin through a lifetime of music.",
    url: "/post/one-owner-1949-martin-0-18/",
    image: resolveImage("/images/blog/one-owner-1949-martin-0-18/linda-gayle-family-with-1949-martin-0-18.jpg")!,
    imageAlt: "Linda Gayle's family member holding the one-owner 1949 Martin 0-18",
  },
  {
    title: "Bill Minnich's One-Owner 1955 Martin D-28",
    detail: "One Owner, A Lifetime of Music",
    summary: "Bill bought it new in 1955. It followed him through Navy service, disappeared for seven years and returned to his family.",
    url: "/post/one-owner-1955-martin-d28/",
    image: resolveImage("/images/blog/one-owner-1955-martin-d28/steve-minnich-1955-martin-d28.jpeg")!,
    imageAlt: "Steve Minnich holding the worn 1955 Martin D-28 his father bought new",
  },
];

const values = [
  { title: "Model and Year", body: "A prewar D-28 starts in a different place than a 1960s D-28, just as an early 000 or OM can differ sharply from a later example.", icon: "M4 19.5V4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-2Z M8 6h8 M8 10h8 M8 14h5" },
  { title: "Tonewoods and Bracing", body: "Brazilian rosewood, Adirondack spruce and original scalloped bracing can have a major effect on collector demand and value.", link: "/martin-d-28-d-18-d-45-dreadnought-value-guide/", linkLabel: "Read the Martin dreadnought value guide", icon: "M14.7 6.3a1 1 0 0 0-1.4-1.4l-8 8a2 2 0 1 0 2.8 2.8l8-8a1 1 0 0 0-1.4-1.4Z M16 3l5 5 M3 21l4-1-3-3-1 4Z" },
  { title: "Original Finish and Parts", body: "The original finish, bridge, tuners, pickguard and internal work all matter. Keep every replaced part with the guitar.", icon: "M12 3l1.7 4.3L18 9l-4.3 1.7L12 15l-1.7-4.3L6 9l4.3-1.7L12 3Z M5 15l.8 2.2L8 18l-2.2.8L5 21l-.8-2.2L2 18l2.2-.8L5 15Z" },
  { title: "Condition and Repairs", body: "Cracks, neck resets and bridge work are common on old acoustics. Good repairs can keep a guitar playable, but they still affect the offer.", icon: "M14.7 6.3a4 4 0 0 0-5-5L12 4l-3 3-2.7-2.7a4 4 0 0 0 5 5L4 16.6A2 2 0 1 0 6.8 19.4L14.7 11.5a4 4 0 0 0 5-5L17 9l-3-3 2.7-2.7Z" },
  { title: "Case and Paperwork", body: "An original case, receipts, warranty papers, repair records and replaced parts should stay together with the guitar.", icon: "M6 2h9l3 3v17H6V2Z M14 2v4h4 M9 11h6 M9 15h6" },
  { title: "Ownership History", body: "Family photographs and a clear original-owner story can add context and value that the serial number alone cannot show.", link: "/post/one-owner-1955-martin-d28/", linkLabel: "Read Bill Minnich's D-28 story", icon: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M22 21v-2a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8" },
];

const valueRows = [
  ["Pre-War D-45 (1936 to 1942)", "$450,000 to $675,000"],
  ["Pre-War D-28 (1931 to 1944)", "$80,000 to $300,000"],
  ["Pre-War D-18 (1931 to 1944)", "$25,000 to $110,000"],
  ["D-28 (1950 to 1959)", "$12,000 to $19,000"],
  ["D-28 (1960 to 1969)", "$6,000 to $11,500"],
  ["D-18 (1950 to 1959)", "$7,000 to $11,000"],
] as const;

const purchases = [
  { image: resolveImage("images/sell-martin/1947-martin-d-28-purchase-800x1200.jpg")!, alt: "Vintage 1947 Martin D-28 purchased by Joe's Vintage Guitars", title: "1947 Martin D-28", price: "$28,000" },
  { image: resolveImage("images/sell-martin/1945-martin-d-18-purchase-800x1200.jpg")!, alt: "Vintage 1945 Martin D-18 purchased by Joe's Vintage Guitars", title: "1945 Martin D-18", price: "$13,000" },
  { image: resolveImage("images/sell-martin/1949-martin-000-28-purchase-800x1200.jpg")!, alt: "Vintage 1949 Martin 000-28 purchased by Joe's Vintage Guitars", title: "1949 Martin 000-28", price: "$11,000" },
  { image: resolveImage("images/sell-martin/1976-martin-000-45-purchase-800x1200.jpg")!, alt: "Rare 1976 Martin 000-45 purchased by Joe's Vintage Guitars", title: "1976 Martin 000-45", price: "$8,900", note: ["Read the full 1976 Martin 000-45 guide", "/post/1976-martin-000-45-specs-history-value-guide/"] },
  { image: resolveImage("images/sell-martin/1947-martin-00-21-purchase-800x1200.jpg")!, alt: "Vintage 1947 Martin 00-21 purchased by Joe's Vintage Guitars", title: "1947 Martin 00-21", price: "$7,500" },
  { image: resolveImage("images/sell-martin/1960-martin-000-18-purchase-800x1200.jpg")!, alt: "Vintage 1960 Martin 000-18 purchased by Joe's Vintage Guitars", title: "1960 Martin 000-18", price: "$6,700" },
  { image: resolveImage("images/sell-martin/1931-martin-0-18k-purchase-800x1200.jpg")!, alt: "Vintage 1931 Martin 0-18K koa acoustic guitar purchased by Joe's Vintage Guitars", title: "1931 Martin 0-18K", price: "$5,000" },
];

const modelGuides = [
  { title: "Martin D-18", era: "1930s Through The 1960s", buying: "I pay close attention to prewar examples, Adirondack spruce tops, scalloped bracing and clean postwar guitars.", url: "/post/martin-d18-history-specs-authentication-value-guide/", action: "Read the Martin D-18 guide", image: resolveImage("images/sell-martin/1953-martin-D-18-1-1024x682.jpg")!, imageAlt: "Vintage 1953 Martin D-18 acoustic guitar" },
  { title: "Martin D-28", era: "1930s Through The 1960s", buying: "Herringbone D-28s and Brazilian rosewood examples from the 1930s through the late 1960s are always of interest.", url: "/martin-d-28-d-18-d-45-dreadnought-value-guide/", action: "Read the Martin dreadnought value guide", image: resolveImage("images/sell-martin/1959-martin-D-28-1024x683.jpg")!, imageAlt: "Vintage 1959 Martin D-28 acoustic guitar" },
  { title: "Martin 0 Models", era: "1800s Through The 1960s", buying: "I buy 0-18, 0-21 and 0-28 guitars, including early 12-fret examples and well-played family instruments.", url: "/post/martin-0-00-000-history-authentication-value-guide/", action: "Compare Martin 0, 00 and 000 models", image: resolveImage("images/sell-martin/martin-acoustic-guitar-1024x682.jpg")!, imageAlt: "Vintage Martin 0-size acoustic guitar" },
  { title: "Martin 00 Models", era: "1900s Through The 1960s", buying: "I buy Grand Concert 00-18, 00-21 and 00-28 guitars in both 12-fret and 14-fret configurations.", url: "/post/martin-0-00-000-history-authentication-value-guide/", action: "Read the small-body Martin guide", image: resolveImage("images/sell-martin/1920s-martin-00-18-1-1024x683.jpg")!, imageAlt: "Vintage 1920s Martin 00-18 acoustic guitar" },
  { title: "Martin 000 Models", era: "1920s Through The 1970s", buying: "I buy vintage 000-18, 000-21, 000-28 and rare high-trim 000 models with original or well-documented features.", url: "/post/martin-0-00-000-history-authentication-value-guide/", action: "Compare vintage Martin 000 models", image: resolveImage("images/sell-martin/1956-martin-000-21-1-1024x683.jpg")!, imageAlt: "Vintage 1956 Martin 000-21 acoustic guitar" },
  { title: "Martin OM Models", era: "1929 Through The 1930s", buying: "Original Orchestra Models are especially scarce. I look closely at body shape, scale length, neck joint and period-correct construction.", url: "/martin-serial-and-model-numbers/", action: "Use the Martin model and serial guide", image: resolveImage("images/sell-martin/martin-om-42-1024x682.jpg")!, imageAlt: "Vintage Martin OM-42 acoustic guitar" },
  { title: "Martin Style 40, 41, 42 and 45", era: "Prewar Through The 1970s", buying: "I buy high-trim Martins with pearl inlay, from rare early examples through carefully documented later guitars.", url: "/martin-d-28-d-18-d-45-dreadnought-value-guide/", action: "Review vintage Martin values", image: resolveImage("images/sell-martin/martin-d-45-brazilian-rosewood-1024x682.jpg")!, imageAlt: "Vintage Martin D-45 with pearl inlay" },
  { title: "Martin Electric Models", era: "Late 1950s Through The 1960s", buying: "I buy factory D-18E and D-28E guitars along with other unusual Martin electrics and thin-line models.", url: "/post/martin-d18e-vs-d28e-authentication-guide/", action: "Compare the Martin D-18E and D-28E", image: resolveImage("images/sell-martin/1959-martin-d-28-e-1-1024x683.jpg")!, imageAlt: "Rare 1959 Martin D-28E electric acoustic guitar" },
];

const heroGuitar = resolveImage("images/1959-martin-D-28-scaled.jpg")!;
const shippingPhoto = resolveImage("images/sell-martin/martin-guitars-at-fedex.webp")!;
const joePhoto = resolveImage("images/fender-sn/about-me-joe-1.jpg")!;
const preservationPhoto = resolveImage("/images/blog/one-owner-1955-martin-d28/steve-minnich-1955-martin-d28.jpeg")!;
const sellerPhoto = resolveImage("images/sell-martin/Copy-of-IMG_1620-600x800.jpg")!;
---

<div class="smm-header-collage" aria-hidden="true"></div>

<div class="smm-page">
  <section class="smm-hero" id="top">
    <div class="smm-hero__copy">
      <p class="smm-eyebrow">Vintage Martin Specialist</p>
      <h1>Sell Your Vintage Martin to a Buyer Who Knows What It Is</h1>
      <p class="smm-hero__lead">Vintage guitars have been at the center of my life for more than twelve years. I love learning where an old Martin has been, who played it and the stories that stayed with it. Send me a few photos of your D-18, D-28, 0, 00, 000, OM or other vintage Martin and tell me what you know. I'll look it over myself and, if it's a guitar I can buy, make you a cash offer with no obligation.</p>
      <div class="smm-hero__actions">
        <Button href="#appraisal" variant="rust" size="lg">Fill Out the Form</Button>
        <a class="smm-button-secondary" href={hrefs.tel}>Call or Text Joe</a>
      </div>
      <a class="smm-hero__story-link" href="#owner-stories">Read Guitar Stories</a>
      <div class="smm-trust-row">
        <span>Insured Nationwide Shipping</span>
        <span>No Obligation</span>
        <span>Deal Directly With Joe</span>
      </div>
    </div>
    <figure class="smm-hero__image">
      <LicensedImage src={heroGuitar} alt="Vintage 1959 Martin D-28 acoustic guitar in its original case" width={1900} sizes="(max-width: 650px) 650px, (max-width: 950px) 950px, 1900px" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section class="smm-proof" aria-label="Joe's experience">
    <div><strong>12+</strong><span>Years Buying Full-Time</span></div>
    <div><strong>10,000+</strong><span>Instruments Appraised</span></div>
    <div><strong>50</strong><span>States Bought From</span></div>
    <div><strong>2,100+</strong><span>Positive Reviews</span></div>
  </section>

  <span class="smm-anchor" id="receive-free-consultation"></span>
  <section class="smm-appraisal" id="appraisal">
    <div class="smm-appraisal__copy"><p class="smm-eyebrow">Talk With Me</p><h2>Tell Me About Your Martin</h2><p>You don't need to know the model, year or value. Send me whatever photos you have and tell me anything you know about the guitar. I'll look it over myself and get back to you.</p><p>If you'd like to know the ideal photos to send, <a href="#photo-guide">read the six-photo guide</a>.</p><a href={hrefs.tel}>Call or Text {contact.phone}</a></div>
    <LeadForm formId="sell-my-martin" instrumentMode="model-only" submitLabel="Send" />
  </section>

  <section class="smm-section smm-process" id="process">
    <span class="smm-anchor" id="how-to-sell-your-guitar"></span>
    <span class="smm-anchor" id="my-guitar-buying-process"></span>
    <header class="smm-heading">
      <p class="smm-eyebrow">How It Works</p>
      <h2>Selling Your Martin Doesn't Have to Be Complicated</h2>
      <p>You'll deal with me from the first message through payment. Here's what I need to get started.</p>
    </header>
    <div class="smm-steps">
      <article><span>01</span><h3>Send Me Photos</h3><p>Take clear photos of the front, back, headstock, neck-block stamp and case. Please don't clean or repair the guitar first.</p></article>
      <article><span>02</span><h3>I'll Look It Over</h3><p>I'll identify the model and year, then check the construction details, condition and repairs that affect its value. There's no charge for the appraisal.</p></article>
      <article><span>03</span><h3>I'll Make an Offer</h3><p>If it's a guitar I can buy, I'll make you a cash offer. You're free to accept it or turn it down.</p></article>
      <article><span>04</span><h3>Agree On Shipping And Payment</h3><p>If you decide to sell, we'll agree on the shipping and payment method before the guitar moves.</p></article>
    </div>
  </section>

  <section class="smm-section smm-shipping" id="shipping">
    <div class="smm-shipping__lead">
      <div class="smm-shipping__intro">
        <p class="smm-eyebrow">Nationwide Shipping</p>
        <h2>A Simple, Proven Way to Ship Your Vintage Martin</h2>
        <p>Sellers across the country have trusted me with valuable and sentimental guitars. I explain the prepaid FedEx process with the offer so you can consider the shipping arrangements before deciding.</p>
        <p>We agree on the shipping and payment details before the guitar moves, and I stay available throughout the process.</p>
        <div class="smm-shipping__included"><strong>There's no shipping cost to you.</strong> Through my special FedEx account, the box, professional packing, fully insured shipping and tracking are all provided at the FedEx location.</div>
      </div>
      <figure class="smm-shipping__photo">
        <LicensedImage src={shippingPhoto} alt="Two Martin guitars and a lap steel in their cases on a FedEx counter" width={720} loading="lazy" />
        <figcaption>Two Martin guitars and a lap steel at the FedEx counter before insured shipping.</figcaption>
      </figure>
    </div>
    <div class="smm-shipping__columns">
      <article><h3>What You Receive With the Offer</h3><ul><li>A clear explanation of the process</li><li>Shipping and insurance details</li><li>Your choice of payment method</li></ul></article>
      <article><h3>What I Handle if You Decide to Sell</h3><ul><li>Prepaid shipping arrangements</li><li>Transit coverage and tracking</li><li>Same-day payment in most cases</li></ul></article>
    </div>
    <div class="smm-shipping__evidence">
      <header><p class="smm-eyebrow">From Sellers Who Used the Process</p><h3>Read What Sellers Said</h3><p>These comments come from people who shipped guitars to me. Each one links to the original Google review.</p></header>
      <div class="smm-shipping__reviews">
        {shippingReviews.map((review) => (
          <a href={review.url} target="_blank" rel="noopener noreferrer">
            <span class="smm-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <blockquote>“{review.quote}”</blockquote>
            <strong>{review.name}</strong>
            <small>Read the Google Review</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="smm-section smm-value" id="value">
    <span class="smm-anchor" id="how-much-is-my-martin-guitar"></span>
    <span class="smm-anchor" id="find-out-martin-really-worth"></span>
    <div class="smm-value__intro-grid">
      <header class="smm-heading">
        <p class="smm-eyebrow">Current Vintage Martin Values</p>
        <h2>How Much Is My Martin Guitar Worth?</h2>
        <p>It depends on the model, the year, the condition and how original it is. Send me a few photos and I'll give you a <a href="/free-appraisal/">free appraisal</a> with a clear answer. It's quick, accurate and there's no obligation to sell.</p>
        <p>These broad ranges come from my <a href="/martin-d-28-d-18-d-45-dreadnought-value-guide/">Martin D-28, D-18 and D-45 value guide</a> and are current as of August 2026.</p>
        <a class="smm-appraisal-route" href="/free-appraisal/"><strong>Want an appraisal for your guitar?</strong><span>Visit the Free Appraisal Page</span></a>
      </header>
      <div class="smm-worth-wrap">
        <table class="smm-worth">
          <caption>Broad market ranges for selected vintage Martin dreadnoughts</caption>
          <tbody>
            {valueRows.map(([model, price]) => (<tr><th scope="row">{model}</th><td>{price}</td></tr>))}
          </tbody>
        </table>
        <p>Condition, originality and repairs move every one of these numbers, so treat them as a starting point, not an appraisal.</p>
      </div>
    </div>
    <header class="smm-value-factors__heading">
      <p class="smm-eyebrow">What Goes Into My Offer</p>
      <h3>The Details I Check Before I Make an Offer</h3>
    </header>
    <div class="smm-value__grid">
      {values.map((item) => (
        <article>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}></path></svg>
          <h3>{item.title}</h3><p>{item.body}</p>
          {item.link && <a class="smm-value-card__link" href={item.link}>{item.linkLabel}</a>}
        </article>
      ))}
    </div>
    <p class="smm-section-link">For more detail, read <a href="/post/how-to-determine-the-value-of-your-old-martin-acoustic-guitar/">how I determine the value of an old Martin</a>, use the <a href="/martin-serial-and-model-numbers/">Martin serial-number guide</a> or compare <a href="/post/martin-0-00-000-history-authentication-value-guide/">Martin 0, 00 and 000 models</a>.</p>
  </section>

  <span class="smm-anchor" id="what-i-have-paid-for-vintage-martin-guitars"></span>
  <section class="smm-section smm-paid" aria-labelledby="smm-paid-title">
    <header class="smm-heading smm-paid__heading">
      <p class="smm-eyebrow">Real Guitars, Real Prices</p>
      <h2 id="smm-paid-title">What I Have Paid for Vintage Martin Guitars</h2>
      <p>These are seven vintage Martins I bought and the actual cash price I paid for each one. Every guitar is different, so what I can pay for yours depends on its year, condition and originality.</p>
    </header>
    <div class="smm-paid__grid">
      {purchases.map((guitar) => (
        <article class="smm-paid__card">
          <div class="smm-paid__image"><LicensedImage src={guitar.image} alt={guitar.alt} width={460} loading="lazy" /></div>
          <div class="smm-paid__copy">
            <h3>{guitar.title}</h3>
            <p><span>I Paid</span><strong>{guitar.price}</strong></p>
            {guitar.note && <a href={guitar.note[1]}>{guitar.note[0]}</a>}
          </div>
        </article>
      ))}
      <article class="smm-paid__card smm-paid__card--cta">
        <div><p class="smm-eyebrow">Your Martin Could Be Next</p><h3>Send Me a Few Photos</h3><p>I'll tell you what your Martin is worth. The appraisal is free, and there's no obligation to sell.</p><Button href="#appraisal" variant="rust" size="lg">Tell Me About Your Martin</Button></div>
      </article>
    </div>
  </section>

  <section class="smm-section smm-photo-guide" id="photo-guide">
    <div>
      <p class="smm-eyebrow">What To Send</p>
      <h2>Six Photos That Help Me Make An Accurate Offer</h2>
      <p>Clear, straight-on photos help me evaluate your Martin and determine what I can pay. Use natural light, and don't loosen strings or take the guitar apart.</p>
    </div>
    <ol>
      <li><span>01</span><strong>Full Front</strong><small>Include the entire body and headstock.</small></li>
      <li><span>02</span><strong>Full Back</strong><small>Show the neck, body and any wear or repairs.</small></li>
      <li><span>03</span><strong>Headstock Front</strong><small>Keep the logo, tuners and nut in view.</small></li>
      <li><span>04</span><strong>Neck-Block Stamp</strong><small>Photograph the model and serial number through the soundhole.</small></li>
      <li><span>05</span><strong>Bridge and Top</strong><small>Show the bridge, pickguard, soundhole and any cracks or repairs.</small></li>
      <li><span>06</span><strong>Case and Paperwork</strong><small>Include tags, receipts, old parts and family photos.</small></li>
    </ol>
  </section>

  <section class="smm-section smm-owner-stories" id="owner-stories">
    <span class="smm-anchor" id="consider-selling-your-guitar"></span>
    <header class="smm-heading smm-owner-stories__heading">
      <p class="smm-eyebrow">Guitars I've Bought</p>
      <h2>Original Owners and the Stories Behind Their Martins</h2>
      <p>These Martins arrived with the names, photographs and memories of the people who played them. I preserve those stories so they can travel with the instruments.</p>
    </header>
    <div class="smm-owner-grid">
      {ownerStories.map((story) => (
        <a class="smm-owner-card" href={story.url}>
          <div class="smm-owner-card__image"><LicensedImage src={story.image} alt={story.imageAlt} width={620} loading="lazy" /></div>
          <div class="smm-owner-card__copy"><span>{story.detail}</span><h3>{story.title}</h3><p>{story.summary}</p><small>Read the Complete Story</small></div>
        </a>
      ))}
    </div>
  </section>

  <section class="smm-section smm-meet" id="meet-connoisseur-joe-dampt">
    <div class="smm-meet__media">
      <figure><LicensedImage src={joePhoto} alt="Joe Dampt playing a vintage guitar" width={720} loading="lazy" /></figure>
      <div class="smm-meet__video"><lite-youtube videoid="fTpIquyV-j8" playlabel="Play Meet Joe Dampt of Joe's Vintage Guitars"></lite-youtube></div>
    </div>
    <div>
      <p class="smm-eyebrow">Meet the Buyer</p>
      <h2>I'm Joe Dampt</h2>
      <p>I buy vintage Martin acoustic guitars from owners in all 50 states. My offers are higher than a typical trade-in or local music-store offer, and every appraisal and cash offer is free with no obligation. When an in-person meeting makes sense, I can inspect the guitar and buy it on the spot.</p>
      <p>I've spent more than twelve years buying vintage guitars full-time and have appraised more than 10,000 instruments. I own Joe's Vintage Guitars in Mesa, Arizona, where I meet sellers by appointment. I can meet many owners in the Phoenix area, and sellers elsewhere can use my prepaid FedEx process.</p>
      <p>I pay attention to the things that separate one Martin from another: the neck-block stamp, tonewoods, bracing, finish, bridge, tuners, repairs and the story that came with it. If I can buy your guitar, I'll explain what I see and make you an offer.</p>
      <div class="smm-credential"><strong>Published by Vintage Verified</strong><p>Vintage Verified is an independent Nashville lab that analyzes the finishes, plastics and hardware on vintage guitars without buying, selling or valuing them. I enjoyed contributing a guest essay about the authentication lessons I've learned from years of handling vintage instruments.</p><a href="https://www.vintageverified.com/joes-vintage" target="_blank" rel="noopener">Read My Vintage Verified Essay</a></div>
      <div class="smm-as-seen"><strong>As Seen In</strong><a href="https://www.kjzz.org/the-show/see-inside-joes-vintage-guitars-in-mesa" target="_blank" rel="noopener">KJZZ 91.5</a><a href="https://voyagephoenix.com/interview/exploring-life-business-with-joseph-dampt-of-joes-vintage-guitars-llc" target="_blank" rel="noopener">VoyagePhoenix</a><a href="https://www.vintageverified.com/joes-vintage" target="_blank" rel="noopener">Vintage Verified</a><a href="/reverb-reviews/">Reverb Top-Rated Seller</a></div>
      <a class="smm-text-link" href="/about-me/">Learn More About Joe</a>
    </div>
  </section>

  <section class="smm-section smm-preservation">
    <figure><LicensedImage src={preservationPhoto} alt="Steve Minnich holding the 1955 Martin D-28 his father bought new" width={820} loading="lazy" /></figure>
    <div>
      <p class="smm-eyebrow">Provenance Matters</p>
      <h2>Original Photos And Stories Can Add To My Offer</h2>
      <p>When a Martin comes with original-owner photographs, receipts or a well-documented family story, I put real value on that history. Meaningful provenance can increase what I'm willing to pay because the people and stories behind vintage guitars matter to me.</p>
      <p>I keep those materials with the guitar. I often print the owner's story and place it inside the case so the next owner knows who played it before them.</p>
      <p>Bill Minnich bought this D-28 new in 1955. His son Steve later shared the guitar and its remarkable history with me. If you inherited a Martin, keep the case, old parts, receipts and photographs together, then send me everything you have.</p>
      <a class="smm-text-link" href="/post/one-owner-1955-martin-d28/">Read Bill Minnich's D-28 Story</a>
    </div>
  </section>

  <section class="smm-section smm-expertise">
    <div><p class="smm-eyebrow">For Sellers Who Want To Learn More</p><h2>Learn More About Your Martin Before You Sell</h2></div>
    <div>
      <p>You don't have to research your guitar before contacting me. That's what I'm here to help with. Send me what you know, and I'll work through the details myself.</p>
      <p>If you'd like to learn more before deciding whether to sell, these Martin resources explain how serial numbers, parts, production totals and model years fit together. I enjoy working with sellers who've done some research because it makes it easier to talk through the guitar, explain my offer and make sure we're on the same page.</p>
      <ul class="smm-resource-links">
        <li><a href="/martin-serial-and-model-numbers/">Date your guitar with my Martin serial and model guide</a></li>
        <li><a href="/martin-d-28-d-18-d-45-dreadnought-value-guide/">Compare D-18, D-28 and D-45 values</a></li>
        <li><a href="/post/martin-d18-history-specs-authentication-value-guide/">Identify a vintage Martin D-18</a></li>
        <li><a href="/post/martin-0-00-000-history-authentication-value-guide/">Compare Martin 0, 00 and 000 models</a></li>
        <li><a href="/post/how-to-determine-the-value-of-your-old-martin-acoustic-guitar/">Learn how I evaluate an old Martin acoustic</a></li>
      </ul>
    </div>
  </section>

  <section class="smm-section smm-options" id="best-way-to-sell">
    <header class="smm-heading"><p class="smm-eyebrow">Know Your Options</p><h2>The Best Way to Sell a Vintage Martin: Dealer, Consignment, Auction or Reverb?</h2><p>Selling directly to me gets you a cash offer with no listing, fees or wait. Consignment or auction can bring more if the guitar sells, but you pay a commission and wait for a buyer. If you'd rather list it yourself, Reverb is where I'd point you. Just factor in the fees.</p></header>
    <table class="smm-options__table">
      <caption>Ways to sell a vintage Martin</caption>
      <thead><tr><th scope="col">Option</th><th scope="col">Why People Choose It</th><th scope="col">What to Consider</th></tr></thead>
      <tbody>
        <tr><th scope="row">Sell Directly to Me</th><td data-label="Why People Choose It">A cash offer, no public listing, no seller fees and help with the handoff.</td><td data-label="What to Consider">I pay among the highest dealer prices, but my offer will still be a little below the guitar's full retail market value.</td></tr>
        <tr><th scope="row">Consignment</th><td data-label="Why People Choose It">You may receive more if the guitar sells at the asking price.</td><td data-label="What to Consider">You pay a commission, and finding the right buyer usually takes several months. Some guitars remain on consignment for a year or longer.</td></tr>
        <tr><th scope="row">Auction</th><td data-label="Why People Choose It">Several bidders can compete for a rare or well-known guitar.</td><td data-label="What to Consider">The final price is uncertain, and seller fees, photography and shipping still matter.</td></tr>
        <tr><th scope="row">Reverb or eBay Listing</th><td data-label="Why People Choose It">You control the asking price and speak directly with buyers. Reverb also offers strong shipping protection.</td><td data-label="What to Consider">Factor in the fees and remember that disputes can favor the buyer. I wouldn't choose this for a first-time sale over $4,000.</td></tr>
        <tr><th scope="row">Music-Store Trade-In</th><td data-label="Why People Choose It">You can finish the deal in a local store without shipping the guitar.</td><td data-label="What to Consider">Trade-in offers are typically well under market because the store has overhead, resale costs and profit requirements.</td></tr>
      </tbody>
    </table>
    <aside class="smm-shipping-note" aria-label="A note on shipping insurance">
      <p class="smm-eyebrow">A Note On Shipping</p>
      <h3>Make Sure the Guitar Is Fully Covered</h3>
      <p>Whether you sell directly or consign the guitar, make sure the buyer or dealer carries the right insurance. Declared-value coverage from FedEx or UPS isn't enough for a high-dollar vintage instrument. My third-party Heritage insurance policy fully covers high-dollar shipments while they're in transit.</p>
    </aside>
    <div class="smm-selling-resources">
      <h3>More Help Before You Choose</h3>
      <ul>
        <li><a href="/sell-a-guitar-collection/">Sell a complete guitar collection to Joe</a></li>
        <li><a href="/post/how-to-sell-a-large-guitar-collection-every-option-honestly-explained/">Compare ways to sell a large guitar collection</a></li>
        <li><a href="/post/what-to-consider-when-selling-a-vintage-guitar/">What to consider before selling a vintage guitar</a></li>
        <li><a href="/post/mistakes-to-avoid-when-selling-a-vintage-guitar/">Mistakes to avoid when selling a vintage guitar</a></li>
        <li><a href="/post/best-online-platforms-sell-vintage-guitars/">Compare online platforms for selling a vintage guitar</a></li>
      </ul>
    </div>
  </section>

  <span class="smm-anchor" id="receive-the-highest-payout"></span>
  <section class="smm-section smm-guides" id="guitar-families">
    <header class="smm-heading"><p class="smm-eyebrow">Martin Models I Buy</p><h2>Vintage Martin Guitars I Buy</h2><p>I buy vintage Martin dreadnoughts, 0, 00, 000 and OM guitars from owners across the country. The cards below show some of the eras and models I'm looking for. If you don't see your Martin listed, send it anyway. I also buy unusual models, mandolins, <a href="/sell-a-guitar-collection/">complete guitar collections</a> and guitars with old repairs or changed parts.</p><a class="smm-text-link" href="#appraisal">Tell Me About Your Martin</a></header>
    <ul class="smm-guide-grid">
      {modelGuides.map((guide) => (
        <li class="smm-guide-card">
          <div class="smm-guide-card__image"><LicensedImage src={guide.image} alt={guide.imageAlt} width={620} loading="lazy" /></div>
