.bd-cta h2{color:#fff;font-size:clamp(38px,5vw,60px);margin-bottom:16px}.bd-cta>p:not(.bd-script){font-size:18px}.bd-cta>p a{color:#fff}.bd-cta>a{display:inline-block;margin-top:18px;padding:13px 28px;background:var(--cream);color:var(--rust-dark);font:600 16px/1 var(--font-display,Oswald),sans-serif;text-decoration:none;text-transform:uppercase}@media(max-width:900px){.bd-hero__copy{width:min(760px,85vw)}.bd-intro{grid-template-columns:1fr;padding:75px 0;gap:45px}}@media(max-width:760px){.bd-hero{height:auto;min-height:820px}.bd-hero__shade{background:linear-gradient(0deg,rgba(10,10,10,.95),rgba(10,10,10,.66) 56%,rgba(10,10,10,.1) 85%)}.bd-hero__copy{left:22px;bottom:45px;width:calc(100% - 44px)}.bd h1{font-size:clamp(42px,12vw,66px)}.bd-dek{font-size:18px}.bd blockquote{margin:45px 0;padding:30px 0}.bd-chapter,.bd-closing{padding:75px 0}.bd-guitar-grid,.bd-archive__grid{grid-template-columns:1fr}.bd-guitar-grid .bd-wide{grid-column:auto}.bd-guitar-grid figure :global(img),.bd-guitar-grid .bd-wide :global(img),.bd-archive__grid figure :global(img){height:auto;max-height:72vh}}
