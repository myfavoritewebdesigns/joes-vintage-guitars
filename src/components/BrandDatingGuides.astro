---
interface GuideLink {
  label: string;
  href: string;
}

interface Props {
  brand: "gibson" | "fender";
  featuredGuide?: GuideLink;
}

const { brand, featuredGuide } = Astro.props;
const brandName = brand === "gibson" ? "Gibson" : "Fender";

const baseGuides: Record<"gibson" | "fender", GuideLink[]> = {
  gibson: [
    { label: "Gibson Serial Number Lookup", href: "/how-to-read-gibson-serial-numbers/" },
    { label: "Gibson Pot Codes", href: "/gibson-pot-codes/" },
    { label: "Gibson Headstock Logos", href: "/gibson-headstock-logo-chronology/" },
    { label: "Gibson Knob Dating", href: "/gibson-knob-dating-guide/" },
    { label: "Gibson Tuner Dating", href: "/gibson-tuner-dating-guide/" },
    { label: "Gibson Physical Features And Hardware", href: "/gibson-physical-features-hardware-guide/" },
  ],
  fender: [
    { label: "Fender Serial Number Lookup", href: "/fender-guitars-serial-number-guide/" },
    { label: "Fender Neck Dates", href: "/fender-neck-dates/" },
    { label: "Fender Body Dates", href: "/fender-body-dates/" },
    { label: "Fender Pot Codes", href: "/fender-pot-codes/" },
    { label: "Fender Pickup Dates", href: "/fender-pickup-dates/" },
    { label: "Fender Physical Features", href: "/fender-physical-features/" },
  ],
};

const guides = featuredGuide ? [...baseGuides[brand], featuredGuide] : baseGuides[brand];
const headingId = `${brand}-dating-guides-heading`;
---

<section class="bdg" aria-labelledby={headingId}>
  <div class="bdg__inner">
    <p class="bdg__eyebrow">Serial Numbers, Parts And Features</p>
    <h2 id={headingId}>Use The {brandName} Dating Guides</h2>
    <p class="bdg__lede">Start with the serial number, then compare the parts and construction that fit this guitar.</p>
    <ul class="bdg__links">
      {guides.map((guide) => (
        <li>
          <a href={guide.href}>
            <span>{guide.label}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bdg {
    padding: 54px 0;
    background: var(--color-brand-cream-light, #f9f1de);
    border-block: 1px solid rgba(62, 42, 20, 0.16);
  }
  .bdg__inner {
    width: min(1100px, calc(100% - 40px));
    margin-inline: auto;
  }
  .bdg__eyebrow {
    margin: 0 0 8px;
    color: var(--color-brand-rust, #a03a1e);
    font: 700 13px/1.3 var(--font-display, "Oswald"), sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bdg h2 {
    margin: 0;
    color: var(--color-brand-brown, #3e2a14);
    font: 700 clamp(28px, 4vw, 42px)/1.12 var(--font-display, "Oswald"), sans-serif;
  }
  .bdg__lede {
    max-width: 760px;
    margin: 12px 0 24px;
    color: var(--color-brand-brown-warm, #60452d);
    font-size: 17px;
    line-height: 1.65;
  }
  .bdg__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bdg__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 54px;
    height: 100%;
    padding: 12px 15px;
    color: var(--color-brand-rust-dark, #682412);
    background: #fff;
    border: 2px solid rgba(160, 58, 30, 0.55);
    border-radius: 7px;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .bdg__links a:hover,
  .bdg__links a:focus-visible {
    color: #fff;
    background: var(--color-brand-rust-dark, #682412);
    border-color: var(--color-brand-rust-dark, #682412);
    outline: none;
  }
  .bdg__links svg {
    width: 19px;
    height: 19px;
    flex: 0 0 auto;
  }
  @media (max-width: 820px) {
    .bdg__links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .bdg { padding: 42px 0; }
    .bdg__inner { width: min(100% - 28px, 1100px); }
    .bdg__links { grid-template-columns: 1fr; }
    .bdg__links a { min-height: 52px; }
  }
</style>
