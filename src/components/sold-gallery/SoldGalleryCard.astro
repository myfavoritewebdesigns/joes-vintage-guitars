---
import LicensedImage from "../primitives/LicensedImage.astro";
import type { SoldGalleryEntry } from "../../lib/soldGallery";
import { soldGalleryHref } from "../../lib/soldGallery";
import { resolveImage } from "../../lib/images";

interface Props {
  entry: SoldGalleryEntry;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
const href = soldGalleryHref(entry);
const hero = resolveImage(entry.data.heroImage);
---

<article class="sg-card">
  <a class="sg-card__media" href={href} aria-label={`View ${entry.data.title} sold archive entry`}>
    {hero ? (
      <LicensedImage
        src={hero}
        alt={entry.data.heroImageAlt}
        width={760}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : "auto"}
      />
    ) : (
      <span class="sg-card__fallback" aria-hidden="true">JVG</span>
    )}
    <span class="sg-card__status">Sold</span>
  </a>
  <div class="sg-card__body">
    <p class="sg-card__eyebrow">{entry.data.year} · {entry.data.brand}</p>
    <h2><a href={href}>{entry.data.title}</a></h2>
    <p>{entry.data.excerpt}</p>
    <a class="sg-card__link" href={href}>View archive entry <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .sg-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e3d4b4;
    border-radius: 10px;
    box-shadow: 0 4px 18px rgba(62, 42, 20, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sg-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(62, 42, 20, 0.15); }
  .sg-card__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #2b1c12; }
  .sg-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .sg-card:hover .sg-card__media :global(img) { transform: scale(1.035); }
  .sg-card__status {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 6px 11px;
    background: var(--color-brand-rust-dark, #682412);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 999px;
    font-family: var(--font-display, Oswald), sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sg-card__fallback { display: grid; height: 100%; place-items: center; color: #fff; font-family: var(--font-display, Oswald), sans-serif; font-size: 2rem; }
  .sg-card__body { display: flex; flex: 1; flex-direction: column; gap: 10px; padding: 22px; }
  .sg-card__eyebrow { margin: 0; color: var(--color-brand-rust, #a03a1e); font-family: var(--font-display, Oswald), sans-serif; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .sg-card h2 { margin: 0; color: var(--color-brand-brown, #3e2a14); font-family: var(--font-display, Oswald), sans-serif; font-size: 1.55rem; line-height: 1.15; }
  .sg-card h2 a { color: inherit; text-decoration: none; }
  .sg-card h2 a:hover { color: var(--color-brand-rust, #a03a1e); }
  .sg-card__body > p:not(.sg-card__eyebrow) { margin: 0; color: #554631; font-size: 0.96rem; line-height: 1.6; }
  .sg-card__link { margin-top: auto; padding-top: 6px; color: var(--color-brand-rust, #a03a1e); font-family: var(--font-display, Oswald), sans-serif; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-decoration: none; text-transform: uppercase; }
  .sg-card__link:hover { color: var(--color-brand-rust-dark, #682412); text-decoration: underline; }
</style>
