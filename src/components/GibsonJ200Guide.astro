interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;

const eras = [
  ["1937", "The Custom Prototypes", "Singing cowboy Ray Whitley asked Gibson for a flat-top with the size and visual authority of the company's premier archtops. The first custom instruments were still experimental. Early body dimensions, neck joints, scales, bridges, and personalized inlays do not all match the later catalog standard."],
  ["1938", "The Super Jumbo Enters the Catalog", "Gibson advertised the new Super Jumbo at $200, the price of a Martin D-45. The production form used a spruce top, rosewood back and sides, a body about 17 inches wide, ornate binding, an ebony fingerboard, graduated crest inlays, a flowered guard, an open moustache bridge, and gold hardware."],
  ["1939 to 1940", "The Super Jumbo 200 Takes Shape", "The price became part of the name. Most examples settled into the familiar 17-inch outline and 25 1/2-inch scale. Prewar bridges can carry six individually adjustable threaded bone saddles, although straight-saddle examples and factory anomalies mean the bridge must be examined rather than dated from a checklist."],
  ["1941 to 1943", "The Wartime Transition", "The fingerboard changed from ebony to rosewood, tuner buttons changed, and the bridge moved toward a single conventional saddle. During 1941 and 1942 Gibson replaced the early double-X system with a lighter single-X pattern. The last documented wartime shipment left in 1943, followed by a production gap."],
  ["1947 to 1948", "The Maple J-200", "Postwar advertising called the model J-200, while factory labels could still read SJ-200. Maple replaced rosewood as the normal back and side wood, the headstock lost part of its earlier binding treatment and strap bracket, a natural finish joined sunburst, and body depth increased."],
  ["1952", "Double-X Bracing Returns", "Gibson deepened the body again and restored a wide double-X pattern with ladder bars and a long bridge plate. This is one reason a 1949 and a 1954 can sound and respond like different models even when the front appointments look close."],
  ["1954 to 1955", "The Label and Trim Change", "The J-200 name finally became normal on interior labels. The molded pickguard lost the engraved border on most examples, and laminated maple construction appears in the standard specification. Some earlier and later features overlap, so 1955 should be treated as a transition year rather than a clean dividing line."],
  ["1959", "Grovers and Larger Frets", "Gold Grover Rotomatic tuners replaced the familiar tulip-buttoned Klusons on many guitars, and larger fretwire arrived. The neck profile is also a useful period clue, but a reprofiled or refinished neck can erase it."],
  ["1961 to 1962", "The Closed Bridge and Adjustable Saddle", "The open moustache bridge gave way to a solid or closed version with four pearl bars. A metal Tune-o-matic saddle, a much larger bridge plate, bridge bolts, a larger neck block, and a suspended top brace appeared. Many of these braces and saddles were later removed in attempts to improve tone."],
  ["1963 to 1968", "Five-Piece Necks and Hardware Changes", "A five-piece maple neck and gold waffle-back or related enclosed tuners are common early in this period; Grovers returned by the late 1960s. Nut width, finish color, guard material, neck shape, and internal hardware can vary through the decade. Measure the guitar in hand."],
  ["1970 to 1984", "The Norlin Years and J-200 Artist", "Double-X bracing, larger bridge plates, volutes, and simplified production details define much of the period. The J-200 Artist used the Super Jumbo idea with a Dove-style bridge and its own trim. A rosewood J-250R and other high-spec relatives also appeared. Model names on labels matter here."],
  ["1985 to 1988", "Nashville Acoustic Production", "Kalamazoo closed in 1984. Limited acoustic production continued in Nashville before Montana production began. A period label can still carry a Kalamazoo address, so the serial ranking number and construction must be read with the paper label."],
  ["1989 to Early 1990s", "The Bozeman Restart", "Gibson's first Bozeman guitars shipped in July 1989. The new shop rebuilt the acoustic line around more traditional construction. Early Montana labels, low daily ranking numbers, maple selection, neck laminates, and bridge details give these guitars their own identity."],
  ["1990s to Today", "Standards, Studios, Reissues, and Custom Builds", "Gibson restored the SJ-200 name and has since used Standard, Studio, Original, Custom, Historic, Western Classic, Pre-War, signature, cutaway, and limited-edition forms. Those names can signal different woods, bracing, bridges, trim, electronics, and historical targets."],
];

const checks = [
  ["Establish the Exact Model Name", "Photograph the label, warranty card, packing list, and any factory certificate. J-200N can identify a natural finish, while Artist, Studio, Custom, Junior, Western Classic, and signature names can identify materially different guitars."],
  ["Read the Serial as One Clock", "Record the number exactly, including leading zeros, spacing, depth, ink or impression, and every nearby factory mark. Gibson reused and overlapped several 1960s and 1970s ranges, so a plausible number does not authenticate the guitar by itself."],
  ["Find the Factory Order Number", "On earlier guitars, inspect the neck block and interior surfaces with a mirror and low-angle light. A factory order number can provide a second date range, but faint ink, refinishing, and replaced neck blocks can hide or remove it."],
  ["Match the Label to the Period", "Check shape, paper color, border, wording, company address, typeface, handwritten fields, aging, glue line, and whether finish or dirt continues naturally around the edge. A convincing label can still be transplanted."],
  ["Identify the Body Woods", "Prewar standard examples used rosewood; postwar standard examples normally used maple. Figure alone does not prove solid construction. Inspect the edge, end grain, interior surface, center seam, back strip, and any exposed repair area."],
  ["Map the Bracing", "Use a mirror, light, or inspection camera to record single-X or double-X architecture, tone bars, scalloping, bridge plate, added top supports, loose braces, shaved braces, and later cleats. Internal changes carry more weight than a replaced pickguard."],
  ["Audit the Bridge and Bridge Plate", "Measure the bridge footprint, height, wood, open or closed ends, pearl bars, saddle type, pin layout, bolt pattern, glue line, and top distortion. Look inside for a matching plate and for plugged holes left by a conversion."],
  ["Read the Pickguard in Context", "Compare shape, thickness, flower artwork, border treatment, bevel, material, shrinkage, finish relationship, and footprint. Guards are frequently replaced, and an accurate reproduction does not make the rest of the guitar correct."],
  ["Inspect the Headstock and Neck", "Record logo style, crown position, binding, headstock outline, stinger, neck laminates, volute, nut width, scale, heel shape, truss rod cover, and finish continuity. A replaced neck can carry an original body into the wrong year."],
  ["Match Tuners to Their Footprints", "Plate shape, screw spacing, post diameter, bushing, button shape, plating wear, unused holes, and finish shadows must agree. Period-correct replacement tuners still need to be disclosed."],
  ["Test the Finish Story", "Inspect checking, color in protected areas, edge wear, pore fill, sanding, overspray lines, blacklight response, and finish inside serial impressions. Blacklight is useful evidence, but polish, contamination, repairs, and mixed lacquer layers can mislead."],
  ["Record Repairs Before Valuing", "Check neck angle, saddle height, bridge rotation, top belly, pickguard cracks, center seams, binding, heel gaps, neck resets, refrets, bridge-plate work, cleats, overspray, pickup installation, and endpin enlargement. Quality and disclosure matter as much as the repair label."],
];
