const values = [
  { title: "Model and Year", body: "The exact model, production period and factory configuration establish the starting point.", icon: "M4 19.5V4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-2Z M8 6h8 M8 10h8 M8 14h5" },
  { title: "Original Parts", body: "Pickups, electronics, tuners, bridge and other original hardware can make a large difference.", icon: "M14.7 6.3a1 1 0 0 0-1.4-1.4l-8 8a2 2 0 1 0 2.8 2.8l8-8a1 1 0 0 0-1.4-1.4Z M16 3l5 5 M3 21l4-1-3-3-1 4Z" },
  { title: "Finish and Color", body: "I check whether the finish is original and whether the color or configuration was unusual for that model.", icon: "M12 3l1.7 4.3L18 9l-4.3 1.7L12 15l-1.7-4.3L6 9l4.3-1.7L12 3Z M5 15l.8 2.2L8 18l-2.2.8L5 21l-.8-2.2L2 18l2.2-.8L5 15Z" },
