  { title: "Gibson Firebird I, III, V and VII", era: "1963 Through The 1970s", buying: "I buy reverse and non-reverse Firebirds, and I pay close attention to original banjo tuners, hardware and custom colors.", url: "/post/gibson-firebird-history-authentication-value/", action: "Read the Firebird guide", image: resolveImage("images/gibson-serial/gibson-nashville-bridge-on-firebird.jpg")!, imageAlt: "Vintage Gibson Firebird hardware" },
