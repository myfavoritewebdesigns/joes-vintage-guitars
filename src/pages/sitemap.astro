---
import { readdirSync, readFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { SITE_URL } from "../config/site";
import { getCategories } from "../lib/blog";
import {
  siteMapPages, siteMapGroupTitles, dynamicSiteMapRoutes, excludedSiteMapRoutes,
  fallbackSiteMapLabel, siteMapLabel, type SiteMapRoute,
} from "../lib/site-map-pages";

// Read paths and source without making page modules (and their CSS) dependencies.
const pagesDirectory = resolve(process.cwd(), 'src/pages');
const pageFiles = discoverPageFiles(pagesDirectory);

function discoverPageFiles(directory: string): string[] {
  // Traverse sorted directory entries to retain the glob's nested-page order.
  return readdirSync(directory, { withFileTypes: true, encoding: 'utf8' })
    .filter((entry) => !entry.name.startsWith('.') && entry.name !== 'node_modules')
    .sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0)
    .flatMap((entry) => {
      if (entry.isDirectory()) {
        return discoverPageFiles(join(directory, entry.name)).map((file) => `${entry.name}/${file}`);
      }
      return entry.isFile() && entry.name.endsWith('.astro') ? [entry.name] : [];
    });
}
// This checkout predates the expert route. If it is added, use its actual flag.
const claimModules = import.meta.glob<{ hasPendingFenderClaims: boolean }>(
  '/src/data/expert-pages/fender-claims.{ts,js}', { eager: true },
);
const hasPendingFenderClaims = Object.values(claimModules).some((m) => m.hasPendingFenderClaims);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id));
const postRoutes = new Set(posts.map((post) => `/post/${post.id}/`));
const routes = new Set<string>();
const branch = import.meta.env.CF_PAGES_BRANCH;
const isPreview = branch ? branch !== 'main' : import.meta.env.DEV;

function routeFromFile(file: string): string {
  const route = file.replace('/src/pages', '').replace(/\.astro$/, '').replace(/\/index$/, '');
  return route === '' ? '/' : `${route}/`;
}
function excluded(route: string): boolean {
  return excludedSiteMapRoutes.has(route)
    || /^\/(?:blog|category\/[^/]+)\/page\/\d+\/$/.test(route)
    || (route === '/fender-vintage-guitar-expert/' && hasPendingFenderClaims);
}
function sourceAllowsIndexing(source: string, route: string): boolean {
  const code = source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/<!--[\s\S]*?-->/g, '');
  if (/\bnoIndex(?:=\{true\}|(?=[\s/>])(?!=))/.test(code)) return false;
  if (/<meta\b[^>]*name=["']robots["'][^>]*content=["'][^"']*noindex/i.test(code)) return false;
  // Match the same environment gates used by these guide templates.
  if (/AcousticModelGuide\.astro/.test(code) && branch !== 'main') return false;
  if (/noIndex=\{isPreview\}/.test(code) && isPreview) return false;
  if (/Gap3Article\.astro/.test(code) && branch && branch !== 'main') return false;
  const canonical = code.match(/\bcanonical=["']([^"']+)["']/)?.[1]
    ?? code.match(/const canonical\s*=\s*["']([^"']+)["']/)?.[1];
  return !canonical || new URL(canonical, SITE_URL).href === new URL(route, SITE_URL).href;
}

for (const file of pageFiles) {
  const pattern = routeFromFile(`/src/pages/${file}`);
  const source = readFileSync(join(pagesDirectory, file), 'utf8');
  if (!sourceAllowsIndexing(source, pattern)) continue;
  if (!pattern.includes('[')) {
    if (!excluded(pattern)) routes.add(pattern);
    continue;
  }
  // Blog/category paths come from the same collection/archive data below.
  if (pattern.startsWith('/post/') || pattern.startsWith('/category/') || pattern.startsWith('/blog/page/')) continue;
  const matcher = new RegExp('^' + pattern.split(/(\[[^\]]+\])/)
    .map((part) => part.startsWith('[') ? '[^/]+' : part.replace(/[.*+?^$\{\}()|[\]\\]/g, '\\$&')).join('') + '$');
  const known = dynamicSiteMapRoutes.filter((route) => matcher.test(route));
  if (!known.length) {
    // New parameter routes must expose their route data without importing pages.
    throw new Error(`Add sitemap route data for ${file} to dynamicSiteMapRoutes.`);
  }
  for (const route of known) if (!excluded(route)) routes.add(route);
}

const groups = siteMapGroupTitles.map((title) => ({
  title,
  links: [...routes].filter((route) => !postRoutes.has(route))
    .filter((route) => (siteMapPages[route as SiteMapRoute]?.group ?? 'Other Pages') === title)
    .map((href) => ({ href, label: siteMapLabel(siteMapPages[href as SiteMapRoute]?.label ?? fallbackSiteMapLabel(href)) })),
})).filter((group) => group.links.length);

const categories = getCategories(posts).map((category) => {
  const categoryPosts = posts.filter((post) => post.data.category === category.slug);
  return {
    href: `/category/${category.slug}/`,
    name: siteMapLabel(categoryPosts[0]?.data.categoryName ?? category.name),
    posts: categoryPosts,
  };
});
const pageCount = groups.reduce((sum, group) => sum + group.links.length, 0);
console.log(`[html-sitemap] ${pageCount} pages, ${posts.length} posts, ${categories.length} category hubs, ${pageCount + posts.length + categories.length} links`);
---

<Layout
  title="Sitemap | Joe’s Vintage Guitars"
  description="A full list of pages on Joe's Vintage Guitars: sell-your-guitar pages, serial number guides, the blog, and more."
  canonical="/sitemap/"
>
  <section class="sm-title-bar">
    <div class="sm-inner"><h1>Sitemap</h1></div>
  </section>

  <section class="sm-body">
    <nav class="sm-inner sm-grid" aria-label="All site pages">
      {groups.map((g) => (
        <div class:list={["sm-group", { "sm-group--long": g.links.length > 24 }]}>
          <h2 class="sm-group__title">{g.title}</h2>
          <ul class="sm-list">
            {g.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="sm-group sm-blog">
        <h2 class="sm-group__title">Blog Posts</h2>
        {categories.map((category) => (
          <section class="sm-blog-category">
            <h3 class="sm-category__title">{category.name}</h3>
            <ul class="sm-list sm-post-list">
              <li><a href={category.href}>All {category.name} Posts</a></li>
              {category.posts.map((post) => (
                <li><a href={`/post/${post.id}/`}>{siteMapLabel(post.data.title)}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </nav>
  </section>
</Layout>

<style>
  .sm-inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .sm-title-bar {
    background: var(--color-brand-rust-dark, #682412);
    padding: 180px 24px 48px;
    text-align: center;
  }
  .sm-title-bar h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 56px);
    color: var(--color-brand-cream);
    line-height: 1.1;
  }
  .sm-body { background: #fff; padding: 52px 0 76px; }
  .sm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 36px 40px;
    align-items: start;
  }
  .sm-group__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-brand-rust-dark);
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-brand-rust-bright);
  }
  .sm-blog, .sm-group--long { grid-column: 1 / -1; }
  .sm-blog-category { margin-top: 28px; }
  .sm-category__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-brand-rust-dark);
    margin: 0 0 12px;
  }
  .sm-post-list, .sm-group--long .sm-list { columns: 260px; column-gap: 40px; }
  .sm-post-list li, .sm-group--long .sm-list li { break-inside: avoid; }
  .sm-list { list-style: none; margin: 0; padding: 0; }
  .sm-list li { margin-bottom: 9px; }
  .sm-list a {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-brand-rust);
    text-decoration: none;
    line-height: 1.4;
  }
  .sm-list a:hover { color: var(--color-brand-rust-bright); text-decoration: underline; }
</style>
