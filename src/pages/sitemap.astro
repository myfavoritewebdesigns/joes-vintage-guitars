---
import Layout from "../layouts/Layout.astro";

const groups = [
  {
    title: "Main Pages",
    links: [
      { label: "Home", href: "/" },
      { label: "About Joe", href: "/about-me/" },
      { label: "Free Vintage Guitar Appraisal", href: "/free-appraisal/" },
      { label: "Contact", href: "/contact-me/" },
      { label: "Blog", href: "/blog/" },
      { label: "Reverb Reviews", href: "/reverb-reviews/" },
    ],
  },
  {
    title: "Sell Your Guitar",
    links: [
      { label: "Sell My Fender Guitar", href: "/sell-my-fender-guitar/" },
      { label: "Sell My Gibson Guitar", href: "/sell-my-gibson-guitar/" },
      { label: "Sell My Martin Guitar", href: "/sell-my-martin-guitar/" },
      { label: "Sell My Gretsch Guitar", href: "/sell-my-gretsch-guitar/" },
      { label: "Sell My Guild Guitar", href: "/sell-my-guild-guitar/" },
      { label: "Sell My Rickenbacker Guitar", href: "/sell-my-rickenbacker-guitar/" },
      { label: "Sell My National Guitar", href: "/sell-my-national-guitar/" },
      { label: "Sell a Vintage D’Angelico Guitar", href: "/sell-your-vintage-dangelico-guitar-in-the-us/" },
      { label: "Sell an Amplifier or Effect", href: "/sell-an-amplifier-or-effect/" },
      { label: "Sell a Guitar Collection", href: "/sell-a-guitar-collection/" },
    ],
  },
  {
    title: "Serial Number Guides",
    links: [
      { label: "Fender Serial Number Guide", href: "/fender-guitars-serial-number-guide/" },
      { label: "How to Read Gibson Serial Numbers", href: "/how-to-read-gibson-serial-numbers/" },
      { label: "Martin Serial & Model Numbers", href: "/martin-serial-and-model-numbers/" },
      { label: "Rickenbacker Serial Numbers", href: "/rickenbacker-serial-numbers/" },
      { label: "Guild Serial Number Lookup", href: "/guild-serial-number-lookup/" },
      { label: "Gretsch Serial Number Lookup", href: "/gretsch-serial-number-lookup/" },
      { label: "Vintage Fender Amplifier Serial Numbers", href: "/vintage-fender-amplifier-serial-numbers-how-to-find-the-year/" },
    ],
  },
  {
    title: "Fender Dating Guides",
    links: [
      { label: "Fender Pot Codes", href: "/fender-pot-codes/" },
      { label: "Fender Neck Dates", href: "/fender-neck-dates/" },
      { label: "Fender Body Dates", href: "/fender-body-dates/" },
      { label: "Fender Pickup Dates", href: "/fender-pickup-dates/" },
      { label: "Fender Physical Features", href: "/fender-physical-features/" },
    ],
  },
  {
    title: "Value Guides",
    links: [
      { label: "Vintage Fender Stratocaster Value Guide", href: "/vintage-fender-stratocaster-value-guide/" },
      { label: "1956 Fender Stratocaster Value Guide", href: "/vintage-fender-stratocaster-value-guide/1956/" },
      { label: "Vintage Fender Telecaster Value Guide", href: "/vintage-fender-telecaster-value-guide/" },
      { label: "Vintage Gibson Les Paul Market Value Guide", href: "/vintage-gibson-les-paul-market-value-guide/" },
      { label: "Martin D-28, D-18 & D-45 Dreadnought Value Guide", href: "/martin-d-28-d-18-d-45-dreadnought-value-guide/" },
    ],
  },
  {
    title: "Services",
    links: [
      { label: "Instrument Repair", href: "/repair/" },
      { label: "Vintage Guitar Consignment", href: "/consignment/" },
    ],
  },
  {
    title: "Policies",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy/" },
      { label: "Refund & Returns Policy", href: "/refund_returns/" },
    ],
  },
];
---

<Layout
  title="Sitemap | Joe’s Vintage Guitars"
  description="A full list of pages on Joe's Vintage Guitars: sell-your-guitar pages, serial number guides, the blog, and more."
  canonical="/sitemap/"
>
  <section class="sm-title-bar">
    <div class="sm-inner"><h1>Sitemap</h1></div>
  </section>

  <section class="sm-body">
    <nav class="sm-inner sm-grid" aria-label="All site pages">
      {groups.map((g) => (
        <div class="sm-group">
          <h2 class="sm-group__title">{g.title}</h2>
          <ul class="sm-list">
            {g.links.map((l) => (
              <li><a href={l.href} set:html={l.label}></a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </section>
</Layout>

<style>
  .sm-inner { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .sm-title-bar {
    background: var(--color-brand-rust-dark, #682412);
    padding: 180px 24px 48px;
    text-align: center;
  }
  .sm-title-bar h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 56px);
    color: var(--color-brand-cream);
    line-height: 1.1;
  }
  .sm-body { background: #fff; padding: 52px 0 76px; }
  .sm-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 36px 40px;
    align-items: start;
  }
  .sm-group__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-brand-rust-dark);
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-brand-rust-bright);
  }
  .sm-list { list-style: none; margin: 0; padding: 0; }
  .sm-list li { margin-bottom: 9px; }
  .sm-list a {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-brand-rust);
    text-decoration: none;
    line-height: 1.4;
  }
  .sm-list a:hover { color: var(--color-brand-rust-bright); text-decoration: underline; }
</style>
