---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/primitives/PageHero.astro";
import Button from "../components/primitives/Button.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import { contact, hrefs } from "../config/site";
import martinD28 from "../assets/images/1959-martin-D-28-scaled.jpg";
import martinD18 from "../assets/images/sell-martin/1945-martin-d-18-1-1024x683.jpg";
import martinD45 from "../assets/images/sell-martin/martin-d-45-brazilian-rosewood-1024x682.jpg";
import martinNeckBlock from "../assets/images/sell-martin/Model-Name-Serial-Number-Martin-1024x683.jpg";
import martinD18Wear from "../assets/blog/martin-d18-history-value-guide/1951-martin-d18-play-wear.jpg";

const canonicalUrl = "https://www.joesvintageguitarsaz.com/martin-d-28-d-18-d-45-dreadnought-value-guide/";
const articleDescription = "2026 vintage Martin D-18, D-28 and D-45 values by era, plus model differences, Brazilian rosewood, bracing, originality, repairs and appraisal tips.";
const articleImage = "https://www.joesvintageguitarsaz.com/images/og/martin-d-28-d-18-d-45-dreadnought-value-guide.jpg";

const structuredData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Martin D-28, D-18 and D-45 Value Guide", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Martin D-28, D-18 and D-45 Dreadnought Value Guide",
    description: articleDescription,
    image: articleImage,
    datePublished: "2026-06-09",
    dateModified: "2026-09-18",
    inLanguage: "en-US",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: canonicalUrl,
    about: [
      { "@type": "Thing", name: "Vintage Martin D-18" },
      { "@type": "Thing", name: "Vintage Martin D-28" },
      { "@type": "Thing", name: "Vintage Martin D-45" },
      { "@type": "Thing", name: "Vintage acoustic guitar appraisal" },
    ],
  },
];

const models = [
  {
    name: "Martin D-18",
    image: martinD18,
    alt: "Original 1945 Martin D-18 mahogany dreadnought resting in its case",
    caption: "A 1945 Martin D-18 with the model’s restrained Style 18 appointments.",
    copy: "The D-18 pairs a spruce top with mahogany back and sides. It is usually the least expensive of these three models, but clean 1930s and wartime examples can still reach six figures.",
  },
  {
    name: "Martin D-28",
    image: martinD28,
    alt: "Original 1959 Martin D-28 rosewood dreadnought in its green-lined case",
    caption: "A 1959 D-28 with spruce top, rosewood body and Style 28 trim.",
    copy: "The D-28 uses rosewood back and sides and sits at the center of the vintage dreadnought market. Pre-1947 herringbone guitars bring the strongest prices, but 1950s and 1960s Brazilian-rosewood examples remain highly collectible.",
  },
  {
    name: "Martin D-45",
    image: martinD45,
    alt: "Martin D-45 dreadnought with pearl top border and fingerboard inlays",
    caption: "Style 45 pearl trim is unmistakable, but the neck-block stamp must still confirm the model.",
    copy: "The D-45 adds extensive pearl trim and Martin’s highest appointment level. Martin made only 91 before discontinuing the model in 1942, then returned it to production in 1968.",
  },
];

const drivers = [
  { t: "Age", b: "A 1937 scalloped-brace dreadnought and a 1967 guitar are not in the same market. Date the guitar from the neck-block serial, then confirm that its construction fits the year." },
  { t: "Model", b: "D-18s use mahogany back and sides. Vintage D-28s and D-45s use rosewood, and standard production changed from Brazilian to East Indian rosewood in 1969." },
  { t: "Originality", b: "The finish, top, bridge, bridge plate, braces, tuners, pickguard and hardware all matter. A replaced bridge is not the same deduction as a replacement top or full refinish." },
  { t: "Condition", b: "Cracks, loose braces, a shaved bridge, overspray and poor structural work affect value. A clean professional neck reset is normal maintenance on many old Martins, not automatic disqualification." },
  { t: "Provenance", b: "Original-owner photographs, receipts, correspondence and a documented repair history make a guitar easier to authenticate and can strengthen buyer confidence." },
];

const prices = [
  { m: "D-45 (pre-war, 1936 to 1942)", v: "$450,000 to $675,000" },
  { m: "D-45 (1968 to 1969)", v: "$35,000 to $55,000" },
  { m: "D-28 (pre-war, 1931 to 1944)", v: "$80,000 to $300,000" },
  { m: "D-28 (1944 to 1949)", v: "$19,000 to $80,000" },
  { m: "D-28 (1950 to 1959)", v: "$12,000 to $19,000" },
  { m: "D-28 (1960 to 1969)", v: "$6,000 to $11,500" },
  { m: "D-18 (pre-war, 1931 to 1944)", v: "$25,000 to $110,000" },
  { m: "D-18 (1944 to 1949)", v: "$12,000 to $45,000" },
  { m: "D-18 (1950 to 1959)", v: "$7,000 to $11,000" },
  { m: "D-18 (1960 to 1969)", v: "$3,000 to $6,000" },
];

const milestones = [
  { year: "1916 and 1931", title: "The Dreadnought Arrives", copy: "Martin developed the first Dreadnought for the Ditson company in 1916. Martin-branded D-18 and D-28 production followed in 1931, which is where the value table begins." },
  { year: "1934", title: "The 14-Fret Body Becomes Standard", copy: "Martin moved its Dreadnoughts to the longer-looking 14-fret neck layout in 1934. Earlier 12-fret examples are rare and need individual evaluation." },
  { year: "Late 1944", title: "Scalloped Bracing Ends", copy: "The wartime change from scalloped to straight bracing is one reason values can move sharply within the 1944 period. Do not price every 1944 guitar from one broad label." },
  { year: "1946", title: "The Original Herringbone Era Closes", copy: "The 1946 D-28 is a transition-year guitar and the last original-production year associated with herringbone top trim before the postwar Style 28 look took over." },
  { year: "1968", title: "The D-45 Returns", copy: "Martin reintroduced the D-45 after a production gap that began after 1942. A 1968 or 1969 D-45 belongs in a different market from one of the 91 pre-war examples." },
  { year: "1969", title: "Rosewood Changes", copy: "Martin ceased using complete Brazilian-rosewood back-and-side sets in standard production during 1969 and moved to East Indian rosewood. Serial number and wood identification both matter on a transition-year guitar." },
];

const deductions = [
  { issue: "Refinish, Overspray or Heavy Touch-Up", effect: "Original lacquer carries a major premium. The size of the deduction depends on how much finish was changed and whether the work hides other repairs." },
  { issue: "Replacement Top or Retop", effect: "The top contains the bridge, bracing and much of the guitar’s acoustic identity. A retop is a much larger change than routine maintenance." },
  { issue: "Replaced or Enlarged Bridge Plate", effect: "An oversized plate adds weight and changes the interior. Originality, footprint and the quality of any repair all affect the appraisal." },
  { issue: "Shaved or Replaced Bridge", effect: "A shaved bridge can signal an attempt to postpone a needed neck reset. A correct replacement is preferable to poor work but is still not the original part." },
  { issue: "Cracks and Brace Repairs", effect: "Location, length, stability and repair quality matter. A cleanly repaired side crack is not priced like a damaged top or a poorly repaired headstock." },
  { issue: "Changed Tuners, Pickguard or Hardware", effect: "Reversible changes usually cost less than altered wood or finish. Keep every original part with the guitar, even if it is no longer installed." },
  { issue: "Needed Neck Reset", effect: "High action with little saddle remaining creates a real repair expense. A well-executed, documented reset can improve saleability and usually carries less penalty than leaving the guitar unplayable." },
];

const steps = [
  { n: "01", title: "Read the Neck Block", copy: "Photograph the model and serial stamped inside the soundhole. Martin’s sequential serial chart establishes the year." },
  { n: "02", title: "Confirm the Specification", copy: "Check the body shape, tonewoods, bracing, trim, neck, bridge, pickguard and tuners against the model and year." },
  { n: "03", title: "Separate Maintenance From Modification", copy: "Document neck resets, refrets and crack repairs separately from refinishing, retopping, bridge-plate alteration or replaced braces." },
  { n: "04", title: "Inventory the Original Parts", copy: "Record the bridge, tuners, pickguard, pins, nut, saddle and case. Keep removed parts, receipts and repair invoices with the guitar." },
  { n: "05", title: "Compare the Right Market", copy: "Compare sold and offered guitars of the same model, era, originality and condition. A record price for a famous pre-war example is not a general price guide." },
];

const faqs = [
  { q: "How much is a vintage Martin D-18, D-28 or D-45 worth?", a: "For the 1931 to 1969 period covered here, excellent all-original examples range from about $3,000 for some 1960s D-18s to $675,000 for the strongest pre-war D-45s. The exact model, year, finish, originality, repairs, provenance and case determine where an individual guitar belongs." },
  { q: "Which is worth more: a Martin D-18, D-28 or D-45?", a: "As a general hierarchy, the D-45 is highest, followed by the D-28 and then the D-18. The exact year can overturn that simple order: a clean pre-war D-18 can be worth more than a much later D-28 or D-45." },
  { q: "What is the difference between a Martin D-18, D-28 and D-45?", a: "The D-18 has mahogany back and sides with restrained Style 18 trim. The D-28 uses rosewood with Style 28 appointments. The D-45 is also a rosewood dreadnought but adds Martin’s highest pearl and inlay treatment." },
  { q: "What does pre-war Martin mean?", a: "Sellers use pre-war loosely, so always ask for the exact serial-number year. In the dreadnought market, the phrase commonly points to the 1930s and wartime Golden Era guitars, especially the scalloped-brace production that ended during 1944." },
  { q: "How do I tell what year my Martin is?", a: "Find the serial number stamped on the neck block inside the body and match it to Martin’s sequential chart. The model is normally stamped on the same block. Use my <a href=\"/martin-serial-and-model-numbers/\">Martin serial number lookup</a> to check the year." },
  { q: "How can I tell Brazilian rosewood from East Indian rosewood?", a: "Start with the year. Martin stopped using complete Brazilian-rosewood back-and-side sets in standard production during 1969. Grain appearance can help, but photographs and serial context should be reviewed together before applying a Brazilian-rosewood premium." },
  { q: "Does a neck reset lower a vintage Martin’s value?", a: "A needed neck reset lowers the current value because the buyer inherits cost and uncertainty. A clean, correctly performed reset is accepted maintenance on many old Martins and usually matters less than a refinish, replacement top or altered bridge plate." },
  { q: "Should I restore or clean my Martin before an appraisal?", a: "Do not refinish it, replace parts, glue cracks or aggressively clean aged finish and hardware before an expert sees it. Save every loose part and case item. Clear photographs are enough to begin an appraisal." },
  { q: "What photos do I need for a Martin appraisal?", a: "Send the full front and back, both sides of the headstock, the neck-block model and serial, bridge and saddle, pickguard, tuners, case, visible cracks and every repaired area. Add interior bridge-plate and brace photos only if you can take them safely." },
];

const stripTags = (s: string) => s.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
structuredData.push({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: stripTags(f.a) },
  })),
});
---

<Layout
  title="Martin D-28, D-18 & D-45 Value Guide (2026)"
  description={articleDescription}
  canonical="/martin-d-28-d-18-d-45-dreadnought-value-guide/"
  ogImage={articleImage}
  ogImageAlt="Vintage Martin D-18, D-28 and D-45 dreadnought value guide"
  structuredData={structuredData}
>
  <PageHero
    eyebrow="2026 Value Guide"
    title="Martin D-28, D-18 & D-45 Dreadnought Value Guide"
    subhead="Current vintage Martin values by model and era, plus the construction, originality, repairs and provenance that set the final number."
    subheadTag="p"
    subheadHtml={true}
    bgImage="/images/hero-background.jpg"
  >
    <Button slot="cta" href={hrefs.tel} variant="cream" size="lg">{contact.phone}</Button>
    <Button slot="cta" href="/free-appraisal/" variant="cream" size="lg">Free Appraisal</Button>
  </PageHero>

  <section class="vg-section" id="quick-answer">
    <div class="vg-inner vg-intro">
      <div class="vg-intro__copy">
        <p class="vg-eyebrow">The Short Answer</p>
        <h2 class="vg-head">How Much Is a Vintage Martin Dreadnought Worth?</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-lede">
          An excellent, all-original vintage Martin D-18, D-28 or D-45 from 1931 through 1969 can be worth about
          <strong>$3,000 to $675,000</strong>. The model and year establish the starting range. Original finish,
          tonewoods, bracing, repairs, condition, provenance and the original case decide where the guitar falls inside it.
        </p>
        <p>
          That spread is wide because a 1960s D-18 and one of the 91 pre-war D-45s are completely different markets.
          Start by identifying the model and serial-number year, then evaluate the wood and construction before using
          any price. For an exact figure on your guitar, <a href="/free-appraisal/">get a free appraisal</a> and I’ll
          give you a straight answer.
        </p>
        <div class="vg-byline">
          <strong>Written and reviewed by <a href="/about-me/">Joe Dampt</a></strong>
          <span>Vintage guitar appraiser and buyer · 10,000+ instruments personally appraised</span>
          <span>Originally published June 9, 2026 · Updated September 18, 2026</span>
        </div>
        <nav class="vg-toc" aria-label="On this page">
          <strong>On This Page</strong>
          <ul>
            <li><a href="#models">D-18, D-28 and D-45</a></li>
            <li><a href="#price-table">Values by era</a></li>
            <li><a href="#era-changes">Important year changes</a></li>
            <li><a href="#value-factors">What sets the value</a></li>
            <li><a href="#deductions">Repairs and deductions</a></li>
            <li><a href="#appraisal-process">Appraisal process</a></li>
          </ul>
        </nav>
      </div>
      <figure class="vg-feature">
        <LicensedImage src={martinD28} alt="Original 1959 Martin D-28 dreadnought in its green-lined case" width={1200} loading="eager" decoding="async" fetchpriority="high" sizes="(max-width: 820px) 100vw, 48vw" />
        <figcaption>An original 1959 Martin D-28. The serial establishes the year; the rosewood body, finish, bridge, pickguard, tuners, condition and case all contribute to the appraisal.</figcaption>
      </figure>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="models">
    <div class="vg-inner">
      <p class="vg-eyebrow">Know the model first</p>
      <h2 class="vg-head">Finding Your Model and Year</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">The letter D identifies the dreadnought body. The number describes the style and appointment level, including the traditional wood family and trim. It is not a quality grade that can replace the exact year and condition.</p>
      <div class="vg-models">
        {models.map((model) => (
          <article class="vg-model-card">
            <figure>
              <LicensedImage src={model.image} alt={model.alt} width={760} loading="lazy" decoding="async" sizes="(max-width: 720px) 100vw, 33vw" />
              <figcaption>{model.caption}</figcaption>
            </figure>
            <div class="vg-model-card__body"><h3>{model.name}</h3><p>{model.copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vg-section" id="price-table">
    <div class="vg-inner">
      <h2 class="vg-head">Vintage Martin Dreadnought Values</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">These estimated current retail-market ranges are for excellent, all-original guitars with the original case. They are reference points, not automatic cash offers, auction predictions or insurance replacement values.</p>
      <p class="vg-note">Reviewed September 2026. The market moves, and the broad era rows contain important year-to-year differences. Early custom-order D-45s from 1933 to 1935 require individual research rather than a generic range.</p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of vintage Martin dreadnought values">
        <table class="vg-table">
          <caption>Estimated 2026 values for excellent, all-original Martin D-18, D-28 and D-45 dreadnoughts with the original case</caption>
          <thead><tr><th scope="col">Model and Era</th><th scope="col">Estimated Value</th></tr></thead>
          <tbody>{prices.map((price) => <tr><th scope="row">{price.m}</th><td>{price.v}</td></tr>)}</tbody>
        </table>
      </div>
      <aside class="vg-market-note"><strong>How to use the table:</strong> identify the exact year first, then move downward for changed finish, altered wood, missing parts, structural needs or weak documentation. Move upward only when the guitar’s originality, condition and provenance support it.</aside>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="era-changes">
    <div class="vg-inner">
      <p class="vg-eyebrow">Why the year matters</p>
      <h2 class="vg-head">The Martin Changes That Matter to Value</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">“Old Martin” is too broad for a useful appraisal. These milestones explain why prices can change sharply between guitars that look similar from the front.</p>
      <div class="vg-timeline">
        {milestones.map((item) => <article><span>{item.year}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div></article>)}
      </div>
      <p class="vg-source-note">
        Martin’s <a href="https://www.martinguitar.com/museum-behind-the-glass.html">museum history</a> identifies the 1916 Dreadnought origin, the 1931 D-18 and D-28 and the 1934 14-fret transition. Its <a href="https://www.martinguitar.com/blog-categories/from-the-factory/blog-072325-the-holy-grail-of-martin-guitars-a-closer-look-at-the-pre-war-d-45.html">pre-war D-45 history</a> confirms the 91-guitar total, and Martin’s <a href="https://www.martinguitar.com/faqs.html">official FAQ</a> dates the end of complete Brazilian-rosewood back-and-side sets in standard production to 1969.
      </p>
    </div>
  </section>

  <section class="vg-section" id="value-factors">
    <div class="vg-inner vg-value-layout">
      <div>
        <h2 class="vg-head">What Drives the Value</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-section-intro">I work from permanent construction details toward replaceable parts. The serial number establishes the year, but a serial number by itself cannot tell you whether the top, finish, bridge or braces are original.</p>
        <div class="vg-grid">{drivers.map((driver) => <article class="vg-card"><h3>{driver.t}</h3><p>{driver.b}</p></article>)}</div>
      </div>
      <figure class="vg-feature vg-feature--wear">
        <LicensedImage src={martinD18Wear} alt="Honest pick wear and finish checking on a 1951 Martin D-18" width={900} loading="lazy" decoding="async" sizes="(max-width: 900px) 100vw, 34vw" />
        <figcaption>Honest play wear on a 1951 D-18 is not the same thing as a refinish or structural damage. Condition has to be described, not reduced to whether the guitar looks new.</figcaption>
      </figure>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="deductions">
    <div class="vg-inner">
      <h2 class="vg-head">What Lowers a Vintage Martin’s Value?</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">The largest deductions come from missing original material, altered wood and work that is difficult to undo. Routine maintenance and irreversible modification should never be put in the same bucket.</p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of repairs and changes that affect vintage Martin value">
        <table class="vg-table vg-table--deductions">
          <caption>Common repairs, changes and condition issues that affect vintage Martin dreadnought values</caption>
          <thead><tr><th scope="col">Issue</th><th scope="col">Why It Matters</th></tr></thead>
          <tbody>{deductions.map((row) => <tr><th scope="row">{row.issue}</th><td>{row.effect}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="vg-note vg-note--after-table">Do not refinish, reglue, replace or aggressively clean anything before an appraisal. Keep loose tuners, bridge pins, pickguards, cases, receipts and repair invoices with the guitar.</p>
    </div>
  </section>

  <section class="vg-section" id="appraisal-process">
    <div class="vg-inner vg-appraisal-layout">
      <div>
        <p class="vg-eyebrow">Joe’s appraisal process</p>
        <h2 class="vg-head">How I Appraise a Vintage Martin Dreadnought</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <ol class="vg-steps">{steps.map((step) => <li><span>{step.n}</span><div><strong>{step.title}</strong><p>{step.copy}</p></div></li>)}</ol>
      </div>
      <div>
        <figure class="vg-feature vg-feature--stamp">
          <LicensedImage src={martinNeckBlock} alt="Martin model and serial number stamped on the neck block inside the soundhole" width={960} loading="lazy" decoding="async" sizes="(max-width: 900px) 100vw, 38vw" />
          <figcaption>Look through the soundhole toward the neck. Photograph the model and serial stamp without adding chalk, pencil or cleaner.</figcaption>
        </figure>
        <aside class="vg-photo-list">
          <h3>Photos to Send</h3>
          <ul><li>Full front and back</li><li>Both sides of the headstock</li><li>Model and serial on the neck block</li><li>Bridge, saddle and pickguard</li><li>Tuners, case and every loose part</li><li>Every crack, repair and refinished area</li></ul>
        </aside>
      </div>
    </div>
    <div class="vg-inner">
      <aside class="vg-cta-panel"><div><strong>Want the number for your Martin?</strong><span>Send clear photos for a free, no-obligation appraisal. You do not need to take the guitar apart.</span></div><a href="/free-appraisal/">Request a Free Appraisal</a></aside>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="selling-options">
    <div class="vg-inner">
      <h2 class="vg-head">Selling Your Vintage Martin</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <div class="vg-grid vg-grid--three">
        <article class="vg-card"><h3>Consign It</h3><p>I handle the photography, listing, authentication, buyer questions and insured transaction. <a href="/consignment/">Consignment</a> runs from as low as 8% on top-tier instruments.</p></article>
        <article class="vg-card"><h3>Sell It Outright</h3><p>Get a straightforward cash offer and payment up front, with me handling the rest. <a href="/sell-my-martin-guitar/">Sell your Martin to me</a> directly.</p></article>
        <article class="vg-card"><h3>Sell It Privately</h3><p>Price it from comparable guitars with the same year, originality and repairs. Disclose every issue and use a written agreement plus trackable, insured shipping.</p></article>
      </div>
    </div>
  </section>

  <section class="vg-section" id="related-guides">
    <div class="vg-inner">
      <h2 class="vg-head">Related Martin Guides</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <div class="vg-links">
        <a href="/martin-serial-and-model-numbers/"><strong>Martin Serial Number Lookup</strong><span>Find the production year from the neck-block serial.</span></a>
        <a href="/post/martin-d18-history-specs-authentication-value-guide/"><strong>Complete Vintage Martin D-18 Guide</strong><span>Year changes, specifications, authentication and values.</span></a>
        <a href="/post/one-family-1946-martin-d-28/"><strong>One-Family 1946 Martin D-28</strong><span>A documented herringbone transition-year guitar.</span></a>
        <a href="/post/one-owner-1955-martin-d28/"><strong>One-Owner 1955 Martin D-28</strong><span>Why family history and original-owner photographs matter.</span></a>
        <a href="/post/how-to-determine-the-value-of-your-old-martin-acoustic-guitar/"><strong>How to Value an Old Martin</strong><span>Apply the same appraisal logic beyond dreadnoughts.</span></a>
        <a href="/post/martin-0-00-000-history-authentication-value-guide/"><strong>Martin 0, 00 and 000 Guide</strong><span>Use this guide if the guitar is smaller than a dreadnought.</span></a>
      </div>
    </div>
  </section>

  <FAQ faqs={faqs} mainTitle="FAQs:" subTitle="Vintage Martin Dreadnought Values" sectionId="martin-dreadnought-faqs" />
  <ContactSection />
</Layout>

<style>
  .vg-inner { max-width: var(--container-site, 1100px); margin: 0 auto; padding: 0 24px; }
  .vg-section { background: #fff; padding: 64px 0; scroll-margin-top: 96px; }
  .vg-section--alt { background: var(--color-brand-cream-light, #f9f1de); }
  .vg-head { color: var(--color-brand-rust-dark); font-family: var(--font-display); font-size: clamp(26px, 3vw, 38px); font-weight: 700; line-height: 1.2; margin: 0; }
  .vg-rule { background: var(--color-brand-rust); height: 3px; margin: 14px 0 22px; width: 80px; }
