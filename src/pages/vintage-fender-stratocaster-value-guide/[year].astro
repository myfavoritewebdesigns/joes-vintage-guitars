---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/primitives/PageHero.astro";
import Button from "../../components/primitives/Button.astro";
import LicensedImage from "../../components/primitives/LicensedImage.astro";
import FAQ from "../../components/FAQ.astro";
import ContactSection from "../../components/ContactSection.astro";
import { contact, hrefs } from "../../config/site";
import {
  stratocasterYearGuides,
  type StratocasterYearGuide,
} from "../../data/stratocasterValueYears";

export function getStaticPaths() {
  return stratocasterYearGuides.map((guide) => ({
    params: { year: guide.year },
    props: { guide },
  }));
}

interface Props {
  guide: StratocasterYearGuide;
}

const { guide } = Astro.props;
const guideIndex = stratocasterYearGuides.findIndex((entry) => entry.year === guide.year);
const previousGuide = stratocasterYearGuides[guideIndex - 1];
const nextGuide = stratocasterYearGuides[guideIndex + 1];
const canonicalPath = `/vintage-fender-stratocaster-value-guide/${guide.year}/`;
const canonicalUrl = `https://www.joesvintageguitarsaz.com${canonicalPath}`;
const articleImage = "https://www.joesvintageguitarsaz.com/images/og/vintage-fender-stratocaster-value-guide-v2.png";
const articleDescription = guide.metaDescription;

const conditionBands = [
  { condition: "Excellent and all original", value: guide.standardRange, note: "The headline sunburst range, assuming the original case and a coherent, authenticated guitar." },
  { condition: "Very good and largely original", value: guide.veryGoodRange, note: "About 75% to 90% of the excellent range. Honest play wear, normal checking, or a professional refret can fit here when the finish and major parts remain original." },
  { condition: "Professional refinish", value: guide.refinishRange, note: "Often about 45% to 60% of a comparable original. The exact result depends on the remaining parts, quality of the work, and whether the body has been altered." },
  { condition: "Major parts mismatch", value: "Value component by component", note: "A replacement neck or body, extra routes, mixed-year parts, or uncertain provenance prevents a reliable whole-guitar comparison." },
];

const customColorAnswer = guide.customColorSummary
  ?? `An authenticated original factory custom color can place a ${guide.year} Stratocaster around ${guide.customRange}. The premium depends on the exact color, condition, originality, and strength of the finish evidence. A later refinish does not receive the factory custom-color premium.`;

const yearFaqs = [
  {
    q: `How much is a ${guide.year} Fender Stratocaster worth?`,
    a: guide.answer,
  },
  {
    q: `What should I check before buying or selling a ${guide.year} Stratocaster?`,
    a: `Confirm the neck, body, finish, electronics, hardware, and date evidence as a group. For ${guide.year}, start with this feature set: ${guide.marker}. No single feature proves the whole guitar is original.`,
  },
  {
    q: `Does a custom color make a ${guide.year} Stratocaster more valuable?`,
    a: customColorAnswer,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: yearFaqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Vintage Fender Stratocaster Value Guide", item: "https://www.joesvintageguitarsaz.com/vintage-fender-stratocaster-value-guide/" },
      { "@type": "ListItem", position: 3, name: guide.year, item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${guide.year} Fender Stratocaster Value Guide`,
    description: articleDescription,
    image: articleImage,
    datePublished: "2026-09-18",
    dateModified: "2026-09-18",
    inLanguage: "en-US",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: canonicalUrl,
    about: { "@type": "Thing", name: `${guide.year} Fender Stratocaster` },
  },
  faqSchema,
];
---

<Layout
  title={`${guide.year} Fender Stratocaster Value Guide: Price & Specs`}
  description={articleDescription}
  canonical={canonicalPath}
  ogImage={articleImage}
  ogImageAlt={`Vintage ${guide.year} Fender Stratocaster value guide`}
  structuredData={structuredData}
>
  <PageHero
    eyebrow={`Value Guide / ${guide.year}`}
    title={`${guide.year} Fender Stratocaster Value Guide`}
    subhead={`Current values, factory features, and the evidence that separates a real ${guide.year} Stratocaster from a mixed or modified guitar.`}
    subheadTag="p"
    bgImage="/images/hero-background.jpg"
  >
    <Button slot="cta" href={hrefs.tel} variant="cream" size="lg">{contact.phone}</Button>
    <Button slot="cta" href="/free-appraisal/" variant="cream" size="lg">Free Appraisal</Button>
  </PageHero>

  <div class="yv-page">
    <section class="yv-section" id="answer">
      <div class="yv-inner yv-lead-grid">
        <div>
          <p class="yv-eyebrow">The short answer</p>
          <h2>What Is a {guide.year} Fender Stratocaster Worth?</h2>
          <div class="yv-rule" aria-hidden="true"></div>
          <p class="yv-lede">{guide.answer}</p>
          <p>{guide.intro}</p>
          <p>{guide.marketContext}</p>
          <div class="yv-byline">
            <strong>Written and reviewed by <a href="/about-me/">Joe Dampt</a></strong>
            <span>Vintage guitar appraiser and buyer, with 10,000+ instruments personally appraised</span>
            <span>Published and reviewed September 18, 2026</span>
          </div>
        </div>
        <figure class="yv-feature">
          <LicensedImage
            src={guide.photo}
            alt={guide.photoAlt}
            width={1000}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            sizes="(max-width: 820px) 100vw, 44vw"
          />
          <figcaption>{guide.photoCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="yv-section yv-section--alt" id="values">
      <div class="yv-inner">
        <p class="yv-eyebrow">2026 market estimate</p>
        <h2>{guide.year} Stratocaster Values by Condition</h2>
        <div class="yv-rule" aria-hidden="true"></div>
        <p class="yv-intro">
          Start with the correct range, then adjust for what is actually present. These are retail-value estimates,
          not automatic cash offers or insurance replacement values. They assume a sunburst guitar unless the custom-color range is stated.
        </p>
        {guide.subRanges && (
          <div class="yv-subranges" aria-label={`${guide.year} Stratocaster specification sub-ranges`}>
            {guide.subRanges.map((band) => (
              <article>
                <h3>{band.label}</h3>
                <strong>{band.range}</strong>
                <p>{band.note}</p>
              </article>
            ))}
          </div>
        )}
        <div class="yv-table-wrap" tabindex="0" aria-label={`${guide.year} Fender Stratocaster values by condition`}>
          <table class="yv-table">
            <caption>Estimated 2026 values and adjustments for a {guide.year} Fender Stratocaster</caption>
            <thead>
              <tr><th>Condition and originality</th><th>Estimated value</th><th>How to use it</th></tr>
            </thead>
            <tbody>
              {conditionBands.map((band) => (
                <tr>
                  <th scope="row">{band.condition}</th>
                  <td><strong>{band.value}</strong></td>
                  <td>{band.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <aside class="yv-callout">
          <strong>Original factory custom colors are generally worth more than the standard sunburst finish when the paint is authentic.</strong>{" "}
          {guide.customColorSummary ?? `For ${guide.year}, the current custom-color estimate is ${guide.customRange}; it is not a fixed multiplier. Finish authentication, color scarcity, condition, and the rest of the guitar still control the result.`}{" "}
          <a href="/post/fender-custom-color-authentication-guide/">Read the Fender custom-color authentication guide</a> before applying a premium.
        </aside>
      </div>
    </section>

    <section class="yv-section" id="features">
      <div class="yv-inner">
        <p class="yv-eyebrow">Year-specific evidence</p>
        <h2>How to Identify a {guide.year} Stratocaster</h2>
        <div class="yv-rule" aria-hidden="true"></div>
        <p class="yv-intro">
          The fastest visual starting point for this year is <strong>{guide.marker}</strong>.
          That narrows the window; it does not authenticate the guitar by itself. The strongest conclusion comes from several independent details agreeing.
        </p>
        <div class="yv-card-grid">
          {guide.features.map((feature) => (
            <article class="yv-card">
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
        <p class="yv-more">
          For the full chronology, use the <a href="/fender-stratocaster-dating-guide/">Fender Stratocaster dating guide</a>.
          Then compare component codes with the <a href="/fender-guitars-serial-number-guide/">Fender serial number guide</a>,{" "}
          <a href="/fender-neck-dates/">neck-date guide</a>, and <a href="/fender-pot-codes/">pot-code guide</a>.
        </p>
      </div>
    </section>

    <section class="yv-section yv-section--alt" id="inspection">
      <div class="yv-inner yv-inspection-grid">
        <figure class="yv-detail">
          <LicensedImage
            src={guide.detailPhoto}
            alt={guide.detailAlt}
            width={1000}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 820px) 100vw, 45vw"
          />
          <figcaption>{guide.detailCaption}</figcaption>
        </figure>
        <div>
          <p class="yv-eyebrow">Before you set a price</p>
          <h2>Three Checks That Matter for {guide.year}</h2>
          <div class="yv-rule" aria-hidden="true"></div>
          <ol class="yv-checks">
            {guide.checks.map((check) => <li>{check}</li>)}
          </ol>
          <p>
            Do not remove a neck or loaded pickguard unless you know how to do it safely. Clear photos of the front,
            back, headstock, neck plate, case, and any visible repairs are enough to begin a <a href="/free-appraisal/">free appraisal</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="yv-section" id="example">
      <div class="yv-inner yv-narrow">
        <p class="yv-eyebrow">Worked example</p>
        <h2>How I Would Appraise a {guide.year} Stratocaster</h2>
        <div class="yv-rule" aria-hidden="true"></div>
        <p class="yv-lede">{guide.appraisalExample}</p>
        <p>
          This is an illustrative appraisal using the real guitars and details pictured on this site, not a claimed public sale record.
          I first place the guitar in the correct year and finish range, then adjust for originality, condition, repairs, case, and provenance.
          Asking prices can show seller expectations, but completed comparable sales and firsthand inspection carry more weight.
        </p>
        <p>
          The method is intentionally conservative: unusual artist ownership and auction outliers do not set the baseline for an ordinary guitar.
          Read the full <a href="/vintage-fender-stratocaster-value-guide/#methodology">valuation methodology</a> and{" "}
          <a href="/vintage-fender-stratocaster-value-guide/#deductions">deduction guide</a> before applying a headline number.
        </p>
      </div>
    </section>

    {guide.relatedGuides && (
      <section class="yv-section yv-section--alt" id="related-reading">
        <div class="yv-inner yv-narrow">
          <p class="yv-eyebrow">See the evidence on a real guitar</p>
          <h2>Related {guide.year} Stratocaster Guides</h2>
          <div class="yv-rule" aria-hidden="true"></div>
          <div class="yv-related-grid">
            {guide.relatedGuides.map((related) => (
              <a href={related.href}>
                <strong>{related.label}</strong>
                <span>{related.description}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="yv-section yv-section--dark" aria-labelledby="related-year-heading">
      <div class="yv-inner">
        <h2 id="related-year-heading">Compare Nearby Stratocaster Years</h2>
        <div class="yv-year-nav">
          {previousGuide && (
            <a href={`/vintage-fender-stratocaster-value-guide/${previousGuide.year}/`}>
              <span>Previous year</span>
              <strong>{previousGuide.year} Stratocaster guide</strong>
            </a>
          )}
          <a href="/vintage-fender-stratocaster-value-guide/">
            <span>All years</span>
            <strong>1954 to 1965 value guide</strong>
          </a>
          {nextGuide && (
            <a href={`/vintage-fender-stratocaster-value-guide/${nextGuide.year}/`}>
              <span>Next year</span>
              <strong>{nextGuide.year} Stratocaster guide</strong>
            </a>
          )}
        </div>
      </div>
    </section>

    <FAQ
      faqs={yearFaqs}
      mainTitle="FAQs:"
      subTitle={`${guide.year} Stratocaster Values`}
      sectionId={`${guide.year}-stratocaster-value-faqs`}
      headingLevel="h2"
    />
  </div>

  <ContactSection />
</Layout>

<style>
  .yv-inner { max-width: var(--container-site, 1100px); margin: 0 auto; padding: 0 24px; }
  :global(.jvgft__menu--sell a) { color: #2a2d33 !important; }
  .yv-narrow { max-width: 920px; }
  .yv-section { padding: 64px 0; background: #fff; }
  .yv-section--alt { background: var(--color-brand-cream-light, #f9f1de); }
  .yv-section h2 {
    margin: 0;
    color: var(--color-brand-rust-dark);
    font-family: var(--font-display);
    font-size: clamp(27px, 3.5vw, 42px);
    font-weight: 700;
    line-height: 1.12;
  }
  .yv-section p, .yv-section li, .yv-table {
    color: var(--color-brand-charcoal);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
  }
  .yv-section p { margin: 0 0 17px; }
  .yv-section a { color: var(--color-brand-rust); font-weight: 700; text-decoration: underline; }
  .yv-section a:hover { color: var(--color-brand-rust-bright); }
  .yv-eyebrow {
    margin-bottom: 8px !important;
    color: var(--color-brand-rust) !important;
    font-family: var(--font-display) !important;
    font-size: 14px !important;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .yv-rule { width: 76px; height: 3px; margin: 15px 0 24px; background: var(--color-brand-rust-bright); }
  .yv-lede { font-size: 18px !important; line-height: 1.65 !important; }
  .yv-intro { max-width: 900px; }
  .yv-lead-grid, .yv-inspection-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: start; }
  .yv-feature, .yv-detail { margin: 0; }
  .yv-feature :global(img), .yv-detail :global(img) { display: block; width: 100%; height: auto; }
  .yv-feature figcaption, .yv-detail figcaption {
    padding: 11px 13px;
    background: var(--color-brand-brown);
    color: #fff;
    font: 13px/1.5 var(--font-sans);
  }
  .yv-byline { display: grid; gap: 3px; margin-top: 26px; padding: 17px 18px; border-left: 4px solid var(--color-brand-rust-bright); background: var(--color-brand-cream-light); font: 14px/1.45 var(--font-sans); }
  .yv-byline span { color: var(--color-brand-charcoal); }
  .yv-table-wrap { margin-top: 28px; overflow-x: auto; border: 1px solid rgba(80, 49, 30, .22); background: #fff; }
  .yv-table { width: 100%; min-width: 760px; border-collapse: collapse; }
  .yv-table caption { padding: 12px 16px; color: var(--color-brand-charcoal); font-weight: 700; text-align: left; }
  .yv-table th, .yv-table td { padding: 15px 16px; border-top: 1px solid rgba(80, 49, 30, .17); text-align: left; vertical-align: top; }
  .yv-table thead th { background: var(--color-brand-rust-dark); color: #fff; font-family: var(--font-display); letter-spacing: .02em; }
  .yv-table tbody th { width: 24%; color: var(--color-brand-rust-dark); }
  .yv-subranges { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 27px; }
  .yv-subranges article { padding: 20px; border: 1px solid rgba(80, 49, 30, .2); border-top: 4px solid var(--color-brand-rust-bright); background: #fff; }
  .yv-subranges h3 { margin: 0 0 7px; color: var(--color-brand-rust-dark); font: 700 20px/1.25 var(--font-display); }
  .yv-subranges strong { display: block; margin-bottom: 8px; color: var(--color-brand-rust); font: 700 21px/1.2 var(--font-display); }
  .yv-subranges p { margin: 0; font-size: 14px; line-height: 1.55; }
  .yv-callout { margin-top: 22px; padding: 19px 21px; border-left: 5px solid var(--color-brand-rust-bright); background: #fff; color: var(--color-brand-charcoal); font: 16px/1.65 var(--font-sans); }
  .yv-card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 30px; }
  .yv-card { padding: 23px 21px; border-top: 4px solid var(--color-brand-rust-bright); background: var(--color-brand-cream-light); }
  .yv-card h3 { margin: 0 0 10px; color: var(--color-brand-rust-dark); font: 700 20px/1.2 var(--font-display); }
  .yv-card p { margin: 0; font-size: 15px; }
  .yv-more { margin-top: 28px !important; }
  .yv-checks { margin: 0 0 24px; padding: 0; list-style: none; counter-reset: steps; }
  .yv-checks li { position: relative; min-height: 43px; margin-bottom: 18px; padding-left: 55px; counter-increment: steps; }
  .yv-checks li::before { position: absolute; left: 0; top: 0; display: grid; width: 38px; height: 38px; place-items: center; border-radius: 50%; background: var(--color-brand-rust-dark); color: #fff; content: counter(steps); font: 700 18px var(--font-display); }
  .yv-related-grid { display: grid; gap: 14px; margin-top: 26px; }
  .yv-related-grid a { display: grid; gap: 5px; padding: 18px 20px; border: 1px solid rgba(80, 49, 30, .18); border-left: 5px solid var(--color-brand-rust-bright); background: #fff; text-decoration: none; }
  .yv-related-grid a:hover { border-color: var(--color-brand-rust-bright); }
  .yv-related-grid strong { color: var(--color-brand-rust-dark); font: 700 19px/1.25 var(--font-display); }
  .yv-related-grid span { color: var(--color-brand-charcoal); font: 14px/1.55 var(--font-sans); }
  .yv-section--dark { background: var(--color-brand-brown); }
  .yv-section--dark h2 { color: var(--color-brand-cream); }
  .yv-year-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 25px; }
  .yv-year-nav a { display: grid; gap: 5px; min-height: 92px; padding: 18px 20px; border: 1px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; }
  .yv-year-nav a:hover { border-color: var(--color-brand-cream); color: var(--color-brand-cream); }
  .yv-year-nav span { font: 700 12px/1.2 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  .yv-year-nav strong { font: 700 19px/1.25 var(--font-display); }
  @media (max-width: 900px) {
    .yv-lead-grid, .yv-inspection-grid { grid-template-columns: 1fr; }
    .yv-card-grid { grid-template-columns: repeat(2, 1fr); }
    .yv-year-nav { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .yv-section { padding: 48px 0; }
    .yv-card-grid, .yv-subranges { grid-template-columns: 1fr; }
  }
</style>
