const faqs = [
  {
    q: "Do I Have To Take My Guitar Apart To Read The Pot Codes?",
    a: "You need to see the back or the side of the potentiometers, which usually means taking off the pickguard or the metal control plate the knobs are mounted on. If you aren't comfortable doing that, don't force it. Get in touch and I'll help, or bring the guitar by and I'll read the codes for you.",
  },
