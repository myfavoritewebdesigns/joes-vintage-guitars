/**
 * Fender pot codes spoke, CONDENSED REBUILD.
 *
 * First of the hub-and-spoke method pages behind the condensed Fender serial
 * rebuild (see fender-guitars-serial-number-guide.astro). Deep-dives the potentiometer
 * date-code method the hub only summarizes, so the hub's "/fender-pot-codes/"
 * card now resolves.
 *
 * Content facts trace to Joe's live serial page and VG_FACTS.md (joes-vintage-
 * databases): VG-0047, VG-0048, VG-0099, VG-0100, VG-0101, VG-0102, plus new
 * VG-0113 (full EIA maker-code roster) and VG-0114 (Fender supplier timeline +
 * CBS bulk-buy lag), added in joes-vintage-databases PR #2.
 *
 * EXPANSION 2026-07-20: added the supplier-era table, the "week never exceeds 52"
 * part-number rule, values/tapers/shafts/thread-size, the control-cavity pass
 * (caps, wire, washers, ground buss, solder), and safe knob removal. Every
 * contested number was independently fact-checked before publishing; sources
 * were guitarhq.com/pots.html, schematicheaven.net/mods/datecodes.html,
 * vintageguitarandbass.com, premierguitar.com (Factory Telecaster Wirings Pt 1;
 * Mod Garage knobs/pots; grounding), precbsstratocasters.com, and Nacho Banos's
 * Blackguard Book as quoted on TDPRI. Claims DELIBERATELY EXCLUDED because the
 * check failed them: (a) "013" as a Fender internal code for Centralab (single
 * site, fuzzfaced.net, contradicted by every EIA list); (b) 500K pots on Wide
 * Range humbucker models (they were 1 Meg); (c) manufacturers "post-dating" pots
 * up to 18 months ahead of assembly (backwards; pots pre-date, never post-date);
 * (d) yellow cloth wire arriving "around 1965" (yellow is the bridge-pickup hot
 * lead from 1950 on); (e) a 12-gauge ground buss (it is roughly 18 to 20 AWG);
 * (f) Preh/Egen/Morganite import pot codes (Hofner/Vox/Framus parts, not Fender).
 * The CBS bulk buy is presented as ONE mid-60s purchase with a disputed year,
 * because no source documents two separately verified lots.
 *
 * MAKER-CODE NOTE: two fixes vs the live serial page's maker-code text LIST.
 * (1) It transposes Centralab and Stackpole (reads 304 = Centralab, 134 =
 * Stackpole); the correct pairing is 134 = Centralab, 304 = Stackpole. (2) It
 * lists 106 = Clarostat, but 106 is Allen-Bradley and Clarostat is 140
 * (guitarhq.com roster, VG-0113). This page uses the corrected values; the live
 * page text is flagged for a separate fix.
 */
import Layout from "../layouts/Layout.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { resolveImage, assetSrc, ogCardSize } from "../lib/images";
import { contact, hrefs, SITE_URL } from "../config/site";

const meta = (file: string) => resolveImage("images/fender-sn/" + file)!;
const img = (file: string) => assetSrc("images/fender-sn/" + file);

const PAGE_PATH = "/fender-pot-codes/";
const HUB_PATH = "/fender-guitars-serial-number-guide/";
const HUB_HREF = HUB_PATH;

// ---- Data ----
const makerRows = [
  ["134", "Centralab"],
  ["137", "CTS (Chicago Telephone Supply)"],
  ["140", "Clarostat"],
  ["304", "Stackpole"],
];
const dateRows = [
  ["3-Digit Date Code", "First digit is the last digit of the year. The next two digits are the week.", "137 8 25", "CTS, week 25 of 1958"],
  ["4-Digit Date Code", "First two digits are the last two of the year. The next two digits are the week.", "304 64 03", "Stackpole, week 3 of 1964"],
];
const supplierRows = [
  ["1949 to mid-1950", "CTS", "The earliest solid-body prototypes and the first Esquires, before the line really got going."],
  ["Mid-1950 to 1951", "Stackpole", "The blackguard years. Esquire, Broadcaster, and the Nocaster all normally carry stamped Stackpole pots."],
  ["Early 1952 to late 1953", "Clarostat", "A supply gap Fender filled with Clarostat. Look for ink-stamped markings instead of a stamp pressed into the metal."],
  ["1954 to early 1963", "Stackpole", "The golden era. Stratocasters, Telecasters, Precision Basses, and the offsets. Centralab pots are occasionally reported alongside them."],
  ["Early 1963 onward", "CTS", "Fender moved back to CTS just before CBS bought the company. It was never a clean cutover: Stackpole still turns up into 1964, and again through the late 1960s and early 1970s."],
];
const valueRows = [
  ["250K", "The Fender standard on single-coil guitars from 1950 on. Rolls a little top end off and keeps a single coil from turning harsh."],
  ["1 Meg", "The Jazzmaster carried 1 Meg from its debut, the Telecaster moved to it around 1969, and the 1970s Wide Range humbucker models used it too. Much brighter and more cutting, because far less signal bleeds off."],
  ["100K", "The earliest 1954 Stratocasters, on a solid brass shaft, before Fender settled on 250K around that September. Rare, and worth a second look if you find one."],
];
const capRows = [
  ["1949", "Prototypes", "Assorted paper and wax", "Whatever radio-grade parts Leo had on the bench. The control plate has no toggle switch yet."],
  ["1950 to 1952", "Broadcaster, Nocaster, early Telecaster", "One Cornell Dubilier tubular paper-foil, 0.05 MFD at 150V", "A brown wax-coated cardboard tube with black or blue lettering. It sits between the 3-way switch and the volume pot and rolls the treble off in the neck position."],
  ["1950 to 1952", "Esquire", "Three Cornell Dubilier tubular 0.05 MFD, plus a resistor", "The same brown waxed tubes, working with a large 2.5k carbon composition resistor usually wrapped in black tape. Together they fake a bassy neck-pickup tone on a guitar with only one pickup."],
  ["Late 1952 to 1953", "Telecaster, the dark circuit", "One phone book 0.1 MFD and one tubular 0.05 MFD", "Leo dropped the blend control for a real tone pot. The tubular 0.05 does the tone work. The flat rectangular 0.1 hangs off the switch to make the preset bass tone."],
  ["1954 to 1957", "Stratocaster", "Paper-in-oil phone book, 0.1 MFD", "Cornell Dubilier again, but now a flat squared-off block dipped in wax, with a seam down the face. It sits on top of the tone pot. The 1956 photo below is one."],
  ["1957 to 1961", "Stratocaster", "Paper-in-oil phone book, 0.1 MFD", "The same shape and value, white body instead of brown."],
  ["1961 to late 1960s", "Stratocaster", "Ceramic disc, 0.1 MFD", "A round wafer, ocher to yellow. Leftover paper-in-oil caps still turn up in early 1962, which is a normal Fender overlap."],
  ["1968 only", "Stratocaster", "Green polyester chicklet by Nissei", "A flat green block. Rare, collectors want them, and one should never be replaced without knowing what it is."],
  ["Around 1968 to 1970 onward", "Stratocaster", "Ceramic disc, 0.05 MFD", "Round and brighter yellow. Fender halved the value somewhere in here, so the tone control rolls off less."],
  ["Mid-1983 on", "Standard Stratocaster, two knob", "Smaller disc or film, 0.022 MFD", "The modern value, and the smallest of the group. It came in on the two-knob Standard rather than across the whole line at once."],
];

const tocItems: [string, string][] = [
  ["#what", "What A Pot Code Is"],
  ["#find", "Where To Find The Code"],
  ["#step1", "Step 1: The Maker Code"],
