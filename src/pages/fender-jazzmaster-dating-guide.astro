const JM = "fender-jazzmaster-evolution-guide-1958-1971";

const PAGE_PATH = "/fender-jazzmaster-dating-guide/";
const HUB_PATH = "/fender-guitars-serial-number-guide/";
const HUB_HREF = HUB_PATH;
const OG = `images/blog/${JM}/1959-fender-jazzmaster-gold-guard-full-front-scaled.jpg`;

// ---- Data ----
const yearRows: [string, string, string][] = [
  [
    "1958",
    "Launch year, and the Jazzmaster arrives as the most expensive guitar Fender made. It is the first Fender production guitar with a rosewood fingerboard, a full year ahead of the Telecaster and Stratocaster, and that board is a thick flat-bottomed slab with clay dots. The pickguard is gold anodized aluminum held on by nine screws. Alder body, three-color sunburst as standard, amber switch tip, no-line Kluson tuners, and a spaghetti logo that on the earliest examples carries no patent numbers at all.",
    "A gold anodized guard with nine screws. Nothing else in the line looked like it.",
  ],
  [
    "1959",
