---
import Layout from "../layouts/Layout.astro";
import { contact, hrefs } from "../config/site";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Text Message Terms", item: "https://www.joesvintageguitarsaz.com/terms/" },
    ],
  },
];
---
<Layout
  title="Text Message Terms | Joe’s Vintage Guitars"
  description="The terms for texting Joe's Vintage Guitars: replies only to people who text first, message frequency and rates, and how to text STOP or HELP."
  canonical="/terms/"
  structuredData={structuredData}
>
  <section class="legal-title-bar">
    <div class="legal-inner"><h1>Text Message Terms</h1></div>
  </section>
  <section class="legal-body">
    <div class="legal-inner legal-prose">
      <p>
        These terms cover texting with Joe’s Vintage Guitars (JOES VINTAGE GUITARS LLC) at the texting number
        shown on <a href="/">joesvintageguitarsaz.com</a>.
      </p>

      <h2>Text Messages</h2>
      <p>
        Joe’s Vintage Guitars texts you only in reply to a text you send first, about the guitar you asked about.
        I don’t send marketing or promotional texts, and I don’t text anyone who hasn’t texted me first.
      </p>

      <h2>Consent To Receive Replies</h2>
      <p>
        When you text the number on this site, you agree to receive replies from Joe’s Vintage Guitars about your
        guitar, such as questions about your photos or serial number, an offer, or shipping details. You give that
        consent directly to Joe’s Vintage Guitars. It isn’t part of any other agreement, and you don’t need to give
        it to buy or sell a guitar.
      </p>

      <h2>Message Frequency And Rates</h2>
      <p>
        Message frequency varies with the conversation. Message and data rates may apply.
      </p>

      <h2>STOP And HELP</h2>
      <p>
        Reply STOP at any time to opt out. You’ll get one text confirming it and no more texts after that. Reply
        HELP for help, or email me at <a href={hrefs.mailto}>{contact.email}</a>.
      </p>

      <h2>Carrier Liability</h2>
      <p>
        Carriers aren’t liable for delayed or undelivered messages.
      </p>

      <h2>Privacy</h2>
      <p>
        Your mobile number and your consent to receive texts are never shared, sold or bought by third parties or
        affiliates. The <a href="/privacy-policy/">Privacy Policy</a> explains how your number is handled.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal-inner { max-width: 820px; margin: 0 auto; padding: 0 24px; }
  .legal-title-bar {
    background: var(--color-brand-rust-dark, #682412);
    padding: 180px 24px 48px;
    text-align: center;
  }
  .legal-title-bar h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 56px);
    color: var(--color-brand-cream);
    line-height: 1.1;
  }
  .legal-body { background: #fff; padding: 48px 0 72px; }
  .legal-prose p,
  .legal-prose li {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-brand-charcoal);
  }
  .legal-prose p { margin: 0 0 18px; }
  .legal-prose h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    color: var(--color-brand-rust-dark);
    margin: 34px 0 12px;
  }
  .legal-prose a { color: var(--color-brand-rust); text-decoration: underline; }
  .legal-prose a:hover { color: var(--color-brand-rust-bright); }
  @media (max-width: 700px) {
    .legal-title-bar { padding: 120px 16px 36px; }
  }
</style>
