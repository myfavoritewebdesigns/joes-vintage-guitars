---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import BlogArchive from "../../../components/BlogArchive.astro";
import { SITE_URL } from "../../../config/site";
import {
  getPublishedPosts,
  getCategories,
  postsInCategory,
  paginate,
  categoryName,
  CATEGORY_META,
} from "../../../lib/blog";

export const getStaticPaths = (async () => {
  const allPosts = await getPublishedPosts();
  const cats = getCategories(allPosts);
  return cats.map((c) => {
    const pages = paginate(postsInCategory(allPosts, c.slug));
    return {
      params: { slug: c.slug },
      props: { posts: pages[0], current: 1, total: pages.length, slug: c.slug },
    };
  });
}) satisfies GetStaticPaths;

const { posts, current, total, slug } = Astro.props;
const allPosts = await getPublishedPosts();
const categories = getCategories(allPosts);
const name = categoryName(slug);
const intro = CATEGORY_META[slug]?.description;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
    { "@type": "ListItem", position: 3, name, item: `${SITE_URL}/category/${slug}/` },
  ],
};
---

<Layout
  title={`${name} | Joe's Vintage Guitars Blog`}
  description={intro || `${name} articles from Joe's Vintage Guitars.`}
  canonical={`/category/${slug}/`}
  structuredData={breadcrumbSchema}
>
  <BlogArchive
    heading={name}
    intro={intro}
    posts={posts}
    current={current}
    total={total}
    basePath={`/category/${slug}`}
    categories={categories}
    activeCategory={slug}
  />
</Layout>
