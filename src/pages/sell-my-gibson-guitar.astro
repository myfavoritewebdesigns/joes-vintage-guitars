  }
  .smg-process__card p + p { margin-top: 10px; }
  .smg-process__card a {
    color: var(--color-brand-rust-dark);
    text-decoration: underline;
    font-weight: 600;
  }
  /* Per-card divider — sits between H4 and body. Live measured at 231×3px,
