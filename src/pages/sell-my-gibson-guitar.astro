---
/**
 * /sell-my-gibson-guitar/ — Archetype A conversion page.
 *
 * Built from scratch (not cloned from sell-fender) per user instruction
 * 2026-05-26. The page uses the project's existing primitives (Layout,
 * Button, FAQ, ContactSection) but defines its own page chrome (.smg-*
 * prefix) because the hero hierarchy (small H1 eyebrow + big H2 display)
 * doesn't fit the standard PageHero primitive.
 *
 * Batches landed:
 *   - Batch 1 (2026-05-26): scaffold + hero + intro form + TOC
 *   - Batch 2 — Meet Joe + buying process (pending)
 *   - Batch 3 — Testimonials + IG embeds (pending)
 *   - Batch 4 — FAQ + closing CTAs + ContactSection + audits (pending)
 */

import Layout from "../layouts/Layout.astro";
import Button from "../components/primitives/Button.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import { contact, hrefs } from "../config/site";
import testimonialsRaw from "../../reference/testimonials.json";

// Reviews — pulled from reference/testimonials.json (Google Reviews scrape).
// Reordered so the Gibson-mentioning review (Randy Abercrombie's old Gibson
// bass) appears FIRST, since topical relevance helps a reader scanning a
// page about selling their Gibson. The other 5 are generic-positive
// experience reviews that work on any sell-* page.
const SCRAPE: { name: string; link: string; body: string }[] = testimonialsRaw;
const reviewOrder = ["Randy Abercrombie", "Jessica Hammond", "Caleb King", "Larry Hattier", "Bobbie Jo Kelly Greene", "Marie Coyle"];
const reviews = reviewOrder.map((n) => SCRAPE.find((r) => r.name === n)).filter(Boolean) as typeof SCRAPE;

// Instagram reels — Gibson-specific posts from live's sell-my-gibson page.
// IG's embed.js (loaded via the page head slot below) replaces these
// blockquotes with rendered IG iframes on the client.
const igPosts = [
  {
    permalink: "https://www.instagram.com/reel/DW6q8Ifk-OI/",
    headline: "Gibson A4 Mandolin",
    subtitle: "A lovely A4 mandolin, available now",
    body: "Gibson mandolins don’t come through every day. This A4 is a beauty: classic construction, great tone, and ready for a player who’ll appreciate it.",
  },
  {
    permalink: "https://www.instagram.com/reel/DWUJk_-E_zV/",
    headline: "1941 Gibson L-4",
    subtitle: "Carved top, warm tone, straight out of another era",
    body: "This 1941 L-4 is the classic archtop: rich, punchy, and woody in all the right ways. The carved top and decades of aging give it a sound you can’t fake.",
  },
  {
    permalink: "https://www.instagram.com/reel/DWjnH_6E3Hz/",
    headline: "Gibson J-45 in Madagascar Rosewood",
    subtitle: "Not your typical J-45: Madagascar rosewood back and sides",
    body: "All the classic warmth you’d expect from a J-45, with Madagascar rosewood adding a little more openness and detail. A rare take on a classic, and a really nice player.",
  },
];

// Live hero photo background — same B&W vintage-shop image the Fender page
// uses (verified by curl-ing live's CSS: both pages set
// `--awb-background-image:url(.../wp-content/uploads/2025/07/background.jpg)`
// on the `.tp-bnr` hero wrapper).
const HERO_BG = "https://www.joesvintageguitarsaz.com/wp-content/uploads/2025/07/background.jpg";

// Live's OG share image for this page (distinct from the hero bg).
const OG_IMAGE = "https://www.joesvintageguitarsaz.com/wp-content/uploads/2025/07/Sell-My-Gibson-Guitar.jpg";

// Gibson-specific serial-number dropdown options — copied verbatim from
// live's wpcf7 form so existing analytics dashboards keyed off these values
// continue to slot in cleanly post-migration.
const serialOptions = [
  "I'm not sure",
  "Four to Six Digits (with no MADE IN USA stamp underneath)",
  "Six Digits with MADE IN USA: 1970-1975",
  "It starts with a letter",
  "Eight Digits: 1976 through 2014",
  "Nine Digits: 2014 to now",
];

// Table-of-Contents anchors — order + slugs MUST match live so any external
// link to a section deep-links correctly. (Same parity rule that motivated
// the v9 meet-joe anchor ID fix on sell-fender.)
const toc: { href: string; label: string }[] = [
  { href: "#meet-connoisseur-joe-dampt",  label: "Meet Joe Dampt, Connoisseur of Gibson Guitars" },
  { href: "#how-to-sell-your-guitar",     label: "How To Sell Your Vintage Gibson Guitar" },
  { href: "#how-much-is-my-gibson-guitar",label: "How Much Is My Gibson Guitar Worth?" },
  { href: "#best-way-to-sell",            label: "What Is the Best Way To Sell A Vintage Gibson Guitar?" },
  { href: "#my-guitar-buying-process",    label: "My Guitar Buying Process" },
  { href: "#our-clients-testimonials",    label: "Our Clients’ Testimonials" },
  { href: "#find-out-gibson-really-worth",label: "Find Out What Your Gibson Les Paul Guitar is Really Worth at Joe’s Vintage Guitars" },
  { href: "#consider-selling-your-guitar",label: "Consider Selling Your Vintage Guitar To Joe’s Vintage Guitars" },
  { href: "#receive-the-highest-payout",  label: "Receive The Highest Payout For Your Vintage Gibson Guitars" },
  { href: "#faqs-about-gibson",           label: "FAQs About Vintage Gibson Guitars" },
  { href: "#receive-free-consultation",   label: "Receive a Free Vintage Guitar Consultation at Joe’s Vintage Guitars!" },
];

// FAQ data — 8 Q+A pairs matching live's accordion. IDs use live's exact
// wpcf7-generated `toggle_*` hex values so external anchor links to this
// page survive the migration (same parity rule that motivated the v9
// meet-joe anchor-ID fix on sell-fender). Q1-Q5 schema-tracked, Q6-Q8 visible-only.
const faqs = [
  {
    id: "toggle_4935d3b16920aa1b2",
    q: "What Are the Key Factors That Determine the Value of a Gibson Guitar?",
    a: "Condition, rarity, and originality are the big ones. I look at each carefully so your Gibson gets an accurate, fair appraisal.",
  },
  {
    id: "toggle_d073b93a144bbc99e",
    q: "What Documentation Is Necessary for Valuing a Vintage Gibson Guitar?",
    a: "Purchase receipts, repair records, and anything showing the guitar&rsquo;s history all help. The more you have, the more thorough and accurate the appraisal.",
  },
  {
    id: "toggle_79483ce4be1a16f44",
    q: "Are There Certain Gibson Guitar Models That Are Especially In Demand?",
    a: "Yes. Les Pauls and SGs from the &rsquo;50s and &rsquo;60s are in the highest demand. I collect, buy, and appraise these models regularly, so I know the market for them.",
  },
  {
    id: "toggle_6a051cc3fa698c41a",
    q: "How Does the Value Compare Between Vintage Gibson Les Pauls and SGs?",
    a: "It depends on age, condition, and rarity. I appraise each guitar on its own so the price reflects the real differences between a vintage Les Paul and an SG.",
  },
  {
    id: "toggle_ab440da3f25cda912",
    q: "What Qualities Should I Seek in an Appraiser for Evaluating My Vintage Gibson Guitar?",
    a: "Look for someone who knows vintage Gibsons, has a solid reputation, and can point to references. I&rsquo;ve spent years doing this and stand behind every valuation I give.",
  },
  {
    id: "toggle_497286b147f79ec18",
    q: "How does a headstock repair or refinish affect my Gibson&rsquo;s value?",
    a: "A headstock crack or a full refinish usually drops the value about 50% compared to a clean, original example. Even so, these are still great players, and I&rsquo;m always a buyer for player-grade Gibsons with a story. I&rsquo;ll give you a fair price that reflects the original parts that remain.",
  },
  {
    id: "toggle_d7562c8058c15cfc5",
    q: "How can I safely ship a high-value vintage guitar to you?",
    a: "Shipping a valuable guitar can be nerve-wracking, so I handle the logistics for you. I&rsquo;ll give you clear packing instructions and can usually send fully insured, prepaid shipping labels. Your guitar stays protected from the moment it leaves your door until it reaches me for the final evaluation.",
  },
  {
    id: "toggle_1d50ca075afe79547",
    q: "Will changing the strings or cleaning my vintage Gibson lower its value?",
    a: "Changing strings is normal maintenance and won&rsquo;t hurt the value, but I&rsquo;d actually rather you didn&rsquo;t clean or polish the guitar before I see it. Modern polishes can react with old nitrocellulose finishes or strip the natural patina collectors look for. It&rsquo;s best to leave it in as-found condition. The dust and grime of 50 years often tell a story of authenticity that I like to see.",
  },
];

// 8 Gibson model-type cards for the "Receive The Highest Payout" section.
// Copy verbatim from live (with one tiny normalization: stripped the
// trailing-space-before-comma typos like "Goldtops ,").
const gibsonModels = [
  { title: "Gibson Les Paul",     body: "Buying 1950s Goldtops, Bursts, and Customs. I pay premium market value for original PAF-equipped Les Pauls and 1960s Standards." },
  { title: "Gibson SG",           body: "Buying early 1960s SG Standards and Customs with sideways or Lyre vibrolas. I pay well for clean, original-finish vintage SGs." },
  { title: "Gibson ES",           body: "Buying ES-330, ES-335, ES-345, and ES-355 thinlines. I know the golden-era Super 400 and L-5 archtops well." },
  { title: "Gibson Flying V",     body: "Looking for rare Korina Flying V models and late-&rsquo;60s reissues. I pay cash for these collectible instruments." },
  { title: "Gibson Explorer",     body: "Buying vintage Korina Explorers and 1970s models. I know how rare these &lsquo;Modernistic&rsquo; series guitars are." },
  { title: "Gibson Firebird",     body: "Buying all vintage reverse and non-reverse Firebird I, III, V, and VII models. I pay extra for original banjo tuners and custom-color finishes." },
  { title: "Gibson Acoustic",     body: "Strong offers on pre-war J-45s, J-200s, and Advanced Jumbos. I know the rare &lsquo;Banner&rsquo; era acoustics, vintage flat-tops, and Gibson jazz archtops." },
  { title: "Gibson Bass Guitars", body: "Buying EB-0, EB-3, and vintage Thunderbird basses. I appreciate the history of Gibson&rsquo;s 1950s and &rsquo;60s basses." },
];

// Page-level structured data — BreadcrumbList + FAQPage (5 schema-curated Qs).
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home",                  item: "https://www.joesvintageguitarsaz.com/" },
    { "@type": "ListItem", position: 2, name: "Sell My Gibson Guitar", item: "https://www.joesvintageguitarsaz.com/sell-my-gibson-guitar/" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.slice(0, 5).map((f) => ({
    "@type": "Question",
    name: f.q.replace(/&[a-z]+;/g, (s) => ({ "&rsquo;": "’", "&ldquo;": "“", "&rdquo;": "”", "&amp;": "&" }[s] ?? s)),
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a.replace(/&[a-z]+;/g, (s) => ({ "&rsquo;": "’", "&ldquo;": "“", "&rdquo;": "”", "&amp;": "&", "—": "—" }[s] ?? s)),
    },
  })),
};

const structuredData = [breadcrumbSchema, faqSchema];
---

<Layout
  title="Sell My Gibson Guitar | Joe's Vintage Guitars"
  description="Looking to sell a vintage Gibson? Get a free professional appraisal and a top-dollar cash offer today. We buy Les Pauls, ES-335s, acoustics, and rare collections."
  canonical="/sell-my-gibson-guitar/"
  ogImage={OG_IMAGE}
  ogImageAlt="Sell My Gibson Guitar, Joe's Vintage Guitars"
  ogType="website"
  structuredData={structuredData}
>

  {/* lite-youtube web component (paulirish/lite-youtube-embed) — for the
      Meet Joe Connoisseur video below. Renders YouTube thumbnail + red play
      button instantly, swaps to iframe on click. Same component live uses. */}
  <link  slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.css" />
  <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.js" defer></script>

  {/* Instagram embed script — scans every `.instagram-media` blockquote
      and renders it as a styled IG iframe. Same script live uses. */}
  <script slot="head" is:inline async src="https://www.instagram.com/embed.js"></script>

  {/* ───────────────────────────────────────────────────────────────
       1. HERO — photo bg + dark vignette + small H1 eyebrow + big H2.

       Live's quirk: H1 is the SMALL gold "Sell Your Vintage Gibson Guitar"
       label (decorative side-bars via `separa-white.png.webp`), H2 is the
       BIG display "Expert In Acquiring..." headline. This inverts what
       most pages do but is the spec for both sell-fender and sell-gibson
       on the live site. Custom hero (not PageHero primitive) because
       PageHero assumes small-eyebrow + big-H1, the opposite hierarchy.
       ─────────────────────────────────────────────────────────────── */}
  <section class="smg-hero" style={`background-image: url('${HERO_BG}');`}>
    <div class="smg-hero__vignette" aria-hidden="true"></div>
    <div class="smg-hero__inner">
      <h1 class="smg-hero__eyebrow"><span>Sell Your Vintage Gibson Guitar</span></h1>
      <h2 class="smg-hero__title">Expert In Acquiring and Collecting Rare &amp; Vintage Gibson Guitars</h2>
      <div class="smg-hero__sep" aria-hidden="true"></div>
    </div>
  </section>

  {/* ───────────────────────────────────────────────────────────────
       2. INTRO + FORM + TOC
       Left column: H2 "Sell Your Vintage Gibson Guitar Today!" + 2
       paragraphs of intro copy + the TOC `<details>` widget (collapsible).
       Right column: dark-rust form panel with Gibson serial-number
       dropdown + name/email/phone/message.

       Form submission uses the shared `data-jvg-contact-form` handler at
       src/scripts/contact-form.ts. `data-form-id="sell-my-gibson"` lets
       the Mailgun-bound endpoint route this form's submissions correctly.
       ─────────────────────────────────────────────────────────────── */}
  <section class="smg-intro">
    <div class="smg-intro__inner">

      <div class="smg-intro__copy">
        <img
          src="https://www.joesvintageguitarsaz.com/wp-content/uploads/2024/06/Guitar22.png"
          alt=""
          aria-hidden="true"
          width="344"
          height="382"
          class="smg-intro__guitar-img"
          loading="lazy"
          decoding="async"
        />
        <div class="smg-intro__text">
          <h2 class="smg-intro__h2">Sell Your Vintage Gibson Guitar Today!</h2>
          <p>
            Looking for the best place to sell a vintage Gibson?
            <strong> You&rsquo;ve found a buyer who knows the history and craftsmanship of these guitars</strong>.
            Whether you have a 1950s Sunburst Les Paul, a vintage SG, or a classic ES-335, I&rsquo;m a private cash buyer, and I especially want the
            Super 400, L-5, and ES-355 models.
            <strong> To me they&rsquo;re not just instruments. They&rsquo;re something special</strong>.
            I&rsquo;ll walk you through what your Gibson is worth with a free appraisal, no run-around. Skip the auctions and consignment shops.
            I make fair cash offers on the spot for original-spec Gibson electrics and acoustics.
          </p>
          <p>
            Ready to sell? Contact me today for a no-obligation valuation. Call or text
            <strong> {contact.phone}</strong> or email
            <a href={hrefs.mailto}><strong> {contact.email}</strong></a> and you&rsquo;ll talk to me directly. I&rsquo;ll make sure your Gibson ends up
            somewhere it&rsquo;ll be played and looked after.
          </p>

          <details class="smg-toc">
            <summary class="smg-toc__summary">
              <span class="smg-toc__title">Table Of Contents</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <ul class="smg-toc__list">
              {toc.map((t) => (<li><a href={t.href}>{t.label}</a></li>))}
            </ul>
          </details>
        </div>
      </div>

      <div class="smg-intro__formwrap">
        <header class="smg-intro__formhead">
          <h3><span class="smg-intro__formhead-em">Feel Free To Contact</span> Joe&rsquo;s Vintage Guitars</h3>
          <h4>For A Free Gibson Guitar Consultation &amp; Appraisal Today!</h4>
        </header>
        <form data-jvg-contact-form data-form-id="sell-my-gibson" class="smg-form" novalidate>
          <label class="smg-form__field smg-form__field--full">
            <span class="smg-form__label">What information can the serial number tell us? Look on the back of the neck at the top or on the inside of the body.*</span>
            <select name="serial-number" required class="smg-form__input">
              <option value="">Please choose an option</option>
              {serialOptions.map((opt) => (<option value={opt}>{opt}</option>))}
            </select>
          </label>

          <label class="smg-form__field">
            <span class="smg-form__label">Name*</span>
            <input type="text"  name="your-name"  required maxlength="400" autocomplete="name"  class="smg-form__input" />
          </label>

          <label class="smg-form__field">
            <span class="smg-form__label">Email*</span>
            <input type="email" name="your-email" required maxlength="400" autocomplete="email" class="smg-form__input" />
          </label>

          <label class="smg-form__field">
            <span class="smg-form__label">Phone*</span>
            <input type="tel"   name="your-phone" required maxlength="400" autocomplete="tel"   class="smg-form__input" />
          </label>

          <label class="smg-form__field smg-form__field--full">
            <span class="smg-form__label">How Can We Help?</span>
            <textarea name="your-message" rows="4" maxlength="2000" class="smg-form__input"></textarea>
          </label>

          {/* Honeypot — see CLAUDE.md "Contact form endpoint" section. Off-screen,
              tabindex=-1, no autocomplete. Server-side, /api/contact silently
              drops any submission with this field non-empty. */}
          <input
            type="text"
            name="_honeypot"
            tabindex="-1"
            autocomplete="off"
            class="smg-form__honeypot"
            aria-hidden="true"
          />

          <button type="submit" class="smg-form__submit">Send</button>
          <p class="smg-form__status" data-jvg-form-status aria-live="polite"></p>
        </form>
      </div>

    </div>
  </section>

  {/* ───────────────────────────────────────────────────────────────
       3. MEET JOE DAMPT, CONNOISSEUR (live's #meet-connoisseur-joe-dampt)

       Spec sourced directly from live's `getComputedStyle` (no reference to
       sell-fender per user instruction 2026-05-26 — that section had quality
       issues we don't want to re-inherit). Live's measured values:
         - Section bg: cream (#eedfc0), padding 100px 30px 120px
         - Row max-width 1144px
         - .smg-meet__row::before  = WHITE CARD (101% wide, 120% tall,
           top -10%, drop-shadow 1px 2px 9px rgba(0,0,0,0.61))
         - .smg-meet__row::after   = RUST TRIANGLE (100px wide, 120% tall,
           top -10%, polygon(0 0, 0 100%, 100% 50%), rust-dark bg)
         - .smg-meet__video::before = OUTLINED RUST FRAME (100px wide,
           110% tall, top -5%, 4px solid rust-bright, left -30px)
         - H3 "Oswald Semibold" 30px rust-dark, NOT uppercased
         - HR .smg-meet__sep = 3px tall, 100% column width, rust-dark bg
         - YouTube video id: fTpIquyV-j8 (Gibson-specific intro video)
         - lite-youtube params unioned: live's autoplay/wmode/jsapi +
           rel=0/modestbranding (matches v9 sell-fender Meet Joe params)
       ─────────────────────────────────────────────────────────────── */}
  <section id="meet-connoisseur-joe-dampt" class="smg-meet">
    <div class="smg-meet__inner">
      <div class="smg-meet__row">
        <div class="smg-meet__video">
          <lite-youtube
            videoid="fTpIquyV-j8"
            params="wmode=transparent&autoplay=1&enablejsapi=1&rel=0&modestbranding=1"
            title="Meet Joe Dampt, Connoisseur of Gibson Guitars"
            class="smg-lite-yt"
          ></lite-youtube>
        </div>
        <div class="smg-meet__panel">
          <h3 class="smg-meet__title">Meet Joe Dampt, Connoisseur <span class="smg-meet__name">of Gibson Guitars</span></h3>
          <hr class="smg-meet__sep" />
          <p>
            Hello! <strong><a href="/about-me/">I&rsquo;m Joe</a>,</strong> and <strong>I&rsquo;d like to hear the story behind your guitar</strong>.
            Whether it&rsquo;s a family heirloom or a guitar you&rsquo;ve played on stage for years, every vintage Gibson has its own history.
            I&rsquo;ve been collecting and buying these for a long time, and I want to keep that history going.
            <strong>I treat every vintage Les Paul, ES-335, and archtop with respect, and I make sure it goes to a home where it&rsquo;ll get played.</strong>
          </p>
          <p>
            Don&rsquo;t settle for a generic trade-in number or an auction house&rsquo;s fees. If you want top dollar for your vintage Gibson, contact me for a free evaluation. It&rsquo;s a straightforward, better-paying way to sell a guitar quickly and safely.
            Call or text me at <strong>{contact.phone}</strong> or email
            <a href={hrefs.mailto}><strong> {contact.email}</strong></a> to start your appraisal today.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ───────────────────────────────────────────────────────────────
       4. HOW TO SELL — text LEFT + Gibson ES-175D photo RIGHT
       (live's `.txt-img-right_sctn` class indicates IMAGE on the right)
       ─────────────────────────────────────────────────────────────── */}
  <section id="how-to-sell-your-guitar" class="smg-split">
    <div class="smg-split__inner smg-split__inner--text-left">
      <div class="smg-split__text">
        <h3 class="smg-split__h3">How To Sell Your Vintage Gibson Guitar</h3>
        <hr class="smg-meet__sep" />
        <p>
          Selling a valuable guitar shouldn&rsquo;t be stressful. I buy nationwide and I&rsquo;m on the road across the U.S. all the time looking at collections. A lot of the time I can meet you in person and buy your Gibson on the spot. If we can&rsquo;t meet face to face, I cover the shipping. I&rsquo;ll set up and pay for prepaid packing and fully insured shipping.
        </p>
        <p>
          It&rsquo;s a simple process built to take the risk out of selling privately. No packing headaches, no shipping liability, no worrying about a lost box.
        </p>
      </div>
      <figure class="smg-split__img">
        <img
          src="https://www.joesvintageguitarsaz.com/wp-content/uploads/2026/03/1961-gibson-es-175-d-sunburst-1024x683.jpg"
          alt="Vintage Gibson ES-175D 1961, Sunburst Electric Guitar"
          width="1024" height="683" loading="lazy" decoding="async"
        />
      </figure>
    </div>
  </section>

  {/* ───────────────────────────────────────────────────────────────
       5. HOW MUCH IS MY GIBSON WORTH — photo LEFT + text RIGHT
       (live's `.txt-img-left_sctn` — image left)
       ─────────────────────────────────────────────────────────────── */}
  <section id="how-much-is-my-gibson-guitar" class="smg-split">
    <div class="smg-split__inner smg-split__inner--text-right">
      <figure class="smg-split__img">
        <img
          src="https://www.joesvintageguitarsaz.com/wp-content/uploads/2026/03/1966-gibson-trini-lopez-cherry-finish-1024x683.jpg"
          alt="Vintage 1967 Cherry Gibson Trini Lopez Model"
          width="1024" height="683" loading="lazy" decoding="async"
        />
      </figure>
      <div class="smg-split__text">
        <h3 class="smg-split__h3">How Much Is My Gibson Guitar Worth?</h3>
        <hr class="smg-meet__sep" />
        <p>
          The first thing most people want to know is what their Gibson is worth. Send me a few photos and I&rsquo;ll give you a free appraisal. It&rsquo;s quick, it&rsquo;s accurate, and there&rsquo;s never any obligation to sell. I&rsquo;ve also written a lot of free guitar-dating articles if you want to research the year and value yourself. Start with my <a href="/how-to-read-gibson-serial-numbers/">Gibson Serial Number Guide</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ───────────────────────────────────────────────────────────────
       6. BEST WAY TO SELL — text LEFT + Les Paul Goldtop photo RIGHT
       ─────────────────────────────────────────────────────────────── */}
  <section id="best-way-to-sell" class="smg-split">
    <div class="smg-split__inner smg-split__inner--text-left">
      <div class="smg-split__text">
        <h3 class="smg-split__h3">What Is the Best Way To Sell A Vintage Gibson Guitar?</h3>
        <hr class="smg-meet__sep" />
        <p>
          It&rsquo;s worth understanding the pros and cons of selling the guitar yourself versus selling to a collector or dealer. Either one can work out well.
        </p>
        <p>
