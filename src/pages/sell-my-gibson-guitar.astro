    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .smg-process__icon {
    /* Live dimensions: 130×121. */
    width: 130px;
    height: 121px;
    object-fit: contain;
    /* align-items: center on the card handles horizontal centering. */
    align-self: center;
  }
  .smg-process__card-h4 {
    margin: 0;
    font-family: var(--font-display, "Oswald"), sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.25;
