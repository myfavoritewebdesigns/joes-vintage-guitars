    color: var(--color-brand-rust-dark);
  }
  .smg-split__text > p {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-brand-brown);
  }
  .smg-split__text > p + p { margin-top: 14px; }
  .smg-split__text a {
    color: var(--color-brand-rust-dark);
    text-decoration: underline;
    font-weight: 600;
  }
  .smg-split__img {
    margin: 0;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
  }
  .smg-split__img img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1024 / 683;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .smg-split__inner { grid-template-columns: 1fr; gap: 24px; }
    /* On mobile both variants render text above image for consistent
       reading order regardless of desktop side. */
    .smg-split__inner--text-right .smg-split__img { order: 2; }
    .smg-split__inner--text-right .smg-split__text { order: 1; }
  }

  /* ────────────────────────────────────────────────────────────────
