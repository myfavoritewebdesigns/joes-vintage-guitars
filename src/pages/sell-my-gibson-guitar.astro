---
import Layout from "../layouts/Layout.astro";
import SellMyGibsonFinal from "../components/SellMyGibsonFinal.astro";

const pageUrl = "https://www.joesvintageguitarsaz.com/sell-my-gibson-guitar/";
const description = "Sell your vintage Gibson directly to Joe Dampt. Send photos for a free appraisal and cash offer, with prepaid insured FedEx packing and shipping nationwide.";

const faqs = [
  {
    q: "Should I Clean or Repair It First?",
    a: "No. Please leave the guitar as you found it. Cleaning, polishing or repairing it can remove clues I use to judge originality, and some repairs can lower the value.",
  },
  {
    q: "How Can I Tell How Old My Gibson Is?",
    a: "Start with the serial number on the back of the headstock, inside the body or on the label. Gibson reused some number patterns, so I also compare the logo, construction, finish, hardware and electronics.",
  },
  {
    q: "Do You Buy Guitars With Headstock Repairs or Refinishes?",
    a: "Yes. A repair, refinish or changed part affects the value, but it doesn't automatically rule out a purchase. Show the area clearly in your photos and tell me anything you know about the work.",
  },
  {
    q: "Does the Original Case Increase the Value?",
    a: "It can. An original case, hang tags, receipts, replaced parts and repair records may add value or help document the guitar. Keep everything together and include it in your photographs.",
  },
  {
    q: "What Information Should I Send?",
    a: "Send clear photographs of the full front and back, both sides of the headstock, the serial number, pickups, controls, bridge, case and any damage or repairs. Add the model and history if you know them.",
  },
  {
    q: "Do You Buy Inherited and Estate Guitars?",
    a: "Yes. Many people contact me about a Gibson they inherited. You don't need to identify it first. Please keep any old photographs, paperwork, cases and spare parts with the guitar.",
  },
  {
    q: "Can You Appraise a Gibson From Photographs?",
    a: "Clear photographs usually give me enough information for an initial appraisal and, when the details are clear, a purchase offer. I may ask for a few close-ups before giving you a final answer.",
  },
  {
    q: "How Does Shipping Work if I Sell My Gibson to You?",
    a: "I explain the full process with the offer. Through my special FedEx account, the box, professional packing, fully insured shipping and tracking are provided at the FedEx location at no cost to you.",
  },
  {
    q: "Do You Buy From Outside Arizona?",
    a: "Yes. I buy vintage Gibsons nationwide and have worked with sellers in all 50 states. We can arrange an in-person meeting when practical or use the prepaid FedEx process.",
  },
  {
    q: "Do You Buy Gibson Basses, Mandolins and Acoustics?",
    a: "Yes. I buy vintage Gibson electric guitars, acoustic guitars, archtops, basses and mandolins, including unusual models and instruments with old repairs or changed parts.",
  },
  {
    q: "Do I Have to Accept the Offer?",
    a: "No. The appraisal and offer are free, and there's no obligation to sell. You can consider the offer and shipping details together before deciding.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.joesvintageguitarsaz.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sell My Gibson Guitar",
      item: pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Nationwide Vintage Gibson Guitar Buying",
  serviceType: "Vintage Gibson Guitar Appraisal and Purchasing",
  provider: {
    "@id": "https://www.joesvintageguitarsaz.com/",
  },
  areaServed: {
    "@type": "Country",
    name: "United States",
  },
  description: "Joe Dampt buys vintage Gibson instruments nationwide and can arrange prepaid, fully insured FedEx shipping. The box, professional packing, shipping and tracking are provided at the FedEx location at no cost to the seller.",
  url: pageUrl,
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Sell My Gibson Guitar",
  description,
  isPartOf: {
    "@id": "https://www.joesvintageguitarsaz.com/#website",
  },
  about: {
    "@type": "Thing",
    name: "Vintage Gibson guitars",
  },
};
---

<Layout
  title="Sell My Gibson Guitar | Free Appraisal and Cash Offer"
  description={description}
  canonical="/sell-my-gibson-guitar/"
  ogType="website"
  ogImage="https://www.joesvintageguitarsaz.com/images/og/sell-my-gibson-guitar.jpg"
  structuredData={[breadcrumbSchema, faqSchema, serviceSchema, webPageSchema]}
>
  <SellMyGibsonFinal faqs={faqs} />
</Layout>
