  /* ────────────────────────────────────────────────────────────────
     3. MEET JOE (Connoisseur of Gibson Guitars)

     Live computed-style spec (captured 2026-05-26 via getComputedStyle):
       section bg: #eedfc0 cream, padding 100px 30px 120px
       row max-width 1144px
       row::before  → WHITE CARD bg, w 101% (~1155px), h 120% (~760px),
                      top -10% (~-63px), drop-shadow 1px 2px 9px rgba(0,0,0,0.61)
       row::after   → RUST TRIANGLE bg rust-dark, w 100px, h 120%, top -10%,
                      polygon(0 0, 0 100%, 100% 50%)
       video::before → OUTLINED RUST FRAME bg none, w 100px, h 110%, top -5%,
                       4px solid rust-bright, left -30px
       H3: Oswald Semibold, 30px, rust-dark, no text-transform
       HR: 3px tall, 100% column width, rust-dark bg, no border
     ──────────────────────────────────────────────────────────────── */

  .smg-meet {
    background: var(--color-brand-cream, #eedfc0);
    padding: 100px 30px 120px;
  }
  .smg-meet__inner {
    max-width: 1144px;
    margin: 0 auto;
  }
  .smg-meet__row {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: stretch;
  }
  .smg-meet__row::before {
    /* WHITE CARD — sits behind both columns, drop-shadowed, extends vertically
       beyond the row so the rust triangle has somewhere to peek out of. */
    content: "";
    position: absolute;
    inset: -49px -11px -49px 0;
    background: #fff;
    filter: drop-shadow(1px 2px 9px rgba(0, 0, 0, 0.61));
    z-index: -1;
  }
  .smg-meet__row::after {
    /* RUST TRIANGLE — anchored at left of card, points right. */
    content: "";
    position: absolute;
    top: -49px;
    bottom: -49px;
    left: 0;
    width: 100px;
    background: var(--color-brand-rust-dark);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    z-index: 0;
  }

  .smg-meet__video {
    position: relative;
    z-index: 1;
    padding: 24px 0 0 16px;
  }
  .smg-meet__video::before {
    /* OUTLINED RUST FRAME — sits to the left of the video, partially behind it,
       so the video appears to overflow the frame on the right side. */
    content: "";
    position: absolute;
    top: -24px;
    bottom: -32px;
    left: -30px;
    width: 108px;
    border: 4px solid var(--color-brand-rust-bright, #be4b25);
    z-index: -1;
    pointer-events: none;
  }
  .smg-lite-yt {
    display: block;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 16 / 9;
  }

  .smg-meet__panel {
    position: relative;
    z-index: 1;
    padding: 24px 8px 24px 24px;
  }
  .smg-meet__title {
    margin: 0;
    font-family: var(--font-display, "Oswald"), sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.25;
    color: var(--color-brand-rust-dark);
    text-transform: none;
  }
  .smg-meet__name {
    color: var(--color-brand-rust-bright);
    white-space: nowrap;
  }
  .smg-meet__sep {
    border: 0;
    height: 3px;
    width: 100%;
    background-color: var(--color-brand-rust-dark);
    margin: 12px 0 18px;
  }
  .smg-meet__panel p {
    margin: 0 0 14px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-brand-brown);
  }
  .smg-meet__panel p:last-child { margin-bottom: 0; }
  .smg-meet__panel strong { color: var(--color-brand-rust-dark); }
  .smg-meet__panel a {
    color: var(--color-brand-rust-dark);
    text-decoration: underline;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .smg-meet { padding: 60px 18px 70px; }
    .smg-meet__row {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .smg-meet__row::after { display: none; }
    .smg-meet__video::before { display: none; }
    .smg-meet__video { padding: 0; }
    .smg-meet__panel { padding: 8px 0; }
  }

  /* ────────────────────────────────────────────────────────────────
     4-6. TEXT + IMAGE SPLIT SECTIONS

     Three sections share a single `.smg-split` shell + an inner modifier
     for which side the image sits on. Background continues cream from the
     Meet Joe section above; alternating sides give visual rhythm.
     ──────────────────────────────────────────────────────────────── */

  .smg-split {
    background: var(--color-brand-cream, #eedfc0);
    padding: 50px 30px;
  }
  .smg-split__inner {
    max-width: 1144px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
