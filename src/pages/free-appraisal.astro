---
import Layout from "../layouts/Layout.astro";
import LeadForm from "../components/LeadForm.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { appraisalPages } from "../data/appraisal-pages";
import { contact, hrefs, SITE_URL } from "../config/site";
import { resolveImage } from "../lib/images";

const VIDEO_ID = "uSu-Ld-xgnI";
const jaguar = resolveImage("images/1966-fender-jaguar-lake-placid-blue.jpg")!;
const neckDate = resolveImage("images/neck-heel-date-stamp-reading-15-may-66.jpg")!;
const finishDetail = resolveImage("images/vintage-fender-custom-color-value.jpg")!;

const faqs = [
  { q: "Is the Guitar Appraisal Really Free?", a: "Yes. I do not charge for the first market valuation, and you do not have to sell. A signed report for insurance, an estate, a donation, or a legal matter is a separate service." },
  { q: "Can You Appraise a Guitar From Photos?", a: "Yes. Clear photos are usually enough to begin. I may ask for a closer view of a serial number, finish, pickup, label, repair, or other detail." },
  { q: "Do I Need to Know the Model or Year?", a: "No. Send the full guitar, headstock, serial number or label, and anything you know about its history. I can help identify it." },
  { q: "Does a Serial Number Tell Me What the Guitar Is Worth?", a: "No. A serial number may help with the date. The model, finish, original parts, condition, repairs, rarity, and current demand determine the value." },
  { q: "Should I Clean or Repair the Guitar First?", a: "No major work is needed. Photograph the guitar as it is. Cleaning or repairing it before the appraisal can remove evidence or create a new problem." },
  { q: "Can You Appraise a Collection or Estate?", a: "Yes. Tell me about how many instruments are involved, where they are located, and what records or photographs you have." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${SITE_URL}/free-appraisal/#video`,
  name: "Free Vintage Guitar Appraisal",
  description: "Joe Dampt explains how to request a free vintage guitar appraisal and which photos help him identify and value an instrument.",
  thumbnailUrl: `https://img.youtube.com/vi/${VIDEO_ID}/maxresdefault.jpg`,
  uploadDate: "2026-02-11T09:18:38-08:00",
  embedUrl: `https://www.youtube.com/embed/${VIDEO_ID}`,
  contentUrl: `https://www.youtube.com/watch?v=${VIDEO_ID}`,
  author: { "@id": `${SITE_URL}/about-me/#person` },
};

const reviews = [
  {
    name: "Jim W. in Pennsylvania",
    body: "I included a description of my guitar including serial number and a couple of photos. He responded immediately with a real pleasant email and gave me a value on my guitar.",
    href: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sChdDSUhNMG9nS0VJQ0FnSURtN192ejFBRRAB!2m1!1s0x0:0x69728d089b8a764!3m1!1s2@1:CIHM0ogKEICAgIDm7_vz1AE%7C%7C?hl=en",
  },
  {
    name: "Ray",
    body: "Joe patiently went through each instrument and provided me with a range of values for each one. I appreciated his knowledge, honesty, and willingness to take time to help me.",
    href: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUNlanAzNEpREAE!2m1!1s0x0:0x69728d089b8a764!3m1!1s2@1:CIHM0ogKEICAgICejp34JQ%7C%7C?hl=en",
  },
  {
    name: "Amy Vickery",
    body: "They were very easy to deal with and appraised my 1979 Guild within minutes! I sent pictures and details via text and received a free estimated value right away!",
    href: "https://www.google.com/maps/reviews/data=!4m8!14m7!1m6!2m5!1sChZDSUhNMG9nS0VJQ0FnSUMzaWFfdUtREAE!2m1!1s0x0:0x69728d089b8a764!3m1!1s2@1:CIHM0ogKEICAgIC3ia_uKQ%7C%7C?hl=en",
  },
];
---

<Layout
  title="Free Vintage Guitar Appraisal | Joe's Vintage Guitars"
  description="Send photos for a free vintage guitar appraisal from Joe Dampt. Get help identifying the model, year, condition, original parts, and current market value."
  canonical="/free-appraisal/"
  ogImage="https://www.joesvintageguitarsaz.com/images/og/vintage-guitar-appraisal-expert.jpg"
  ogImageAlt="Free vintage guitar appraisal from Joe's Vintage Guitars"
  ogType="article"
  structuredData={[faqSchema, videoSchema]}
>
  <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
  <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>

  <main class="ah-page">
    <section class="ah-hero">
      <div class="ah-container ah-hero-grid">
        <div class="ah-hero-copy">
          <p class="ah-eyebrow">Free Appraisal · No Obligation · Nationwide</p>
          <h1>Free Online <span>Vintage Guitar Appraisal</span></h1>
          <p class="ah-lede">Send me clear photos and whatever you know about the guitar. I will identify the model, look closely at its condition and originality, and tell you what similar instruments are selling for in <a class="ah-inline" href="/category/value-evaluation/">today's vintage guitar market</a>.</p>
          <p>I do every appraisal myself. The first market valuation is free, and you do not have to sell the guitar.</p>
          <div class="ah-actions">
            <a class="ah-button ah-button-light" href="#appraisal-form">Get My Free Appraisal</a>
            <a class="ah-button ah-button-outline" href={hrefs.tel}>Call or Text Joe</a>
          </div>
          <div class="ah-proof" aria-label="Appraisal benefits">
            <span>Joe Evaluates It Personally</span>
            <span>No Pressure to Sell</span>
            <span>Photos Are Enough to Start</span>
          </div>
          <div class="ah-video" id="video" aria-labelledby="video-title">
            <p class="ah-eyebrow" id="video-title">Watch How the Free Appraisal Works</p>
            <div class="ah-video-frame">
              <lite-youtube videoid={VIDEO_ID} params="wmode=transparent&autoplay=1&enablejsapi=1&rel=0&modestbranding=1" playlabel="Play Joe's free vintage guitar appraisal video"></lite-youtube>
            </div>
          </div>
        </div>

        <div class="ah-form-card" id="appraisal-form">
          <LeadForm
            formId="free-appraisal-hub"
            heading="Tell Me About Your Guitar"
            subheading="Not sure of the exact model or year? Send what you know."
            appraisalType={true}
            submitLabel="Get My Free Appraisal"
          />
        </div>
      </div>
      <div class="ah-container ah-trust" aria-label="Joe's appraisal experience">
        <div><strong>10,000+</strong><span>Instruments Appraised</span></div>
        <div><strong>12+ Years</strong><span>Hands On Experience</span></div>
        <div><strong>50 States</strong><span>Owners Served</span></div>
      </div>
    </section>

    <section class="ah-section">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">What I Will Check</p>
          <h2>What You Will Learn From the Appraisal</h2>
          <p class="ah-lede">A useful appraisal starts with the identity of the guitar and ends with a value based on the right comparisons.</p>
        </div>
        <div class="ah-card-grid">
          <article><span>01</span><h3>What the Guitar Is</h3><p>I narrow down the maker, model, production period, and important factory specifications.</p></article>
          <article><span>02</span><h3>What May Have Changed</h3><p>I look for repairs, refinishing, overspray, changed parts, and condition issues that affect the market.</p></article>
          <article><span>03</span><h3>What It Is Worth Today</h3><p>I compare the guitar with completed sales of similar instruments, not broad price tables or unsold asking prices.</p></article>
        </div>
      </div>
    </section>

    <section class="ah-section ah-paper">
      <div class="ah-container ah-split">
        <div>
          <p class="ah-eyebrow">Start With Clear Photos</p>
          <h2>Photos That Help Me Appraise It</h2>
          <p class="ah-lede">You do not need professional pictures. Daylight, a plain background, and a few sharp close views are enough to start.</p>
          <p>Also photograph the pickups, bridge, tuners, controls, cracks, repairs, finish wear, an acoustic guitar's interior label, and any receipts or family photographs.</p>
          <p class="ah-note"><strong>Only have a few photos?</strong> Send them. I can ask for specific details after I see the instrument.</p>
          <a class="ah-button ah-button-rust" href="#appraisal-form">Send Photos to Joe</a>
        </div>
        <ul class="ah-photo-list">
          <li>Complete front</li>
          <li>Complete back</li>
          <li>Headstock front</li>
          <li>Headstock back</li>
          <li>Serial number or label</li>
          <li>Original case</li>
        </ul>
      </div>
    </section>

    <section class="ah-section ah-dark" id="brand-appraisals">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">Start With the Maker</p>
          <h2>Brand Specific Guitar Appraisal Guides</h2>
          <p>Choose the maker on the headstock. Each guide shows the photos, markings, parts, and value factors I use for that brand.</p>
        </div>
        <div class="ah-brand-grid">
          {appraisalPages.map((page) => (
            <a href={`/free-appraisal/${page.slug}-guitar-appraisal/`}>
              <h3>{page.brand}</h3>
              <p>{page.heroCaption}</p>
              <span>View {page.brand} Appraisal Guide</span>
            </a>
          ))}
          <a href="#appraisal-form"><h3>Other Brands</h3><p>Epiphone, National, Dobro, Harmony, Kay, and unusual instruments.</p><span>Send Photos to Joe</span></a>
        </div>
      </div>
    </section>

    <section class="ah-section">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">What Changes the Price</p>
          <h2>What Changes a Vintage Guitar's Market Value</h2>
          <p class="ah-lede">The date matters, but it is only one part of the appraisal. These are the details that usually change the comparison group and the final value range.</p>
        </div>
        <div class="ah-factor-grid">
          <article><h3>Maker, Model, and Year</h3><p>I first place the guitar in the correct family and production period.</p></article>
          <article><h3>Original Finish</h3><p>Factory colors, normal play wear, overspray, touchups, and refinishing belong in different parts of the market.</p></article>
          <article><h3>Original Parts</h3><p>Pickups, tuners, bridges, tailpieces, electronics, pickguards, and cases do not all affect value equally.</p></article>
          <article><h3>Condition and Repairs</h3><p>Cracks, neck resets, headstock repairs, refrets, routing, and structural work must be judged by quality and extent.</p></article>
          <article><h3>Rarity and Specification</h3><p>A rare feature only adds value when buyers want that model, finish, pickup, wood, or factory option.</p></article>
          <article><h3>Current Demand</h3><p>I compare the guitar with completed sales and the buyers active in today's market.</p></article>
        </div>
        <p class="ah-center-link">Read more about the <a class="ah-inline" href="/post/is-your-vintage-guitar-valuable-7-factors-that-determine-its-value/">seven factors that determine vintage guitar value</a>.</p>
      </div>
    </section>

    <section class="ah-section ah-case">
      <div class="ah-container ah-case-grid">
        <div>
          <p class="ah-eyebrow">One Example</p>
          <h2>How Details Changed This Appraisal</h2>
          <h3><a href="/post/vintage-fender-jaguar-guide/">1966 Fender Jaguar in Lake Placid Blue</a></h3>
          <p>The owner wanted to know if the Lake Placid Blue finish was original. Its serial number could not settle that question.</p>
          <p>I reviewed the neck date, electronics, solder joints, and paint stick evidence in the neck pocket. Together, those details showed that the finish and components were original.</p>
          <p class="ah-result"><strong>The result:</strong> Original Lake Placid Blue Jaguars sell in a different market than refinished examples. Confirming the finish changed the value.</p>
          <a class="ah-button ah-button-light" href="#appraisal-form">Have Joe Look at Mine</a>
        </div>
        <div class="ah-case-photos" aria-label="1966 Fender Jaguar appraisal details">
          <LicensedImage src={jaguar} alt="1966 Fender Jaguar in Lake Placid Blue" width={800} loading="lazy" class="ah-case-main" sizes="(max-width: 760px) 92vw, 520px" />
          <LicensedImage src={neckDate} alt="Neck heel date stamp reading 15 May 66" width={520} loading="lazy" class="ah-case-detail" sizes="(max-width: 760px) 44vw, 250px" />
          <LicensedImage src={finishDetail} alt="Paint stick evidence in a Fender neck pocket" width={520} loading="lazy" class="ah-case-detail" sizes="(max-width: 760px) 44vw, 250px" />
        </div>
      </div>
    </section>

    <section class="ah-section ah-paper">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">From Guitar Owners</p>
          <h2>Reviews From People I Have Helped</h2>
          <p>Each review links to the original Google review.</p>
        </div>
        <div class="ah-reviews">
          {reviews.map((review) => (
            <a href={review.href} target="_blank" rel="noopener noreferrer" aria-label={`Read ${review.name}'s review on Google`}>
              <span class="ah-stars" aria-label="Five stars">★★★★★</span>
              <blockquote>“{review.body}”</blockquote>
              <cite>{review.name}</cite>
              <span class="ah-review-source">Read on Google</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ah-section">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">Which Appraisal Do You Need?</p>
          <h2>Free Market Valuation or Written Appraisal?</h2>
        </div>
        <div class="ah-choice-grid">
          <article>
            <p class="ah-eyebrow">Start Here</p>
            <h3>Free Market Valuation</h3>
            <p>Use this if you inherited a guitar, want to know its current value, or are thinking about selling. I will review the guitar and give you an informal opinion of its current market value.</p>
            <ul><li>No charge</li><li>No obligation to sell</li><li>Photos are enough to start</li></ul>
            <a class="ah-button ah-button-rust" href="#appraisal-form">Get a Free Valuation</a>
          </article>
          <article>
            <p class="ah-eyebrow">For Official Use</p>
            <h3>Written Appraisal</h3>
            <p>Use this if an insurance company, estate, attorney, accountant, court, or charity needs a signed report. Written appraisals require more research and documentation.</p>
            <ul><li>Insurance documentation</li><li>Estate or probate needs</li><li>Tax or donation support</li></ul>
            <a class="ah-button ah-button-rust" href={`mailto:${contact.email}?subject=Written%20guitar%20appraisal`}>Ask Joe About a Written Appraisal</a>
          </article>
        </div>
      </div>
    </section>

    <section class="ah-section ah-resource-hub">
      <div class="ah-container">
        <div class="ah-section-head">
          <p class="ah-eyebrow">Research Before or After the Appraisal</p>
          <h2>Research Your Guitar and Choose Your Next Step</h2>
          <p class="ah-lede">These links help you find the information I use in an appraisal, understand the value, and decide what to do after you receive it.</p>
        </div>
        <div class="ah-resource-groups">
          <article>
            <h3>Confirm the Date</h3>
            <ul>
              <li><a href="/fender-guitars-serial-number-guide/">Fender Serial Numbers and Dating</a></li>
              <li><a href="/how-to-read-gibson-serial-numbers/">Gibson Serial Numbers and Dating</a></li>
              <li><a href="/martin-serial-and-model-numbers/">Martin Serial and Model Numbers</a></li>
              <li><a href="/rickenbacker-serial-numbers/">Rickenbacker Serial Numbers</a></li>
              <li><a href="/gretsch-serial-number-lookup/">Gretsch Serial Number Lookup</a></li>
              <li><a href="/guild-serial-number-lookup/">Guild Serial Number Lookup</a></li>
            </ul>
          </article>
          <article>
            <h3>Understand the Value</h3>
            <ul>
              <li><a href="/post/what-a-serial-number-cant-tell-you/">What a Serial Number Cannot Tell You</a></li>
              <li><a href="/post/is-your-vintage-guitar-valuable-7-factors-that-determine-its-value/">Seven Factors That Determine Value</a></li>
              <li><a href="/vintage-fender-stratocaster-value-guide/">Vintage Stratocaster Value Guide</a></li>
              <li><a href="/vintage-fender-telecaster-value-guide/">Vintage Telecaster Value Guide</a></li>
              <li><a href="/vintage-gibson-les-paul-market-value-guide/">Vintage Les Paul Market Value Guide</a></li>
              <li><a href="/martin-d-28-d-18-d-45-dreadnought-value-guide/">Martin Dreadnought Value Guide</a></li>
            </ul>
          </article>
          <article>
            <h3>Choose the Next Step</h3>
            <ul>
              <li><a href="/">Sell a Vintage Guitar</a></li>
              <li><a href="/sell-a-guitar-collection/">Appraise or Sell a Collection</a></li>
              <li><a href="/consignment/">Consider Guitar Consignment</a></li>
              <li><a href="/repair/">Discuss Instrument Repair</a></li>
              <li><a href="/post/what-to-consider-when-selling-a-vintage-guitar/">What to Consider Before Selling</a></li>
              <li><a href="/post/best-online-platforms-sell-vintage-guitars/">Compare Online Selling Options</a></li>
            </ul>
          </article>
        </div>
        <p class="ah-resource-note"><strong>Not sure which guide applies?</strong> You do not need to research the guitar first. <a class="ah-inline" href="#appraisal-form">Send me your photos</a> and I will help identify it.</p>
      </div>
    </section>

    <section class="ah-section">
      <div class="ah-container ah-faq-grid">
        <div>
          <p class="ah-eyebrow">Common Questions</p>
          <h2>Questions About Free Guitar Appraisals</h2>
        </div>
        <div class="ah-faqs">
          {faqs.map((item, index) => (
            <details open={index === 0}><summary>{item.q}</summary><p>{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="ah-final">
      <div class="ah-container ah-final-grid">
        <div><p class="ah-eyebrow">Ready When You Are</p><h2>Find Out What Your Vintage Guitar Is Worth</h2><p>Send photos and what you know, even if the model or year is a mystery. I will look at the guitar and tell you what I think it is worth in the current market.</p></div>
        <div class="ah-final-actions"><a class="ah-button ah-button-light" href="#appraisal-form">Get My Free Appraisal</a><a href={hrefs.tel}>Call or Text {contact.phone}</a></div>
      </div>
    </section>
  </main>

  <script is:inline>
    const requestedBrand = new URLSearchParams(window.location.search).get("brand");
    const instrumentInput = document.querySelector('[data-form-id="free-appraisal-hub"] input[name="instrument"]');
    if (requestedBrand && instrumentInput instanceof HTMLInputElement && !instrumentInput.value) {
      instrumentInput.value = requestedBrand;
    }
  </script>
</Layout>

<style>
  .ah-page {
    --ah-ink: #211d18;
    --ah-paper: #fffaf0;
    --ah-paper-2: #f2eadb;
    --ah-line: rgba(62, 42, 20, 0.18);
    color: var(--ah-ink);
    background: var(--ah-paper);
    font-size: 17px;
    line-height: 1.72;
  }
  .ah-container { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .ah-hero { padding: 176px 0 0; color: #fffaf0; background: linear-gradient(135deg, #26211c, #682412 70%, #8b321b); }
  .ah-hero-grid { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(390px, 0.78fr); gap: clamp(42px, 6vw, 78px); align-items: start; }
  .ah-hero h1, .ah-section h2, .ah-final h2 { margin: 0 0 20px; font-family: var(--font-display); font-weight: 700; line-height: 1.03; text-transform: uppercase; }
  .ah-hero h1 { color: #fffaf0; font-size: clamp(3.6rem, 7vw, 6.8rem); }
  .ah-hero h1 span { display: block; color: #eab265; }
  .ah-section h2, .ah-final h2 { color: var(--color-brand-brown); font-size: clamp(2.45rem, 5vw, 4.4rem); }
  .ah-dark h2, .ah-case h2, .ah-final h2 { color: #fffaf0; }
  .ah-section h3 { margin: 0 0 10px; color: var(--color-brand-brown); font-family: var(--font-display); font-size: 1.35rem; line-height: 1.2; text-transform: uppercase; }
  .ah-eyebrow { margin: 0 0 12px; color: var(--color-brand-rust-bright); font-family: var(--font-display); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
  .ah-hero .ah-eyebrow, .ah-dark .ah-eyebrow, .ah-case .ah-eyebrow, .ah-final .ah-eyebrow { color: #eab265; }
  .ah-lede { font-size: 1.12rem; line-height: 1.68; }
  .ah-inline { color: var(--color-brand-rust-bright); font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .ah-hero .ah-inline, .ah-dark .ah-inline, .ah-case .ah-inline { color: #eab265; }
  .ah-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0 22px; }
  .ah-button { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; padding: 12px 22px; border: 2px solid transparent; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.025em; line-height: 1.2; text-align: center; text-decoration: none; text-transform: uppercase; transition: transform 0.2s ease, background 0.2s ease; }
  .ah-button:hover { transform: translateY(-2px); }
  .ah-button-light { background: var(--color-brand-cream); color: var(--color-brand-rust-dark); }
  .ah-button-outline { border-color: rgba(255, 255, 255, 0.62); color: #fff; }
  .ah-button-rust { background: var(--color-brand-rust-bright); color: #fff; }
  .ah-proof { display: flex; flex-wrap: wrap; gap: 9px 20px; color: #eadfce; font-size: 0.88rem; font-weight: 700; }
  .ah-proof span::before { content: "◆"; margin-right: 7px; color: #eab265; font-size: 0.62em; }
  .ah-video { margin-top: 34px; }
  .ah-video-frame { overflow: hidden; aspect-ratio: 16 / 9; border: 1px solid rgba(255, 255, 255, 0.2); background: #111; box-shadow: 0 20px 46px rgba(0, 0, 0, 0.28); }
  .ah-video-frame :global(lite-youtube), .ah-video-frame :global(iframe) { width: 100%; height: 100%; }
  .ah-form-card { min-width: 0; }
  .ah-form-card :global(.lead-form) { border-left: 0; background: #eadfce; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32); }
  .ah-trust { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 56px; border-top: 1px solid rgba(255, 255, 255, 0.18); }
  .ah-trust div { padding: 25px 18px; text-align: center; }
  .ah-trust div + div { border-left: 1px solid rgba(255, 255, 255, 0.18); }
  .ah-trust strong { display: block; color: #fffaf0; font-family: var(--font-display); font-size: 1.75rem; line-height: 1; text-transform: uppercase; }
  .ah-trust span { display: block; margin-top: 6px; color: #decdb6; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
  .ah-section { padding: 88px 0; }
  .ah-paper { background: var(--ah-paper-2); }
  .ah-dark { color: #eee6da; background: #27231f; }
  .ah-dark p { color: #d7cec1; }
  .ah-section-head { max-width: 810px; margin-bottom: 38px; }
  .ah-card-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
