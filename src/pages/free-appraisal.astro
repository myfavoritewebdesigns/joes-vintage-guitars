---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/primitives/PageHero.astro";
import SectionHeader from "../components/primitives/SectionHeader.astro";
import Button from "../components/primitives/Button.astro";
import { contact, hrefs } from "../config/site";
import { Image } from "astro:assets";
import { resolveImage } from "../lib/images";

// FAQPage JSON-LD — sourced from live JSON-LD #4
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What's The Difference Between Fair Market Value And An Insurance Appraisal?", acceptedAnswer: { "@type": "Answer", text: "Fair market value is what a buyer will realistically hand you in cash today. An insurance appraisal is usually higher. It's the retail cost of replacing your instrument with an equivalent one from a dealer if yours gets stolen or destroyed. I give you the numbers for both. If you're selling, you know your floor. If you're insuring, you know your coverage." } },
    { "@type": "Question", name: "Do I Have To Bring The Guitar To Mesa To Get An Appraisal?", acceptedAnswer: { "@type": "Answer", text: "Not at all. I love it when great gear walks through the door, but I do most appraisals remotely. From clear photos of the right details, like neck heels, pot codes, and solder joints, I can authenticate and value your guitar anywhere in the country." } },
    { "@type": "Question", name: "Why Can't I Just Check eBay Or Reverb Sold Listings To Find The Value Myself?", acceptedAnswer: { "@type": "Answer", text: "Sold listings don't tell you the whole story. A 1965 Stratocaster that sold for $12,000 might have had swapped pickups, a refret, and overspray, while an untouched one could be worth double. I price your guitar off private sales data and the exact factory specs that public listings leave out." } },
    { "@type": "Question", name: "How Much Does A Refinish Or A Headstock Repair Hurt The Value?", acceptedAnswer: { "@type": "Answer", text: "It depends on the era and how good the work is, but as a rule a refinish on a golden-era Fender or Gibson cuts the collector value by about half. A headstock break does about the same, usually 40% to 50%. That's not the end of the road, though. These guitars still sell well as player-grade instruments, and I know how to price them for that market." } },
    { "@type": "Question", name: "Can You Help With Appraisals For An Estate Or Probate Court?", acceptedAnswer: { "@type": "Answer", text: "Yes. Settling an estate takes accurate numbers and clean paperwork. I write official appraisals that hold up for legal, tax, and probate purposes, so the family isn't left guessing." } },
    { "@type": "Question", name: "Will You Buy My Guitar After You Appraise It?", acceptedAnswer: { "@type": "Answer", text: "Absolutely. If you decide to sell, I'll make a fair cash offer based on that same value. There's never any pressure, but the option is there if you'd rather sell quick than deal with tire-kickers online." } },
  ],
};

const steps = [
  {
    n: "01",
    title: "Send Over the Details",
    body: "Just fill out the form below with the brand, model, and a few clear photos. One old Fender or a whole collection built over the years, either way this is the easiest way to get started. The more details you give me, the more accurate the guitar identification will be. You can also call, text, or email if you&rsquo;d rather reach out that way.",
    img: resolveImage("images/get-your-valuation.jpg")!,
    alt: "Man taking photo of cherry Gibson ES-335",
  },
  {
    n: "02",
    title: "Expert Review & Research",
    body: "I use more than just the serial number to date your guitar correctly, including pot codes and hardware specs. I&rsquo;ll go through the details, checking the serial number and looking over the parts and overall condition. Once I&rsquo;ve pinned down the model &amp; year, I&rsquo;ll compare it against recent sales and my own market data to find what it&rsquo;s actually worth today.",
    img: resolveImage("images/expert-review-research.jpg")!,
    alt: "Joe Dampt reviewing Gibson Barney Kessel guitar",
  },
  {
    n: "03",
    title: "Get Your Valuation",
    body: "I&rsquo;ll get back to you with a straight, honest look at what your guitar is worth right now. Curious about its history or ready to move it on, you&rsquo;ll have solid numbers to work from. And if you do decide to sell, I&rsquo;m always happy to make a fair cash offer and buy it through my easy nationwide process.",
    img: resolveImage("images/joes-vintage-guitars-remote-nationwide-guitar-appraisal.png")!,
    alt: "Email from Joe explaining market value of cherry red Gibson ES-335",
  },
];

const authority = [
  { title: "Known Beyond Arizona", body: "I&rsquo;m based in Mesa, but I&rsquo;ve spent years building a name as a vintage guitar buyer for collectors all over the country. I work mostly on the high-end stuff, the instruments with real history that take an experienced eye to get right." },
  { title: "No Shipping Required", body: "You don&rsquo;t have to ship your guitar just to find out what it is. I can spot original parts, finish issues, and hardware specs from good photos. I&rsquo;ve done thousands of these remote appraisals for owners across the US, all without them leaving the living room." },
  { title: "Beyond the &ldquo;Big Three&rdquo;", body: "My market knowledge goes well past Fender and Gibson. If you need an accurate Gretsch appraisal, the value of a vintage Guild, or help identifying a rare Rickenbacker or Epiphone, I&rsquo;ve got the national sales data to give you a real number." },
  { title: "Real-World Market Data", body: "I don&rsquo;t go by the bargain-bin prices from 10 years ago, or the inflated &lsquo;asking prices&rsquo; you see on Reverb. I track real sales data across the national vintage guitar market so my numbers reflect what&rsquo;s actually selling right now." },
];

const stats = [
  { value: "10,000+", label: "Vintage Instruments Appraised Personally" },
  { value: "$2,000,000+", label: "Annual Volume in Vintage Gear Bought & Sold" },
  { value: "1,000+", label: "Instruments Repaired & Restored by Joe" },
  { value: "20+", label: "Countries Shipped to Globally" },
  { value: "1500+ Hours", label: "Of live performance and studio session guitar work" },
];

const caseStudies = [
  {
    title: "1966 Fender Jaguar in Lake Placid Blue",
    subtitle: "Fender Custom Color Authentication",
    img: resolveImage("images/neck-heel-date-stamp-reading-15-may-66.jpg")!,
    challenge: "Determining if the rare custom color finish was factory-original or a high-quality &lsquo;pro-refinish&rsquo; from years ago.",
    detail: "I asked the seller for photos of the &lsquo;paint stick&rsquo; mark in the neck pocket in order to aid in finish authentication, as well as detailed photos of the electronics to inspect the originality of the solder joints. Untouched solder joints are key in confirming the originality of a Fender finish. I also verified the neck heel date and pot codes to confirm the 1966 production window.",
    outcome: "Confirmed the guitar was a 100% original custom color survivor. This verification provided the owner with a precise market valuation, reflecting its rarity compared to the more common sunburst models. Custom color Fender guitars are often worth twice as much (or more) than sunburst models.",
  },
  {
    title: "1962 Gibson ES-335 (Transitional Year)",
    subtitle: "Vintage PAF Pickup Identification",
    img: resolveImage("images/1962-gibson-335-cherry-red-semi-hollow-body-electric.jpg")!,
    challenge: "1962 is a major &lsquo;transition&rsquo; year for Gibson. The goal was to determine if this Cherry 335 still held the coveted PAF pickups, early Patent Number pickups, or a mix of both. This was an in-person appraisal.",
    detail: "I pulled the pickups to verify the PAF stickers, &lsquo;L&rsquo; shaped tooling marks, cover solder, and overall construction. I then looked at the pots and wiring to confirm that the electronics were untouched. I also spent time on the hardware, identifying the &lsquo;no-wire&rsquo; ABR-1 bridge and the &lsquo;short seam&rsquo;, lightweight aluminum stop tailpiece. Unlike the heavier zinc versions that followed, this specific tailpiece is a key indicator of an early &rsquo;62. I finished by verifying that the single-line, double-ring Kluson tuners were original with no added or enlarged holes.",
    outcome: "With two original PAFs and all-original hardware, this was about as good as it gets. The confirmation let the seller ask the full premium a transitional 1962 model brings.",
  },
  {
    title: "1956 Gibson ES-5 (The &ldquo;N&rdquo; Mystery)",
    subtitle: "Gibson Factory Inconsistencies",
    img: resolveImage("images/1956-Gibson.jpg")!,
    challenge: "This was an in-person appraisal with a couple of &lsquo;red flags.&rsquo; It was a Natural finish, but the label was missing the &lsquo;N&rsquo; designation Gibson usually used. Even weirder, it had double black &lsquo;stingers&rsquo; on the back of the neck, which can often mean that someone is trying to hide a headstock/heel repair or a refinish.",
    detail: "I did a deep dive into the finish, looking at the weather checking and the way the finish had aged under the hardware. Also performed a &lsquo;blacklight test&rsquo; by looking for that telltale nitrocellulose green glow and consistency of finish. I looked for any overspray in the cavities and checked the interior for original wiring. After a full physical disassembly, I was able to prove that the missing &lsquo;N&rsquo; was just a factory slip-up. Most importantly, the finish and those black stingers were 100% factory original.",
    outcome: "By certifying the guitar as factory-original, I cleared up the doubts that would have made buyers walk away. It gave the owner peace of mind and protected the value of a seriously rare Gibson. According to the Gibson shipping totals, a Natural ES-5 is approximately three to four times rare than a Sunburst.",
  },
];

const marketPulse = [
  { tag: "&ldquo;Player Grade&rdquo; is on fire.", body: "I&rsquo;m seeing a surge in demand for 50s and 60s gear that is &lsquo;player grade&rsquo;. Whereas any modification used to be a death sentence for value, I&rsquo;ve been noticing that the market has become increasingly forgiving towards modifications, especially if they are era-correct vintage mods. Now, is your refinished 50s Fender Telecaster going to be worth as much as an original one? Not even close. But it will be worth comparatively more than it was a few years ago, especially if it&rsquo;s a cool older refinish." },
  { tag: "The Hunt for Transition Years.", body: "Collectors are getting much more specific. They&rsquo;re hunting for those &lsquo;in-between&rsquo; months where the specs were shifting. If I can identify a stray PAF pickup or an early-spec neck profile on a mid-60s piece, it&rsquo;s adding thousands to the value." },
  { tag: "The Reality Check.", body: "There&rsquo;s a massive gap right now between the &lsquo;asking prices&rsquo; you see on the big public sites and what the actual sales data is telling us. A lot of sellers are still acting as if COVID-era price inflation never ended. Don&rsquo;t get me wrong, the market is still strong, but prices aren&rsquo;t climbing at that crazy rate anymore. That&rsquo;s left the market full of unsold listings and inflated, speculative prices that just aren&rsquo;t grounded in reality." },
  { tag: "&ldquo;Under the Radar&rdquo; Brands.", body: "Everyone wants a Burst or a Blackguard, but I&rsquo;m seeing a huge uptick in interest for brands like Gretsch, Guild, and Epiphone (Kalamazoo-made). The &lsquo;alternative&rsquo; vintage market is booming because the value-to-vibe ratio is so high. If you&rsquo;ve got a clean Gretsch 6120 or an Epiphone Crestwood, don&rsquo;t sleep on it. Collector interest in these &lsquo;other&rsquo; brands is as strong as I&rsquo;ve ever seen it." },
];

const conditionGradesElectric = [
  { grade: "Mint", impact: "Top of Market", body: "100% original factory finish. No checking, buckle rash, or wear of any kind. Original hardware, pickups, and electronics with zero oxidation. Original frets at full height." },
  { grade: "Excellent", impact: "80 to 95% of Mint", body: "Original finish with only the lightest signs of play. All original hardware and electronics. Minor surface oxidation acceptable. Frets at 90%+ height." },
  { grade: "Very Good+", impact: "60 to 75% of Mint", body: "Original finish showing honest player wear, with moderate checking and light buckle rash. All original hardware. Original or refretted with good height." },
  { grade: "Very Good", impact: "45 to 60% of Mint", body: "Visible player wear, heavier checking, moderate buckle rash, small dings. Mostly original hardware with minor replacements. Plays well after set-up." },
  { grade: "Good", impact: "25 to 40% of Mint", body: "Heavy player wear. May include a repaired crack or small headstock repair. Mix of original and non-original parts. Functional as a gigging instrument." },
  { grade: "Fair", impact: "10 to 25% of Mint", body: "Refinished, or original finish with significant structural repairs. Non-original hardware throughout, including pickups. Playable but requires work." },
  { grade: "Poor", impact: "Parts Value Only", body: "Significant structural damage, missing parts, heavy modifications. Heavily modified or non-functional electronics. A project guitar." },
];

const conditionGradesAcoustic = [
  { grade: "Mint", impact: "Top of Market", body: "Original nitrocellulose finish perfectly intact. No checking, no pick wear. 100% original binding, intact bracing, perfect glue joints. Practically impossible on pre-war instruments." },
  { grade: "Excellent", impact: "80 to 95% of Mint", body: "Original finish with very light checking or minor pick wear near soundhole. No belly-up. All original binding. No structural cracks." },
  { grade: "Very Good+", impact: "60 to 75% of Mint", body: "Original finish showing honest play wear. Light to moderate pick wear and checking. One neatly repaired crack acceptable. All original bracing." },
  { grade: "Very Good", impact: "45 to 60% of Mint", body: "Heavy checking, moderate pick wear, possible small top dings. No refin. Likely refretted. Neck reset likely performed. A few professionally repaired cracks." },
  { grade: "Good", impact: "25 to 40% of Mint", body: "Heavy player wear. Possible touch-up or localized refinish. Multiple repaired cracks. Bridge plate replacement acceptable. Multiple refrets." },
  { grade: "Fair", impact: "10 to 25% of Mint", body: "Full or partial refinish, OR extensive top damage with amateur repairs. Significant bellying. Major structural repairs throughout." },
  { grade: "Poor", impact: "Restoration / Parts", body: "Extensive damage, missing top sections, heavily cracked soundboard, or amateur refinish. Not playable without major restoration." },
];

const fakeSpotting = [
  {
    brand: "Gibson",
    points: [
      { title: "The Truss Rod Reveal", body: "Real Gibson uses a brass hex nut for adjustments. Almost every fake uses a recessed Allen key. If you see a deep hole meant for a hex wrench instead of that standing brass nut, you&rsquo;re looking at a counterfeit." },
      { title: "The &ldquo;Flathead&rdquo; Bridge Tell", body: "On a genuine American-made Gibson, the bridge is adjusted using thumbwheels. Counterfeits almost exclusively use a bridge that sits on large, chunky bolts with a flathead screwdriver slot on top." },
      { title: "The Headstock &ldquo;Wings&rdquo;", body: "A genuine Gibson neck is carved from a single piece of mahogany, but the &lsquo;flares&rsquo; on the side of the headstock are separate pieces of wood called &lsquo;wings&rsquo; glued on at the factory. Most fakes use a &lsquo;scarf joint.&rsquo;" },
      { title: "Stampings vs. Laser Etching", body: "Gibson serial numbers are stamped into the wood before paint. Counterfeits usually laser-etch numbers after the finish is dry. If the serial looks sharp enough to cut your finger, it&rsquo;s a fake." },
    ],
  },
  {
    brand: "Martin",
    points: [
      { title: "The Neck Block Identity", body: "Through the soundhole, the model name and serial number should be cleanly stamped into solid mahogany using Martin&rsquo;s sans-serif typeface. Fakers usually stumble here with generic, serifed stamps or sloppy ink transfers." },
      { title: "The &ldquo;Inside-Outside&rdquo; Grain Test", body: "On a solid-wood Martin, grain patterns on the outside back match the inside back exactly. If the inside looks plain while the outside is figured rosewood, it&rsquo;s a laminate." },
      { title: "The Back Center Strip", body: "On a genuine Nazareth-built Martin, the back center strip is stamped with &lsquo;C.F. Martin &amp; Co. Nazareth, PA.&rsquo; If that strip is blank or the font looks like modern computer print, you need a professional look." },
    ],
  },
  {
    brand: "Fender",
    points: [
      { title: "Date Stamps &amp; Codes", body: "On a vintage piece, you&rsquo;re looking for a handwritten pencil date or ink stamp on the &lsquo;butt&rsquo; of the neck, like &lsquo;5-62&rsquo; or &lsquo;13MAY65B.&rsquo; A clean modern barcode or no markings means a newer guitar or &lsquo;Partscaster.&rsquo;" },
      { title: "The &ldquo;Walnut Plug&rdquo; Test", body: "On a genuine American Fender with a headstock-adjust truss rod, you&rsquo;ll see a distinct dark walnut wood plug surrounding the adjustment hole. Counterfeits leave raw wood or a cheap black plastic insert." },
      { title: "Era-Correct Hardware", body: "Fender was very specific about which hardware went with which era. A &lsquo;1954&rsquo; Strat with an 11-screw pickguard (didn&rsquo;t exist until 1959) or a &lsquo;1960s&rsquo; neck with a 3-bolt &lsquo;Micro-Tilt&rsquo; plate is a parts-bin guitar." },
    ],
  },
];

const testimonials = [
  { name: "Jim W. (PA)", body: "I sent an email to Joe&rsquo;s Vintage Guitars last evening about 10:00 PM Eastern Time. I included a description of my guitar including serial number and a couple of photos. He responded immediately with a real pleasant email and gave me a value on my guitar. I can&rsquo;t tell you how cool the experience was!" },
  { name: "Ray", body: "I had been doing some research on the value of instruments that my father owned when I saw Joe&rsquo;s Vintage Guitars website and their free appraisals. The next day I called. Joe patiently went through each instrument and provided me with a range of values for each one. I appreciated his knowledge, honesty, and willingness to take time to help me." },
  { name: "Amy Vickery", body: "They were very easy to deal with and appraised my 1979 Guild within minutes! I sent pictures and details via text and received a FREE estimated value right away! 10/10 highly recommend!" },
  { name: "Missy", body: "I highly recommend Joe&rsquo;s Vintage Guitars if you have a guitar that you&rsquo;d like to get an appraisal on. I sent my contact information and was called the next day. The process couldn&rsquo;t have been any easier. Thank you again for an easy and honest appraisal!" },
  { name: "Kevin Richard Scholl", body: "I needed help with accurately unscrambling the serial number on my Gibson Spirit. I saw Joe&rsquo;s web site and it said &lsquo;Contact me if you need help dating, valuing or selling a guitar.&rsquo; So I called, he answered quickly and told me it was indeed a 1983 Spirit. Nice guy, real chill and pleasant to speak with." },
  { name: "D Angelino", body: "Joe called me himself to let me know the value of my &rsquo;76 Les Paul Custom. He was fair, honest, super easy to talk with, as well as being informative and educational. His call was a really pleasant break in my day. I trust his knowledge, experience and character." },
];

const faqs = faqSchema.mainEntity.map((q) => ({ q: q.name, a: q.acceptedAnswer.text }));
---

<Layout
  title="Free Vintage Guitar Appraisal | Joe&rsquo;s Vintage Guitars"
  description="Get a free vintage guitar appraisal from Joe's Vintage Guitars. I give accurate market valuations for Fender, Gibson, Martin and more, based on real sales data."
  canonical="/free-appraisal/"
  ogImage="https://www.joesvintageguitarsaz.com/images/og/vintage-guitar-appraisal-expert.jpg"
  ogImageAlt="Free vintage guitar appraisal at Joe's Vintage Guitars"
  ogType="article"
  publishedTime="2022-05-11T21:17:00+00:00"
  modifiedTime="2026-04-24T19:29:25+00:00"
  structuredData={faqSchema}
>
  <PageHero
    title="Free Vintage Guitar Appraisal: What Is Your Vintage Guitar Worth?"
    subhead="Expert Valuations For Fender, Gibson, Martin &amp; Every Major American Brand"
    bgImage="/images/hero-background.jpg"
    size="lg"
  >
    <Button slot="cta" href={hrefs.tel} variant="cream" size="lg">{contact.phone}</Button>
    <Button slot="cta" href="#contact" variant="cream" size="lg">Contact Now</Button>
  </PageHero>

  <!-- Intro section under hero: video left + intro copy + 2 CTAs right -->
  <section class="fa-intro">
    <div class="fa-intro__inner">
      <div class="fa-intro__video">
        <div class="fa-intro__video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/uSu-Ld-xgnI"
            title="Joe explains the free vintage guitar appraisal"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div class="fa-intro__copy">
        <p>
          Getting a free vintage guitar appraisal shouldn&rsquo;t be a hassle. At Joe&rsquo;s Vintage Guitars,
          I help owners and collectors nationwide find out what their gear is worth in today&rsquo;s
          market. Maybe you want the cash value of a vintage Gibson, need a
          <a href="/fender-guitars-serial-number-guide/"><strong>Fender Serial Number</strong></a>
          identified, or have a whole
          <a href="/sell-a-guitar-collection/"><strong>Guitar Collection to Sell</strong></a>.
          Either way, I&rsquo;ll give you a straight, honest answer and the right
          numbers before you sell or insure it.
        </p>
        <div class="fa-intro__ctas">
          <Button href={hrefs.tel} variant="rust" size="md">Call Or Text Joe</Button>
          <Button href="#contact" variant="cream" size="md">Appraisal Form</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Simple Steps — heading + alternating 2-col rows with "Step N:" labels -->
  <section class="fa-steps">
    <div class="fa-steps__inner">
      <h3 class="fa-steps__heading">How to Get Your Free Vintage Guitar Valuation In 3 Simple Steps</h3>
      <div class="fa-steps__rule" aria-hidden="true"></div>
      {steps.map((s, i) => (
        <article class={`fa-step fa-step--${i % 2 === 0 ? "left" : "right"}`}>
          <div class="fa-step__copy">
            <span class="fa-step__label">Step {i + 1}:</span>
            <h4 class="fa-step__title">{s.title}</h4>
            <div class="fa-step__title-rule" aria-hidden="true"></div>
            <p class="fa-step__body" set:html={s.body} />
          </div>
          <div class="fa-step__photo">
            <Image src={s.img} alt={s.alt} width={510} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Get An Appraisal + Trusted Authority — two-column lead section (matches live's sctn-contact) -->
  <section class="fa-appraisal" id="get-an-appraisal">
    <div class="fa-appraisal__inner">
      <!-- Left: dark-rust appraisal form panel -->
      <div class="fa-appraisal__formcol">
        <p class="fa-appraisal__eyebrow">Get An Appraisal</p>
        <h4 class="fa-appraisal__subhead">For Your Vintage Guitar Or Collection Online Or In Person</h4>

        <form class="appr-top-form" data-jvg-contact-form data-form-id="free-appraisal" novalidate>
          <div class="apf-q"><label>Name<input name="your-name" type="text" autocomplete="name" required /></label></div>
          <div class="apf-q"><label>Email<input name="your-email" type="email" autocomplete="email" required /></label></div>
          <div class="apf-q"><label>Phone<input name="your-phone" type="tel" autocomplete="tel" /></label></div>
          <div class="apf-q"><label>Location <span class="sub-color">(City, State or Country)</span><input name="your-location" type="text" /></label></div>
          <div class="apf-t"><label>Make/Brand <span class="sub-color">(e.g., Fender, Gibson, Martin)</span><input name="your-brand" type="text" /></label></div>
          <div class="apf-t"><label>Model <span class="sub-color">(e.g., Stratocaster, Les Paul)</span><input name="your-model" type="text" /></label></div>
          <div class="apf-t"><label>Year <span class="sub-color">(Approximate)</span><input name="your-year" type="number" inputmode="numeric" min="1900" max="2099" /></label></div>
          <div class="apf-full"><label>Condition <span class="sub-color">(e.g., Excellent, Good, Fair, Needs Repair)</span><input name="your-condition" type="text" /></label></div>
          <div class="apf-full"><label>Comments<textarea name="your-comment" rows="3"></textarea></label></div>
          <div class="apf-full apf-reply">
            <span class="apf-reply__legend">Best Way To Reply:</span>
            <label class="apf-radio"><input type="radio" name="best-reply" value="call" checked /> Call</label>
            <label class="apf-radio"><input type="radio" name="best-reply" value="text" /> Text</label>
            <label class="apf-radio"><input type="radio" name="best-reply" value="email" /> Email</label>
          </div>
          <div class="apf-full"><button type="submit" class="appr-top-form__submit">Submit</button></div>
          <p class="appr-top-form__note">*If you have photos, you will have the option to upload them after clicking submit</p>
        </form>
      </div>

      <!-- Right: Trusted Authority -->
      <div class="fa-appraisal__authoritycol">
        <h3 class="fa-authority__heading">Nationwide Vintage Guitar Values You Can Trust</h3>
        <div class="fa-authority__rule" aria-hidden="true"></div>
        <h4 class="fa-authority__sub">Expertise By The Numbers</h4>
        <div class="fa-authority__stats">
          {stats.map((s) => (
            <div class="fa-authority__stat">
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
        <div class="fa-authority__grid">
          {authority.map((c) => (
            <article class="fa-authority__card">
              <h3 set:html={c.title} />
              <p set:html={c.body} />
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Notable Appraisals: 3 case studies — combined heading, natural case -->
  <section class="fa-cases">
    <div class="fa-cases__inner">
      <header class="fa-cases__head">
        <h3 class="fa-cases__title">Notable Appraisals:<br />Real-World Vintage Guitar Case Studies</h3>
        <div class="fa-cases__rule" aria-hidden="true"></div>
        <p class="fa-cases__lede">I&rsquo;ve handled thousands of vintage instruments over the years. Here are a few where my research got sellers the full story, and the right price, for their gear.</p>
      </header>
      {caseStudies.map((c, i) => (
        <article class={`fa-case fa-case--${i % 2 === 0 ? "left" : "right"}`}>
          <div class="fa-case__photo">
            <Image src={c.img} alt={c.title} width={460} />
          </div>
          <div class="fa-case__body">
            <span class="fa-case__sub">{c.subtitle}</span>
            <h3 class="fa-case__title" set:html={c.title} />
            <dl>
              <dt>The Challenge:</dt>
              <dd set:html={c.challenge} />
              <dt>The Detail:</dt>
              <dd set:html={c.detail} />
              <dt>The Outcome:</dt>
              <dd set:html={c.outcome} />
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Free vs Insurance comparison -->
  <section class="fa-vs">
    <div class="fa-vs__inner">
      <header class="fa-section-head">
        <h3 class="fa-section-head__title">Free Expert Market Valuation vs.<br />Official Insurance Appraisals</h3>
        <div class="fa-section-head__rule" aria-hidden="true"></div>
