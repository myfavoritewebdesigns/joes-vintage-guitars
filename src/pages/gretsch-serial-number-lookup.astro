  <script is:inline>
    function toggleJvgNav() {
      var p = document.getElementById("jvgNavPanel"), b = document.getElementById("jvgNavBtn");
      var open = p.classList.toggle("open"); b.classList.toggle("open");
      b.setAttribute("aria-expanded", open ? "true" : "false");
    }
    function closeJvgNav() {
      var p = document.getElementById("jvgNavPanel"), b = document.getElementById("jvgNavBtn");
      p.classList.remove("open"); b.classList.remove("open"); b.setAttribute("aria-expanded", "false");
    }
  </script>
</Layout>

