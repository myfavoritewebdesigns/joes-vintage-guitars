---
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { assetSrc, resolveImage } from "../lib/images";
import Layout from "../layouts/Layout.astro";
import { SITE_URL, hrefs, contact } from "../config/site";
// Decoder widget markup (handlers live in /scripts/grsn-tool.js, on window.jvgDecode / jvgTry)
import grsnToolHtml from "../../reference/grsn-tool-html.html?raw";
import grsnToolCss from "../../reference/grsn-tool.css?raw";

// Every inline figure on this page is converted to <LicensedImage>; files verified in src/assets/images/gretsch-sn/.
const imgMeta = (file: string) => resolveImage("images/gretsch-sn/" + file)!;
const PAGE_URL = `${SITE_URL}/gretsch-serial-number-lookup/`;
const OG_IMG = `${SITE_URL}${assetSrc("images/gretsch-sn/1969-gretsch-serial-number-1024x680.jpg")}`;

const navParts = [
  { href: "#gretsch-history-overview", label: "History & Ownership" },
  { href: "#gretsch-serial-number-lookup", label: "Quick Reference Grid" },
  { href: "#gretsch-serial-numbers-1939-1966", label: "Era 1: Sequential (1939 to 1966)" },
  { href: "#gretsch-serial-numbers-1966-1972", label: "Era 2: Date-Coded (1966 to 1972)" },
  { href: "#gretsch-serial-numbers-1972-1981", label: "Era 3: Hyphenated (1972 to 1981)" },
  { href: "#gretsch-serial-numbers-1989-2002", label: "Era 4: Japan & Korea" },
  { href: "#gretsch-serial-numbers-2003-present", label: "Era 5: Fender Era" },
  { href: "#gretsch-advanced-dating-guide", label: "Advanced Dating Guide" },
  { href: "#gretsch-headstock-logo-changes", label: "Headstock Logo Changes" },
  { href: "#gretsch-label-types", label: "Label Identification" },
  { href: "#gretsch-pickup-dating", label: "Dating by Pickup" },
  { href: "#gretsch-fingerboard-inlay-dating", label: "Fingerboard Inlays" },
  { href: "#gretsch-body-cutaway-dating", label: "Body & Cutaway Changes" },
  { href: "#gretsch-bigsby-vibrato-dating", label: "Bigsby & Vibrato" },
