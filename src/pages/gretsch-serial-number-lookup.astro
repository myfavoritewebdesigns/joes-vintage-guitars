import GretschGuideLayout from '../layouts/GretschGuideLayout.astro';
import GretschPhoto from '../components/GretschPhoto.astro';
import LicensedImage from '../components/primitives/LicensedImage.astro';
import {resolveImage} from '../lib/images';
import {gretschPhotos} from '../data/gretsch-photos';
import {gretschGuides} from '../data/gretsch-guides';
import {gretschFactories} from '../lib/gretsch-serials';
import {SITE_URL} from '../config/site';
const chart=[['1939 To 1946','001s To 1,000s'],['1946 To 1949','2,000s'],['1950','4,000s To 5,000s'],['1951','001s To 1,000s'],['1952','5,000s To 6,000s'],['1953','6,000s To 8,000s'],['1954','9,000s To 12,000s'],['1955','13,000s To 16,000s'],['1956','17,000s To 21,000s'],['1957','21,000s To 26,000s'],['1958','26,000s To 30,000s'],['1959','30,000s To 34,000s'],['1960','35,000s To 39,000s'],['1961','40,000s To 45,000s'],['1962','46,000s To 52,000s'],['1963','53,000s To 63,000s'],['1964','63,000s To 78,000s'],['1965','78,000s To 85,000s']];
const eras=[['Early Sequential Numbers','1939 To Mid 1960s','Pencil marks, paper labels, headstock stamps or model plates. Compare model features at overlapping chart boundaries.','gretsch-serial-numbers-1939-1966'],['Short Date Codes','Mid 1960s To Early 1970s','Month, one year digit and a unit sequence. One- and two-digit months can produce more than one reading.','gretsch-serial-numbers-1966-1972'],['Baldwin Date Codes','1970s To 1981','A short date code, sometimes with a separator after the month. Some later orange labels use a different sequence.','gretsch-serial-numbers-1972-1981'],['Japanese Revival And Korean Production','1989 To 2002','Longer Japanese codes may include model digits. Korean sticker formats need their own model evidence.','gretsch-serial-numbers-1989-2002'],['Modern Factory Prefixes','2003 Onward','Two letters, two year digits, two month digits and four sequence digits on common formats.','gretsch-serial-numbers-2003-present']];
const faqs=[
{q:'How Do I Look Up A Gretsch Guitar Serial Number?',a:'<p>Photograph the entire label or headstock marking, then choose its format in the lookup tool. Keep letters and separators. Older numbers may have more than one possible reading, so compare the model, <a href="/gretsch-pickup-dating-guide/">pickups</a> and body features before choosing a year.</p>'},
{q:'How Do I Date A Gretsch Guitar Without A Serial Number?',a:'<p>Compare the model, construction, headstock, pickups, inlays and hardware together. Check every <a href="/gretsch-labels-and-serial-number-locations/">possible serial location</a> first. Features can support an approximate period, but replacements and reissues may prevent an exact year. A hump-block inlay or a DynaSonic pickup isn’t a one-year guarantee.</p>'},
{q:'What Is A Pre-Baldwin Gretsch?',a:'<p>The term describes a guitar made before Baldwin acquired Gretsch in 1967. It is an ownership-era description, not a guarantee of condition, originality or value. Date-coded instruments can straddle that transition, and company wording on a label isn’t enough to establish which side a guitar belongs to.</p>'},
{q:'What Do The Letters At The Beginning Of A Gretsch Serial Number Mean?',a:'<p>On the common modern format, the letters identify a country and factory. JT means Terada in Japan; other documented prefixes appear in the <a href="#gretsch-fender-prefix-codes">factory table</a>. Don’t infer a particular product series or quality level from the letters alone. Unknown or unusual formats need confirmation from Gretsch.</p>'},
{q:'Why Does My Gretsch Serial Number Seem To Be From The Wrong Year?',a:'<p>Possible causes include an incorrectly copied digit, the wrong serial system, overlapping chart ranges, reused labels, a model-year transition or replacement parts. Gretsch documents misplaced 1957 labels appearing on some mid-1960s instruments. Check the <a href="/gretsch-vintage-vs-reissue/#when-evidence-disagrees">conflicting-evidence guide</a> before treating a mismatch as proof of a fake.</p>'},
{q:'How Much Is My Vintage Gretsch Guitar Worth?',a:'<p>Model, condition, originality, repair history and comparable sales all matter. A serial lookup can’t price the guitar or verify its parts. Send complete photos for a <a href="/free-appraisal/gretsch/">free Gretsch appraisal</a>, including any replaced pickups, binding damage, finish work and original parts kept in the case.</p>'}
];
const extra=[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a.replace(/<[^>]+>/g,'')}}))},{'@context':'https://schema.org','@type':'WebApplication',name:'Gretsch Serial Number Lookup',url:SITE_URL+'/gretsch-serial-number-lookup/#grsn-tool',applicationCategory:'UtilityApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description:'Compare common Gretsch serial formats and approximate dating ranges with model and label evidence.'}];
---
<GretschGuideLayout title="Gretsch Serial Number Lookup And Dating Guide" metaTitle="Gretsch Serial Number Lookup & Dating Guide With Photos" description="Date your Gretsch with a free serial lookup, vintage charts and photo guides to labels, pickups, hardware and finishes. Compare original guitars and reissues." canonical="/gretsch-serial-number-lookup/" structuredData={extra}>
<article>
<section class="gr-hero"><div class="gr-wrap gr-hero-grid"><div><p class="gr-kicker">Joe’s Gretsch Dating Library</p><h1>Gretsch Serial Number Lookup And Dating Guide</h1><p class="gr-lede">Find your Gretsch’s likely production period, then check it against the guitar in front of you. Serial formats overlap, labels were sometimes reused, and later guitars can look much like their vintage counterparts.</p>
        <p class="jvg-guide-context">My guide to <a class="underline underline-offset-4" href="/how-old-is-my-guitar/">finding a guitar's age</a> explains how to weigh the serial against the physical evidence when they don't agree.</p><p>Start with the lookup, or compare the <a href="/gretsch-labels-and-serial-number-locations/">label and headstock photos</a> if you’re not sure which number to use. The guides below connect the serial to the pickups, body, hardware and finish.</p><p class="gr-byline">By <a href="/about-me/">Joe Dampt</a> · Updated October 15, 2026</p><nav class="gr-toc" aria-label="Gretsch hub sections"><a href="#gretsch-advanced-dating-guide">Photo Guides</a><a href="#gretsch-serial-number-lookup">Serial Formats</a><a href="#gretsch-serial-numbers-1939-1966">Vintage Chart</a><a href="#gretsch-dating-checklist">Dating Checklist</a><a href="#gretsch-faq">Questions</a></nav></div>
<form class="gr-tool" id="grsn-tool"><h2>Look Up Your Gretsch Serial</h2><label for="gretsch-number">Serial Number</label><input id="gretsch-number" name="serial" placeholder="Example: JT20083227" maxlength="20" autocomplete="off" spellcheck="false" required aria-describedby="gretsch-number-help"/><label for="gretsch-era">Serial Format</label><select id="gretsch-era" name="era"><option value="auto">Help Me Identify The Format</option><option value="sequential">Early Sequential Number</option><option value="datecode">Mid-1960s To Early-1970s Date Code</option><option value="baldwin">Baldwin Date Code, 1970s To 1981</option><option value="revival">Japanese Revival, 1989 To 2002</option><option value="modern">Modern Factory Prefix, 2003 Onward</option><option value="orange">Later Orange “That Great Gretsch Sound” Label</option></select><button class="gr-button" type="submit">Check Serial Number</button><small id="gretsch-number-help">Enter the complete serial, including letters and separators. Results are dating clues; they don’t authenticate a guitar or its parts.</small><div id="gretsch-result" class="gr-result" role="status" aria-live="polite" aria-atomic="true"></div><noscript><p>The charts and photo guides below work without JavaScript.</p></noscript></form></div></section>
<section class="gr-section" id="gretsch-advanced-dating-guide"><div class="gr-wrap"><div class="gr-section-head"><h2>Compare Your Gretsch’s Details</h2><p>Choose the feature you can photograph. Each guide shows what to look for, which details recur on later models, and how replacements can affect a date estimate.</p></div><div class="gr-cards">{gretschGuides.map(g=><article class="gr-card"><a href={'/'+g.slug+'/'} tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage(gretschPhotos[g.photo])!} alt="" width={600} loading="lazy"/></a><div class="gr-card-body"><h3><a href={'/'+g.slug+'/'}>{g.title}</a></h3><p>{g.intro}</p><details class="gr-card-topics"><summary>Topics In This Guide</summary><ul>{g.sections.map(s=><li><a href={'/'+g.slug+'/#'+s.id}>{s.title}</a></li>)}</ul></details></div></article>)}</div></div></section>
<section class="gr-section gr-section--tint" id="gretsch-serial-number-lookup"><div class="gr-wrap"><h2>Choose The Correct Serial Number System</h2><p class="gr-hub-intro">A number’s location and format are part of the identification. Five digits on a 1950s paper label and five digits stamped on a later headstock may need different readings. If the number is on a later orange label, read the wording before applying either chart.</p><div class="gr-table-scroll" tabindex="0" role="region" aria-label="Gretsch serial format comparison"><table><thead><tr><th scope="col">System</th><th scope="col">Approximate Period</th><th scope="col">What To Check</th></tr></thead><tbody>{eras.map(e=><tr><td><a href={'#'+e[3]}>{e[0]}</a></td><td>{e[1]}</td><td>{e[2]}</td></tr>)}</tbody></table></div><p>Keep the model number separate. A marking such as 6120 identifies a model family, while the serial belongs to an individual instrument. The <a href="/gretsch-labels-and-serial-number-locations/">serial-location guide</a> shows labels, cavity locations, headstock stamps and model plates.</p></div></section>
<div class="gr-wrap gr-article">
<section class="gr-article-section" id="gretsch-history-overview"><h2>Why Gretsch Has Several Dating Systems</h2><p>Gretsch’s history extends back to 1883, but its guitar numbering systems changed as production and ownership changed. Early pencil marks, later paper labels and headstock date codes don’t form one uninterrupted sequence. A date estimate needs the system that applies to the instrument.</p><p>Baldwin acquired Gretsch in 1967. Production later moved from Brooklyn to Arkansas, and guitar production stopped in the early 1980s. The Gretsch family reacquired the company in 1985, before the later Japanese production revival. Gretsch’s <a href="https://blog.gretschguitars.com/2013/05/gretschtech-the-baldwin-era/">Baldwin-era history</a> explains those separate events.</p><p>The Fender arrangement announced in 2002 concerned manufacture, distribution and marketing; it was not a purchase of the Gretsch family’s ownership. The modern serial system began in 2003. “Fender era” is common shorthand, but it should not replace the model and factory information on the guitar itself.</p></section>
<section class="gr-article-section" id="gretsch-serial-numbers-1939-1966"><h2>Sequential Gretsch Serial Numbers: 1939 To Mid 1960s</h2><p>Early Gretsch serial numbers generally follow a sequence, but the published boundaries are approximate. The table below follows the broad bands on <a href="https://gretschguitars.com/support/product-dating">Gretsch’s product-dating page</a>. A range such as “17,000s” means numbers in that thousand band; it isn’t a claim that a model changed on a particular day.</p><div class="gr-table-scroll" tabindex="0" role="region" aria-label="Vintage Gretsch sequential serial chart"><table><thead><tr><th scope="col">Year Or Period</th><th scope="col">Published Number Bands</th></tr></thead><tbody>{chart.map(r=><tr><td>{r[0]}</td><td>{r[1]}</td></tr>)}</tbody></table></div><p>Gretsch’s separate <a href="https://blog.gretschguitars.com/2016/05/gretschtech-serial-numbers-1930s-1966/">early serial-number article</a> gives different boundaries in places. For example, it extends 1955 farther into the 17,000 range than the support table. This lookup retains overlapping estimates instead of presenting one exact year as settled.</p><GretschPhoto photo="clubLabel" alt="Country Club label showing serial 17622" caption="17622 is a useful boundary example: one official chart points to 1956, while another includes it in the 1955 range. Compare the model and features before choosing a year."/><p>Early numbering also restarted, so a low number doesn’t automatically establish prewar production. Check the <a href="/gretsch-headstock-and-tuner-dating-guide/">headstock shape and markings</a> and the instrument's construction. A pencil mark can fade, and a label can be lost; the remaining evidence may support only a period.</p><div class="gr-note"><h3>The Reused 1957 Labels</h3><p>Gretsch documents a misplaced batch of 1957 labels that resurfaced in the mid 1960s. If a 21,000-range number appears on a guitar with later body or pickup features, investigate that exception. The serial isn’t a reason to ignore the rest of the instrument.</p></div><p>Model year and calendar year also differ. A guitar built late in a year may carry the following model year's features. Use the <a href="/gretsch-body-binding-and-inlays/">body and inlay comparisons</a> with the serial, particularly near transitions.</p></section>
<section class="gr-article-section" id="gretsch-serial-numbers-1966-1972"><h2>Gretsch Date Codes: Mid 1960s To Early 1970s</h2><p>In the short date-code system, the first one or two digits give the month, the next digit gives the year within the period, and the remaining digits identify a unit sequence. This is a different reading from the earlier ascending serial chart.</p><p>For example, 68409 reads as June 1968, unit 409. The Viking's 27127 below can read as February 1967, unit 127. Its model and headstock location support that context. Entering 27127 against an early sequential chart would instead produce a 1950s estimate.</p><GretschPhoto photo="vikingSerial" alt="27127 serial stamped between Grover tuners on a Gretsch Viking" caption="On this Viking, 27127 supports a February 1967 date-code reading. The model and serial location distinguish it from an earlier sequential number."/><p>Numbers starting with 10, 11 or 12 need care: the first digit may mean January followed by a year digit, or the first two digits may indicate October, November or December. The lookup displays possible readings where needed. Month 10 is October, even though an example on Gretsch's support page labels it November.</p><p>A “Made in USA” marking helps establish context for later U.S. production. It doesn’t prove an exact ownership-change day. If a stamp seems inconsistent, check the <a href="/gretsch-headstock-and-tuner-dating-guide/">headstock and tuners</a> and retain a photograph of the complete marking.</p><GretschPhoto photo="serial1969" alt="Rear Gretsch headstock with serial 1878 and a Made in USA stamp" caption="Keep the country marking and the full serial in one photograph. Both contribute to the interpretation."/></section>
<section class="gr-article-section" id="gretsch-serial-numbers-1972-1981"><h2>Baldwin Date Codes And Later Label Exceptions</h2><p>A separator after the month can clarify the short date-code system. In the manufacturer's example, 2-365 reads as February 1973, with 65 as the unit sequence. Some instruments omit the separator or use a handwritten mark. Preserve what you see in the photograph.</p><GretschPhoto photo="baldwinSerial" alt="Hyphenated serial on a 1970s Gretsch" caption="A separator can distinguish the month from the year digit. Confirm the label and model before choosing the decade."/><p>Don’t treat any hyphen as proof of Baldwin manufacture. Longer Japanese revival numbers can also contain a hyphen, but in a different position. Likewise, some later orange and gray labels use five-digit sequences beginning with 1 or 2 that can’t be decoded into an exact date.</p><p>The black and white rectangular labels introduced in the 1970s are another useful comparison. See the <a href="/gretsch-labels-and-serial-number-locations/#baldwin-labels">Baldwin label photographs</a> for a handwritten example and a discussion of the orange-label exception. Check <a href="/gretsch-bridges-and-tailpieces/">bridges and tailpieces</a> as supporting evidence, allowing for replacements.</p></section>
<section class="gr-article-section" id="gretsch-serial-numbers-1989-2002"><h2>Japanese Revival And Korean Gretsches: 1989 To 2002</h2><p>Many Japanese revival instruments use a longer numeric format: a two-digit year, a one- or two-digit month, three model-related digits and a final unit sequence. A hyphen may precede the sequence. This common pattern doesn’t cover every Gretsch made during the period.</p><p>Keep the model digits in place when you transcribe the serial, but don't mistake them for extra year or month digits. Select the Japanese revival option in the tool and compare the result with the full model line. A format match is a possible reading, not confirmation that the number belongs to that guitar.</p><p>Korean instruments can use different sticker formats. A missing sticker may leave no complete serial to decode. In that situation, the model specification, paperwork and physical details matter more than trying to force the remaining numbers into a Japanese chart.</p><GretschPhoto photo="reverbAnniversary" alt="Joe’s 1997 Gretsch Double Anniversary in Smoke Green" caption="Joe’s 1997 Double Anniversary shows how later Japanese production can preserve earlier-looking styling. Its appearance alone doesn’t identify a 1950s guitar." source="https://reverb.com/item/89818249-gretsch-double-anniversary-1997-smoke-green"/><p>The <a href="/gretsch-vintage-vs-reissue/#japanese-revival-example">Japanese revival comparison</a> connects this instrument's body and label. Compare the <a href="/gretsch-finish-colors/#green-and-two-tone-finishes">Smoke Green finish examples</a> if color is the main clue you have.</p></section>
<section class="gr-article-section" id="gretsch-serial-numbers-2003-present"><h2>Modern Gretsch Serial Numbers: 2003 Onward</h2><p>The common modern format is two factory letters followed by eight digits. For JT20083227, JT identifies the factory, 20 is the year 2020, 08 is August and 3227 is the factory/year sequence. The sequence covers models built at that factory; it isn’t a count of one specific model.</p><GretschPhoto photo="blackLabel" alt="G6136T-BLK label with JT20083227 serial" caption="This Black Falcon label supplies both the model and an August 2020 serial reading. The orange border isn’t evidence of a vintage build."/><p>Gretsch reserves low sequence numbers in its documented scheme for prototypes, samples and other special instruments. A low sequence alone doesn’t establish rarity, a special specification or a higher value. Compare any such claim with the instrument's paperwork and manufacturer information.</p><h3 id="gretsch-fender-prefix-codes">Documented Factory Prefixes</h3><div class="gr-table-scroll" tabindex="0" role="region" aria-label="Gretsch factory prefix reference"><table><thead><tr><th scope="col">Prefix</th><th scope="col">Country And Factory</th></tr></thead><tbody>{Object.entries(gretschFactories).map(([code,factory])=><tr><td>{code}</td><td>{factory}</td></tr>)}</tbody></table></div><p>These prefixes come from Gretsch's <a href="https://blog.gretschguitars.com/2013/07/gretschtech-understanding-modern-gretsch-serial-numbers/">modern serial-number explanation</a>. It is a documented reference list, not a promise that every later factory code is included. Unknown prefixes, unusual lengths or conflicting labels need confirmation. The letters alone don’t establish a product series, originality or quality level.</p><p>Use the <a href="/gretsch-vintage-vs-reissue/">vintage versus reissue guide</a> if a modern date conflicts with an older-looking body or model-year designation.</p></section>
<section class="gr-article-section"><h2>Check The Features Against The Serial</h2><h3 id="gretsch-headstock-logo-changes">Headstock Logos And Tuners</h3><p>Compare the complete headstock: outline, logo, decorative inlay, model plate, cover and rear tuner pattern. The <a href="/gretsch-headstock-and-tuner-dating-guide/">headstock and tuner guide</a> shows why a vertical Falcon logo or familiar tuner button doesn’t establish a year on its own.</p><h3 id="gretsch-label-types">Label Types And Serial Locations</h3><p>Read the border and wording as well as the digits. Early rectangular labels, orange oval labels, later orange labels, Baldwin rectangles and modern labels need different interpretations. Use the <a href="/gretsch-labels-and-serial-number-locations/">label photo guide</a> when the number seems to disagree with the instrument.</p><h3 id="gretsch-pickup-dating">Pickups And Replacement Covers</h3><p>DynaSonic, Filter’Tron, HiLo’Tron and Super’Tron designs have distinct faces, but later versions repeat those features. The <a href="/gretsch-pickup-dating-guide/">pickup identification guide</a> compares pole pieces, covers and mounting evidence without treating a removable part as a manufacture date.</p><h3 id="gretsch-fingerboard-inlay-dating">Fingerboard Inlays</h3><p>Hump-blocks aren’t exclusive to 1957, and thumbnails continued beyond the early 1960s. Compare the <a href="/gretsch-body-binding-and-inlays/#blocks-humps-thumbnails">block, hump-block and thumbnail photos</a> with the model before choosing a period.</p><h3 id="gretsch-body-cutaway-dating">Bodies, Cutaways And Back Pads</h3><p>The 6120, Country Gentleman, Jet, Falcon, Penguin, Viking and Anniversary have their own histories. A double cutaway or padded back needs that model context. The <a href="/gretsch-body-binding-and-inlays/">body guide</a> connects construction, f-holes, bracing, binding and fingerboard details.</p><h3 id="gretsch-bigsby-vibrato-dating">Bigsbys, Bridges And Tailpieces</h3><p>A V-cut Bigsby refers to the frame opening, not a V-shaped arm. Melita, Space Control, bar and adjustable-saddle bridges can also be replacements. Compare the <a href="/gretsch-bridges-and-tailpieces/">bridge and tailpiece photos</a>, then check the surrounding <a href="/gretsch-knobs-and-controls/">controls</a> and <a href="/gretsch-finish-colors/#refinish-checks">finish evidence</a>.</p></section>
<section class="gr-article-section" id="gretsch-dating-checklist"><h2>A Dating Checklist For Your Guitar</h2><ol><li>Photograph the complete guitar, front and back, before concentrating on one feature.</li><li>Copy every serial character and record whether it appears on a label, headstock, cavity label or model plate.</li><li>Identify the full model number separately from the serial, including any G-prefix or suffix.</li><li>Choose the matching serial format and keep all plausible readings if the result overlaps.</li><li>Compare the body, pickups, inlays and hardware with that model's period. Allow for reissues and documented production exceptions.</li><li>List repairs and replaced parts. A later bridge or tuner set doesn’t change the body's manufacture date.</li><li>Retain uncertain details in the description and request an appraisal if the evidence still conflicts.</li></ol><p>A serial in a 1957 range on a later-looking body, a later bridge on an early guitar, or a missing interior label all deserve a closer look. None should be resolved by ignoring the conflicting evidence. The <a href="/gretsch-vintage-vs-reissue/#when-evidence-disagrees">conflicting-date examples</a> show how to proceed.</p></section>
<section class="gr-article-section" id="gretsch-model-number-guide"><h2>Gretsch Model Numbers And Era Clues</h2><div class="gr-table-scroll" tabindex="0" role="region" aria-label="Gretsch model number families"><table><thead><tr><th scope="col">Model Marking</th><th scope="col">What It Helps Identify</th><th scope="col">Dating Limit</th></tr></thead><tbody><tr><td>Early Synchromatic Names And Numbers</td><td>Prewar and early acoustic families; some numbers originated as price designations.</td><td>Read the full model and construction alongside the number.</td></tr><tr><td>6000-Series Numbers</td><td>Families including 6120, 6122, 6128 and 6136.</td><td>Related numbers returned in later production.</td></tr><tr><td>7000 And Later Baldwin Numbers</td><td>Renumbered and redesigned 1970s instruments, with some late 8000-series designations.</td><td>A number series alone doesn’t establish exact year or condition.</td></tr><tr><td>G-Prefix And Longer Suffixes</td><td>Later model families and versions, including historical-design references.</td><td>A year in the model name can identify the design being recreated.</td></tr></tbody></table></div><p>For a Jet, continue with the <a href="/post/gretsch-duo-jet-history-value/">Duo Jet, Silver Jet and Jet Firebird history</a>. For a 6120 or Nashville, use the <a href="/post/gretsch-6120-history-value/">6120 model guide</a>. Those model comparisons supply context that a serial chart can’t.</p></section>
<section class="gr-article-section" id="gretsch-faq"><h2>Gretsch Dating Questions</h2>{faqs.map(f=><details><summary>{f.q}</summary><div class="gr-faq-answer" set:html={f.a}/></details>)}</section>
<section class="gr-article-section"><h2>Manufacturer References</h2><ul class="gr-resources"><li><a href="https://gretschguitars.com/support/product-dating">Gretsch Product Dating</a><p>Compare the manufacturer’s serial bands, label descriptions and date-code examples.</p></li><li><a href="https://blog.gretschguitars.com/2016/05/gretschtech-serial-numbers-1930s-1966/">Early Gretsch Serial History</a><p>Read the alternate early ranges and explanation of reused labels and model years.</p></li><li><a href="https://blog.gretschguitars.com/2013/07/gretschtech-understanding-modern-gretsch-serial-numbers/">Modern Gretsch Serial Format</a><p>Check the documented factory letters and positions of the date digits.</p></li><li><a href="https://gretschguitars.com/support/catalogs">Gretsch Catalog Archive</a><p>Compare the complete specification of later models when a part or finish needs confirmation.</p></li></ul></section>
</div>
<section class="gr-section gr-section--tint" id="gretsch-appraisal-phoenix"><div class="gr-wrap gr-article"><h2>Get A Gretsch Appraisal From Joe</h2><p>Send the serial, full front and back photos, both sides of the headstock and close-ups of any changed or damaged parts. Include known repairs, refinishing and any older parts stored in the case. Those details let me assess the instrument beyond its chart date.</p><p><a class="gr-button" href="/free-appraisal/gretsch/">Get A Free Gretsch Appraisal</a></p><p>If you're ready to sell, see <a href="/sell-my-gretsch-guitar/">how to sell your Gretsch to Joe’s Vintage Guitars</a>. For other instruments, compare the <a href="/fender-guitars-serial-number-guide/">Fender</a>, <a href="/how-to-read-gibson-serial-numbers/">Gibson</a>, <a href="/martin-serial-and-model-numbers/">Martin</a>, <a href="/rickenbacker-serial-numbers/">Rickenbacker</a> and <a href="/guild-serial-number-lookup/">Guild serial guides</a>.</p></div></section>
</article>
<script>
 import {decodeGretsch,type GretschEra} from '../lib/gretsch-serials';
 const form=document.querySelector<HTMLFormElement>('#grsn-tool');
 form?.addEventListener('submit',(event)=>{event.preventDefault();const input=document.querySelector<HTMLInputElement>('#gretsch-number')!;const era=document.querySelector<HTMLSelectElement>('#gretsch-era')!;const result=decodeGretsch(input.value,era.value as GretschEra);const box=document.querySelector<HTMLDivElement>('#gretsch-result')!;box.replaceChildren();const title=document.createElement('strong');title.textContent=result.title;const detail=document.createElement('p');detail.textContent=result.detail;const link=document.createElement('a');link.href='#'+result.anchor;link.textContent='Compare The Matching Guide Section';box.append(title,detail,link);});
</script>
</GretschGuideLayout>
