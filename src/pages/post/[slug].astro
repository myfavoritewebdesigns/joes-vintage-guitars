---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import ContactSection from "../../components/ContactSection.astro";
import { SITE_URL, hrefs, contact, imageLicense } from "../../config/site";
import { getPublishedPosts, getRelated, categoryName, formatDate } from "../../lib/blog";
import { resolveImage, assetSrc } from "../../lib/images";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: getRelated(posts, entry, 3) },
  }));
}) satisfies GetStaticPaths;

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const postUrl = `${SITE_URL}/post/${entry.id}/`;
const catName = categoryName(data.category, data.categoryName);
const catUrl = `/category/${data.category}/`;
// og:image must be absolute. When the file was relocated under src/assets the
// shim returns pipeline metadata (hashed /_astro/ URL); otherwise the original
// public path passes through unchanged.
const ogMeta = data.ogImage ? resolveImage(data.ogImage) : null;
// Hero: pipeline metadata when relocated (responsive <Image>), public path
// fallback otherwise (raw <img>, the 15 raw-HTML-blocked heroes).
const heroMeta = data.heroImage ? resolveImage(data.heroImage) : null;

// Real pixel dimensions for the public-path heroes too: read once at build
// with sharp so og:image:width/height and the BlogPosting ImageObject never
// carry made-up numbers. Build-time only; ships nothing to the client.
let publicDims: { width: number; height: number } | null = null;
if (!ogMeta && data.ogImage && data.ogImage.startsWith("/images/")) {
  try {
    const sharp = (await import("sharp")).default;
    const m = await sharp(`public${data.ogImage}`).metadata();
    if (m.width && m.height) publicDims = { width: m.width, height: m.height };
  } catch {
    publicDims = null;
  }
}
const ogDims = ogMeta ?? publicDims;
const heroAbs = data.ogImage
  ? ogMeta
    ? `${SITE_URL}${ogMeta.src}`
    : data.ogImage.startsWith("http")
      ? data.ogImage
      : `${SITE_URL}${data.ogImage}`
  : undefined;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
    { "@type": "ListItem", position: 3, name: catName, item: `${SITE_URL}${catUrl}` },
    { "@type": "ListItem", position: 4, name: data.title, item: postUrl },
  ],
};
// BlogPosting.image as ImageObject with real dimensions (and the alt text as
// caption). Falls back to a url-only ImageObject for the 15 public-path heroes
// whose dimensions are not statically known.
//
// Every blog hero is a photo Joe shot, so it carries the PERMISSIVE license
// (license = acquireLicensePage = imageLicense.photoLicenseUrl) plus credit,
// creator (reusing the existing shared Person @id node), and copyright. These
// fields are the single source of truth in src/config/site.ts.
const imageSchema = heroAbs
  ? {
      "@type": "ImageObject",
      url: heroAbs,
      ...(ogDims ? { width: ogDims.width, height: ogDims.height } : {}),
      ...(data.heroImageAlt ? { caption: data.heroImageAlt } : {}),
      license: imageLicense.photoLicenseUrl,
      acquireLicensePage: imageLicense.photoLicenseUrl,
      creditText: imageLicense.creditText,
      creator: { "@id": `${SITE_URL}/about-me/#person` },
      copyrightNotice: imageLicense.copyrightNotice,
    }
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": postUrl,
  headline: data.title,
  description: data.metaDescription || data.excerpt,
  image: imageSchema ? [imageSchema] : undefined,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.modified.toISOString(),
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  mainEntityOfPage: postUrl,
  articleSection: catName,
};
---

<Layout
  title={`${data.title} | Joe's Vintage Guitars`}
  description={data.metaDescription || data.excerpt}
  canonical={`/post/${entry.id}/`}
  ogImage={heroAbs}
  ogImageAlt={data.heroImageAlt || data.title}
  ogImageWidth={ogDims?.width ?? 1200}
  ogImageHeight={ogDims?.height ?? 630}
  ogType="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={data.modified.toISOString()}
  structuredData={[breadcrumbSchema, articleSchema]}
>
  <div class="bpost-header-backdrop" aria-hidden="true"></div>

  <article class="bpost">
    <div class="bpost__inner">
      <nav class="bpost__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
        <a href={catUrl}>{catName}</a>
      </nav>

      <a class="bpost__cat" href={catUrl}>{catName}</a>
      <h1 class="bpost__title">{data.title}</h1>
      <p class="bpost__meta">
        By <a href="/about-me/">{data.author}</a>
        <span aria-hidden="true">·</span>
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      </p>
    </div>

    {data.heroImage && (
      <figure class="bpost__hero">
        {heroMeta ? (
          <Image
            src={heroMeta}
            alt={data.heroImageAlt || data.title}
            width={1200}
            priority
          />
        ) : (
          <img
            src={assetSrc(data.heroImage)}
            alt={data.heroImageAlt || data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        )}
      </figure>
    )}

    <div class="bpost__inner">
      <div class="blog-prose">
        <Content />
      </div>

      <!-- Author box -->
      <aside class="bpost__author" aria-label="About the author">
        <img class="bpost__author-photo" src={assetSrc("images/about-me-joe-1.jpg")} alt="Joe Dampt, owner of Joe's Vintage Guitars" width="120" height="120" loading="lazy" decoding="async" />
        <div class="bpost__author-body">
          <p class="bpost__author-eyebrow">About the Author</p>
          <h2 class="bpost__author-name">{data.author}</h2>
          <p class="bpost__author-bio">
            Joe Dampt has spent decades buying, authenticating, and collecting vintage guitars. He handles
            Fender, Gibson, Martin, and other classics nationwide and shares what he learns from real
            instruments, not spec sheets. Have a guitar to identify or sell?
          </p>
          <div class="bpost__author-cta">
            <a class="bpost__btn" href={hrefs.tel}>Call {contact.phone}</a>
            <a class="bpost__btn bpost__btn--ghost" href="/about-me/">Meet Joe</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bpost-related" aria-label="Related posts">
      <div class="bpost__inner">
        <h2 class="bpost-related__h2">Keep Reading</h2>
        <div class="bpost-related__grid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <ContactSection />

  <script is:inline>document.body.classList.add("blog-post-page");</script>
</Layout>

<style is:global>
  /* Archetype-B: force the secondary-nav text dark over the white band. */
  body.blog-post-page header nav.border-b-\[6px\] a { color: var(--color-brand-brown) !important; }
  body.blog-post-page header nav.border-b-\[6px\] > ul > li > a { color: #fff !important; }
  body.blog-post-page header nav.border-b-\[6px\] > ul > li > a:hover { color: var(--color-brand-cream) !important; }
</style>

<style>
  .bpost-header-backdrop {
    background: var(--color-brand-rust-dark, #682412);
    height: 200px;
  }
  @media (max-width: 640px) {
    .bpost-header-backdrop { height: 160px; }
  }

  .bpost {
    background: #fff;
    color: var(--color-brand-brown, #3e2a14);
    padding: 40px 0 70px;
  }
  @media (max-width: 640px) {
    .bpost { padding-top: 24px; }
  }
  .bpost__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .bpost__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.82rem;
    color: var(--color-brand-brown-muted, #7a6a52);
    margin: 24px 0 18px;
  }
  .bpost__crumbs a {
    color: var(--color-brand-rust, #a03a1e);
    text-decoration: none;
  }
  .bpost__crumbs a:hover { text-decoration: underline; }

  .bpost__cat {
    display: inline-block;
    font-family: var(--font-display, Oswald), sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand-rust, #a03a1e);
    text-decoration: none;
    margin-bottom: 8px;
  }
  .bpost__cat:hover { text-decoration: underline; }

  .bpost__title {
    font-family: var(--font-display, Oswald), sans-serif;
    font-size: clamp(28px, 4.4vw, 46px);
    line-height: 1.12;
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 14px;
  }
  .bpost__meta {
    font-size: 0.92rem;
    color: var(--color-brand-brown-muted, #7a6a52);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .bpost__meta a {
    color: var(--color-brand-rust, #a03a1e);
    text-decoration: none;
  }
  .bpost__meta a:hover { text-decoration: underline; }

  .bpost__hero {
    max-width: 1100px;
    margin: 30px auto 8px;
    padding: 0 24px;
  }
  .bpost__hero img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  /* ---- Author box ---- */
  .bpost__author {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    margin-top: 56px;
    padding: 28px;
    background: var(--color-brand-cream, #eedfc0);
    border: 1px solid #e0cfa9;
    border-radius: 10px;
  }
  .bpost__author-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-brand-rust-dark, #682412);
    flex-shrink: 0;
  }
  .bpost__author-eyebrow {
    font-family: var(--font-display, Oswald), sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    color: var(--color-brand-rust, #a03a1e);
    margin: 0 0 2px;
  }
  .bpost__author-name {
    font-family: var(--font-display, Oswald), sans-serif;
    font-size: 1.5rem;
    color: var(--color-brand-brown, #3e2a14);
    margin: 0 0 8px;
  }
  .bpost__author-bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-brand-brown-warm, #4a3a24);
    margin: 0 0 14px;
  }
  .bpost__author-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .bpost__btn {
    font-family: var(--font-display, Oswald), sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: 9px 18px;
    border-radius: 4px;
    background: var(--color-brand-rust, #a03a1e);
    color: #fff;
    border: 1px solid var(--color-brand-rust, #a03a1e);
  }
  .bpost__btn:hover { background: var(--color-brand-rust-dark, #682412); }
  .bpost__btn--ghost {
    background: transparent;
    color: var(--color-brand-rust-dark, #682412);
    border-color: var(--color-brand-rust-dark, #682412);
  }
  .bpost__btn--ghost:hover { background: rgba(104, 36, 18, 0.08); }
  @media (max-width: 560px) {
    .bpost__author { flex-direction: column; align-items: center; text-align: center; }
    .bpost__author-cta { justify-content: center; }
  }

  /* ---- Related ---- */
  .bpost-related {
    background: #faf4e6;
    padding: 56px 0 64px;
    border-top: 1px solid #e3d4b4;
  }
  .bpost-related__h2 {
    font-family: var(--font-display, Oswald), sans-serif;
    font-size: 1.9rem;
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 28px;
  }
  .bpost-related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  @media (max-width: 900px) {
    .bpost-related__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .bpost-related__grid { grid-template-columns: 1fr; }
  }
  .bpost-related .bpost__inner { max-width: 1140px; }
</style>

<!-- Prose styling for the migrated Markdown body. Global because <Content />
     output isn't scoped to this component. -->
<style is:global>
  .blog-prose {
    font-size: 1.05rem;
    line-height: 1.72;
    color: #41331f;
  }
  .blog-prose > *:first-child { margin-top: 0; }
  .blog-prose p { margin: 0 0 1.2em; }
  .blog-prose h2,
  .blog-prose h3,
  .blog-prose h4 {
    font-family: var(--font-display, Oswald), sans-serif;
    color: var(--color-brand-rust-dark, #682412);
    line-height: 1.2;
    scroll-margin-top: 110px;
  }
  .blog-prose h2 {
    font-size: 1.7rem;
    margin: 1.9em 0 0.5em;
    padding-bottom: 0.25em;
    border-bottom: 2px solid #e7d8b7;
  }
  .blog-prose h3 { font-size: 1.32rem; margin: 1.5em 0 0.4em; color: var(--color-brand-rust, #a03a1e); }
  .blog-prose h4 { font-size: 1.1rem; margin: 1.3em 0 0.4em; color: var(--color-brand-brown, #3e2a14); }
  .blog-prose a { color: var(--color-brand-rust, #a03a1e); text-decoration: underline; }
  .blog-prose a:hover { color: var(--color-brand-rust-dark, #682412); }
  .blog-prose strong { color: var(--color-brand-brown, #3e2a14); }
  .blog-prose ul,
  .blog-prose ol { margin: 0 0 1.3em; padding-left: 1.5em; }
  .blog-prose li { margin: 0 0 0.5em; }
  .blog-prose blockquote {
    margin: 1.6em 0;
    padding: 0.6em 1.2em;
    border-left: 4px solid var(--color-brand-rust, #a03a1e);
    background: #faf4e6;
    font-style: italic;
    color: var(--color-brand-brown-warm, #4a3a24);
  }
  .blog-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }
  .blog-prose figure {
    margin: 1.8em 0;
  }
  .blog-prose figure img { margin: 0 auto; }
  .blog-prose figcaption {
    margin-top: 0.6em;
    font-size: 0.85rem;
    color: var(--color-brand-brown-muted, #7a6a52);
    text-align: center;
    font-style: italic;
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
  }
  .blog-prose th,
  .blog-prose td {
    border: 1px solid #e0cfa9;
    padding: 9px 12px;
    text-align: left;
    vertical-align: top;
  }
  .blog-prose thead th {
    background: var(--color-brand-rust-dark, #682412);
    color: #fff;
    font-family: var(--font-display, Oswald), sans-serif;
    font-weight: 600;
  }
  .blog-prose tbody tr:nth-child(even) { background: #faf4e6; }
  .blog-prose hr { border: none; border-top: 1px solid #e3d4b4; margin: 2em 0; }
  @media (max-width: 640px) {
    .blog-prose { font-size: 1rem; }
    .blog-prose table { display: block; overflow-x: auto; white-space: nowrap; }
  }
</style>
