---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import ContactSection from "../../components/ContactSection.astro";
import MartinSmallBodyGuide from "../../components/MartinSmallBodyGuide.astro";
import MartinD18Guide from "../../components/MartinD18Guide.astro";
import GibsonJ200Guide from "../../components/GibsonJ200Guide.astro";
import DennisHiattLesPaulStory from "../../components/DennisHiattLesPaulStory.astro";
import BobDentonJ200Story from "../../components/BobDentonJ200Story.astro";
import CaliforniaL5CStory from "../../components/CaliforniaL5CStory.astro";
import OneFamilyES355Story from "../../components/OneFamilyES355Story.astro";
import SylviaES335Story from "../../components/SylviaES335Story.astro";
import OneOwnerES345Story from "../../components/OneOwnerES345Story.astro";
import { SITE_URL, hrefs, contact, imageLicense } from "../../config/site";
import { getPublishedPosts, getRelated, categoryName, formatDate } from "../../lib/blog";
import { resolveImage, assetSrc } from "../../lib/images";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: getRelated(posts, entry, 3) },
  }));
}) satisfies GetStaticPaths;

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const isMartinSmallBodyGuide = entry.id === "martin-0-00-000-history-authentication-value-guide";
const isMartinD18Guide = entry.id === "martin-d18-history-specs-authentication-value-guide";
const isCustomMartinGuide = isMartinSmallBodyGuide || isMartinD18Guide;
const isDennisHiattStory = entry.id === "one-owner-1983-gibson-les-paul-custom";
const isBobDentonJ200Story = entry.id === "bob-denton-1955-gibson-j200";
const isCaliforniaL5CStory = entry.id === "1954-gibson-l5c-california-session-musician";
const isOneFamilyES355Story = entry.id === "one-family-1959-gibson-es-355";
const isSylviaES335Story = entry.id === "sylvias-1959-gibson-es-335";
const isOneOwnerES345Story = entry.id === "one-owner-1966-gibson-es-345";
const isFirebirdGuide = entry.id === "gibson-firebird-history-authentication-value";
const isGibsonJ200Guide = entry.id === "gibson-j200-model-history-authentication-guide";

const postUrl = `${SITE_URL}/post/${entry.id}/`;
const catName = categoryName(data.category, data.categoryName);
const catUrl = `/category/${data.category}/`;
// og:image must be absolute. When the file was relocated under src/assets the
// shim returns pipeline metadata (hashed /_astro/ URL); otherwise the original
// public path passes through unchanged.
const ogMeta = data.ogImage ? resolveImage(data.ogImage) : null;

// Author-box portrait. The file is 587x587 / 79.7KB and renders in a 120px slot,
// so serving it raw from public/ wasted ~70KB on EVERY blog post (57 pages). It
// already exists under src/assets, so route it through the pipeline instead.
// The asset lives in the fender-sn folder for historical reasons (identical
// copies also sit in gibson-serial/ and public/); it is a shared site asset, not
// a Fender-specific one. Falls back to the raw public path if it ever moves.
const authorPhoto = resolveImage("images/fender-sn/about-me-joe-1.jpg");
// Hero: pipeline metadata when relocated (responsive <Image>), public path
// fallback otherwise (raw <img>, the 15 raw-HTML-blocked heroes).
const heroMeta = data.heroImage ? resolveImage(data.heroImage) : null;

// Real pixel dimensions for the public-path heroes too: read once at build
// with sharp so og:image:width/height and the BlogPosting ImageObject never
// carry made-up numbers. Build-time only; ships nothing to the client.
let publicDims: { width: number; height: number } | null = null;
if (!ogMeta && data.ogImage && data.ogImage.startsWith("/images/")) {
  try {
    const sharp = (await import("sharp")).default;
    const m = await sharp(`public${data.ogImage}`).metadata();
    if (m.width && m.height) publicDims = { width: m.width, height: m.height };
  } catch {
    publicDims = null;
  }
}
const ogDims = ogMeta ?? publicDims;
const heroAbs = data.ogImage
  ? ogMeta
    ? `${SITE_URL}${ogMeta.src}`
    : data.ogImage.startsWith("http")
      ? data.ogImage
      : `${SITE_URL}${data.ogImage}`
  : undefined;
const articleHeroAbs = data.heroImage
  ? heroMeta
    ? `${SITE_URL}${heroMeta.src}`
    : data.heroImage.startsWith("http")
      ? data.heroImage
      : `${SITE_URL}${data.heroImage}`
  : heroAbs;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
    { "@type": "ListItem", position: 3, name: catName, item: `${SITE_URL}${catUrl}` },
    { "@type": "ListItem", position: 4, name: data.title, item: postUrl },
  ],
};
// BlogPosting.image as ImageObject with real dimensions (and the alt text as
// caption). Falls back to a url-only ImageObject for the 15 public-path heroes
// whose dimensions are not statically known.
//
// Every blog hero is a photo Joe shot, so it carries the PERMISSIVE license
// (license = acquireLicensePage = imageLicense.photoLicenseUrl) plus credit,
// creator (reusing the existing shared Person @id node), and copyright. These
// fields are the single source of truth in src/config/site.ts.
const imageSchema = heroAbs
  ? {
      "@type": "ImageObject",
      url: articleHeroAbs,
      ...(heroMeta
        ? { width: heroMeta.width, height: heroMeta.height }
        : ogDims
          ? { width: ogDims.width, height: ogDims.height }
          : {}),
      ...(data.heroImageAlt ? { caption: data.heroImageAlt } : {}),
      ...(data.heroImageLicensed
        ? {
            license: imageLicense.photoLicenseUrl,
            acquireLicensePage: imageLicense.photoLicenseUrl,
            creditText: imageLicense.creditText,
            creator: { "@id": `${SITE_URL}/about-me/#person` },
            copyrightNotice: imageLicense.copyrightNotice,
          }
        : {}),
    }
  : undefined;

// Optional VideoObject for posts that embed one of Joe's YouTube videos. The
// chapter list becomes a Clip array, which is the shape Google reads for key
// moments; each Clip's endOffset is the next chapter's start, and the last one
// runs to the end of the video. All metadata comes from the watch page.
const vid = data.video;
const videoSchema = vid
  ? {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "@id": `${postUrl}#video`,
      name: vid.title,
      description: vid.description,
      thumbnailUrl: `https://i.ytimg.com/vi/${vid.id}/maxresdefault.jpg`,
      uploadDate: vid.uploadDate,
      duration: `PT${Math.floor(vid.seconds / 60)}M${vid.seconds % 60}S`,
      embedUrl: `https://www.youtube.com/embed/${vid.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${vid.id}`,
      author: { "@id": `${SITE_URL}/about-me/#person` },
      ...(vid.chapters.length
        ? {
            hasPart: vid.chapters.map((c, i) => ({
              "@type": "Clip",
              name: c.name,
              startOffset: c.start,
              endOffset: vid.chapters[i + 1]?.start ?? vid.seconds,
              url: `${postUrl}#video`,
            })),
          }
        : {}),
    }
  : null;

const martinGuideFaqs = [
  { q: "What is the difference between a Martin 0, 00, and 000?", a: "The number identifies the body-size family. A size 0 is the smallest of the three, a 00 is the middle Grand Concert size, and a 000 is the larger Auditorium body. Exact dimensions and tone also depend on the year and whether the guitar has a 12-fret or 14-fret neck joint." },
  { q: "How do I date a vintage Martin 0, 00, or 000?", a: "Begin with the serial number and complete model stamp, then compare the neck joint, headstock, frets, neck reinforcement, bracing, bridge, bridge plate, tuners, woods, and trim with the expected features for that production period. No single feature should be used by itself." },
  { q: "Where is the serial number on a vintage Martin guitar?", a: "On many later vintage Martins, the model and serial number are stamped on the neck block inside the body. Earlier instruments may use a serial stamp, backstrip stamp, headstock stamp, or label, so the location depends on the period." },
  { q: "Is a 12-fret Martin more valuable than a 14-fret Martin?", a: "Not automatically. Early 12-fret Martins can be scarce and highly desirable, while golden-era 14-fret steel-string examples also command strong prices. Model, year, construction, originality, condition, repairs, and sound determine the market." },
  { q: "What is the difference between a Martin OM and a 000?", a: "The classic OM and 14-fret 000 share the same basic body outline. A traditional OM uses a long scale near 25.4 inches and early orchestra-model specifications, while most later standard 000 models use a shorter scale near 24.9 inches. Special editions can mix these features." },
  { q: "Which vintage Martin 0, 00, and 000 guitars are most collectible?", a: "Demand is strongest for original prewar steel-string examples, especially pearl-trimmed Styles 42 and 45, pre-1947 herringbone Style 28 guitars, and lightly built scalloped-brace instruments from the late 1920s through the early 1940s. Scarcity and condition can change the hierarchy." },
  { q: "Can I put steel strings on a 1920s Martin?", a: "Do not choose string tension from the year or model name alone. Some were built for gut, some for Hawaiian steel, and some were converted later. A qualified repair specialist should inspect the top, bridge, bridge plate, bracing, neck angle, and previous repairs first." },
  { q: "How much is an old Martin 0, 00, or 000 worth?", a: "Value starts with recent sold examples of the same model, year band, and condition. It is then adjusted for originality, structural health, repairs, wood, bracing period, rarity, provenance, sound, and current demand. An appraisal requires photographs and inspection details from the individual guitar." },
  { q: "Are Martin 0 and 00 guitars considered parlor guitars?", a: "Sellers often use parlor guitar as a broad search term for small acoustics, but Martin's traditional names are more precise: size 0 is Concert and size 00 is Grand Concert. Dimensions, scale, and neck joint are better identification evidence than the informal parlor label." },
];

const martinD18Faqs = [
  { q: "What years are the most valuable Martin D-18 guitars?", a: "Original 1930s D-18s, especially forward-braced examples from 1934 through the 1938 transition, generally lead the market. Later prewar and wartime scalloped-brace guitars are also highly collectible. Condition, originality, repairs, and sound can change the order." },
  { q: "When did Martin stop scalloping D-18 braces?", a: "The factory transition occurs during late 1944 rather than at a perfectly clean model-year boundary. A 1944 D-18 should be inspected internally because serial number and brace carving together establish which construction it has." },
  { q: "When did Martin change the D-18 from Adirondack to Sitka spruce?", a: "Red spruce, commonly called Adirondack in the vintage market, continued through the wartime period and into the postwar transition. Sitka spruce became normal during 1946. Transitional guitars should be evaluated individually." },
  { q: "What is the difference between a Martin D-18 and D-28?", a: "A traditional D-18 has mahogany back and sides with restrained Style 18 trim. A D-28 has rosewood back and sides and Style 28 appointments. Players often describe the D-18 as dry and direct and the D-28 as overtone-rich, but individual guitars vary." },
  { q: "How can I tell if a vintage Martin D-18 is original?", a: "Start with the neck-block model and serial stamps, then inspect the woods, X-brace location, brace carving, neck reinforcement, bridge, bridge plate, pickguard, finish, tuners, frets, and repair history. The features must agree with one another and the production period." },
  { q: "Does a neck reset reduce the value of a Martin D-18?", a: "A professionally executed neck reset is accepted maintenance on many old Martins and can improve usability. Poor workmanship, heel damage, finish disturbance, or altered geometry can reduce value. A shaved bridge used to postpone a reset is usually a larger concern." },
  { q: "How much is a vintage Martin D-18 worth?", a: "Joe's broad published ranges run from about $3,000 to $6,000 for many 1960s examples up to $25,000 to $110,000 for prewar guitars. Those are orientation ranges, not an offer. Year, bracing, originality, condition, repairs, provenance, and sound determine an individual value." },
  { q: "What do D-18S, D-18E, D-18V, D-18GE, and D-18 Authentic mean?", a: "They identify materially different variants: 12-fret or special construction, factory electronics, Vintage Series, Golden Era, and historically targeted Authentic recreations. The complete suffix and production year are essential because these models do not share one specification or value range." },
];

const activeMartinFaqs = isMartinD18Guide ? martinD18Faqs : martinGuideFaqs;

const martinFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${postUrl}#faq-schema`,
  mainEntity: activeMartinFaqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const firebirdFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${postUrl}#faq-schema`,
  mainEntity: [
    { "@type": "Question", name: "How much is a vintage Gibson Firebird worth?", acceptedAnswer: { "@type": "Answer", text: "Broad 2026 retail-market guides range from about $5,500 for some Bicentennial examples to $28,000 to $50,000+ for reverse Firebird VIIs. Originality, condition, repairs, playability, provenance, color, and sold comparables determine the value of an individual guitar." } },
    { "@type": "Question", name: "How do you date a Gibson Firebird?", acceptedAnswer: { "@type": "Answer", text: "Use the serial as one clue, then compare construction, potentiometer codes, pickup construction, hardware, finish, solder, and repair evidence. Overlapping serial ranges mean one number is not enough." } },
    { "@type": "Question", name: "What separates a reverse Firebird from a non-reverse model?", acceptedAnswer: { "@type": "Answer", text: "The 1963 to 1965 reverse design has a raised neck-through center, attached wings, a reverse headstock, and banjo-style tuners. The non-reverse model introduced in 1965 has a flatter body, a glued-in neck, conventional tuners, and a large pickguard carrying much of the wiring." } },
  ],
};

const j200Faqs = [
  { q: "What is the difference between a Gibson SJ-200 and J-200?", a: "They are names Gibson has used for the same flagship Super Jumbo family. Catalogs, factory labels, and shipping records did not always change names together. The complete year, label, woods, bridge, bracing, and other construction details identify the specific version." },
  { q: "When did Gibson change the SJ-200 from rosewood to maple?", a: "Maple became the normal back and side wood when postwar production resumed in 1947 and 1948. Prewar standard examples used rosewood, while later custom, J-250R, Western Classic, Custom, Pre-War, and rosewood-branded variants can use rosewood again." },
  { q: "How do you date a vintage Gibson J-200?", a: "Record the serial number, factory order number, and label, then compare the woods, bracing, bridge, bridge plate, neck construction, tuners, pickguard, finish, and repairs with the expected period. Gibson serial ranges can overlap, so one number is not enough." },
  { q: "When did the J-200 get an adjustable Tune-o-matic bridge?", a: "The closed moustache bridge and adjustable metal Tune-o-matic saddle arrived around 1961. The change also brought a larger bridge plate, bolts, an enlarged neck block, and added top-support hardware. Many guitars were converted later, so inspect for filled holes and missing braces." },
  { q: "Is a J-200N a different model?", a: "The N normally identifies the natural-finish version in postwar factory records and price lists. The year still determines its bridge, bracing, neck, label, and other specifications." },
  { q: "Is a J-200 Artist the same as a standard J-200?", a: "No. The Norlin-era J-200 Artist is a related Super Jumbo model with its own body, Dove-style bridge, trim, bracing, neck, and label specifications. It should be identified and valued as an Artist." },
  { q: "How can you tell a real Gibson J-200 from a copy?", a: "Authenticate the full construction rather than the logo. Check body dimensions, neck joint, internal braces and tool marks, bridge and bridge plate, label, serial format, headstock, tuners, binding, finish, and repair evidence. A skilled copy can reproduce the visible decoration." },
  { q: "Which vintage Gibson J-200 years are most collectible?", a: "Verified prewar rosewood Super Jumbos generally lead the market because production was tiny. Lightly braced 1947 to 1951 maple examples and original 1950s guitars also draw strong demand. Condition, originality, repairs, sound, provenance, and exact variant can reorder the market." },
];

const j200FaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${postUrl}#faq-schema`,
  mainEntity: j200Faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": postUrl,
  headline: data.title,
  description: data.metaDescription || data.excerpt,
  image: imageSchema ? [imageSchema] : undefined,
  datePublished: data.pubDate.toISOString(),
  dateModified: data.modified.toISOString(),
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  mainEntityOfPage: postUrl,
  articleSection: catName,
  inLanguage: "en-US",
  isAccessibleForFree: true,
  ...(isCustomMartinGuide ? {
    keywords: isMartinD18Guide
      ? ["Martin D-18", "vintage Martin D-18", "Martin D-18 value", "Martin D-18 specifications", "Martin D-18 authentication", "Martin D-18 bracing"]
      : ["Martin 0", "Martin 00", "Martin 000", "vintage Martin guitars", "Martin serial numbers", "Martin guitar value", "Martin guitar authentication"],
    about: [
      { "@type": "Thing", name: "C. F. Martin & Company" },
      { "@type": "Thing", name: "Vintage acoustic guitars" },
      { "@type": "Thing", name: "Guitar authentication" },
    ],
  } : {}),
  ...(isGibsonJ200Guide ? {
    keywords: ["Gibson J-200", "Gibson SJ-200", "vintage Gibson J-200", "Gibson J-200 history", "Gibson J-200 models", "Gibson J-200 authentication", "Gibson J-200 serial numbers"],
    about: [
      { "@type": "Thing", name: "Gibson J-200" },
      { "@type": "Thing", name: "Gibson SJ-200" },
      { "@type": "Thing", name: "Vintage acoustic guitars" },
      { "@type": "Thing", name: "Guitar authentication" },
    ],
  } : {}),
};
---

<Layout
  bodyClass={isFirebirdGuide ? "blog-post-page firebird-guide-page" : "blog-post-page"}
  title={`${data.title} | Joe's Vintage Guitars`}
  description={data.metaDescription || data.excerpt}
  canonical={`/post/${entry.id}/`}
  ogImage={heroAbs}
  ogImageAlt={data.heroImageAlt || data.title}
  ogImageWidth={ogDims?.width ?? 1200}
  ogImageHeight={ogDims?.height ?? 630}
  ogType="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={data.modified.toISOString()}
  structuredData={isGibsonJ200Guide
    ? [breadcrumbSchema, articleSchema, j200FaqSchema]
    : isCustomMartinGuide
    ? [breadcrumbSchema, articleSchema, martinFaqSchema]
    : isFirebirdGuide
      ? [breadcrumbSchema, articleSchema, firebirdFaqSchema]
    : videoSchema
      ? [breadcrumbSchema, articleSchema, videoSchema]
      : [breadcrumbSchema, articleSchema]}
>
  {vid && (
    <>
      <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
      <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>
    </>
  )}

  {isSylviaES335Story ? (
    <SylviaES335Story />
  ) : isOneOwnerES345Story ? (
    <OneOwnerES345Story />
  ) : isOneFamilyES355Story ? (
    <OneFamilyES355Story />
  ) : isCaliforniaL5CStory ? (
    <CaliforniaL5CStory />
  ) : isBobDentonJ200Story ? (
    <BobDentonJ200Story />
  ) : isDennisHiattStory ? (
    <DennisHiattLesPaulStory />
  ) : isGibsonJ200Guide ? (
    <GibsonJ200Guide faqs={j200Faqs} />
  ) : isMartinD18Guide ? (
    <MartinD18Guide faqs={martinD18Faqs} />
  ) : isMartinSmallBodyGuide ? (
    <MartinSmallBodyGuide faqs={martinGuideFaqs} />
  ) : (
    <>
  {!isFirebirdGuide && <div class="bpost-header-backdrop" aria-hidden="true"></div>}

  {data.toc.length > 0 && (
    <>
      <aside class="bpost-toc" id="bpost-toc" aria-label="Table of contents">
        <p class="bpost-toc__label">Table of Contents</p>
        <ul class="bpost-toc__list">
          {data.toc.map((t) => (
            <li>
              <a href={t.href} class={t.sub ? "bpost-toc__sub" : "bpost-toc__top"}>{t.label}</a>
            </li>
          ))}
        </ul>
      </aside>

      <button
        class="bpost-toc-fab"
        id="bpost-toc-fab"
        type="button"
        aria-expanded="false"
        aria-controls="bpost-toc-sheet"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" />
          <line x1="3" y1="6" x2="3.01" y2="6" /><line x1="3" y1="12" x2="3.01" y2="12" /><line x1="3" y1="18" x2="3.01" y2="18" />
        </svg>
        Sections
      </button>
      <div class="bpost-toc-sheet" id="bpost-toc-sheet" role="dialog" aria-label="Table of contents">
        <div class="bpost-toc-sheet__head">
          Jump to a Section
          <button class="bpost-toc-sheet__close" id="bpost-toc-sheet-close" type="button" aria-label="Close">&times;</button>
        </div>
        <div class="bpost-toc-sheet__body" id="bpost-toc-sheet-body"></div>
      </div>
    </>
  )}

  <article class="bpost">
    {!isFirebirdGuide && <div class="bpost__inner">
      <nav class="bpost__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a><span aria-hidden="true">/</span>
        <a href={catUrl}>{catName}</a>
      </nav>

      <a class="bpost__cat" href={catUrl}>{catName}</a>
      <h1 class="bpost__title">{data.title}</h1>
      <p class="bpost__meta">
        By <a href="/about-me/">{data.author}</a>
        <span aria-hidden="true">·</span>
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      </p>
    </div>}

    {!isFirebirdGuide && data.heroImage && (
      <figure class="bpost__hero">
        {heroMeta ? (
          <Image
            src={heroMeta}
            alt={data.heroImageAlt || data.title}
            width={1200}
            priority
          />
        ) : (
          <img
            src={assetSrc(data.heroImage)}
            alt={data.heroImageAlt || data.title}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
          />
        )}
      </figure>
    )}

    <div class="bpost__inner">
      <div class="blog-prose">
        <Content />
      </div>

      <!-- Author box -->
      <aside class="bpost__author" aria-label="About the author">
        {authorPhoto ? (
          <Image class="bpost__author-photo" src={authorPhoto} alt="Joe Dampt, owner of Joe's Vintage Guitars" width={120} height={120} loading="lazy" decoding="async" />
        ) : (
          <img class="bpost__author-photo" src={assetSrc("images/about-me-joe-1.jpg")} alt="Joe Dampt, owner of Joe's Vintage Guitars" width="120" height="120" loading="lazy" decoding="async" />
        )}
        <div class="bpost__author-body">
          <p class="bpost__author-eyebrow">About the Author</p>
          <h2 class="bpost__author-name">{data.author}</h2>
          <p class="bpost__author-bio">
            Joe Dampt has spent decades buying, authenticating, and collecting vintage guitars. He handles
            Fender, Gibson, Martin, and other classics nationwide and shares what he learns from real
            instruments, not spec sheets. Have a guitar to identify or sell?
          </p>
          <div class="bpost__author-cta">
            <a class="bpost__btn" href={hrefs.tel}>Call {contact.phone}</a>
            <a class="bpost__btn bpost__btn--ghost" href="/about-me/">Meet Joe</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="bpost-related" aria-label="Related posts">
      <div class="bpost__inner">
        <h2 class="bpost-related__h2">Keep Reading</h2>
        <div class="bpost-related__grid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}
    </>
  )}

  <ContactSection />

  <!-- Floating TOC behavior: hide the sidebar over the contact form, and power
       the mobile "Sections" button by cloning the sidebar links into the sheet.
       No-ops when the post has no `toc` (elements absent). -->
  <script is:inline>
    (function () {
      function initTocHide() {
        var toc = document.getElementById("bpost-toc");
        var contact = document.getElementById("contact");
        if (!toc || !contact || !("IntersectionObserver" in window)) return;
        var obs = new IntersectionObserver(
          function (entries) {
            toc.classList.toggle("bpost-toc--hidden", entries[0].isIntersecting);
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        obs.observe(contact);
      }
      function initMobileToc() {
        var fab = document.getElementById("bpost-toc-fab");
        var sheet = document.getElementById("bpost-toc-sheet");
        var body = document.getElementById("bpost-toc-sheet-body");
        var closeBtn = document.getElementById("bpost-toc-sheet-close");
        var srcList = document.querySelector(".bpost-toc .bpost-toc__list");
        if (!fab || !sheet || !body || !srcList) return;
        body.appendChild(srcList.cloneNode(true));
        function open() { sheet.classList.add("bpost-toc-sheet--open"); fab.setAttribute("aria-expanded", "true"); }
        function close() { sheet.classList.remove("bpost-toc-sheet--open"); fab.setAttribute("aria-expanded", "false"); }
        fab.addEventListener("click", function (e) {
          e.stopPropagation();
          sheet.classList.contains("bpost-toc-sheet--open") ? close() : open();
        });
        if (closeBtn) closeBtn.addEventListener("click", close);
        body.addEventListener("click", function (e) { if (e.target.closest("a")) close(); });
        document.addEventListener("click", function (e) {
          if (!sheet.contains(e.target) && !fab.contains(e.target)) close();
        });
      }
      function init() { initTocHide(); initMobileToc(); }
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</Layout>

