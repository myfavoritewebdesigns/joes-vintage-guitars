---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { assetSrc, resolveImage } from "../lib/images";
import Button from "../components/primitives/Button.astro";
import ContactSection from "../components/ContactSection.astro";
import FAQ from "../components/FAQ.astro";
import { SITE_URL, contact, hrefs } from "../config/site";
import testimonialsRaw from "../../reference/testimonials.json";

// Reviews — sourced from reference/testimonials.json, a scrape of Joe's
// Google Business Profile reviews. Each entry has a direct review link
// (much better UX than a generic Maps link). All 6 are 5-star reviews;
// stars are rendered uniformly by the template — no need to store rating
// per-review unless we later mix lower ratings.
//
// v10 (2026-05-26): bumped from 3 hard-coded reviews to all 6 from the
// scrape per user request; cards now stack Pinterest-style via CSS columns.
const reviews: { name: string; link: string; body: string }[] = testimonialsRaw;

// Instagram reels — exact post permalinks from live's sell-my-fender page.
// Live loads www.instagram.com/embed.js which scans for any .instagram-media
// blockquote and renders it as a styled iframe. We add the same script via
// the Layout `head` slot (one-time load, same pattern as lite-youtube).
//
// v10 (2026-05-26): added per user request. Earlier decision-log row
// ("IG embeds NOT replicated") superseded — user explicitly wants them now.
const igPosts = [
  {
    permalink: "https://www.instagram.com/reel/DWCSaGtD4qS/",
    headline: "1966 Fender Stratocaster",
    subtitle: "Sacred Heart of Mary, not your typical Strat",
    body: "This ’66 Stratocaster is one of a kind. A Sacred Heart of Mary painting on the body sets it apart from any other Strat. Watch it play and see the details for yourself.",
  },
  {
    permalink: "https://www.instagram.com/reel/DUO_ZAqkq8F/",
    headline: "1967 Fender Coronado in Antigua Finish",
    subtitle: "Guitar pick of the week, and it sounds as good as it looks",
    body: "Light, comfortable, and a great-sounding player. This ’67 Coronado in Antigua finish turns heads before you play a note.",
  },
  {
    permalink: "https://www.instagram.com/reel/DT3vdFFkps8/",
    headline: "Early 1960s Fender Blonde Cabinet",
    subtitle: "Calling all Fender nerds: has anyone seen this before?",
    body: "This early ’60s 3×10 blonde cabinet has all the signs of Fender construction, but it’s shorter and wider than a Dual Showman cab. We’re still digging into it. If you know what it is, we’d love to hear from you.",
  },
];

// Live image base — kept hot-linked for first-pass parity. Swap to /images/sell-fender/ later.
const smfImg = (file: string) => assetSrc("images/sell-fender/" + file);
// Metadata twin of smfImg for <Image> conversions (SEO v2 responsive images).
// Non-null assertion is safe only for files verified to exist under
// src/assets/images/sell-fender/ — the page's SVG icons are public/-only
// and stay on smfImg + raw <img>.
const smfImgMeta = (file: string) => resolveImage("images/sell-fender/" + file)!;

// 2026-05 audit fix v5: REVERTING the v3 "no photo" decision.
// Live's hero is actually a B&W photo of vintage guitar collectors with a
// dark vignette overlay (NOT a rust gradient — that was the wrong conclusion
// from the v2 audit). Restoring the photo bg using live's exact image URL.
// Verified via `getComputedStyle(.tp-bnr).backgroundImage` on the live page.
const HERO_BG = assetSrc("images/sell-hero-background.jpg");

// FAQs sourced from live JSON-LD (reference/sell-my-fender-jsonld.json, FAQPage entity).
// IDs match live's wpcf7-generated `toggle_*` IDs so anchor links from external pages still work.
const faqs = [
  {
    id: "toggle_e5a80b5c1eab84219",
    q: "What Factors Are Most Crucial in Determining The Value of a Vintage Fender Guitar?",
    a: "Value comes down to condition, rarity, originality, and provenance. I go over each of those carefully so the appraisal reflects what your guitar is actually worth.",
  },
  {
    id: "toggle_098b6f29162bd1430",
    q: "What Documentation is Essential for Appraising a Vintage Fender Guitar?",
    a: "Original purchase receipts, repair records, and anything that documents the guitar&rsquo;s history all help. The more paperwork you have, the easier it is to authenticate and appraise your Fender accurately.",
  },
  {
    id: "toggle_157b1d9a99dd3b7ee",
    q: "Are There Specific Models Of Vintage Fender Guitars That Are Particularly Sought After?",
    a: "Yes. Stratocasters and Telecasters from the &rsquo;50s and &rsquo;60s are the most sought after. I collect, buy, and appraise these models, so I know what separates a good one from a great one.",
  },
  {
    id: "toggle_e5bcf276f553f9570",
    q: "Is There a Difference in Value Between Vintage Fender Stratocasters and Telecasters?",
    a: "Yes. Value varies with age, condition, and rarity, and it can swing quite a bit between two guitars that look alike. I appraise each one on its own so the price reflects those differences.",
  },
  {
    id: "toggle_a9d76fb4ce52b7088",
    q: "What Should I Look for in an Appraiser When Getting My Vintage Fender Guitar Valued?",
    a: "Look for someone who really knows vintage Fenders, has a solid reputation, and can point to references. I&rsquo;ve spent years doing this and stand behind every valuation I give.",
  },
];

// 7 model cards — content + photos from live's "I'm Currently Paying Top Dollar" grid
const models = [
  {
    img: smfImgMeta("1956-fender-stratocaster-sunburst-800x533.jpg"),
    alt: "Vintage 1956 sunburst Fender Stratocaster electric guitar",
    title: "Fender Stratocaster",
    body: "Buying 1950s and Pre-CBS 1960s Stratocasters. I pay a premium for all-original examples, Custom Color finishes, and early 'spaghetti' logo models.",
  },
  {
    img: smfImgMeta("1960-fender-telecaster-blonde-800x533.jpg"),
    alt: "Vintage 1960 blonde Fender Telecaster electric guitar",
    title: "Fender Telecaster",
    body: "Buying Fullerton-era Telecasters, Broadcasters, and No-casters. I know the Blackguard '50s models and early '60s slab-board guitars inside and out.",
  },
  {
    img: smfImgMeta("1965-fender-jazzmaster-charcoal-frost-800x533.jpg"),
    alt: "Vintage 1965 charcoal frost Fender Jazzmaster",
    title: "Fender Jazzmaster",
    body: "Buying Pre-CBS Jazzmasters. I pay extra for clay-dot inlays, original anodized guards, and clean Custom Color finishes.",
  },
  {
    img: smfImgMeta("1952-fender-precision-bass-800x533.jpg"),
    alt: "Vintage 1952 Fender Precision Bass",
    title: "Fender Precision Bass",
    body: "Buying vintage P-Basses, especially early 'slab-body' '50s designs and early '60s split-coil models with original hardware.",
  },
  {
    img: smfImgMeta("1964-fender-jaguar-sunburst-800x533.jpg"),
    alt: "Vintage 1964 sunburst Fender Jaguar",
    title: "Fender Jaguar",
    body: "Looking for early 1960s Jaguars with original mutes and Pre-CBS specs. I pay cash for these chrome-heavy offsets.",
  },
  {
    img: smfImgMeta("1972-fender-mustang-competition-blue-800x533.jpg"),
    alt: "1972 Fender Mustang Competition in blue with green stripe",
    title: "Fender Mustang",
    body: "Buying 1960s and '70s Mustangs. I pay extra for original 'Competition' finishes and clean short-scale Fullerton models.",
  },
  {
    img: smfImgMeta("1972-fender-jazz-bass-sunburst-800x533.jpg"),
    alt: "1972 sunburst Fender Jazz Bass",
    title: "Fender Jazz Bass",
    body: "Buying vintage J-Basses, especially early '60s 'stack-knob' versions and '70s models with original block inlays and binding.",
  },
];

// Serial-number dropdown options — direct port from live wpcf7 form
const serialOptions = [
  "I'm not sure",
  "Four or five digits on BRIDGE plate (1950 - 1954)",
  "Four or five digits on the NECK plate (1954 - 1963)",
  "Serial numbers that start with the letter L on the NECK plate (1963-1965)",
  "6 digit NECK plate serial numbers with large F logo underneath (1965 -1976)",
  "Serial number on the front or back of the headstock (1977 - present)",
  "Serial number on the NECK plate that starts with a V (1982 and up reissue models)",
  "Import guitars made in Japan and Mexico",
];

// Page-specific JSON-LD: FAQPage + Article + BreadcrumbList
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a.replace(/&rsquo;/g, "'").replace(/<[^>]+>/g, "") },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Sell My Fender Guitar", item: "https://www.joesvintageguitarsaz.com/sell-my-fender-guitar/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Sell Your Vintage Fender Guitar",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: "https://www.joesvintageguitarsaz.com/sell-my-fender-guitar/",
  },
  // VideoObject for the Meet Joe embed. uploadDate and duration were looked up
  // from YouTube on 2026-06-11 (89 seconds), never fabricated.
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Meet Vintage Guitar Buyer Joe Dampt",
    description:
      "Joe Dampt introduces himself and explains how selling your vintage Fender guitar to Joe's Vintage Guitars works.",
    thumbnailUrl: "https://i.ytimg.com/vi/U3eJgXLs4w8/hqdefault.jpg",
    uploadDate: "2024-06-04T20:04:06-07:00",
    duration: "PT1M29S",
    embedUrl: "https://www.youtube.com/embed/U3eJgXLs4w8",
    contentUrl: "https://www.youtube.com/watch?v=U3eJgXLs4w8",
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
  },
];
---

<Layout
  title="Sell My FENDER Guitar | Joe's Vintage Guitars"
  description="Sell your vintage Fender guitar to a trusted specialist. Expert appraisals, top-dollar cash offers, and stress-free nationwide shipping for Stratocasters, Telecasters, Jazzmasters, Precision Basses and more."
  canonical="/sell-my-fender-guitar/"
  ogImage={`${SITE_URL}${smfImg("Guitar.png")}`}
  structuredData={structuredData}
>
  <!-- lite-youtube web component (paulirish/lite-youtube-embed) — matches live's
       Meet Joe video element. Renders the YouTube thumbnail + red play button
       instantly, swaps to iframe only on click. Same component live uses. -->
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.css" />
  <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.js" defer></script>

  <!-- Instagram embed script — scans every `.instagram-media` blockquote on
       the page and renders it as a styled IG iframe. Same script live loads.
       v10 (2026-05-26): added for the 3 IG reels in the testimonials section. -->
  <script slot="head" is:inline async src="https://www.instagram.com/embed.js"></script>

  <!-- 1. Hero — B&W vintage-shop photo with dark vignette overlay
       (matches live's .tp-bnr structure verified via DOM inspection) -->
  <section class="smf-hero" style={`background-image: url('${HERO_BG}')`}>
    <div class="smf-hero__inner">
      <h1>Sell Your Vintage Fender Guitar</h1>
      <h2 class="smf-hero__subtitle">Expert Buyer &amp; Collector Specializing in Rare &amp; Vintage Fender Guitars</h2>
      <div class="smf-hero__rule" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 2. Intro + serial-number form -->
  <section class="smf-intro">
    <div class="smf-inner smf-intro__grid">
      <!-- LEFT: guitar photo + intro copy -->
      <div class="smf-intro__copy">
        <div class="smf-intro__photo">
          <Image src={smfImgMeta("Guitar.png")} alt="Vintage Fender Stratocaster" loading="eager" width={240} />
        </div>
        <div class="smf-intro__text">
          <p>
            If you own a Pre-CBS Stratocaster or a vintage Fender you&rsquo;ve had for years, I&rsquo;d like to hear about it. I&rsquo;ve been collecting Fenders and studying their history for a long time, and <strong>I appraise guitars from every era</strong>, from the early Telecaster &amp; Precision Bass years through the collectible CBS-era and early reissue models.
          </p>
          <p>I buy all vintage Fender electrics for cash, including:</p>
          <ul class="smf-intro__list">
            <li><strong>Classic models:</strong> Stratocasters, Telecasters, and Precision Basses from every era.</li>
            <li><strong>Offsets:</strong> Jazzmasters, Jaguars, Mustangs, and Musicmasters.</li>
            <li><strong>Rare features:</strong> Custom Color finishes, unusual neck profiles, and original &ldquo;spaghetti&rdquo; or &ldquo;transition&rdquo; logos.</li>
            <li><strong>Player-grade guitars:</strong> Even if yours has been modified, refretted, or shows heavy stage wear, <strong>it still has value and a history worth knowing.</strong></li>
          </ul>
          <p>The process is straightforward and the cash offer is fair, for a single guitar or a whole collection. Whatever you have, a rare prototype or a 1970s workhorse, <strong>I&rsquo;ll take good care of it.</strong></p>
          <p>Get a free evaluation for your Fender today. Call or text me at <strong>{contact.phone}</strong> or email <strong><span class="smf-underline">{contact.email}</span></strong>.</p>

          <!-- Table of contents — mirrors live's <details class="table-of-contents"> widget.
               Anchor IDs match this page's local section IDs (not live's slugs). -->
          <details class="smf-toc">
            <summary>
              <span class="smf-toc__title">Table Of Contents</span>
              <svg class="smf-toc__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <ul class="smf-toc__list">
              <li><a href="#meet-vintage-guitar-buyer-joe-dampt">Meet Classic Fender Guitar Specialist, Joe Dampt</a></li>
              <li><a href="#how-to-sell">How To Sell Your Vintage Fender Guitar</a></li>
              <li><a href="#how-much-worth">How Much Is My Fender Guitar Worth?</a></li>
              <li><a href="#best-way">What Is the Best Way To Sell A Classic Fender Guitar?</a></li>
              <li><a href="#buying-process">My Guitar Buying Process</a></li>
              <li><a href="#testimonials">Our Clients' Testimonials</a></li>
              <li><a href="#discover-value">Discover the Real Value of Your Fender Stratocaster at Joe&rsquo;s Vintage Guitars</a></li>
              <li><a href="#consider-selling">Consider Selling Your Vintage Guitar To Joe's Vintage Guitars</a></li>
              <li><a href="#top-dollar">I'm Currently Paying Top Dollar for These Vintage Fender Guitars</a></li>
              <li><a href="#faqs">FAQs About Vintage Fender Guitars</a></li>
            </ul>
          </details>
        </div>
      </div>

      <!-- RIGHT: contact form with serial-number dropdown -->
      <div class="smf-intro__formwrap">
        <div class="smf-form-head">
          <h3><span class="smf-form-head__lede">Feel Free To Contact</span> Joe&rsquo;s Vintage Guitar</h3>
          <h4>For A Free Fender Guitar Consultation &amp; Appraisal Today!</h4>
        </div>
        <form
          class="smf-form"
          data-jvg-contact-form
          data-form-id="sell-fender-top"
          action="/api/contact"
          method="post"
          novalidate
        >
          <div class="smf-field">
            <label for="smf-serial">
              What information can the serial number tell us?<br />
              Look on the back of the neck at the top or on the inside of the body.*
            </label>
            <select id="smf-serial" name="serial-number" required>
              <option value="">Please choose an option</option>
              {serialOptions.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div class="smf-field">
            <label for="smf-name">Name*</label>
            <input id="smf-name" type="text" name="your-name" required maxlength="400" />
          </div>
          <div class="smf-field">
            <label for="smf-email">Email*</label>
            <input id="smf-email" type="email" name="your-email" required maxlength="400" />
          </div>
          <div class="smf-field">
            <label for="smf-phone">Phone*</label>
            <input id="smf-phone" type="tel" name="your-phone" required maxlength="400" />
          </div>
          <div class="smf-field">
            <label for="smf-city">City &amp; State/Province <span class="smf-opt">(Optional)</span></label>
            <input id="smf-city" type="text" name="your-city" maxlength="400" />
          </div>
          <div class="smf-field">
            <label for="smf-country">Country <span class="smf-opt">(Optional)</span></label>
            <input id="smf-country" type="text" name="your-country" maxlength="400" />
          </div>
          <div class="smf-field">
            <label for="smf-price">Do you have a price in mind? <span class="smf-opt">(Optional)</span></label>
            <input id="smf-price" type="text" name="price-mind" maxlength="400" />
          </div>
          <div class="smf-field smf-field--message">
            <label for="smf-message">Tell us more about it <span class="smf-opt">(Optional)</span></label>
            <textarea id="smf-message" name="your-message" rows="5" maxlength="2000"></textarea>
          </div>
          <div class="smf-reply">
            <span class="smf-reply__label">Best Way To Reply:</span>
            <label class="smf-reply__opt"><input type="radio" name="best-reply" value="Call" /> Call</label>
            <label class="smf-reply__opt"><input type="radio" name="best-reply" value="Text" /> Text</label>
            <label class="smf-reply__opt"><input type="radio" name="best-reply" value="Email" /> Email</label>
          </div>
          <button type="submit" class="smf-submit">SUBMIT</button>
          <p class="smf-form__note">*If you have photos, you will have the option to upload them after clicking submit</p>
        </form>
      </div>
    </div>
  </section>

  <!-- 3. Meet Joe — exact live structure (verified via DOM query):
       outer .smf-meet (cream section bg)
         > .smf-inner (max-width 1144px)
           > .smf-meet__row (relative; z-index:10; has the WHITE CARD ::before
             behind the columns + the DARK RUST TRIANGLE ::after overlapping
             the left edge of the video — the "tasteful frame" effect)
             > .smf-meet__video  (video column, sits above the white card)
             > .smf-meet__panel  (text column, sits above the white card) -->
  <section id="meet-vintage-guitar-buyer-joe-dampt" class="smf-meet">
    {/* Backward-compat anchor — earlier revisions used #meet-joe as the local
        identifier. Live uses #meet-vintage-guitar-buyer-joe-dampt (Avada's
        fusion-container-anchor pattern); v9 audit caught the mismatch and
        moved the canonical ID to match live for inbound-link parity. The
        empty div below preserves any internal/external link still pointing
        at the older slug. */}
    <div id="meet-joe" class="smf-anchor" aria-hidden="true"></div>
    <div class="smf-inner">
      <div class="smf-meet__row">
        <div class="smf-meet__video">
          <!-- 2026-05 v7: lite-youtube web component (paulirish/lite-youtube-embed)
               matches live's exact element. Shows the YouTube thumbnail + red play
               button immediately, swaps to iframe only on click. Loaded via CDN.
               v9 (2026-05-26): params unioned with live's set so clicking the
               placeholder autoplays + enables the YT player API, while keeping
               modest branding + rel=0 (no related-video distraction at end). -->
          <lite-youtube
            videoid="U3eJgXLs4w8"
            params="wmode=transparent&autoplay=1&enablejsapi=1&rel=0&modestbranding=1"
            title="Meet Classic Fender Guitar Specialist, Joe Dampt"
            class="smf-lite-yt"
          ></lite-youtube>
        </div>
        <div class="smf-meet__panel">
          <h3 class="smf-meet__title">Meet Classic Fender Guitar Specialist, <span class="smf-meet__name">Joe Dampt</span></h3>
          <hr class="smf-meet__sep" />
          <p>
            Hi, <strong><a href="/about-me/">I&rsquo;m Joe Dampt</a>.</strong> I&rsquo;ve collected Fender guitars and basses my whole life, and I&rsquo;d like to hear about yours. <strong>When you contact Joe&rsquo;s Vintage Guitars, you deal with me directly, not a middleman.</strong> I give free evaluations and strong cash offers for Pre-CBS Stratocasters, Telecasters, Precision Basses, and rare Custom Color models. Whether it&rsquo;s a clean heirloom or a well-worn 1970s player, <strong>I&rsquo;ll treat it right.</strong>
          </p>
          <p><strong>Call or text me at {contact.phone} for a fair offer today.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How To Sell — text left, photo right -->
  <section id="how-to-sell" class="smf-split">
    <div class="smf-inner smf-split__grid">
      <div class="smf-split__text">
        <h3 class="smf-h3">How To Sell Your Vintage<br /> Fender Guitar</h3>
        <p>
          I travel all over the country to meet collectors and families who are ready to sell. Since I&rsquo;m on the road so much, I can usually come see your Fender in person and evaluate it on the spot. If we can&rsquo;t meet face to face, selling remotely is easy. I&rsquo;ll set up and pay for <strong>prepaid packing and shipping</strong>, so your guitar gets packed by people who do it for a living and stays fully insured in transit. You <a href="/" class="smf-link"><strong>get paid right away</strong></a>, and you never have to deal with packing it yourself, shipping liability, or a lost box.
        </p>
        <p><strong>Ready to get started? <a href="/contact-me/" class="smf-link">Contact me</a> today and I&rsquo;ll walk you through it.</strong></p>
      </div>
      <div class="smf-split__photo">
        <Image src={smfImgMeta("1964-fiesta-red-stratocaster-17-1-1024x683.jpg")} alt="Vintage 1964 fiesta red Fender Stratocaster" width={523} />
      </div>
    </div>
  </section>

  <!-- 5. How Much Worth — photo left, text right -->
  <section id="how-much-worth" class="smf-split smf-split--alt">
    <div class="smf-inner smf-split__grid smf-split__grid--reverse">
      <div class="smf-split__photo">
        <Image src={smfImgMeta("IMG_2424-1024x683.jpg")} alt="Vintage 1968 blonde Fender Telecaster electric guitar" width={523} />
      </div>
      <div class="smf-split__text">
        <h3 class="smf-h3">How Much Is My Fender<br /> Guitar Worth?</h3>
        <p>
          The first thing most people want to know is what their Fender is worth. I give <a href="/free-appraisal/" class="smf-link"><strong>free appraisals</strong></a> to owners who want an honest, current read on value. They&rsquo;re quick, there&rsquo;s no pressure, and you&rsquo;re never obligated to sell. If you&rsquo;d rather dig into the history yourself, I&rsquo;ve written plenty of Fender dating articles, and you can use my <a href="/fender-guitars-serial-number-guide/" class="smf-link"><strong>Fender Serial Number Guide</strong></a> to pin down the year your guitar was made and get a sense of what it&rsquo;s worth to collectors.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Best Way To Sell — text left, photo right -->
  <section id="best-way" class="smf-split">
    <div class="smf-inner smf-split__grid">
      <div class="smf-split__text">
        <h3 class="smf-h3">What Is the Best Way To Sell<br /> A Classic Fender Guitar?</h3>
        <p>
          Selling a vintage Fender comes down to weighing the safety of a known buyer against the risk of the open market. Selling it yourself can be tempting, but it&rsquo;s rarely a good idea for a first-time seller with a guitar worth $4,000 or more. Shipping a Pre-CBS Stratocaster or a rare Custom Color Telecaster carries real risk, and most private sellers don&rsquo;t carry the kind of $100,000+ transit insurance I keep on every shipment. <strong>I take that risk off your plate. I travel the country to pay cash in person, and I handle the packing and shipping, fully insured.</strong> You get a fair price, and your Fender gets where it&rsquo;s going safely.
        </p>
      </div>
      <div class="smf-split__photo">
        <Image src={smfImgMeta("IMG_0992-1024x683.jpg")} alt="Vintage 1964 Fender Telecaster solid body electric guitar" width={523} />
      </div>
    </div>
  </section>

  <!-- 7. My Buying Process -->
  <section id="buying-process" class="smf-process">
    <div class="smf-inner">
      <h3 class="smf-h3 smf-h3--center">My Guitar Buying Process</h3>
      <div class="smf-process__grid">
