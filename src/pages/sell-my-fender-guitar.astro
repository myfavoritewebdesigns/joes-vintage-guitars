  /* 3. Meet Joe ------------------------------------------------ */
  /* 2026-05 audit fix v6 (exact DOM-verified match of live).
     Structure:
       .smf-meet (cream section bg)
         .smf-inner (max-width 1144px wrapper)
           .smf-meet__row  (position: relative; z-index: 10)
             ::before — WHITE CARD behind both columns (inset -49 -11 -49 0)
             .smf-meet__video  (column, position: relative — above white card)
             .smf-meet__panel  (column, position: relative — above white card)
             ::after  — DARK RUST TRIANGLE overlapping left edge of video
                       (width 100px, left 0, top/bottom -49, clip-path triangle)
     The natural stacking gives: white card (back) → columns (middle) → rust triangle (front).
     Triangle visually peeks out top-left + bottom-left of card (extends 49px above/below row). */
  .smf-meet {
    background: var(--color-brand-cream, #eedfc0);
    /* v9 (2026-05-26): padding bumped to match live exactly
       (was 90px 0 110px — under by 10px top/bottom + 0 horizontal). */
    padding: 100px 30px 120px;
  }
  /* Backward-compat anchor — see comment near <div id="meet-joe"> above.
     scroll-margin-top compensates for the sticky header so legacy #meet-joe
     links land below it, not buried underneath. */
  .smf-anchor {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    scroll-margin-top: 100px;
  }
  .smf-meet__row {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: stretch;
  }
  /* WHITE CARD behind both columns */
  .smf-meet__row::before {
    content: "";
    position: absolute;
    top: -49px;
    right: -11px;
    bottom: -49px;
    left: 0;
    background: #fff;
    z-index: -1;
  }
  /* DARK RUST TRIANGLE overlapping left edge — the "tasteful frame" */
  .smf-meet__row::after {
    content: "";
    position: absolute;
    top: -49px;
    bottom: -49px;
    left: 0;
    width: 100px;
    background: rgb(104, 36, 18);
    clip-path: polygon(0 0, 0 100%, 100% 50%);
    pointer-events: none;
  }
