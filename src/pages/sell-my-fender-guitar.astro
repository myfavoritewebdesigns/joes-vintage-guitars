---
import Layout from "../layouts/Layout.astro";
import { SITE_URL } from "../config/site";
import { buildImageGraph } from "../lib/imageLicense";
import rawPageMarkup from "../page-data/sell-fender-redesign.html?raw";
import rawPageCss from "../styles/pages/sell-fender-redesign.css?raw";

const pageTitle = "Sell My Fender Guitar | Joe's Vintage Guitars";
const pageDescription =
  "Sell your vintage Fender guitar or bass directly to Joe Dampt for a free appraisal, a no-obligation cash offer and prepaid insured shipping.";

const faqEntries = [
  [
    "Should I clean or repair my Fender before sending photos?",
    "No. Leave it exactly as you found it. Cleaning, polishing, swapping parts or opening the guitar can remove clues I use to judge the finish and originality.",
  ],
  [
    "How can I tell how old my Fender is?",
    "The serial number is a starting point, but neck dates, body dates, pot codes, pickup markings, hardware and construction details often matter just as much. Send photos and I will work through those clues.",
  ],
  [
    "Do you buy modified, refinished or player-grade Fenders?",
    "Yes. A refinish, changed pickups, a refret or natural stage wear affects value, but it does not rule out a sale. Keep any original parts you still have with the guitar.",
  ],
  [
    "Does the original case increase the value?",
    "It can. Original tweed, brown, white or black tolex cases, tags, receipts, bridge covers and replaced parts should all stay together with the guitar.",
  ],
  [
    "Can you appraise an inherited Fender from photographs?",
    "Usually, yes. Clear photos of the front, back, headstock, neck plate or bridge serial number, controls and case are enough to begin. You do not need to know the model or year.",
  ],
  [
    "How does shipping work if I decide to sell?",
    "We agree on the offer, payment and shipping details before the guitar moves. I arrange prepaid professional packing, fully insured FedEx shipping and tracking at no cost to you.",
  ],
  [
    "Do you buy Fender basses and amplifiers too?",
    "Yes. I buy vintage Precision and Jazz Basses as well as collectible Fender tube amplifiers. Send the cabinet, chassis, transformer and speaker information you have.",
  ],
  [
    "Do I have to accept the offer?",
    "No. Every appraisal and offer is free and carries no obligation. If the guitar is one I can buy, I will explain what I see and what I can pay.",
  ],
] as const;

const licensedImages = await buildImageGraph([
  {
    renderedSrc: "/images/sell-fender-redesign/fender-hero.webp",
    alt: "1956 Fender Stratocaster in its red-lined case",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1962-fender-jazzmaster-fedex-counter.webp",
    alt: "A 1962 Fender Jazzmaster Joe purchased resting in its open case on a FedEx counter",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/joshua-with-1952-fender-telecaster.jpeg",
    alt: "Joshua holding his uncle's 1952 Fender Telecaster in Washington",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/one-owner-1965-stratocaster.webp",
    alt: "The original owner holding his 1965 Olympic White Fender Stratocaster with its factory tortoise pickguard",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/one-owner-1960-telecaster.webp",
    alt: "The original owner holding his worn 1960 Fender Telecaster in Fountain Hills, Arizona",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/bill-one-owner-1966-jaguar.webp",
    alt: "Bill holding the Lake Placid Blue 1966 Fender Jaguar his father bought for him when he was young",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/jim-with-1972-fender-jazz-bass-scaled.jpeg",
    alt: "Jim with the Fender Jazz Bass he owned for more than forty years",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/fender-stratocaster-dakota-red-768x1024.jpg",
    alt: "Mary's 1963 Fender Stratocaster in Dakota Red with gold hardware",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1956-fender-stratocaster-sunburst-800x533.jpg",
    alt: "Vintage 1956 sunburst Fender Stratocaster",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1960-fender-telecaster-blonde-800x533.jpg",
    alt: "Vintage 1960 blonde Fender Telecaster",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1965-fender-jazzmaster-charcoal-frost-800x533.jpg",
    alt: "Vintage 1965 charcoal frost Fender Jazzmaster",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1952-fender-precision-bass-800x533.jpg",
    alt: "Vintage 1952 Fender Precision Bass",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1964-fender-jaguar-sunburst-800x533.jpg",
    alt: "Vintage 1964 sunburst Fender Jaguar",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1972-fender-mustang-competition-blue-800x533.jpg",
    alt: "1972 Fender Mustang Competition in blue",
  },
  {
    renderedSrc: "/images/sell-fender-redesign/1972-fender-jazz-bass-sunburst-800x533.jpg",
    alt: "1972 sunburst Fender Jazz Bass",
  },
]);

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqEntries.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      {
        "@type": "ListItem",
        position: 2,
        name: "Sell My Fender Guitar",
        item: `${SITE_URL}/sell-my-fender-guitar/`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Sell Your Vintage Fender Guitar",
    author: { "@id": `${SITE_URL}/about-me/#person` },
    publisher: { "@id": `${SITE_URL}/` },
    mainEntityOfPage: `${SITE_URL}/sell-my-fender-guitar/`,
    image: `${SITE_URL}/images/sell-fender-redesign/fender-hero.webp`,
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Meet Vintage Guitar Buyer Joe Dampt",
    description:
      "Joe Dampt introduces himself and explains how selling your vintage Fender guitar to Joe's Vintage Guitars works.",
    thumbnailUrl: `${SITE_URL}/images/sell-fender-redesign/meet-joe-youtube.webp`,
    uploadDate: "2024-06-04T20:04:06-07:00",
    duration: "PT1M29S",
    embedUrl: "https://www.youtube.com/embed/U3eJgXLs4w8",
    contentUrl: "https://www.youtube.com/watch?v=U3eJgXLs4w8",
    publisher: { "@id": `${SITE_URL}/` },
  },
  ...licensedImages,
];

const assetReplacements: Record<string, string> = {
  "https://www.joesvintageguitarsaz.com/_astro/logo-joe-2.lTrGXLF-_28Y3Wl.webp":
    "/images/logo-joe-2.png",
  "https://www.joesvintageguitarsaz.com/_astro/Logo-Footer-1-1-300x300.BujTPpJc_Z1Sc90V.webp":
    "/images/Logo-Footer-1-1-300x300.png",
  "/images/fender-hero.webp":
    "/images/sell-fender-redesign/fender-hero.webp",
  "/images/1962-fender-jazzmaster-fedex-counter.webp":
    "/images/sell-fender-redesign/1962-fender-jazzmaster-fedex-counter.webp",
  "/images/meet-joe-youtube.webp":
    "/images/sell-fender-redesign/meet-joe-youtube.webp",
  "https://www.joesvintageguitarsaz.com/images/faq-bg.webp":
    "/images/faq-bg.webp",
  "/images/stories/one-owner-1965-stratocaster.webp":
    "/images/sell-fender-redesign/one-owner-1965-stratocaster.webp",
  "/images/stories/one-owner-1960-telecaster.webp":
    "/images/sell-fender-redesign/one-owner-1960-telecaster.webp",
  "/images/stories/bill-one-owner-1966-jaguar.webp":
    "/images/sell-fender-redesign/bill-one-owner-1966-jaguar.webp",
  "https://www.joesvintageguitarsaz.com/_astro/joshua-with-1952-fender-telecaster.uki_tDfX_ZC93Uw.webp":
    "/images/sell-fender-redesign/joshua-with-1952-fender-telecaster.jpeg",
  "https://www.joesvintageguitarsaz.com/_astro/jim-with-1972-fender-jazz-bass-scaled.9_8aNxlN_Z1HE95b.webp":
    "/images/sell-fender-redesign/jim-with-1972-fender-jazz-bass-scaled.jpeg",
  "https://www.joesvintageguitarsaz.com/_astro/fender-stratocaster-dakota-red-768x1024.C2ld4GN-_ZOiUi2.webp":
    "/images/sell-fender-redesign/fender-stratocaster-dakota-red-768x1024.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1956-fender-stratocaster-sunburst-800x533.mVj3ZAQt_Z1znJhC.webp":
    "/images/sell-fender-redesign/1956-fender-stratocaster-sunburst-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1960-fender-telecaster-blonde-800x533.CBMJ0I_L_Z2Y5UM.webp":
    "/images/sell-fender-redesign/1960-fender-telecaster-blonde-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1965-fender-jazzmaster-charcoal-frost-800x533.Dw85I3aH_ZSVVbt.webp":
    "/images/sell-fender-redesign/1965-fender-jazzmaster-charcoal-frost-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1952-fender-precision-bass-800x533.B9ys3MSL_FoJ1C.webp":
    "/images/sell-fender-redesign/1952-fender-precision-bass-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1964-fender-jaguar-sunburst-800x533.0GsYHbQ0_Ze26tq.webp":
    "/images/sell-fender-redesign/1964-fender-jaguar-sunburst-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1972-fender-mustang-competition-blue-800x533.DeXStnA-_1b0hI2.webp":
    "/images/sell-fender-redesign/1972-fender-mustang-competition-blue-800x533.jpg",
  "https://www.joesvintageguitarsaz.com/_astro/1972-fender-jazz-bass-sunburst-800x533.DlX_IW15_ASEdl.webp":
    "/images/sell-fender-redesign/1972-fender-jazz-bass-sunburst-800x533.jpg",
};

let pageMarkup = rawPageMarkup
  .replace(/^<link rel="preload"[^>]*\/><link rel="preload"[^>]*\/>/, "")
  .replace(/^<main>/, "")
  .replace(/<\/main>\s*$/, "")
  .replace(/<script type="application\/ld\+json">.*?<\/script>/, "")
  .replace(
    '<form class="appraisal-form">',
    '<form class="appraisal-form" data-jvg-contact-form data-form-id="sell-fender-top">',
  )
  .replace(
    'class="full-field captcha-row"',
    'class="full-field captcha-row h-captcha-mount"',
  );

for (const [from, to] of Object.entries(assetReplacements)) {
  pageMarkup = pageMarkup.split(from).join(to);
}

pageMarkup = pageMarkup.replace(
  '<img src="/images/logo-joe-2.png"',
  '<img src="/images/logo-joe-2.png" width="296" height="355"',
);

const intrinsicImageDimensions: Record<string, [number, number]> = {
  "/images/sell-fender-redesign/joshua-with-1952-fender-telecaster.jpeg": [1440, 1920],
  "/images/sell-fender-redesign/one-owner-1965-stratocaster.webp": [1400, 1050],
  "/images/sell-fender-redesign/one-owner-1960-telecaster.webp": [1050, 1400],
  "/images/sell-fender-redesign/bill-one-owner-1966-jaguar.webp": [1050, 1400],
  "/images/sell-fender-redesign/jim-with-1972-fender-jazz-bass-scaled.jpeg": [1920, 2560],
};

for (const [src, [width, height]] of Object.entries(intrinsicImageDimensions)) {
  pageMarkup = pageMarkup.replace(
    `<img src="${src}"`,
    `<img src="${src}" width="${width}" height="${height}"`,
  );
}

pageMarkup = pageMarkup.replace(
  '<img class="faq-background" src="/images/faq-bg.webp"',
  '<img class="faq-background" src="/images/faq-bg.webp" width="1920" height="765"',
);

const pageCss = rawPageCss.replace(/^@import 'tailwindcss';\s*/, "") + `
  :root {
    --font-open-sans: Arial, sans-serif;
    --font-oswald: "Oswald", "Arial Narrow", sans-serif;
  }

  body.smf-redesign-page > header.absolute,
  body.smf-redesign-page > footer.jvgft,
  body.smf-redesign-page > aside[aria-label="Quick contact"] {
    display: none !important;
  }

  body.smf-redesign-page > main#main-content {
    min-height: 100vh;
  }

  .appraisal-form .jvg-form-banner {
    grid-column: 1 / -1;
    padding: 12px 14px;
    border: 1px solid #b34220;
    background: #fffdf8;
    color: #8b2412;
    font-size: 0.88rem;
    font-weight: 700;
  }
`;
---

<Layout
  bodyClass="smf-redesign-page"
  title={pageTitle}
  description={pageDescription}
  canonical="/sell-my-fender-guitar/"
  ogImage={`${SITE_URL}/images/sell-fender-redesign/fender-hero.webp`}
  ogImageAlt="1956 Fender Stratocaster in its red-lined case"
  ogImageWidth={2000}
  ogImageHeight={1333}
  ogImageType="image/webp"
  structuredData={structuredData}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/sell-fender-redesign/fender-hero.webp"
    type="image/webp"
    fetchpriority="high"
  />
  <style slot="head" is:inline set:html={pageCss}></style>
  <Fragment set:html={pageMarkup} />
</Layout>
