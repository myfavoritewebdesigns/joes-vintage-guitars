---
import ForumSampleLayout from '../../layouts/ForumSampleLayout.astro';
import { moderationItems } from '../../data/forum-sample';
---
<ForumSampleLayout title="Moderation Queue">
  <h1>Moderation Queue</h1><p class="mb-7 mt-3 max-w-3xl text-stone-600">A mock queue showing how the AI helper could assist. A person approves every new member. These controls are disabled, Demo only.</p>
  <div class="grid gap-4 md:grid-cols-2">
    {moderationItems.map((item) => <article class="forum-card p-6"><p class="mb-2 text-xs font-semibold uppercase tracking-wider text-[#74382d]">{item.kind}</p><h2>{item.title}</h2><p class="mt-3 text-sm text-stone-600">{item.action}</p><p class="mt-3 text-xs font-semibold">{item.status}</p><div class="mt-5 flex flex-wrap gap-3"><button disabled class="rounded border border-stone-300 px-3 py-2 text-sm text-stone-500">Approve: Demo only</button><button disabled class="rounded border border-stone-300 px-3 py-2 text-sm text-stone-500">Reject: Demo only</button></div></article>)}
  </div>
</ForumSampleLayout>
