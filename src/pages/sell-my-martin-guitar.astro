---
import type { ImageMetadata } from "astro";
import { assetSrc, resolveImage, ogCardSize } from "../lib/images";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import LeadForm from "../components/LeadForm.astro";
import InstagramEmbeds from "../components/InstagramEmbeds.astro";
import FAQ from "../components/FAQ.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { SITE_URL, contact, hrefs } from "../config/site";
import testimonialsRaw from "../../reference/martin-testimonials.json";

// Reviews — sourced from reference/martin-testimonials.json. All 5-star;
// stars are rendered uniformly by the template — no need to store rating
// per review. Review bodies are VERBATIM quoted material and must never be
// edited (dash/pattern exceptions live in reports/seo-v2/copy-allowlist.json).
//
// v2 (2026-08-07, per Joe): bumped 3 -> 6 to match Fender's v10 pattern.
// The Scott Wolfe repair review was dropped (repair intent on a selling
// page); the only two Martin-naming Google reviews in the corpus (Adrienne
// Young, Tony Michaud) lead, then four brand-neutral SELLING reviews from
// reference/testimonials.json fill out the set, exactly as Joe asked:
// Martin-specific first, brand-neutral where we run out.
const reviews: { name: string; link: string; body: string }[] = testimonialsRaw;

// Instagram reels — exact post permalinks from live's sell-my-martin page.
// The deferred <InstagramEmbeds /> component lazy-loads IG's embed script on
// scroll and renders each .instagram-media blockquote as a styled iframe.
const igPosts = [
  {
    permalink: "https://www.instagram.com/reel/DV_coYfkz5t/",
    headline: "1923 Martin 0-21, Player Grade",
    subtitle: "A century old and every bit as sweet as ever",
    body: "Compact body, vintage voice, and loads of character. This 1923 Martin 0-21 is a genuine player, the kind of guitar that rewards every hour you put into it.",
  },
  {
    permalink: "https://www.instagram.com/reel/DV85bu_k2_w/",
    headline: "Martin, Nearly 200 Years Old",
    subtitle: "Almost two centuries old, and in great condition",
    body: "Some instruments just survive. This one thrived. A Martin pushing nearly 200 years old and still looking great, thanks to the care it’s had over the generations.",
  },
  {
    permalink: "https://www.instagram.com/reel/DVooAQEDxVi/",
    headline: "1966 Martin D-28",
    subtitle: "A D-28 from one of Martin’s finest decades",
    body: "The 1960s were a great decade for Martin dreadnoughts, and this 1966 D-28 shows why. Big, balanced, and built to last, exactly what a good Martin should be.",
  },
];

// Image base — local copies downloaded same-session per CLAUDE.md rule 1
// ("hot-linked images must be swapped to local in the SAME session they were added").
// Files live in public/images/sell-martin/ and were sourced from the live WP uploads directory
// paths during this build session.
const img = (file: string) => assetSrc("images/sell-martin/" + file);
// Metadata twin — only for files verified to exist under src/assets/images/sell-martin/.
const imgMeta = (file: string) => resolveImage("images/sell-martin/" + file)!;

// Featured image — used for ogImage and the WebPage schema's primaryImageOfPage.
const FEATURED_IMG = img("sell-my-martin-guitar-featured-image.jpg");

// FAQs — v2 (2026-08-07, per Joe): 5 -> 10. The original five came from the live
// JSON-LD (reference/sell-my-martin-jsonld.json); kept questions keep their live
// toggle_ IDs so external anchor links still work. The old documentation
// question (toggle_2ebbbd8a61ddcff50) was a near-duplicate of the paperwork one
// and is folded into it (grep confirmed no inbound links to that id). New
// answers reuse only published claims: payment methods from the homepage FAQ,
// same-day payment from about-me, neck-block stamp location per VG-0077, and
// the originality ordering per VG-0112.
const faqs = [
  {
    id: "toggle_15bcac79451840ec9",
    q: "What Should I Look For In An Appraiser When Evaluating My Vintage Martin Guitar?",
    a: "Work with someone who specializes in vintage and high-end acoustics. I’ve handled a lot of Martins and I know the details that actually move the value: model variations, serial numbers, tonewoods, and original parts. I base every evaluation on current market trends and years of hands-on work, so you get a clear, honest read on what your guitar is worth.",
  },
  {
    id: "toggle_martin_worth_01",
    q: "How Much Is My Vintage Martin Guitar Worth?",
    a: "It depends on the model, the year, the condition, and how original it is. Pre-war models and Brazilian rosewood guitars sit at the top of the market, and clean, all-original examples bring the most. The fastest way to a real answer is to send me a few photos for a free appraisal. I’ll tell you exactly what you have and what it’s worth in today’s market, with no obligation to sell.",
  },
  {
    id: "toggle_30d237965adcb2a03",
    q: "What Factors Affect The Value Of A Vintage Martin Guitar?",
    a: "A few things drive the value: the model, the year, overall condition, how original the parts are, and any modifications or repairs. Pre-war models and Brazilian rosewood guitars are especially in demand. I also factor in how it plays, how it sounds, and what the market’s doing. I’ve got the experience to assess your guitar accurately and give you a fair appraisal.",
  },
  {
    id: "toggle_74a9dca0d7a06eae0",
    q: "Are There Specific Martin Guitar Models That Are More Sought-After?",
    a: "Yes. A few Martin models are always in demand with collectors and players: pre-war D-28s and D-18s, 1930s OM and 000 models, and anything with Brazilian rosewood. Limited editions and clean, well-kept vintage instruments draw strong interest too. I know how to spot these high-value models and can tell you exactly what you have and where it sits in today’s market.",
  },
  {
    id: "toggle_martin_clean_02",
    q: "Should I Clean Or Repair My Martin Before Selling It?",
    a: "No, please don’t. Leave it exactly as it is. A well-meant cleaning or a quick repair can actually hurt the value of a vintage Martin, because collectors pay for originality, right down to the dust and the worn spots. Don’t polish it and don’t have anything fixed. Send me photos of the guitar as it sits and let me take a look first.",
  },
  {
    id: "toggle_martin_damage_03",
    q: "Do You Buy Martins With Cracks, Repairs, Or A Refinish?",
    a: "Yes. Old Martins have usually lived a little, and cracks, repairs, and even refinishes don’t scare me off. Condition and originality change the offer, not my interest. A worn guitar with its original finish is often worth more than one that’s been made pretty again, so don’t assume yours is too rough to sell. Send photos and I’ll give you a straight answer.",
  },
  {
    id: "toggle_martin_inherited_04",
    q: "How Do I Sell An Inherited Martin Guitar?",
    a: "Start with photos, even if you don’t know what the guitar is. The model and serial number are stamped on the neck block inside the body, visible through the soundhole, so include a shot of that stamp if you can. I’ll identify the guitar, tell you what year it was made, and give you a free appraisal so your family knows its fair value. No paperwork is needed, and I make a point of preserving the story that comes with the guitar.",
  },
  {
    id: "toggle_667a03873c0f1b397",
    q: "Can I Sell My Vintage Martin Guitar Without Original Paperwork?",
    a: "Yes, you can sell a vintage Martin without the original paperwork. A bill of sale or warranty card adds context, but it’s not required to confirm authenticity or value. I inspect each guitar closely to verify its originality and condition, and I’ve bought and appraised plenty of valuable Martins with no paperwork at all. Clear photos and any history you know help, but what matters is the guitar itself.",
  },
  {
    id: "toggle_martin_payment_05",
    q: "How And How Fast Do I Get Paid?",
    a: "Fast. My average turnaround for payment is the same day. I can often travel to you and pay cash in person, and if we ship instead I can pay by money order, Venmo, PayPal, Cashapp, Zelle, or bank transfer. More than one seller has had the money in their account before leaving the FedEx parking lot.",
  },
  {
    // Answer follows VG-0079's approved wording (pre-war definition + premium).
    id: "toggle_martin_prewar_06",
    q: "What Does Pre-War Mean For Martin Guitars?",
    a: "Collectors use pre-war for Martins built before the WWII era spec changes, roughly 1944 and earlier, with 1930s examples the most coveted. These typically carry a meaningful premium over comparable post-war guitars, though actual value still depends on the model, condition, and originality. If you’re not sure where yours lands, send me photos and I’ll tell you.",
  },
];

// 8 model cards — content + photos from live's "Receive The Best Cash Deal" grid.
const models = [
  {
    img: imgMeta("1953-martin-D-18-1-1024x682.jpg"),
    alt: "Classic Martin D-18 Acoustic with Solid Wood Construction",
    title: "Martin D-18",
    body: "Buying <strong>Pre-War and Golden Era D-18s</strong>. I pay a premium for mahogany-body dreadnoughts with original <strong>scalloped bracing</strong> and Adirondack spruce tops.",
  },
  {
    img: imgMeta("1959-martin-D-28-1024x683.jpg"),
    alt: "Authentic Martin D-28 Acoustic Guitar in Excellent Condition",
    title: "Martin D-28",
    body: "Buying vintage herringbone D-28s. I know the Brazilian Rosewood models from the 1930s through the late ’60s well.",
  },
  {
    img: imgMeta("martin-acoustic-guitar-1024x682.jpg"),
    alt: "Classic Martin 0-18 Guitar with Tortoise Pickguard",
    title: "Martin 0-18, 0-21, 0-28",
    body: "Buying Single-0 Martin models. I like the projection and history of these early concert-sized guitars.",
  },
  {
    img: imgMeta("1920s-martin-00-18-1-1024x683.jpg"),
    alt: "Martin 00-18 Vintage Acoustic Guitar",
    title: "Martin 00-18, 00-21, 00-28",
    body: "Strong cash offers on Grand Concert 00 models. I can spot the rare 12-fret and 14-fret configurations with original finishes.",
  },
  {
    img: imgMeta("1956-martin-000-21-1-1024x683.jpg"),
    alt: "Martin 000-21 Guitar in Excellent Vintage Condition",
    title: "Martin 000-18, 21, 28",
    body: "Buying vintage 000 ‘Auditorium’ models. I pay top dollar for Pre-War examples and clean, original 000-28 guitars.",
  },
  {
    img: imgMeta("martin-om-42-1024x682.jpg"),
    alt: "Martin OM-42 with Abalone Trim in Excellent Condition",
    title: "Martin OM Models",
    body: "Looking for original Orchestra Model (OM) Martins. I know how rare the 1929 to 1933 era is and pay a premium for authentic examples.",
  },
  {
    img: imgMeta("martin-d-45-brazilian-rosewood-1024x682.jpg"),
    alt: "Classic Martin D-45 Acoustic Guitar with Elegant Detailing",
    title: "Martin D-45, 42, 41, 40",
    body: "Buying high-trim Martin dreadnoughts. I know the original abalone pearl inlay and the rare early production numbers.",
  },
  {
    // Migrated into the image pipeline 2026-08-07 (was a raw 122 KB public/ JPEG;
    // the public/ copy stays in place so any indexed image URL keeps resolving).
    img: imgMeta("1959-martin-d-28-e-1-1024x683.jpg"),
    alt: "1959 Martin D-28E Electric Acoustic Guitar at Joe's Vintage Guitars",
    title: "Martin Electric Models",
    body: "Looking for <a href=\"/post/martin-d18e-vs-d28e-authentication-guide/\" class=\"smm-link\">rare 1960s Martin electrics like the D-18E and D-28E</a> and thin-line hollow bodies. These models have an unusual place in Martin’s history, and I appreciate them.",
  },
];

// Seven documented purchases with the prices Joe actually paid — the fact record
// is VG-0117 in joes-vintage-databases (PR #3 pending). Photos are Joe's own
// purchase shots from Downloads, resized to 800x1200 JPEG via sharp this session.
// Two entries were corrected from Joe's original list, both Joe-confirmed
// 2026-08-07: the 1945 dreadnought is a D-18 (his list said D-19, a model
// Martin did not introduce until the late 1970s) and the 0-18K is a 1931
// (his list said "19312").
// Sorted by price descending so the D-28 leads.
const purchases: { img: ImageMetadata; alt: string; title: string; price: string; note?: string }[] = [
  {
    img: imgMeta("1947-martin-d-28-purchase-800x1200.jpg"),
    alt: "Vintage 1947 Martin D-28 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1947 Martin D-28",
    price: "$28,000",
  },
  {
    img: imgMeta("1945-martin-d-18-purchase-800x1200.jpg"),
    alt: "Vintage 1945 Martin D-18 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1945 Martin D-18",
    price: "$13,000",
  },
  {
    img: imgMeta("1949-martin-000-28-purchase-800x1200.jpg"),
    alt: "Vintage 1949 Martin 000-28 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1949 Martin 000-28",
    price: "$11,000",
  },
  {
    img: imgMeta("1976-martin-000-45-purchase-800x1200.jpg"),
    alt: "Rare 1976 Martin 000-45 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1976 Martin 000-45",
    price: "$8,900",
    note: 'Read the <a href="/post/1976-martin-000-45-specs-history-value-guide/" class="smm-link">full story of this rare 1976 000-45</a>.',
  },
  {
    img: imgMeta("1947-martin-00-21-purchase-800x1200.jpg"),
    alt: "Vintage 1947 Martin 00-21 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1947 Martin 00-21",
    price: "$7,500",
  },
  {
    img: imgMeta("1960-martin-000-18-purchase-800x1200.jpg"),
    alt: "Vintage 1960 Martin 000-18 Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1960 Martin 000-18",
    price: "$6,700",
  },
  {
    img: imgMeta("1931-martin-0-18k-purchase-800x1200.jpg"),
    alt: "Vintage 1931 Martin 0-18K Koa Acoustic Guitar Purchased by Joe's Vintage Guitars",
    title: "1931 Martin 0-18K",
    price: "$5,000",
  },
];

// Page-specific JSON-LD: FAQPage + BreadcrumbList + Article.
// Mirrors live JSON-LD blocks 1 (BreadcrumbList + Article), 4 (FAQPage).
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a.replace(/<[^>]+>/g, ""),
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Sell My Martin Guitar", item: "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/" },
    ],
  },
  {
    // WebPage replaces the live site's Article node (2026-08-07): this is a
    // service page, not editorial content, and the Article carried no dates or
    // image so it could never earn a rich result. Dates are real: datePublished
    // is the live WP page's original publish date (reference/sell-my-martin-jsonld.json),
    // dateModified tracks the last substantive content change.
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/",
    name: "Sell My Martin Guitar",
    url: "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/",
    datePublished: "2022-05-11T22:05:20+00:00",
    dateModified: "2026-08-07T00:00:00+00:00",
    about: { "@id": "https://www.joesvintageguitarsaz.com/" },
    primaryImageOfPage: { "@type": "ImageObject", contentUrl: `${SITE_URL}${FEATURED_IMG}` },
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "@id": "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/#video",
    // Honest metadata (2026-08-07): fTpIquyV-j8 is the same general intro video
    // the Gibson page embeds (YouTube title is Gibson-flavored), so the schema
    // must not claim a Martin-specific video. Swap name/description back to a
    // Martin-specific form only when Joe records a Martin intro.
    name: "Meet Joe Dampt of Joe's Vintage Guitars",
    description: "Joe Dampt introduces himself and explains how selling your vintage guitar to Joe's Vintage Guitars works.",
    thumbnailUrl: "https://img.youtube.com/vi/fTpIquyV-j8/maxresdefault.jpg",
    uploadDate: "2024-06-04T19:55:33-07:00",
    duration: "PT1M45S",
    embedUrl: "https://www.youtube.com/embed/fTpIquyV-j8",
    contentUrl: "https://www.youtube.com/watch?v=fTpIquyV-j8",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
  },
];
---

<Layout
  title="Sell My Martin Guitar | Vintage Martin Buyer Paying Top Cash"
  description="Wondering what your Martin is worth? Joe buys vintage Martins nationwide, from Pre-War D-28s to 000s and OMs. Free appraisal and top cash offers."
  canonical="/sell-my-martin-guitar/"
  ogImage={`${SITE_URL}${FEATURED_IMG}`}
  {...ogCardSize("images/sell-martin/sell-my-martin-guitar-featured-image.jpg")}
  ogImageAlt="Sell My Martin Guitar banner from Joe's Vintage Guitars"
  publishedTime="2022-05-11T22:05:20+00:00"
  modifiedTime="2026-08-07T00:00:00+00:00"
  structuredData={structuredData}
>
  <!-- lite-youtube web component — matches live's Meet Joe video element.
       Renders YouTube thumbnail + red play button instantly, swaps to iframe only on click. -->
  <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
  <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>

  <InstagramEmbeds />

  <!-- 1. Hero — solid linear-gradient (NOT a photo like Fender).
       Verified via live DOM: `--awb-background-image:linear-gradient(180deg, #612211 0%,#682412 100%)` on .tp-bnr. -->
  <section class="smm-hero">
    <div class="smm-hero__inner">
      <h1>Sell Your Vintage Martin Guitar</h1>
      <!-- Rendered as a <p> (2026-08-07): the visual headline was an h2 above
           ten h3 sections, inverting the outline. The h1 carries the query;
           sections are now the h2 level. Class keeps the styling identical.
           Reworded so the page's most prominent line carries the contiguous
           phrase "Martin Guitar Buyer" (it appeared nowhere on the page). -->
      <p class="smm-hero__subtitle">Expert Martin Guitar Buyer and Collector Specializing in Vintage Acoustic Guitars</p>
      <div class="smm-hero__rule" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 2. Intro + simplified form (Martin's form is SIMPLER than Fender's:
       only Name / Phone / Email / Comments — no city/country/price/serial-dropdown). -->
  <section class="smm-intro">
    <div class="smm-inner smm-intro__grid">
      <!-- LEFT: intro copy + serial-number locator photo -->
      <div class="smm-intro__copy">
        <p class="smm-intro__lede">
          There’s something special about a Martin acoustic. <strong>Martins mean a lot to me, and I’m always looking to buy vintage ones.</strong> I want Martin D-18s, D-28s, 0-18s, 00-18s, 000-18s, 000-28s, D-45s, and just about any other vintage Martin, and I’ll consider any Martin built before 1970. If you’re looking for a trusted Martin guitar buyer, you’ve come to the right place. I’m based in Mesa, Arizona, and I buy vintage Martins in all 50 states. I’ll make you a fair cash offer, then play it myself or make sure it goes to someone who will. And if you just want to know what your Martin is worth, I can tell you. If you’ve got a vintage Martin you’d like to sell, call or text me at <a href={`tel:${contact.tel}`} class="smm-underline"><strong>{contact.phone}</strong></a> or email me at <a href={`mailto:${contact.email}`} class="smm-underline"><strong>{contact.email}</strong></a>.
        </p>
        <div class="smm-intro__photo">
          <LicensedImage
            src={imgMeta("Model-Name-Serial-Number-Martin-1024x683.jpg")}
            alt="Model Name and Serial Number on a Martin Acoustic Guitar"
            loading="eager"
            fetchpriority="high"
            width={500}
          />
          <!-- Serial-location caption (VG-0077): tells the seller where to find
               what Joe will ask for before they ever hit the form. -->
          <p class="smm-intro__caption">The model and serial number are stamped on the neck block, visible through the soundhole. Include both in your message if you can.</p>
        </div>

        <!-- Table of contents (2026-08-07, per Joe) — same details widget the
             Fender page carries. Labels match the section h2s; anchors are the
             page's stable section IDs, which feed jump-to sitelinks. -->
        <details class="smm-toc">
          <summary>
            <span class="smm-toc__title">Table Of Contents</span>
            <svg class="smm-toc__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <ul class="smm-toc__list">
            <li><a href="#meet-connoisseur-joe-dampt">Introducing Joe Dampt, A Martin Guitar Connoisseur</a></li>
            <li><a href="#how-to-sell-your-guitar">How To Sell Your Vintage Martin Guitar</a></li>
            <li><a href="#how-much-is-my-martin-guitar">How Much Is My Martin Guitar Worth?</a></li>
            <li><a href="#what-i-have-paid-for-vintage-martin-guitars">What I Have Paid For Vintage Martin Guitars</a></li>
            <li><a href="#best-way-to-sell">Where To Sell Your Martin Guitar For The Best Price</a></li>
            <li><a href="#my-guitar-buying-process">My Guitar Buying Process</a></li>
            <li><a href="#our-clients-testimonials">Our Clients’ Testimonials</a></li>
            <li><a href="#find-out-martin-really-worth">Identify Your Martin Guitar’s Model &amp; Value</a></li>
            <li><a href="#consider-selling-your-guitar">Looking To Sell? Joe’s Vintage Guitars Is Ready to Buy</a></li>
            <li><a href="#receive-the-highest-payout">Receive The Best Cash Deal for Your Vintage Martin Guitars</a></li>
            <li><a href="#faqs-about-martin">FAQs About Vintage Martin Guitars</a></li>
          </ul>
        </details>
      </div>

      <!-- RIGHT: shared lead form -->
      <LeadForm
        formId="sell-martin-top"
        instrumentMode="model-only"
        heading="Feel Free To Contact Joe’s Vintage Guitars"
        subheading="Get a Free Martin Guitar Evaluation & Appraisal Today!"
        submitLabel="Send"
      />
    </div>
  </section>

  <!-- 3. Meet Joe — anchor matches live exactly (#meet-connoisseur-joe-dampt).
       Same structural pattern as Fender (white card behind columns + rust triangle accent). -->
  <section id="meet-connoisseur-joe-dampt" class="smm-meet">
    <div class="smm-inner">
      <div class="smm-meet__row">
        <div class="smm-meet__video">
          <lite-youtube
            videoid="fTpIquyV-j8"
            params="wmode=transparent&autoplay=1&enablejsapi=1&rel=0&modestbranding=1"
            title="Meet Joe Dampt of Joe's Vintage Guitars"
            class="smm-lite-yt"
          ></lite-youtube>
        </div>
        <div class="smm-meet__panel">
          <h2 class="smm-meet__title">Introducing Joe Dampt, <span class="smm-meet__name">A Martin Guitar Connoisseur</span></h2>
          <hr class="smm-meet__sep" />
          <p>
            <a href="/about-me/"><strong>My name is Joe</strong></a>, and I’m in this to keep musical history alive, one guitar at a time. To me a vintage Martin isn’t just an instrument; <strong>it’s a piece of American history</strong>. Whether you have a pre-war Dreadnought or a classic 000, I treat every Martin with real respect. I grew up on the players who defined the Martin sound, <strong>Doc Watson, Merle Travis, and Ernest Tubb</strong>, and I keep that in mind on every guitar I look at. If you want to sell a vintage Martin, or just want to know what it’s worth, I can help. The evaluation is free, and the process is honest and gets you top dollar. I’d love to hear your guitar’s history and help you figure out the next step. Call me at <a href={`tel:${contact.tel}`}><strong>{contact.phone}</strong></a> or email <a href={`mailto:${contact.email}`} class="smm-underline"><strong>{contact.email}</strong></a> today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How To Sell — text left, photo right (anchor matches live: #how-to-sell-your-guitar). -->
  <section id="how-to-sell-your-guitar" class="smm-split">
    <div class="smm-inner smm-split__grid">
      <div class="smm-split__text">
        <h2 class="smm-h3">How To Sell Your Vintage<br /> Martin Guitar</h2>
        <p>
          I travel all over the country buying acoustic guitars, which often means I can come to you and buy yours in person. I want selling a vintage Martin to be as easy and safe as possible, so I handle all the logistics for you. Here is the whole process:
        </p>
        <!-- 4-step process (2026-08-07) — the same facts the prose carried, made
             scannable. Same-day payment claim mirrors about-me. -->
