---
import Layout from "../layouts/Layout.astro";
import SellMyMartinFinal from "../components/SellMyMartinFinal.astro";
import { assetSrc, ogCardSize } from "../lib/images";
import { SITE_URL } from "../config/site";

const pageUrl = "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/";
const description = "Wondering what your Martin is worth? Joe buys vintage Martins nationwide, from Pre-War D-28s to 000s and OMs. Free appraisal and top cash offers.";
const ogImagePath = "images/sell-martin/sell-my-martin-guitar-featured-image.jpg";

const faqs = [
  {
    q: "Should I Clean or Repair My Martin First?",
    a: "No. Please leave the guitar as you found it. Cleaning, polishing or repairing it can remove clues I use to judge originality. Old cracks and repairs do not rule out a purchase, so send photos before doing any work.",
  },
  {
    q: "How Can I Tell How Old My Martin Is?",
    a: "Look through the soundhole for the model and serial number stamped on the neck block. Send me a clear photograph of that stamp, and I can help identify the guitar and its year.",
  },
  {
    q: "What Factors Affect the Value of a Vintage Martin?",
    a: "The model, year, tonewoods, bracing, condition, original finish and original parts all matter. Repairs such as a neck reset, bridge replacement, refinishing or crack work can also change the value.",
  },
  {
    q: "Which Vintage Martin Models Are Most Valuable?",
    a: "Pre-War D-45, D-28 and D-18 guitars can be especially valuable. Early OM and 000 models, Brazilian rosewood guitars and clean original examples also attract strong collector interest. The exact value still depends on the individual guitar.",
  },
  {
    q: "Do You Buy Martins With Cracks, Repairs or a Refinish?",
    a: "Yes. Cracks, neck resets, bridge work and refinishes are common on old acoustics. Condition and originality affect the offer, but they do not automatically rule out a purchase. Show the work clearly in your photographs.",
  },
  {
    q: "Does the Original Case Increase the Value?",
    a: "It can. An original case, receipts, warranty papers, repair records and replaced parts may add value or help document the guitar. Keep everything together and include it in your photographs.",
  },
  {
    q: "How Do I Sell an Inherited Martin Guitar?",
    a: "Start with photographs, even if you do not know the model or year. Keep the case, old parts, receipts and family photographs with the guitar. I can identify it, explain what affects its value and make an offer if it is a Martin I can buy.",
  },
  {
    q: "Can I Sell My Martin Without Original Paperwork?",
    a: "Yes. Paperwork can add helpful context, but it is not required. Clear photographs of the guitar, neck-block stamp, case and any repairs usually give me enough information to begin an appraisal.",
  },
  {
    q: "Can You Appraise a Martin From Photographs?",
    a: "Clear photographs usually give me enough information for an initial appraisal and, when the details are visible, a purchase offer. I may ask for a few close-ups before giving you a final answer.",
  },
  {
    q: "How Does Shipping Work if I Sell My Martin to You?",
    a: "I explain the process with the offer. Through my special FedEx account, the box, professional packing, fully insured shipping and tracking are provided at the FedEx location at no cost to you.",
  },
  {
    q: "How and How Fast Do I Get Paid?",
    a: "Payment is usually completed the same day. I can pay cash when we meet in person, and shipped-guitar payment options include money order, Venmo, PayPal, Cash App, Zelle and bank transfer.",
  },
  {
    q: "Do I Have to Accept the Offer?",
    a: "No. The appraisal and offer are free, and there is no obligation to sell. You can consider the offer and shipping details together before deciding.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
    { "@type": "ListItem", position: 2, name: "Sell My Martin Guitar", item: pageUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Nationwide Vintage Martin Guitar Buying",
  serviceType: "Vintage Martin Guitar Appraisal and Purchasing",
  provider: { "@id": "https://www.joesvintageguitarsaz.com/" },
  areaServed: { "@type": "Country", name: "United States" },
  description: "Joe Dampt buys vintage Martin guitars nationwide and can arrange prepaid, fully insured FedEx shipping. The box, professional packing, shipping and tracking are provided at the FedEx location at no cost to the seller.",
  url: pageUrl,
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Sell My Martin Guitar",
  description,
  isPartOf: { "@id": "https://www.joesvintageguitarsaz.com/#website" },
  about: { "@type": "Thing", name: "Vintage Martin guitars" },
};

const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Meet Joe Dampt of Joe's Vintage Guitars",
  description: "Joe Dampt explains how he works with owners who want to sell a vintage guitar.",
  thumbnailUrl: "https://img.youtube.com/vi/fTpIquyV-j8/maxresdefault.jpg",
  uploadDate: "2024-06-04T19:55:33-07:00",
  duration: "PT1M45S",
  contentUrl: "https://www.youtube.com/watch?v=fTpIquyV-j8",
  embedUrl: "https://www.youtube.com/embed/fTpIquyV-j8",
  author: {
    "@type": "Person",
    "@id": "https://www.joesvintageguitarsaz.com/#joe-dampt",
    name: "Joe Dampt",
  },
};
---

<Layout
  title="Sell My Martin Guitar | Vintage Martin Buyer Paying Top Cash"
  description={description}
  canonical="/sell-my-martin-guitar/"
  ogType="website"
  ogImage={`${SITE_URL}${assetSrc(ogImagePath)}`}
  {...ogCardSize(ogImagePath)}
  ogImageAlt="Sell My Martin Guitar banner from Joe's Vintage Guitars"
  publishedTime="2022-05-11T22:05:20+00:00"
  modifiedTime="2026-09-14T00:00:00-07:00"
  structuredData={[breadcrumbSchema, faqSchema, serviceSchema, webPageSchema, videoSchema]}
>
  <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
  <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>
  <SellMyMartinFinal faqs={faqs} />
</Layout>
