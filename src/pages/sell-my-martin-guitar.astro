---
import { assetSrc, resolveImage } from "../lib/images";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import FAQ from "../components/FAQ.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { buildImageGraph } from "../lib/imageLicense";
import { SITE_URL, contact } from "../config/site";
import testimonialsRaw from "../../reference/martin-testimonials.json";

// Reviews — sourced from reference/martin-testimonials.json (3 Martin-specific
// reviews scraped from the live page's ProfessionalService JSON-LD and rendered
// testimonial cards). All 5-star; stars are rendered uniformly by the template
// — no need to store rating per review.
//
// Note: Fender's page v10 (2026-05-26) bumped from 3 -> 6 reviews per user
// request. Martin starts at 3 to match live exactly; can be bumped later if
// the same pattern is desired here.
const reviews: { name: string; link: string; body: string }[] = testimonialsRaw;

// Instagram reels — exact post permalinks from live's sell-my-martin page.
// Live loads www.instagram.com/embed.js which scans for any .instagram-media
// blockquote and renders it as a styled iframe.
const igPosts = [
  {
    permalink: "https://www.instagram.com/reel/DV_coYfkz5t/",
    headline: "1923 Martin 0-21, Player Grade",
    subtitle: "A century old and every bit as sweet as ever",
    body: "Compact body, vintage voice, and loads of character. This 1923 Martin 0-21 is a genuine player, the kind of guitar that rewards every hour you put into it.",
  },
  {
    permalink: "https://www.instagram.com/reel/DV85bu_k2_w/",
    headline: "Martin, Nearly 200 Years Old",
    subtitle: "Almost two centuries old, and in great condition",
    body: "Some instruments just survive. This one thrived. A Martin pushing nearly 200 years old and still looking great, thanks to the care it’s had over the generations.",
  },
  {
    permalink: "https://www.instagram.com/reel/DVooAQEDxVi/",
    headline: "1966 Martin D-28",
    subtitle: "A D-28 from one of Martin’s finest decades",
    body: "The 1960s were a great decade for Martin dreadnoughts, and this 1966 D-28 shows why. Big, balanced, and built to last, exactly what a good Martin should be.",
  },
];

// Image base — local copies downloaded same-session per CLAUDE.md rule 1
// ("hot-linked images must be swapped to local in the SAME session they were added").
// Files live in public/images/sell-martin/ and were sourced from the live WP uploads directory
// paths during this build session.
const img = (file: string) => assetSrc("images/sell-martin/" + file);
// Metadata twin — only for files verified to exist under src/assets/images/sell-martin/.
const imgMeta = (file: string) => resolveImage("images/sell-martin/" + file)!;

// Featured image — used for ogImage + intro section's serial-number-locator photo.
const FEATURED_IMG = img("sell-my-martin-guitar-featured-image.jpg");

// FAQs sourced from live JSON-LD (reference/sell-my-martin-jsonld.json, FAQPage entity).
// Toggle IDs match live's `panel-` / `toggle_` IDs so anchor links from external pages still work.
const faqs = [
  {
    id: "toggle_15bcac79451840ec9",
    q: "What Should I Look For In An Appraiser When Evaluating My Vintage Martin Guitar?",
    a: "Work with someone who specializes in vintage and high-end acoustics. I&rsquo;ve handled a lot of Martins and I know the details that actually move the value: model variations, serial numbers, tonewoods, and original parts. I base every evaluation on current market trends and years of hands-on work, so you get a clear, honest read on what your guitar is worth.",
  },
  {
    id: "toggle_667a03873c0f1b397",
    q: "Can I Sell My Vintage Martin Guitar Without Original Paperwork?",
    a: "Yes, you can sell a vintage Martin without the original paperwork. A bill of sale or warranty card helps, but it&rsquo;s not required to confirm authenticity or value. I inspect each guitar closely to verify its originality and condition. I&rsquo;ve bought and appraised plenty of valuable Martins with no paperwork at all. What matters is the guitar itself.",
  },
  {
    id: "toggle_30d237965adcb2a03",
    q: "What Factors Affect The Value Of A Vintage Martin Guitar?",
    a: "A few things drive the value: the model, the year, overall condition, how original the parts are, and any modifications or repairs. Pre-war models and Brazilian rosewood guitars are especially in demand. I also factor in how it plays, how it sounds, and what the market&rsquo;s doing. I&rsquo;ve got the experience to assess your guitar accurately and give you a fair appraisal.",
  },
  {
    id: "toggle_74a9dca0d7a06eae0",
    q: "Are There Specific Martin Guitar Models That Are More Sought-After?",
    a: "Yes. A few Martin models are always in demand with collectors and players: pre-war D-28s and D-18s, 1930s OM and 000 models, and anything with Brazilian rosewood. Limited editions and clean, well-kept vintage instruments draw strong interest too. I know how to spot these high-value models and can tell you exactly what you have and where it sits in today&rsquo;s market.",
  },
  {
    id: "toggle_2ebbbd8a61ddcff50",
    q: "What Documentation Is Needed To Accurately Value A Vintage Martin Guitar?",
    a: "Documentation adds context, but it&rsquo;s not required to assess a vintage Martin accurately. My process covers the serial number, the tonewoods and hardware, and the guitar&rsquo;s originality and condition. Clear photos and any history you know help, but even with no paperwork I can give you a reliable, well-documented appraisal.",
  },
];

// 8 model cards — content + photos from live's "Receive The Best Cash Deal" grid.
const models = [
  {
    img: imgMeta("1953-martin-D-18-1-1024x682.jpg"),
    alt: "Classic Martin D-18 Acoustic with Solid Wood Construction",
    title: "Martin D-18",
    body: "Buying <strong>Pre-War and Golden Era D-18s</strong>. I pay a premium for mahogany-body dreadnoughts with original <strong>scalloped bracing</strong> and Adirondack spruce tops.",
  },
  {
    img: imgMeta("1959-martin-D-28-1024x683.jpg"),
    alt: "Authentic Martin D-28 Acoustic Guitar in Excellent Condition",
    title: "Martin D-28",
    body: "Buying vintage herringbone D-28s. I know the Brazilian Rosewood models from the 1930s through the late &rsquo;60s well.",
  },
  {
    img: imgMeta("martin-acoustic-guitar-1024x682.jpg"),
    alt: "Classic Martin 0-18 Guitar with Tortoise Pickguard",
    title: "Martin 0-18, 0-21, 0-28",
    body: "Buying Single-0 Martin models. I like the projection and history of these early concert-sized guitars.",
  },
  {
    img: imgMeta("1920s-martin-00-18-1-1024x683.jpg"),
    alt: "Martin 00-18 Vintage Acoustic Guitar",
    title: "Martin 00-18, 00-21, 00-28",
    body: "Strong cash offers on Grand Concert 00 models. I can spot the rare 12-fret and 14-fret configurations with original finishes.",
  },
  {
    img: imgMeta("1956-martin-000-21-1-1024x683.jpg"),
    alt: "Martin 000-18 Guitar in Excellent Vintage Condition",
    title: "Martin 000-18, 21, 28",
    body: "Buying vintage 000 &lsquo;Auditorium&rsquo; models. I pay top dollar for Pre-War examples and clean, original 000-28 guitars.",
  },
  {
    img: imgMeta("martin-om-42-1024x682.jpg"),
    alt: "Authentic Martin 000-28 Guitar in Excellent Condition",
    title: "Martin OM Models",
    body: "Looking for original Orchestra Model (OM) Martins. I know how rare the 1929 to 1933 era is and pay a premium for authentic examples.",
  },
  {
    img: imgMeta("martin-d-45-brazilian-rosewood-1024x682.jpg"),
    alt: "Classic Martin D-45 Acoustic Guitar with Elegant Detailing",
    title: "Martin D-45, 42, 41, 40",
    body: "Buying high-trim Martin dreadnoughts. I know the original abalone pearl inlay and the rare early production numbers.",
  },
  {
    // Stays a public/ string path — this file only exists in public/images/sell-martin/.
    img: img("1959-martin-d-28-e-1-1024x683.jpg"),
    alt: "Martin GPC Acoustic Guitar with Rich Tone and Smooth Playability",
    title: "Martin Electric Models",
    body: "Looking for <a href=\"/post/martin-d18e-vs-d28e-authentication-guide/\" class=\"smm-link\">rare 1960s Martin electrics</a> and thin-line hollow bodies. These models have an unusual place in Martin&rsquo;s history, and I appreciate them.",
  },
];

// One model card (the Martin Electric / d-28-e) only exists in public/ and renders
// as a raw <img> via img() (string src), so it is licensed here with its exact
// rendered src. Every other content photo self-licenses via <LicensedImage>.
const licensedImages = await buildImageGraph([
  {
    renderedSrc: img("1959-martin-d-28-e-1-1024x683.jpg"),
    alt: "Martin GPC Acoustic Guitar with Rich Tone and Smooth Playability",
  },
]);

// Page-specific JSON-LD: FAQPage + BreadcrumbList + Article.
// Mirrors live JSON-LD blocks 1 (BreadcrumbList + Article), 4 (FAQPage).
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.a
          .replace(/&rsquo;/g, "’")
          .replace(/&lsquo;/g, "‘")
          .replace(/—/g, "—")
          .replace(/–/g, "–")
          .replace(/<[^>]+>/g, ""),
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Sell My Martin Guitar", item: "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Sell Your Vintage Martin Guitar",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: "https://www.joesvintageguitarsaz.com/sell-my-martin-guitar/",
  },
  ...licensedImages,
];
---

<Layout
  title="Sell My Vintage Martin Guitar | Top Cash Offers"
  description="Looking to sell your Martin? Joe Dampt is a premier buyer of Pre-War D-18s, D-28s, and OM models. We travel the U.S. to offer top dollar for Golden Era acoustics."
  canonical="/sell-my-martin-guitar/"
  ogImage={`${SITE_URL}${FEATURED_IMG}`}
  structuredData={structuredData}
>
  <!-- lite-youtube web component — matches live's Meet Joe video element.
       Renders YouTube thumbnail + red play button instantly, swaps to iframe only on click. -->
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.css" />
  <script slot="head" is:inline src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.js" defer></script>

  <!-- Instagram embed script — scans every `.instagram-media` blockquote and
       renders it as a styled IG iframe. Same script live loads. -->
  <script slot="head" is:inline async src="https://www.instagram.com/embed.js"></script>

  <!-- 1. Hero — solid linear-gradient (NOT a photo like Fender).
       Verified via live DOM: `--awb-background-image:linear-gradient(180deg, #612211 0%,#682412 100%)` on .tp-bnr. -->
  <section class="smm-hero">
    <div class="smm-hero__inner">
      <h1>Sell Your Vintage Martin Guitar</h1>
      <h2 class="smm-hero__subtitle">Expert Buyer and Collector Specializing in Vintage Martin Acoustic Guitars</h2>
      <div class="smm-hero__rule" aria-hidden="true"></div>
    </div>
  </section>

  <!-- 2. Intro + simplified form (Martin's form is SIMPLER than Fender's:
       only Name / Phone / Email / Comments — no city/country/price/serial-dropdown). -->
  <section class="smm-intro">
    <div class="smm-inner smm-intro__grid">
      <!-- LEFT: intro copy + serial-number locator photo -->
      <div class="smm-intro__copy">
        <p class="smm-intro__lede">
          There&rsquo;s something special about a Martin acoustic. <strong>Martins mean a lot to me, and I&rsquo;m always looking to buy vintage ones.</strong> I want Martin D-18s, D-28s, 0-18s, 00-18s, 000-18s, 000-28s, D-45s, and just about any other vintage Martin. If you&rsquo;re looking for someone to buy your Martin, you&rsquo;ve come to the right place. I&rsquo;ll make you a fair cash offer, then play it myself or make sure it goes to someone who will. And if you just want to know what your Martin is worth, I can tell you. If you&rsquo;ve got a vintage Martin you&rsquo;d like to sell, call or text me at <a href={`tel:${contact.tel}`} class="smm-underline"><strong>{contact.phone}</strong></a> or email me at <a href={`mailto:${contact.email}`} class="smm-underline"><strong>{contact.email}</strong></a>.
        </p>
        <div class="smm-intro__photo">
          <LicensedImage
            src={imgMeta("Model-Name-Serial-Number-Martin-1024x683.jpg")}
            alt="Model Name and Serial Number on a Martin Acoustic Guitar"
            loading="eager"
            width={500}
          />
        </div>
      </div>

      <!-- RIGHT: simplified contact form -->
      <div class="smm-intro__formwrap">
        <div class="smm-form-head">
          <h3><span class="smm-form-head__lede">Feel Free To Contact</span> Joe&rsquo;s Vintage Guitars</h3>
          <h4>Get a Free Martin Guitar Evaluation &amp; Appraisal Today!</h4>
        </div>
        <form
          class="smm-form"
          data-jvg-contact-form
          data-form-id="sell-martin-top"
          action="/api/contact"
          method="post"
          novalidate
        >
          <div class="smm-field">
            <label for="smm-name">Name*</label>
            <input id="smm-name" type="text" name="your-name" required maxlength="400" />
          </div>
          <div class="smm-field">
            <label for="smm-phone">Phone*</label>
            <input id="smm-phone" type="tel" name="your-phone" required maxlength="400" />
          </div>
          <div class="smm-field">
            <label for="smm-email">Email*</label>
            <input id="smm-email" type="email" name="your-email" required maxlength="400" />
          </div>
          <div class="smm-field smm-field--message">
            <label for="smm-message">Comments</label>
            <textarea id="smm-message" name="your-message" rows="6" maxlength="2000"></textarea>
          </div>
          <div class="smm-reply">
            <span class="smm-reply__label">How do you want to do it?:</span>
            <label class="smm-reply__opt"><input type="radio" name="best-reply" value="Call" /> Call</label>
            <label class="smm-reply__opt"><input type="radio" name="best-reply" value="Text" /> Text</label>
            <label class="smm-reply__opt"><input type="radio" name="best-reply" value="Email" /> Email</label>
          </div>
          <button type="submit" class="smm-submit">SENT</button>
          <p class="smm-form__note">*If you have photos, you will have the option to upload them after clicking submit</p>
        </form>
      </div>
    </div>
  </section>

  <!-- 3. Meet Joe — anchor matches live exactly (#meet-connoisseur-joe-dampt).
       Same structural pattern as Fender (white card behind columns + rust triangle accent). -->
  <section id="meet-connoisseur-joe-dampt" class="smm-meet">
    <div class="smm-inner">
      <div class="smm-meet__row">
        <div class="smm-meet__video">
          <lite-youtube
            videoid="fTpIquyV-j8"
            params="wmode=transparent&autoplay=1&enablejsapi=1&rel=0&modestbranding=1"
            title="Introducing Joe Dampt, A Martin Guitar Connoisseur"
            class="smm-lite-yt"
          ></lite-youtube>
        </div>
        <div class="smm-meet__panel">
          <h3 class="smm-meet__title">Introducing Joe Dampt, <span class="smm-meet__name">A Martin Guitar Connoisseur</span></h3>
          <hr class="smm-meet__sep" />
          <p>
            <a href="/about-me/"><strong>My name is Joe,</strong></a> and I&rsquo;m in this to keep musical history alive, one guitar at a time. To me a vintage Martin isn&rsquo;t just an instrument; <strong>it&rsquo;s a piece of American history</strong>. Whether you have a pre-war Dreadnought or a classic 000, I treat every Martin with real respect. I grew up on the players who defined the Martin sound, <strong>Doc Watson, Merle Travis, and Ernest Tubb</strong>, and I keep that in mind on every guitar I look at. If you want to sell a vintage Martin, or just want to know what it&rsquo;s worth, I can help. The evaluation is free, and the process is honest and gets you top dollar. I&rsquo;d love to hear your guitar&rsquo;s history and help you figure out the next step. Call me at <strong>{contact.phone}</strong> or email <strong class="smm-underline">{contact.email}</strong> today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How To Sell — text left, photo right (anchor matches live: #how-to-sell-your-guitar). -->
  <section id="how-to-sell-your-guitar" class="smm-split">
    <div class="smm-inner smm-split__grid">
      <div class="smm-split__text">
        <h3 class="smm-h3">How To Sell Your Vintage<br /> Martin Guitar</h3>
        <p>
          I travel all over the country buying acoustic guitars, which often means I can come to you and buy yours in person. I want selling a vintage Martin to be as easy and safe as possible, so I handle all the logistics for you.
        </p>
        <p>
          If we can&rsquo;t meet in person, I set up prepaid packing and shipping with no risk to you. <strong>I cover the cost and provide the right materials for a fragile vintage acoustic.</strong> From the moment it&rsquo;s packed to the moment it arrives, it&rsquo;s fully insured and handled by me. You get paid quickly and safely, with no packing headaches, no shipping risk, and no lost boxes. <a href="/contact-me/" class="smm-link"><strong>Contact me</strong></a> today to get top dollar for your vintage Martin without the stress.
        </p>
      </div>
      <div class="smm-split__photo">
        <LicensedImage
          src={imgMeta("1929-martin-00-21-1-1024x683.jpg")}
          alt="Vintage Martin Acoustic Guitar In Purple Case At Joe&rsquo;s Vintage Guitars"
          width={520}
        />
      </div>
    </div>
  </section>

  <!-- 5. Discover The Value — photo left, text right.
       LIVE-SITE QUIRK: anchor ID is `#how-much-is-my-gibson-guitar` (leftover from
       when the Martin page was cloned from the Gibson page and never renamed).
       Per project's "exact visual parity" rule we preserve it for inbound-link parity.
       Revisit this if/when live's anchor gets fixed — track in decision log. -->
  <section id="how-much-is-my-gibson-guitar" class="smm-split smm-split--alt">
    <div class="smm-inner smm-split__grid smm-split__grid--reverse">
      <div class="smm-split__photo">
        <LicensedImage
          src={imgMeta("1945-martin-d-18-1-1024x683.jpg")}
          alt="Free Vintage Martin Acoustic Guitar Appraisal at Joe&rsquo;s Vintage Guitars"
          width={520}
        />
      </div>
      <div class="smm-split__text">
        <h3 class="smm-h3">Discover The Value Of<br /> Your Martin Guitar</h3>
        <p>
          The big question for any owner is what the guitar is actually worth. Send me a few photos and I&rsquo;ll give you a <a href="/free-appraisal/" class="smm-link"><strong>free appraisal</strong></a> with a clear answer. It&rsquo;s quick, accurate, and there&rsquo;s no obligation to sell. I&rsquo;ve also written a guide on <a href="/post/how-to-determine-the-value-of-your-old-martin-acoustic-guitar/" class="smm-link"><strong>how to determine the value of your old Martin acoustic guitar</strong></a> if you want to dig in. And you can research the history yourself: a good place to start is my <a href="/martin-serial-and-model-numbers/" class="smm-link"><strong>Martin Serial Number Guide</strong></a>, which helps you pin down the exact year and production details. You might be just curious, or you might be ready to sell. Either way, I&rsquo;ll make sure you have what you need.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Where To Sell — text left, photo right (anchor matches live: #best-way-to-sell). -->
  <section id="best-way-to-sell" class="smm-split">
    <div class="smm-inner smm-split__grid">
      <div class="smm-split__text">
        <h3 class="smm-h3">Where To Sell Your Martin Guitar<br /> For The Best Price</h3>
        <p>
          It&rsquo;s worth understanding the trade-offs between selling privately and selling to a Martin collector or dealer. <strong>A private sale can work out, but I wouldn&rsquo;t recommend it for a first-time seller with a high-end acoustic worth over $4,000.</strong> There&rsquo;s real liability in it, especially around shipping and buyer disputes. Martins react to temperature and humidity, so shipping one is tricky and takes know-how to avoid damaging the guitar.
        </p>
        <p>
          I take the worry out of it with nationwide shipping and proper packing. Unlike a private seller who might be underinsured, I carry high-value insurance made for vintage instruments, so the guitar&rsquo;s covered from the moment it leaves your door.
        </p>
        <p>
          If you do sell privately, platforms like <a href="https://reverb.com/" target="_blank" rel="noopener" class="smm-link"><strong>Reverb.com</strong></a> offer some protection, but watch out for the high selling fees, and remember marketplaces usually side with the buyer in a dispute. Sell to me and you skip the shipping stress and the risk of a forced return. I handle the logistics, the insurance, and the packing, so you can focus on getting top dollar for your Martin.
        </p>
      </div>
      <div class="smm-split__photo">
        <LicensedImage
          src={imgMeta("1955-martin-d-18-1-1024x683.jpg")}
          alt="1955 Martin D-18 Guitar in Excellent Condition Available at Joe&rsquo;s Vintage Guitars"
          width={520}
        />
      </div>
    </div>
  </section>

  <!-- 7. My Buying Process — 3-card grid (anchor matches live: #my-guitar-buying-process).
       Card headings/copy are Martin-specific; icons are the shared Fair-Cash SVGs. -->
  <section id="my-guitar-buying-process" class="smm-process">
    <div class="smm-inner">
      <h3 class="smm-h3 smm-h3--center">My Guitar Buying Process</h3>
      <div class="smm-process__grid">
        <div class="smm-process__card">
          <img src={img("Fair-Cash-1.svg")} alt="Accurate Guitar Dating and Value Assessment at Joe&rsquo;s Vintage Guitars" class="smm-process__icon" />
          <h4>Precise Martin Identification</h4>
          <hr class="smm-rule" />
          <p>After decades of doing this, I can date and identify your guitar down to the construction details. I&rsquo;m always glad to talk through the history of a vintage Martin, from the bracing patterns to the tonewoods that make it what it is. I&rsquo;ll work out the real market value so you know exactly what your guitar is worth.</p>
        </div>
        <div class="smm-process__card">
          <img src={img("Fair-Cash-2.svg")} alt="Joe&rsquo;s Vintage Guitars: A Safe Home for Your Beloved Guitar" class="smm-process__icon" />
          <h4>A Trusted Home For<br /> Your Beloved Martin</h4>
          <hr class="smm-rule" />
          <p>Over the years I&rsquo;ve bought a lot of heirlooms and historic acoustics that weren&rsquo;t being played anymore. When you sell me a vintage Martin, I promise it&rsquo;ll be appreciated, well cared for, and played the way it should be. I take being a caretaker for these &lsquo;Golden Era&rsquo; instruments seriously, and I make sure they go to a good home.</p>
        </div>
        <div class="smm-process__card">
          <img src={img("Fair-Cash-3-1.svg")} alt="Competitive Cash Offer at Fair Market Valuation for Your Vintage Martin Guitar" class="smm-process__icon" />
          <h4>Transparent Cash Offer</h4>
          <hr class="smm-rule" />
          <p>I&rsquo;m always ready to pay top dollar for vintage Martins and other quality collectible guitars. I work to be one of the best buyers in the country, with strong cash offers on everything from pre-war Dreadnoughts to classic 00-21s. If you want to sell your Martin through a safe, straightforward process, reach out for a free evaluation today.</p>
        </div>
      </div>
    </div>
  </section>

  {/* 8. Testimonials — 3 Martin-specific Google reviews + 3 IG reels.
       Pinterest masonry layout via CSS columns (same pattern as Fender v10). */}
  <section id="our-clients-testimonials" class="smm-testi">
    <div class="smm-inner">
      <h3 class="smm-testi__title">Our Clients&rsquo; Testimonials</h3>

      <div class="smm-testi__masonry">
        {reviews.map((r) => (
          <article class="smm-testi__card">
            <p class="smm-testi__name">
              <a href={r.link} target="_blank" rel="noopener noreferrer">{r.name}</a>
              <br />
              <span class="smm-testi__stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </p>
            <p>{r.body}</p>
          </article>
        ))}
      </div>

      <div class="smm-testi__ig-grid">
        {igPosts.map((post) => (
          <div class="smm-testi__ig">
            <div class="instagram-wrapper">
              <blockquote
                class="instagram-media"
                data-instgrm-permalink={post.permalink}
                data-instgrm-version="14"
              ></blockquote>
            </div>
            <div class="instagram-text">
