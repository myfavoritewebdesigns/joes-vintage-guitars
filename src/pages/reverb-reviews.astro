---
/* The Reverb hub features five-star written reviews of at least 25 words.
   Brand links lead to full written-review archives or the brand's expert page.
   Stars-only reviews contribute to brand counts without rendering cards.
   Published headline figures stay fixed. Reviews use plain text without rating schema. */
import Layout from "../layouts/Layout.astro";
import "../styles/sn-page.css";
import ContactSection from "../components/ContactSection.astro";
import ReviewCard from "../components/reviews/ReviewCard.astro";
import { SITE_URL } from "../config/site";
import { groups, groupUrl } from "../data/reviews/groups";
import reviews from "../data/reviews/reverb.json";
import summary from "../data/reviews/reverb-summary.json";
import theme from "../../reference/reverb-reviews-theme.css?raw";

const featuredReviews = reviews
  .filter((review) => review.stars === 5 && review.words >= 25 && review.body.trim())
  .sort((a, b) => b.date.localeCompare(a.date));

const title = "Reverb Reviews (2,191 Verified) | Joe's Vintage Guitars";
const description =
  "Read 2,191 verified Reverb reviews for Joe's Vintage Guitars, a 4.9-star nationwide vintage guitar buyer. Honest grading, expert packing, and fast shipping.";
const canonical = "/reverb-reviews/";
const ogImage = `${SITE_URL}/images/og/reverb-reviews.jpg`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Reverb Reviews", item: `${SITE_URL}${canonical}` },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt="Reverb reviews for Joe's Vintage Guitars"
  ogImageWidth={868}
  ogImageHeight={868}
  structuredData={[breadcrumbSchema]}
>
  <div class="sn-header-backdrop" aria-hidden="true"></div>
  <div class="reverb-reviews-page">
    <div class="topbannerbg fullwidth-box"><p>At Joe’s Vintage Guitars, our reputation is as timeless as the gear we curate. This page features our verified Reverb reviews, documenting our commitment to honest grading, expert packing, and world-class service. Whether you are a collector or a player, our 5-star history offers the confidence you need to find your next dream piece.</p></div>
    <header class="site-header">
      <h1 class="header-title">Joe's Vintage Guitars Reverb Reviews</h1>
      <div class="header-stats">
        <div class="stat"><span class="stat-number">4.9</span><span class="stat-label">Avg Rating / 5</span></div>
        <div class="stat"><span class="stat-number">2,191</span><span class="stat-label">Total Reviews</span></div>
        <div class="stat"><span class="stat-number">2,071</span><span class="stat-label">Five-Star Reviews</span></div>
      </div>
    </header>

    <nav class="rv-brand-links rv-brand-links-list" aria-label="Sell A Vintage Guitar">
      <a href="/sell-my-martin-guitar/">Sell a Vintage Martin</a>
      <a href="/sell-my-fender-guitar/">Sell a Vintage Fender</a>
      <a href="/sell-my-gibson-guitar/">Sell a Vintage Gibson</a>
    </nav>

    <section class="rv-brand-links" aria-labelledby="reviews-by-brand">
      <h2 id="reviews-by-brand">Reviews By Brand</h2>
      <ul class="rv-brand-links-list">
        {groups.map((group) => (
          <li><a href={groupUrl(group)}>{group.label} ({summary.byBrand[group.slug].total.toLocaleString("en-US")} Reviews)</a></li>
        ))}
      </ul>
    </section>

    <section class="main-wrap" aria-labelledby="featured-reviews">
      <h2 id="featured-reviews">Featured Reverb Reviews</h2>
      {featuredReviews.map((review) => <ReviewCard review={review} />)}
    </section>
  </div>

  <ContactSection />
</Layout>

<Fragment set:html={`<style>${theme}</style>`} />

<style>
  .reverb-reviews-page { max-width: 1180px; margin: 0 auto; padding: 12px 16px 0; }
  .rv-brand-links {
    max-width: 900px;
    margin: 0 auto 2.5rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid rgb(160 58 30 / 28%);
    border-radius: 8px;
    background: #fffaf3;
    text-align: center;
  }
  .rv-brand-links h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); }
  .rv-brand-links-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }
  ul.rv-brand-links-list { margin: 1rem 0 0; padding: 0; list-style: none; }
  .rv-brand-links-list a {
    display: inline-block;
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--color-brand-rust, #a03a1e);
    border-radius: 4px;
    color: var(--color-brand-rust, #a03a1e);
    font-family: "Oswald", sans-serif;
    font-weight: 600;
    text-decoration: none;
  }
  .rv-brand-links-list a:hover { background: var(--color-brand-rust, #a03a1e); color: #fff; }
</style>
