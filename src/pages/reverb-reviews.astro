---
/* /reverb-reviews/ : all 2,191 verified Reverb buyer reviews rendered statically.
   Reverb's review data is not crawlable, so static rendering is the only way search
   engines and AI models ever index this social proof (GEO). Full set kept on purpose,
   do NOT trim. Body is the live .post-content (stats header + 2,052 .rv review cards),
   theme injected from the page's own CSS. The schema.org Review/Rating microdata was
   STRIPPED on purpose, consistent with the PR #12 decision to publish no self-placed
   ratings (Google penalizes self-asserted review markup). Reviews render as plain text,
   which is all AI answer engines need; only the global + BreadcrumbList JSON-LD remain. */
import Layout from "../layouts/Layout.astro";
import "../styles/sn-page.css";
import ContactSection from "../components/ContactSection.astro";
import { SITE_URL } from "../config/site";
import body from "../../reference/reverb-reviews-body.html?raw";
import theme from "../../reference/reverb-reviews-theme.css?raw";

const title = "Reverb Reviews (2,191 Verified) | Joe's Vintage Guitars";
const description =
  "Read 2,191 verified Reverb reviews for Joe's Vintage Guitars, a 4.9-star nationwide vintage guitar buyer. Honest grading, expert packing, and fast shipping.";
const canonical = "/reverb-reviews/";
const ogImage = `${SITE_URL}/images/og/reverb-reviews.jpg`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Reverb Reviews", item: `${SITE_URL}${canonical}` },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt="Reverb reviews for Joe's Vintage Guitars"
  ogImageWidth={868}
  ogImageHeight={868}
  structuredData={[breadcrumbSchema]}
>
  <div class="sn-header-backdrop" aria-hidden="true"></div>
  <div class="reverb-reviews-page" set:html={body} />

  {/* The review body is a raw scrape, so the page's internal links live here
      rather than inside `reference/reverb-reviews-body.html`. Without them the
      page is a dead end: nothing carries a reader from the social proof to the
      pages that act on it. */}
  <section class="rvnext">
    <div class="rvnext__inner">
      <h2 class="rvnext__title">Ready To Sell Yours?</h2>
      <p>
        These reviews are from buyers. If you are on the other side of the deal and have a vintage
        instrument to sell, start with a <a href="/free-appraisal/">free appraisal</a> or read more
        <a href="/about-me/">about Joe</a> first. I buy <a href="/sell-my-fender-guitar/">Fender</a>,
        <a href="/sell-my-gibson-guitar/">Gibson</a>, <a href="/sell-my-martin-guitar/">Martin</a>, and
        <a href="/sell-a-guitar-collection/">whole collections</a> nationwide.
      </p>
    </div>
  </section>

  <ContactSection />
</Layout>

<Fragment set:html={`<style>${theme}</style>`} />

<style>
  .reverb-reviews-page { max-width: 1180px; margin: 0 auto; padding: 12px 16px 0; }
  /* the page ships its own .site-header (dark band) + .rv card styling via the theme */
  .reverb-reviews-page :global(.rv-cta) { text-align: center; margin: 2.5rem 0 1rem; }
  .reverb-reviews-page :global(.rv-cta-btn) {
    display: inline-block; background: var(--color-brand-rust, #a03a1e); color: #fff;
    font-family: "Oswald", sans-serif; font-weight: 600; letter-spacing: 0.04em;
    padding: 0.9rem 1.8rem; border-radius: 4px; text-decoration: none;
    text-transform: uppercase; font-size: 0.95rem;
  }
  .reverb-reviews-page :global(.rv-cta-btn:hover) { background: var(--color-brand-rust-bright, #be4b25); }

  /* Skip layout + paint for the off-screen review cards.
     This page deliberately renders all 2,191 Reverb reviews so search and AI
     engines can read them (Reverb's own data is not crawlable), which means a
     ~18,000-element DOM. `content-visibility: auto` keeps every card in the DOM
     and in the accessibility tree, it only defers rendering work until a card
     is near the viewport, so crawlability is unaffected.

     `contain-intrinsic-size: auto <fallback>` is what stops this from causing
     scroll jump: `auto` makes the browser remember each card's real rendered
     height after it is first laid out, so the fallback only applies to the very
     first paint. Fallback measured live on 2,052 cards: mean 146px at 390px
     wide, 120px at 1920px, so 140px sits between the two. */
  .reverb-reviews-page :global(article.rv) {
    content-visibility: auto;
    contain-intrinsic-size: auto 140px;
  }

  .rvnext { background: var(--color-brand-cream-light, #f9f1de); padding: 44px 0; margin-top: 32px; }
  .rvnext__inner { max-width: 900px; margin: 0 auto; padding: 0 20px; text-align: center; }
  .rvnext__title {
    font-family: var(--font-display, Oswald), sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 34px);
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 14px;
  }
  .rvnext p {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-brand-charcoal, #2a2d33);
    margin: 0;
  }
  .rvnext a { color: var(--color-brand-rust-dark, #682412); text-decoration: underline; font-weight: 600; }
  .rvnext a:hover { color: var(--color-brand-rust-bright, #be4b25); }
</style>
