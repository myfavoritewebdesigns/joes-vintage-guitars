  }
  .smc-prep__scope {
    background: var(--color-brand-brown, #3d2c1d);
    color: #fff;
    padding: 30px 30px 32px;
  }
  .smc-prep__scope-label { color: #d0a044; margin: 0 0 9px; }
  .smc-prep__scope h3 {
    color: #fff;
    font-family: var(--font-display);
    font-size: 27px;
    line-height: 1.2;
    margin: 0 0 14px;
  }
  .smc-prep__scope p { line-height: 1.65; margin: 0 0 15px; }
  .smc-prep__scope ul { margin: 0 0 20px; padding-left: 20px; }
  .smc-prep__scope li { line-height: 1.5; margin: 0 0 8px; }
