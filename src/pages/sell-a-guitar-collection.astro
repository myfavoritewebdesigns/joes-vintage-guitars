    font-weight: 600;
    transition: background 0.2s;
  }
  .smc-intro-box__jump-btn:hover { background: #bf6344; }

  /* 1b. Answer-first summary and on-page navigation ------------ */
  .smc-overview {
    background: var(--color-brand-cream-light, #f6e9cf);
    padding: 58px 0;
  }
  .smc-overview__grid {
    display: grid;
