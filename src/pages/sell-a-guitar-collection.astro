  }

  /* 1d. Appraisal preparation and collection scope ------------- */
  .smc-prep {
    background: #fff;
    padding: 72px 0 80px;
  }
  .smc-prep__header {
    max-width: 820px;
    margin: 0 auto 42px;
    text-align: center;
  }
  .smc-prep__eyebrow,
  .smc-prep__scope-label {
    color: #a63f21;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .smc-prep__eyebrow { margin: 0 0 10px; }
  .smc-prep__header h2 {
    color: var(--color-brand-rust-dark);
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.18;
    margin: 0 0 16px;
  }
  .smc-prep__header > p:last-child {
    color: var(--color-brand-brown);
    line-height: 1.7;
    margin: 0;
  }
  .smc-prep__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.75fr);
    gap: 34px;
    align-items: stretch;
