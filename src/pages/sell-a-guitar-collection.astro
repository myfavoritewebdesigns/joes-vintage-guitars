        <a href={`tel:${contact.tel}`} class="smc-btn smc-btn--rust">{contact.phone}</a>
      </div>
      <div class="smc-buyappraise__photo">
        <LicensedImage
          src={imgMeta("i-buy-and-appraise-vintage-guitars.png")}
