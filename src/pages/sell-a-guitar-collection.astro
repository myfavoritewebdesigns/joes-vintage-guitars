  .smc-intro-box__contact a { color: #d0a044; text-decoration: underline; }
  .smc-intro-box__jump {
    text-align: center;
    padding-top: 8px;
  }
  .smc-intro-box__jump-label {
    font-style: italic;
    color: var(--color-brand-cream);
    margin: 0 0 8px !important;
  }
  .smc-intro-box__jump-btn {
    display: inline-block;
    padding: 10px 22px;
    background: var(--color-brand-rust-bright);
