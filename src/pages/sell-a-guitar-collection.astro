    border-top: 4px solid var(--color-brand-rust-bright);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 15px;
    padding: 23px 22px;
  }
  .smc-prep__number {
    color: #a63f21;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
  }
  .smc-prep__checklist h3 {
    color: var(--color-brand-rust-dark);
