          <article class="smc-options__card">
            <h3>{option.title}</h3>
            <p>{option.body}</p>
          </article>
        ))}
      </div>
      <div class="smc-options__footer">
        <p>For a detailed comparison of marketplaces, fees, timelines, and workload, read my <a href="/post/how-to-sell-a-large-guitar-collection-every-option-honestly-explained/">guide to selling a large guitar collection</a>.</p>
        <a href="#collection-appraisal-form" class="smc-btn smc-btn--rust">Discuss My Collection</a>
      </div>
    </div>
  </section>

  <!-- 7. Notable Collection Purchases: 5 items with location, stats, and logistics badges.
       Anchor #notable-purchases is the target of the hero jump button. -->
  <section class="smc-notable">
    <div class="smc-inner">
      <div class="smc-notable__header">
        <p class="smc-notable__eyebrow">Sourced Across The Country</p>
        <h2 id="notable-purchases" class="smc-notable__title">Notable Collection<br />Purchases</h2>
        <p class="smc-notable__subtitle">We travel wherever the great instruments are, flying, driving, and hauling truckloads of history to bring you the finest vintage guitars and amps anywhere.</p>
        <div class="smc-notable__divider"></div>
      </div>

      <div class="smc-purchase-list">
        {pastPurchases.map((p) => (
          <div class="smc-purchase">
            <div class="smc-purchase__number">{p.n}</div>
            <div class="smc-purchase__content">
              <div class="smc-purchase__location">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z"/></svg>
                {p.location}
              </div>
              <h3 class="smc-purchase__title">{p.title}</h3>
              <p class="smc-purchase__desc" set:html={p.desc} />
              <div class="smc-purchase__stat"><strong>{p.stat.number}</strong> {p.stat.label}</div>
              <div class="smc-purchase__badges">
                {p.badges.map((b) => <span class="smc-logistics-badge">{b}</span>)}
              </div>
              {p.video && (
                <div class="smc-purchase__video">
