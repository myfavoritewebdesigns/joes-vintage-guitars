<style>
  /* ============================================================
     SELL A GUITAR COLLECTION (.smc-*): Archetype A conversion page styles

     Structural notes:
     - Hero uses solid dark-brown bg (not gradient like Martin)
     - Intro-box card sits over the hero with internal contact info + jump btn
     - How It Works uses big numbered cards with keyword chips
     - Notable Purchases uses left-side number "stamps" with bordered cards
     ============================================================ */
  .smc-inner {
    max-width: 1144px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .smc-link { color: var(--color-brand-rust-dark); text-decoration: underline; }
  .smc-link:hover { color: var(--color-brand-rust-bright); }
  :global(body.collection-page .text-\[11px\]) { color: #d0a044; }
  .smc-anchor,
  #faqs-collection,
  #notable-purchases { scroll-margin-top: 110px; }
  .smc-rule {
    border: none;
    border-top: 3px solid var(--color-brand-rust-bright);
    width: 80px;
    margin: 12px auto 16px;
  }

  /* Buttons (used in hero + HIW CTA + buy/appraise + vintage banner) */
  .smc-btn {
    display: inline-block;
    padding: 14px 32px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
    border: none;
    cursor: pointer;
  }
  .smc-btn--rust { background: var(--color-brand-rust-bright); color: #fff; }
  .smc-btn--rust:hover { background: #bf6344; color: #fff; }
  .smc-btn--cream { background: var(--color-brand-cream); color: var(--color-brand-rust-dark); }
  .smc-btn--cream:hover { background: #fff; }

  /* 1. Hero ------------------------------------------------------ */
  .smc-hero {
    background: var(--color-brand-brown, #3e2a14);
    color: #fff;
    padding: 280px 24px 80px;
    text-align: center;
  }
  @media (max-width: 768px) {
    .smc-hero { padding: 120px 16px 60px; }
  }
  .smc-hero__inner h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 600;
    color: var(--color-brand-cream);
    margin: 0 auto 18px;
    max-width: 1000px;
    line-height: 1.15;
  }
  .smc-hero__rule {
    height: 3px;
    width: 100%;
    max-width: 740px;
    background: var(--color-brand-cream);
    margin: 0 auto 20px;
  }
  .smc-hero__subtitle {
    font-family: var(--font-display);
    color: #f0e1c1;
    font-weight: 400;
    font-size: clamp(20px, 2.5vw, 26px);
    margin: 0 auto 30px;
    max-width: 900px;
  }
  .smc-hero__cta { margin-top: 30px; }

  /* Intro box that sits inside the hero with collection-specific copy */
  .smc-intro-box {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    padding: 28px 34px;
    text-align: left;
    max-width: 900px;
    margin: 0 auto;
  }
  .smc-intro-box p {
    margin: 0 0 14px;
    line-height: 1.7;
    color: var(--color-brand-cream);
    font-size: 16px;
  }
  .smc-intro-box__brands {
    color: #d0a044 !important;
    font-weight: 600;
  }
  .smc-intro-box__divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
    margin: 18px 0;
  }
  .smc-intro-box__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: var(--color-brand-cream);
