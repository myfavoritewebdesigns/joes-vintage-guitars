---
import { assetSrc, resolveImage } from "../lib/images";
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import LeadForm from "../components/LeadForm.astro";
import InstagramEmbeds from "../components/InstagramEmbeds.astro";
import FAQ from "../components/FAQ.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { SITE_URL, contact } from "../config/site";
import testimonialsRaw from "../../reference/collection-testimonials.json";

/* ============================================================
   SELL A GUITAR COLLECTION: Archetype A conversion page
   ============================================================
   Structurally distinct from the Fender/Gibson/Martin "sell my X" pages:
   - NO fusion-container-anchor wrappers (live page uses custom hand-rolled
     HTML inside Avada containers with BEM-style class names: .hiw-step__*,
     .purchase-item__*, .notable-purchases__*)
   - NO contact form embedded in hero (uses a "Get Your Free Appraisal"
     button linking to /free-appraisal/)
   - NEW section: "How Our Collection Purchasing Process Works" (3 numbered
     steps with keyword tags), unique to this page
   - NEW section: "Notable Collection Purchases" (5 items with location
     pins, instrument counts, and logistics badges; 2 items have embedded
     YouTube videos)
   - Testimonials show 5 reviews (vs 3 on Martin), 3 IG reels
   - 2-column "I Buy & Appraise" feature
   - 3-column "Nationwide Vintage Guitar Collection Purchase & Appraisals"
     feature grid with icons + photos
   - Meet Joe section is BELOW the past-purchases (different position)
   ============================================================ */

// 5 testimonials sourced from reference/collection-testimonials.json (live JSON-LD
// review schema + rendered cards). All 5-star.
const reviews: { name: string; link: string; body: string }[] = testimonialsRaw.map((review) => ({
  ...review,
  body: review.body.replace(/[\u2013\u2014]/g, "-"),
}));

// Instagram reels: exact post permalinks from live's sell-a-guitar-collection page.
const igPosts = [
  {
    permalink: "https://www.instagram.com/reel/C0MuI5ix5Tr/",
    headline: "71-Piece Bluegrass Collection",
    subtitle: "71 top-shelf bluegrass instruments from a single storage unit",
    body: "Sometimes the good stuff is hiding right around the corner. This haul of 71 premium bluegrass instruments came out of one storage unit, a reminder that great collections can turn up anywhere, anytime.",
  },
  {
    permalink: "https://www.instagram.com/reel/DIPBvPmyaCK/",
    headline: "Multi-State Road Trip, Part 1",
    subtitle: "New Jersey to New Mexico, one unforgettable buying trip",
    body: "Five states, countless guitars, amps, and parts, and even more great people along the way. This cross-country run through New Jersey, Virginia, Tennessee, and New Mexico was well worth the miles.",
  },
  {
    permalink: "https://www.instagram.com/reel/C45z6mARK2T/",
    headline: "200+ Instrument Collection",
    subtitle: "Over 200 instruments, one road trip, and a little fishing",
    body: "One of the biggest single hauls we’ve done: over 200 instruments picked up on a road trip that had it all, rainstorms, snowstorms, great finds, and a fishing stop on the way home.",
  },
];

// Image base: local copies downloaded same-session per CLAUDE.md rule 1.
// Source URLs (preserved in commit history) lived under the live WP uploads directory.
const img = (file: string) => assetSrc("images/sell-collection/" + file);
// Metadata twin: only for files verified to exist under src/assets/images/sell-collection/.
const imgMeta = (file: string) => resolveImage("images/sell-collection/" + file)!;
const FEATURED_IMG = img("Sell-Your-Vintage-Guitar.jpg");

// 3-step process: content from live .hiw-section
const hiwSteps = [
  {
    n: "01",
    label: "Discovery & Valuation",
    title: "We Document & Value Your Collection Together",
    desc: "We start with a conversation, by phone, email, or text. You send photos and details of your instruments, and I document and appraise some or all of the collection remotely. We talk pricing openly so the value is clear before I ever travel. That means little back-and-forth when it’s time to buy: no surprises, no lowball offers on arrival, no drawn-out negotiation.",
    keywords: ["Collection Appraisal", "Remote Valuation", "No Obligation"],
  },
  {
    n: "02",
    label: "On-Site Collection Purchasing",
    title: "I Come To You, Anywhere In The U.S.",
    desc: "For large instrument collections, I come to you. Depending on distance, I either drive out in my own box truck or fly to your location and rent a truck on-site. Either way, the goal is the same: buy the entire collection in a single visit. No multiple trips, no partial purchases, no leaving instruments behind. One transaction, handled completely.",
    keywords: ["Nationwide Collection Buying", "Estate Liquidation", "On-Site Purchase"],
  },
  {
    n: "03",
    label: "Same-Day Payment",
    title: "We Load Up And You Get Paid The Same Day",
    desc: "Once we’ve gone through the collection, we load everything into the truck and get you paid on the spot. No waiting on wire transfers, no payment holds, no “we’ll send a check.” Collection liquidation shouldn’t drag on, and it doesn’t. You walk away paid the same day your instruments leave.",
    keywords: ["Same-Day Payment", "Collection Liquidation", "Cash or Transfer"],
  },
];

// 3-column "Nationwide" feature grid (icons + photos + headlines + copy)
const featureCols = [
  {
    icon: img("prices-icon.svg"),
    iconAlt: "Providing Fair And Convenient Prices Nationwide",
    iconWidth: 68,
    iconHeight: 79,
    photo: imgMeta("1966-gibson-es-335-1024x683.jpg"),
    photoAlt: "Sell An Electric Or Acoustic Guitar Collection",
    headline: "Sell An Electric Or Acoustic Guitar Collection At The Right Price",
    body: `After years of trial and error buying and selling electric and acoustic guitars, I can usually tell within minutes what your collection is worth. Whether you’ve got a big collection of <a href="/sell-my-gibson-guitar/" class="smc-link">Gibsons to sell</a> or a mix of makes and models, I can help you sell it.`,
  },
  {
    icon: img("classic-icon.svg"),
    iconAlt: "Buy Classic And Vintage Guitar Collections",
    iconWidth: 65,
    iconHeight: 68,
    photo: imgMeta("large-vintage-guitar-collection.jpg"),
    photoAlt: "Find Classic And Vintage Guitar Collections In Our Online Shop",
    headline: "Get A Free Appraisal For Your Guitar Collection",
    body: `Not sure what your collection is worth? I offer <a href="/free-appraisal/" class="smc-link">free appraisals</a> with no obligation to sell. I can also help you document and organize your collection. That comes in handy if you plan to sell, want to insure it, or just want a clear record of what you have.`,
  },
  {
    icon: img("guitar-icon.svg"),
    iconAlt: "Many Years Of Experience",
    iconWidth: 41,
    iconHeight: 38,
    photo: imgMeta("1966-fender-jazzmaster-in-hard-case-1024x683.jpg"),
    photoAlt: "Years Of Experience Buying And Selling Guitar Collections Nationwide",
    headline: "Years Of Experience Buying & Selling Guitars Throughout The States",
    body: `Take advantage of my knowledge and <a href="/about-me/" class="smc-link">years of experience</a> with new and vintage guitars, and let me make selling straightforward for you.`,
  },
];

// 5 notable past purchases: content from live .purchase-list
// Items 2 and 5 include embedded YouTube videos in addition to copy.
const pastPurchases = [
  {
    n: "01",
    location: "Tucson, Arizona",
    title: "700+ Guitars & Amps From A Retiring Collector",
    desc: "One of our biggest single buys ever. A lifelong collector in Tucson had spent decades putting together a huge range of guitars and amps, and he trusted us with the whole inventory when he retired. Every piece was hand-inspected and brought back to the shop.",
    stat: { number: "700+", label: "Guitars & Amplifiers" },
    badges: ["Flew to Tucson", "Box Truck Transport"],
    video: null,
  },
  {
    n: "02",
    location: "New Jersey",
    title: "100+ Rare 1950s To 1960s Instruments",
    desc: `We flew out to New Jersey, rented a box truck, and loaded it with over 100 instruments from the golden era of American lutherie. A great run of mid-century pieces from a collector named Art. See the haul in the video below. One highlight: a <a href="/post/gretsch-6120-history-value/" class="smc-link">1960 Gretsch 6120</a> that became the centerpiece of our guide to the model.`,
    stat: { number: "100+", label: "1950s To 1960s Instruments" },
    badges: ["Flew to New Jersey", "Box Truck Rented On-Site"],
    video: { id: "NTw8EcrS5Y8", title: "I Spent $100,000 On Guitars In One Week!" },
  },
  {
    n: "03",
    location: "Santa Fe, New Mexico",
    title: "100+ Premium Archtop Jazz Guitars",
    desc: "A private collector in Santa Fe had put together a remarkable personal archtop collection. Over 100 premium jazz guitars, carved tops, big names, and rare finds, all in a single purchase. A once-in-a-career buy.",
    stat: { number: "100+", label: "Premium Archtop Jazz Guitars" },
    badges: ["Private Collection Purchase"],
    video: null,
  },
  {
    n: "04",
    location: "Connecticut",
    title: "80+ High-End Acoustic Guitars",
    desc: `We flew to Connecticut and rented a truck on-site to haul back more than 80 acoustic guitars, a deep collection of high-end flat-tops from some of the most sought-after builders in American history. One standout was a Gibson J-45 that we later featured in our <a href="/post/identify-vintage-gibson-j45-j50-sj/" class="smc-link">complete guide to identifying vintage Gibson J-45s, J-50s, and SJs</a>.`,
    stat: { number: "80+", label: "Premium Acoustic Guitars" },
    badges: ["Flew to Connecticut", "Truck Rented On-Site"],
    video: null,
  },
  {
    n: "05",
    location: "Southern Arizona",
    title: "100+ Rare Vintage Fender Amps, Bought In A Single Day",
    desc: "A memorable single-day haul. Over 100 rare vintage Fender amplifiers, plus several guitars, all bought in one visit in Southern Arizona. Every amp loaded up and gone the same day. See the haul in the video below.",
    stat: { number: "100+", label: "Vintage Fender Amplifiers" },
    badges: ["Single-Day Purchase", "Southern Arizona"],
    video: { id: "SFjsaZsEHqI", title: "Buying Over 100 Vintage Fender Amps & Rare Guitars In The Middle Of Nowhere In Arizona!" },
  },
];

const appraisalChecklist = [
  {
    title: "A Wide Photo Of The Collection",
    body: "Start with a room, wall, rack, or case photo that shows the size of the collection. You don’t need to stage every instrument before reaching out.",
  },
  {
    title: "Photos Of Identifying Details",
    body: "For standout instruments, include the front, back, headstock, label, and serial number when they are easy to reach. Don’t take anything apart.",
  },
  {
    title: "A Rough Count And Location",
    body: "Share an approximate number of guitars, amplifiers, and other instruments, plus the city and state where the collection is located.",
  },
  {
    title: "Cases, Parts, And Paperwork",
    body: "Keep original cases, receipts, old appraisals, hang tags, spare parts, and notes with the collection. These details can help identify and value an instrument.",
  },
];

const sellingOptions = [
  {
    title: "Direct Collection Sale",
    body: "One buyer evaluates the collection, makes an offer, handles transportation, and completes the purchase. This trades some potential retail return for speed, clarity, and less work.",
  },
  {
    title: "Individual Online Listings",
    body: "Selling each instrument yourself can produce a higher total before fees, but it requires identification, pricing, photography, buyer messages, packing, shipping, and possible returns.",
  },
  {
    title: "Consignment",
    body: "A shop markets and sells the instruments for you, then keeps an agreed portion of each sale. It reduces the hands-on work, but the collection may sell over a longer period.",
  },
  {
    title: "Specialty Auction",
    body: "An instrument auction can make sense for rare pieces with strong documentation. Auction timing, seller fees, and the quality of the bidder pool all affect the result.",
  },
];

// FAQs sourced from live JSON-LD (reference/sell-a-guitar-collection-jsonld.json).
// Toggle IDs match live's `panel-` / `toggle_` IDs for inbound-link parity.
const faqs = [
  {
    id: "toggle_e51afd6282088838c",
    q: "How Do You Determine My Guitar Collection’s Price & Value?",
    a: "When you bring your guitar in for appraisal, I will inspect your guitar carefully. Its make and model, the age, condition, and any unique features the guitar has will be considered as I determine its value. You will receive a written appraisal detailing my assessment and findings, along with the determined value of your guitar so you can make an informed decision for moving forward with keeping or selling it.",
  },
  {
    id: "toggle_36b0dcad5b96e59a8",
    q: "How Long Will The Process Of Selling My Vintage Guitar Collection Take?",
    a: "When you visit Joe’s Vintage Guitar for an appraisal and assessment, I do everything I can to make the process quick, painless, and straightforward for you. I share as much information as I can without overwhelming you, and take my time understanding the guitar’s history and sentimental value to you personally. If you are ready to sell it, the actual process is relatively quick and simple.",
  },
  {
    id: "toggle_8517607e71808a494",
    q: "Will I Have To Pay For Shipping Taxes To Sell My Vintage Guitar Collection?",
    a: "When I purchase your guitar, all expected fees and information are up front. I will never surprise you with hidden shipping fees or unexpected taxes, because I want the process to be painless and easy for you. We will take the utmost care as we package and ship your vintage guitar to my inventory. Feel free to text or call me for more details about the shipping process!",
  },
  {
    id: "toggle_97d0a78fd56124e29",
    q: "Can I Sell My Guitar Collection On Consignment Or Trade It For Other Guitars?",
    a: "Consignment comes with a few risks, but depending on your guitar I am willing to offer the opportunity to you. I want you to have a guitar that you love, so if you are interested in trading your guitar for one from my inventory, let’s talk! I am flexible and ready to work with you to ensure a fair trade experience for all involved.",
  },
  {
    id: "toggle_37b36752c094139f4",
    q: "Is There A Warranty Or Return Policy After Buying Or Selling My Guitar Collection?",
    a: "I love guitars and want you to love yours too! If you purchase a guitar from my inventory and feel there was missing information, or you are simply unhappy with your purchase, please reach out to me! I will do everything possible to make it right for you.",
  },
  {
    id: "faq_collection_inventory",
    q: "Do I Need An Inventory Before Contacting Joe?",
    a: "No. A rough count, your location, and a few clear photos are enough to begin. Send any records that already exist, but I can help identify, document, and organize a collection that doesn’t have an inventory.",
  },
  {
    id: "faq_collection_types",
    q: "What Types Of Instruments And Gear Do You Buy In A Collection?",
    a: "I buy collections that can include electric and acoustic guitars, basses, amplifiers, effects, mandolins, banjos, parts, and mixed musical instruments. If you are unsure what something is, send a wide photo and a rough count so I can review it with you.",
  },
  {
    id: "faq_partial_collection",
    q: "Can I Sell Only Part Of My Guitar Collection?",
    a: "Tell me which instruments are available and which ones you or your family plan to keep. I can review the group being offered and explain whether a direct purchase, consignment, trade, or another route makes sense for those instruments.",
  },
  {
    id: "faq_collection_travel",
    q: "How Large Must A Collection Be For Nationwide Pickup?",
    a: "Travel depends on the collection’s location, size, and instruments. Send a rough count and a few photos first. I will tell you whether a remote review, shipping plan, or on-site visit makes sense before either of us commits to travel.",
  },
  {
    id: "faq_appraisal_offer",
    q: "What Is The Difference Between An Appraisal And A Purchase Offer?",
    a: "An appraisal explains the collection’s current market value based on the instruments, condition, originality, and available records. A purchase offer is the amount I can pay in a direct sale after accounting for the work, transportation, and resale involved. I explain that tradeoff so you can choose the right selling route.",
  },
  {
    id: "faq_collection_payment_transport",
    q: "How Are Payment And Transportation Handled?",
    a: "For a large on-site purchase, I may drive my box truck or fly to your location and rent a truck there. Once we agree on the purchase, we load the collection and complete payment by cash or transfer the same day.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q.replace(/’/g, "'").replace(/&/g, "&"),
      acceptedAnswer: { "@type": "Answer", text: f.a.replace(/’/g, "'") },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/#breadcrumb",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Sell A Guitar Collection", item: "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/#webpage",
    name: "Sell A Guitar Collection Nationwide | Joe's Guitars",
    description: "Sell your vintage guitar collection to Joe. Get a free appraisal, a clear offer, and nationwide pickup for large collections, estates, and inherited gear.",
    url: "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/",
    about: { "@id": "https://www.joesvintageguitarsaz.com/" },
    breadcrumb: { "@id": "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/#breadcrumb" },
    dateModified: "2026-10-02",
    mainEntityOfPage: "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/",
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "@id": "https://www.joesvintageguitarsaz.com/sell-a-guitar-collection/#video",
    name: "Meet Vintage Guitar Buyer, Joe Dampt",
    description: "Meet Joe Dampt of Joe's Vintage Guitars and see how selling your vintage guitar collection to a nationwide buyer works.",
    thumbnailUrl: "https://img.youtube.com/vi/zMd6IJ-6e-8/maxresdefault.jpg",
    uploadDate: "2023-11-20T09:28:04-08:00",
    embedUrl: "https://www.youtube.com/embed/zMd6IJ-6e-8",
    contentUrl: "https://www.youtube.com/watch?v=zMd6IJ-6e-8",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
  },
];
---

<Layout
  bodyClass="collection-page"
  title="Sell A Guitar Collection Nationwide | Joe's Guitars"
  description="Sell your vintage guitar collection to Joe. Get a free appraisal, a clear offer, and nationwide pickup for large collections, estates, and inherited gear."
  canonical="/sell-a-guitar-collection/"
  ogImage={`${SITE_URL}${FEATURED_IMG}`}
  structuredData={structuredData}
>
  <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
  <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>

  <InstagramEmbeds />

  <!-- 1. Hero: dark-brown background, large title, intro box, and jump button -->
  <section class="smc-hero">
    <div class="smc-hero__inner">
      <h1>Sell Your Vintage Guitar Collection In The US</h1>
      <div class="smc-hero__rule" aria-hidden="true"></div>
      <p class="smc-hero__subtitle">Nationwide Guitar Collection Buyer Who Comes To You</p>

      <div class="smc-intro-box">
        <p>Whether you’ve been building your collection for decades or you’re just ready to pass it on, I’ll make the process simple, fast, and pressure-free.</p>
        <p>I buy entire collections: guitars, basses, amplifiers, mandolins, banjos, and more. With years of experience and over $1 million in cash ready to go, I can make you a serious same-day offer on everything at once. No listing items one by one, no lowball offers, no waiting weeks for a sale.</p>
        <p class="smc-intro-box__brands">Brands I’m looking for include: <a href="/sell-my-gibson-guitar/">Gibson</a>, <a href="/sell-my-fender-guitar/">Fender</a>, <a href="/sell-my-martin-guitar/">Martin</a>, <a href="/sell-my-gretsch-guitar/">Gretsch</a>, <a href="/sell-my-rickenbacker-guitar/">Rickenbacker</a>, <a href="/sell-my-guild-guitar/">Guild</a>, <a href="/sell-your-vintage-dangelico-guitar-in-the-us/">D’Angelico</a>, <a href="/sell-my-national-guitar/">National</a>, Epiphone, Marshall, Vox & more! I also buy <a href="/sell-an-amplifier-or-effect/">amplifiers and effects</a> on their own.</p>
        <p>I travel all across the U.S. with my trailer and come right to you. California, New York, anywhere in between. One call, one visit, one fair offer, it’s that simple.</p>
        <div class="smc-intro-box__divider"></div>
        <div class="smc-intro-box__contact">
          <span>Call Or Text: <a href={`tel:${contact.tel}`}>{contact.phone}</a></span>
          <span>Email: <a href={`mailto:${contact.email}`}>{contact.email}</a></span>
        </div>
        <div class="smc-intro-box__jump">
          <p class="smc-intro-box__jump-label">Every collection has a story.</p>
          <a href="#notable-purchases" class="smc-intro-box__jump-btn">See Our Notable Past Purchases ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. Answer-first summary and section navigation -->
  <section class="smc-overview" aria-labelledby="collection-answer-heading">
    <div class="smc-inner smc-overview__grid">
      <div class="smc-overview__answer">
        <p class="smc-overview__eyebrow">The Short Answer</p>
        <h2 id="collection-answer-heading">How To Sell A Guitar Collection Without Listing Every Instrument</h2>
        <p>Joe buys complete vintage guitar collections across the U.S. Start with photos and a conversation. Joe can appraise the collection remotely and travel for large purchases, with the goal of completing the sale in one visit.</p>
        <p>Still comparing your options? Read Joe’s <a href="/post/how-to-sell-a-large-guitar-collection-every-option-honestly-explained/">guide to selling a large guitar collection</a>.</p>
        <a href="#collection-appraisal-form" class="smc-btn smc-btn--rust">Get A Free Collection Appraisal</a>
      </div>
      <nav class="smc-overview__nav" aria-label="On This Page">
        <p class="smc-overview__nav-title">On This Page</p>
        <ol>
          <li><a href="#collection-appraisal-form">Get A Collection Appraisal</a></li>
          <li><a href="#collection-appraisal-checklist">Prepare Photos And Details</a></li>
          <li><a href="#collection-buying-process">See How The Buying Process Works</a></li>
          <li><a href="#inherited-guitar-collection">Sell An Inherited Guitar Collection</a></li>
          <li><a href="#collection-selling-options">Compare Ways To Sell</a></li>
          <li><a href="#notable-purchases">View Notable Collection Purchases</a></li>
          <li><a href="#faqs-collection">Read Guitar Collection FAQs</a></li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- 1c. Lead form -->
  <section id="collection-appraisal-form" class="px-4 py-12 sm:py-16 smc-anchor" style="background: var(--color-brand-cream);">
    <div class="mx-auto max-w-[760px]">
      <LeadForm
        formId="sell-a-collection"
        collection
        heading="Sell Your Vintage Guitar Collection"
        subheading="Get A Free Appraisal And A Fair Cash Offer Today"
      />
    </div>
  </section>

  <!-- 1d. Appraisal preparation and collection scope -->
  <section id="collection-appraisal-checklist" class="smc-prep smc-anchor">
    <div class="smc-inner">
      <div class="smc-prep__header">
        <p class="smc-prep__eyebrow">A Simple Place To Start</p>
        <h2>What To Send For A Guitar Collection Appraisal</h2>
        <p>You don’t need a finished inventory or exact dates for every instrument before you contact me. A few clear photos and the basic details below are enough for our first conversation.</p>
      </div>

      <div class="smc-prep__layout">
        <ol class="smc-prep__checklist">
          {appraisalChecklist.map((item, index) => (
            <li>
              <span class="smc-prep__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <aside class="smc-prep__scope" aria-labelledby="collection-types-heading">
          <p class="smc-prep__scope-label">Collection Types</p>
          <h3 id="collection-types-heading">What I Buy In A Collection</h3>
          <p>I buy complete and mixed collections that can include:</p>
          <ul>
            <li>Vintage and quality used electric guitars</li>
            <li>Acoustic, archtop, and resonator guitars</li>
            <li>Vintage and collectible bass guitars</li>
            <li><a href="/sell-an-amplifier-or-effect/">Amplifiers and effects</a></li>
            <li>Mandolins, banjos, and other string instruments</li>
            <li>Cases, parts, paperwork, and related accessories</li>
          </ul>
          <p>Collections don’t need to be organized by brand or value. If you’re unsure what you have, send a wide photo and we can start there.</p>
          <a href="#collection-appraisal-form" class="smc-btn smc-btn--cream">Start My Appraisal</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- 2. How It Works: 3 numbered steps with keyword tags and a CTA -->
  <section id="collection-buying-process" class="smc-hiw smc-anchor">
    <div class="smc-inner">
      <div class="smc-hiw__header">
        <p class="smc-hiw__eyebrow">Guitar & Instrument Collection Liquidation</p>
        <h2 class="smc-hiw__title">How Our Collection<br />Purchasing Process Works</h2>
        <p class="smc-hiw__subtitle">Whether you’re liquidating a lifelong collection, settling an estate, or selling a retiring musician’s instruments, my collection buying process is fast, fair, and hassle-free.</p>
