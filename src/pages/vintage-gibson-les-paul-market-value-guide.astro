---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/primitives/PageHero.astro";
import Button from "../components/primitives/Button.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import LicensedImage from "../components/LicensedImage.astro";
import { contact, hrefs } from "../config/site";

import standardPhoto from "../assets/les-paul-family/1956-les-paul-goldtop.jpg";
import customPhoto from "../assets/les-paul-family/1958-les-paul-custom.jpg";
import specialPhoto from "../assets/les-paul-family/1958-les-paul-special.jpg";
import juniorPhoto from "../assets/les-paul-family/1955-les-paul-junior.jpg";
import pafPhoto from "../assets/les-paul-family/feature-details/1957-gibson-PAF-pickup-1024x683.jpg";
import electronicsPhoto from "../assets/les-paul-family/feature-details/1954-gibson-les-paul-goldtop-electronics-cavity-wiring-scaled.jpg";
import goldtopValuePhoto from "../assets/les-paul-family/1954-les-paul-goldtop.jpg";
import burstFinishPhoto from "../assets/les-paul-family/feature-details/gibson-les-paul-burst-finish-example.jpg";

const modelCards = [
  {
    id: "les-paul-standard-value",
    title: "Les Paul Standard",
    range: "$20,000 to $500,000+ in this guide",
    body: "The Standard has the widest value range. Early Goldtops, PAF Goldtops and 1958 to 1960 Sunburst Standards are different markets, so the year, bridge, pickups, finish and originality all matter.",
    image: standardPhoto,
    alt: "Original 1956 Gibson Les Paul Standard Goldtop with two cream P-90 pickups",
    href: "/gibson-les-paul-dating-guide/#goldtop-standard",
    link: "Identify A Les Paul Standard",
  },
  {
    id: "les-paul-custom-value",
    title: "Les Paul Custom",
    range: "$12,000 to $225,000 in this guide",
    body: "A 1950s Custom with its original pickup set is valued very differently from a late 1960s example. Confirm the pickup layout, gold hardware, neck, finish and repairs before choosing a range.",
    image: customPhoto,
    alt: "Original black 1958 Gibson Les Paul Custom with three humbuckers and a Bigsby vibrato",
    href: "/gibson-les-paul-dating-guide/#les-paul-custom",
    link: "Identify A Les Paul Custom",
  },
  {
    id: "les-paul-special-value",
    title: "Les Paul Special",
    range: "$8,000 to $21,000 in this guide",
    body: "TV Yellow and Cherry examples do not carry the same value. Body style, neck joint, pickup routes, finish and original P-90s are especially important on Juniors and Specials that have been modified over the years.",
    image: specialPhoto,
    alt: "Original 1958 Gibson Les Paul Special in TV Yellow with two black P-90 pickups",
    href: "/gibson-les-paul-dating-guide/#les-paul-special",
    link: "Identify A Les Paul Special",
  },
  {
    id: "les-paul-junior-value",
    title: "Les Paul Junior",
    range: "$6,000 to $20,000 in this guide",
    body: "The one-pickup Junior looks simple, but finish, body shape, pickup position, bridge, tuners and untouched electronics separate valuable original guitars from refinished or rebuilt examples.",
    image: juniorPhoto,
    alt: "Original sunburst 1955 Gibson Les Paul Junior with one dog-ear P-90 pickup",
    href: "/post/gibson-les-paul-junior-guide/",
    link: "Read The Les Paul Junior Guide",
  },
];

const prices = [
  { m: "Standard, 1952 to 1953", v: "$20,000 to $40,000" },
  { m: "Standard, 1954 to 1956", v: "$40,000 to $80,000" },
  { m: "Standard, 1957 to 1958 Goldtop with humbuckers", v: "$135,000 to $250,000" },
  { m: "Standard, 1958 to 1960 Sunburst with humbuckers", v: "$200,000 to $500,000+" },
  { m: "Standard, 1968 to 1969", v: "$8,000 to $24,000" },
  { m: "Custom, 1953 to 1957", v: "$25,000 to $55,000" },
  { m: "Custom, 1957 to 1961", v: "$60,000 to $225,000" },
  { m: "Custom, 1968 to 1969", v: "$12,000 to $18,000" },
  { m: "Special, 1955 to 1959 TV Yellow", v: "$13,000 to $21,000" },
  { m: "Special, 1959 Cherry Red", v: "$8,000 to $15,000" },
  { m: "Junior, 1954 to 1958 Sunburst", v: "$6,000 to $13,000" },
  { m: "Junior, 1955 to 1958 TV Yellow", v: "$10,000 to $20,000" },
];

const factors = [
  { t: "Headstock Break Or Repair", b: "Even a clean, professional repair usually lowers the value by roughly 40 to 50% compared with an otherwise similar unbroken example." },
  { t: "Refinished Body Or Neck", b: "A non-original finish can lower the value by roughly 40 to 50%. Finish wear, checking and black-light response must be evaluated together before calling a guitar refinished." },
  { t: "Replaced Or Routed Pickups", b: "A pickup swap with no routing can mean roughly 25%. A P-90 to humbucker route can mean 35 to 40% because wood was removed, and missing original PAFs can have an even larger effect." },
  { t: "Added Locking Tremolo", b: "A locking tremolo installation can lower the value by roughly 35 to 45%. The routing and mounting holes make this one of the harder modifications to reverse." },
  { t: "Replaced Tuners", b: "Replaced tuners often mean roughly 10 to 15%. Extra holes, enlarged post holes and the missing original set matter more than a clean no-drill replacement." },
  { t: "Refret", b: "A good refret often changes the value by only 5 to 10%. Playability and the quality of the work matter, especially when the original frets were already worn out." },
  { t: "Replaced Pots Or Electronics", b: "Changed pots, capacitors or wiring can mean roughly 10 to 20%, depending on the guitar and what remains. Disturbed solder can also make original pickups harder to verify." },
  { t: "Extra Holes Or Missing Parts", b: "Extra strap-button holes may mean about 10%. Missing pickguards, switch rings, bridges and other model-specific parts are valued individually because some originals are expensive to replace." },
];

const appraisalSteps = [
  {
    title: "Identify The Exact Model And Year",
    body: "Start with the body shape, pickup layout and trim level, then use the serial number as one piece of the date. A serial alone does not prove that the rest of the guitar is from the same period.",
    links: [
      ["Gibson serial number lookup", "/how-to-read-gibson-serial-numbers/"],
      ["Les Paul dating guide", "/gibson-les-paul-dating-guide/"],
    ],
  },
  {
    title: "Check The Finish And Construction",
    body: "Look for the correct neck joint, body construction, routing, logo, hardware era and finish evidence. A refinished guitar can still be valuable, but it belongs in a different comparison set.",
    links: [
      ["Gibson physical features guide", "/gibson-physical-features-hardware-guide/"],
      ["Gibson logo chronology", "/gibson-headstock-logo-chronology/"],
      ["What a serial number cannot tell you", "/post/what-a-serial-number-cant-tell-you/"],
    ],
  },
  {
    title: "Inventory The Original Parts",
    body: "Pickups, pots, capacitors, tuners, knobs, bridge and case should be checked separately. A guitar can have the correct serial number and still contain thousands of dollars in replaced parts.",
    links: [
      ["PAF and Patent Number pickup guide", "/post/gibson-paf-patent-number-pickup-guide/"],
      ["Gibson pot code guide", "/gibson-pot-codes/"],
      ["Gibson knob guide", "/gibson-knob-dating-guide/"],
      ["Gibson tuner guide", "/gibson-tuner-dating-guide/"],
    ],
  },
  {
    title: "Compare The Right Market",
    body: "Compare the guitar with recent examples of the same model, year, finish, condition and originality. An asking price is not the same as a completed sale, and an exceptional celebrity-owned guitar is not a useful comparison for an ordinary example.",
    links: [
      ["Gibson shipping totals", "/post/gibson-shipping-totals-1948-1979/"],
      ["Request a free appraisal", "/free-appraisal/"],
    ],
  },
];

const faqs = [
  { q: "How Much Is A Vintage Gibson Les Paul Worth?", a: "It depends on the model, year, originality and condition. The guitars covered in this guide range from about $6,000 for some vintage Juniors to more than $500,000 for exceptional 1958 to 1960 Sunburst Standards. A specific guitar needs to be identified and inspected before that range becomes useful." },
  { q: "How Do I Find The Year Of My Gibson Les Paul?", a: "Start with the serial number on the back of the headstock, but do not stop there. Gibson reused numbers and used several formats. Compare the result with the guitar’s construction and parts using the <a href=\"/how-to-read-gibson-serial-numbers/\">Gibson serial number lookup</a> and <a href=\"/gibson-les-paul-dating-guide/\">Les Paul dating guide</a>." },
  { q: "Can A Gibson Serial Number Tell Me What My Les Paul Is Worth?", a: "No. A serial number may help establish a production period, but value also depends on the exact model, original finish, pickups, electronics, repairs, condition and provenance. Reissues and altered vintage guitars can also carry serials that are easy to misread." },
  { q: "Does A Headstock Repair Affect Les Paul Value?", a: "Yes. Even a clean, professional repair commonly lowers the value by roughly 40 to 50% compared with a similar unbroken guitar. The location, visibility, stability and amount of added finish all matter." },
  { q: "How Much Does A Refinish Affect Les Paul Value?", a: "A refinished vintage Les Paul is often worth roughly 40 to 50% less than a comparable guitar with its original finish. The exact effect depends on the model, the quality of the work and how much original finish remains." },
  { q: "What Are PAF Pickups And Why Do They Matter?", a: "PAF humbuckers were used on valuable late 1950s and early 1960s Gibsons. Original examples are valuable on their own, so missing pickups, opened covers and disturbed solder can materially change the guitar’s value. Use the <a href=\"/post/gibson-paf-patent-number-pickup-guide/\">PAF and Patent Number pickup guide</a> before drawing a conclusion." },
  { q: "What Is The Most Valuable Vintage Les Paul?", a: "The 1958 to 1960 Sunburst Standard is the most consistently valuable production model in this guide. Original examples can range from about $200,000 to $500,000 or more, while famous provenance or exceptional condition can move an individual guitar outside a normal guide range." },
  { q: "Are 1970s Gibson Les Pauls Valuable?", a: "Yes. Model, year, finish and originality still matter. Early 1970s construction details, rare factory finishes and desirable original hardware can increase demand, while routing, refinishing and replaced parts reduce the number." },
  { q: "Does The Original Case Increase A Les Paul’s Value?", a: "The correct original case helps the value and completeness of a collectible Les Paul, but it does not authenticate the guitar by itself. Case style, wear and hardware should agree with the instrument’s era." },
  { q: "What Photos Do I Need For A Les Paul Appraisal?", a: "Send the full front and back, the front and back of the headstock, the serial number, control cavity, pickups and solder that can be photographed safely, plus any repairs, changed parts, case and paperwork. Do not remove valuable pickups or disturb original solder just to take a photo." },
  { q: "Should I Clean A Vintage Les Paul Before Selling It?", a: "Do not aggressively polish, buff or disassemble it. Leave checking, patina and untouched solder alone. A dry soft cloth is safer than experimenting with cleaners on an old nitrocellulose finish." },
];

const structuredData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Vintage Gibson Les Paul Value Guide", item: "https://www.joesvintageguitarsaz.com/vintage-gibson-les-paul-market-value-guide/" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Vintage Gibson Les Paul Value Guide",
    description: "Current vintage Gibson Les Paul values by model and year, plus the originality, repairs and parts that affect market value.",
    datePublished: "2026-06-09",
    dateModified: "2026-09-18",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: "https://www.joesvintageguitarsaz.com/vintage-gibson-les-paul-market-value-guide/",
    image: "https://www.joesvintageguitarsaz.com/images/og/vintage-gibson-les-paul-market-value-guide.jpg",
  },
];

const stripTags = (s: string) => s.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
structuredData.push({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: stripTags(f.a) },
  })),
});
---

<Layout
  title="Gibson Les Paul Value Guide: Vintage Prices By Year"
  description="See vintage Gibson Les Paul values by model and year, including Standards, Customs, Specials and Juniors, plus the repairs and parts that affect price."
  canonical="/vintage-gibson-les-paul-market-value-guide/"
  ogImage="https://www.joesvintageguitarsaz.com/images/og/vintage-gibson-les-paul-market-value-guide.jpg"
  ogImageAlt="Vintage Gibson Les Paul value guide from Joe's Vintage Guitars"
  ogType="article"
  structuredData={structuredData}
>
  <PageHero
    eyebrow="2026 Price Guide"
    title="Vintage Gibson Les Paul Value Guide"
    subhead="Current price ranges for the Les Paul Standard, Custom, Special and Junior, with the originality and condition checks that determine where a guitar belongs."
    subheadTag="p"
    subheadHtml={true}
    bgImage="/images/hero-background.jpg"
  >
    <Button slot="cta" href="/free-appraisal/" variant="cream" size="lg">Get A Free Appraisal</Button>
    <Button slot="cta" href="/sell-my-gibson-guitar/" variant="outline-cream" size="lg">Sell My Les Paul</Button>
  </PageHero>

  <div class="vg-page">
    <section class="vg-section vg-intro" aria-labelledby="worth-heading">
      <div class="vg-inner">
        <p class="vg-byline">By <a href="/about-me/">Joe Dampt</a> · Updated <time datetime="2026-09-18">September 18, 2026</time></p>
        <div class="vg-intro-grid">
          <div>
            <p class="vg-kicker">The Short Answer</p>
            <h2 class="vg-head" id="worth-heading">How Much Is A Vintage Gibson Les Paul Worth?</h2>
            <div class="vg-rule" aria-hidden="true"></div>
            <p class="vg-lede">The vintage Gibson Les Pauls covered here range from about <strong>$6,000</strong> for some Juniors to <strong>$500,000 or more</strong> for exceptional 1958 to 1960 Sunburst Standards. The useful number depends on the exact model, year, finish, original parts, repairs and condition.</p>
            <p>This is a market guide, not an offer or insurance appraisal. Start with the table, then use the inspection steps below to determine whether your guitar belongs near the top, middle or bottom of its range.</p>
          </div>
          <nav class="vg-jump" aria-label="On this page">
            <p>On This Page</p>
            <a href="#les-paul-values">Values By Model And Year</a>
            <a href="#goldtop-burst-values">Goldtop And Burst Values</a>
            <a href="#les-paul-models">Standard, Custom, Special And Junior</a>
            <a href="#value-factors">What Changes The Value</a>
            <a href="#appraise-les-paul">How To Value A Les Paul</a>
            <a href="#sell-vintage-les-paul">Selling A Vintage Les Paul</a>
            <a href="#les-paul-faqs">Value Questions</a>
          </nav>
        </div>
      </div>
    </section>

    <section class="vg-section vg-section--alt" id="les-paul-values" aria-labelledby="values-heading">
      <div class="vg-inner">
        <p class="vg-kicker">Current Reference Ranges</p>
        <h2 class="vg-head" id="values-heading">Vintage Gibson Les Paul Values By Model And Year</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-note">These ranges describe all-original guitars in excellent condition with the correct original case. They are starting points for the United States market. Price ranges reviewed July 2026. Page updated September 2026. An individual guitar can fall outside the range.</p>
        <div class="vg-table-wrap">
          <table class="vg-table">
            <caption class="sr-only">Estimated 2026 vintage Gibson Les Paul values by model and year</caption>
            <thead>
              <tr><th scope="col">Model And Year</th><th scope="col">Estimated Value</th></tr>
            </thead>
            <tbody>
              {prices.map((price) => (
                <tr>
                  <td data-label="Model And Year">{price.m}</td>
                  <td data-label="Estimated Value">{price.v}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="vg-methodology" aria-labelledby="methodology-heading">
          <h3 id="methodology-heading">How These Les Paul Values Were Calculated</h3>
          <p>These are Joe’s estimates of likely United States retail market value for correctly identified guitars. They are not automatic purchase offers, auction estimates or insurance replacement values. When reviewing a range, Joe compares recent completed sales and credible dealer listings with guitars he has personally appraised, bought or sold. An unsold asking price is useful context, but it does not establish what a guitar is worth.</p>
          <p>The table assumes an all-original guitar in excellent condition with the correct original case. The finish, pickups, repairs, changed parts and provenance discussed below determine where a specific guitar belongs within—or outside—a range.</p>
        </div>

        <aside class="vg-scope" aria-labelledby="scope-heading">
          <h3 id="scope-heading">Which Vintage Les Paul Years Does This Table Cover?</h3>
          <p>The ranges emphasize the original single-cut Les Paul models from the 1950s and the returned 1968 to 1969 Standard and Custom. From 1961 into 1963, some SG-shaped guitars were sold under Les Paul model names; compare those instruments with the <a href="/gibson-sg-dating-guide/">Gibson SG dating guide</a>, not the single-cut rows above. Later Deluxes, Standards, Customs and Heritage-era models from the 1970s and 1980s also require their own model-and-year comparisons. If yours falls outside this table, <a href="/free-appraisal/">send photos for a free appraisal</a>.</p>
        </aside>

        <aside class="vg-callout">
          <p><strong>Do not choose a row from the serial number alone.</strong> Gibson serials can overlap, and the highest-value models are also copied and converted. Use the <a href="/how-to-read-gibson-serial-numbers/">Gibson serial number lookup</a>, then confirm the guitar with the <a href="/gibson-les-paul-dating-guide/">model-specific Les Paul dating guide</a>.</p>
        </aside>
      </div>
    </section>

    <section class="vg-section" id="goldtop-burst-values" aria-labelledby="goldtop-burst-heading">
      <div class="vg-inner">
        <p class="vg-kicker">The Standard’s Two Major Markets</p>
        <h2 class="vg-head" id="goldtop-burst-heading">Why Gibson Les Paul Goldtops And Bursts Have Different Values</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-section-intro">“Les Paul Standard” covers several materially different guitars. The finish, bridge and pickup changes between 1952 and 1960 divide Goldtops and Sunburst Standards into separate collector markets.</p>

        <div class="vg-era-grid">
          <article class="vg-era-card">
            <figure>
              <LicensedImage src={goldtopValuePhoto} alt="Original 1954 Gibson Les Paul Goldtop with cream P-90 pickups and wraparound bridge" sizes="(max-width: 800px) calc(100vw - 28px), 536px" />
              <figcaption>An original 1954 Goldtop with P-90 pickups and a wraparound bridge. Photo by Joe Dampt.</figcaption>
            </figure>
            <div class="vg-era-card__copy">
              <h3>Gibson Les Paul Goldtop Values</h3>
              <p>The 1952 to 1956 Goldtops use P-90 pickups, but their bridge systems changed from the early trapeze to a wraparound and then a Tune-o-matic. Those changes affect playability, collector demand and value. The 1957 and early 1958 Goldtops with original PAF humbuckers occupy a much higher tier.</p>
              <p>Finish authenticity, original cream plastic, correct hardware and untouched pickup solder all matter. Compare the details in the <a href="/post/1954-gibson-les-paul-goldtop-authentication-guide/">1954 Goldtop guide</a>, <a href="/post/1956-les-paul-goldtop-authentication-guide/">1956 Goldtop guide</a> and <a href="/post/1957-les-paul-goldtop-guide/">1957 PAF Goldtop guide</a>.</p>
            </div>
          </article>

          <article class="vg-era-card">
            <figure>
              <LicensedImage src={burstFinishPhoto} alt="Close-up of a Gibson Les Paul cherry sunburst finish over figured maple beside the bridge and tailpiece" sizes="(max-width: 800px) calc(100vw - 28px), 536px" />
              <figcaption>Cherry sunburst color, fade and maple figure are visible here. The photo illustrates the finish; those details alone do not authenticate a 1958 to 1960 Burst. Photo by Joe Dampt.</figcaption>
            </figure>
            <div class="vg-era-card__copy">
              <h3>1958 To 1960 Gibson Les Paul Burst Values</h3>
              <p>Gibson’s 1958 to 1960 Sunburst Standards expose the maple top beneath a cherry sunburst finish. Original PAF pickups, finish, top figure, fade, neck condition and provenance can move two seemingly similar Bursts to very different values.</p>
              <p>A dramatic top or attractive fade can add collector interest, but neither proves the year or originality. The serial number, finish under protected areas, pickup routes, solder, hardware and neck must tell the same story. Use the <a href="/gibson-les-paul-dating-guide/#goldtop-standard">Les Paul Standard dating guide</a> before applying the Burst range.</p>
            </div>
          </article>
        </div>

        <div class="vg-guide-block" aria-labelledby="guide-links-heading">
          <h3 id="guide-links-heading">Detailed Vintage Les Paul Guides</h3>
          <div class="vg-guide-links">
            <a href="/post/vintage-gibson-les-paul-family-guide/">Les Paul Family Guide</a>
            <a href="/post/1955-1958-tv-yellow-les-paul-special-guide/">TV Yellow Special Guide</a>
            <a href="/post/gibson-les-paul-junior-guide/">Les Paul Junior Guide</a>
            <a href="/post/gibson-les-paul-tv-model-guide/">Les Paul TV Model Guide</a>
            <a href="/post/gibson-shipping-totals-1948-1979/">Gibson Shipping Totals</a>
            <a href="/post/one-owner-1983-gibson-les-paul-custom/">1983 Les Paul Custom Story</a>
          </div>
        </div>
      </div>
    </section>

    <section class="vg-section vg-section--alt" id="les-paul-models" aria-labelledby="models-heading">
      <div class="vg-inner">
        <p class="vg-kicker">Choose The Right Family</p>
        <h2 class="vg-head" id="models-heading">Gibson Les Paul Values By Model</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-section-intro">Model identification comes before price. These original guitars show the basic Standard, Custom, Special and Junior families, but the details changed throughout production.</p>
        <div class="vg-model-grid">
          {modelCards.map((model) => (
            <article class="vg-model-card" id={model.id}>
              <figure>
                <LicensedImage src={model.image} alt={model.alt} sizes="(max-width: 800px) calc(100vw - 28px), 536px" />
                <figcaption>Original example photographed by Joe Dampt.</figcaption>
              </figure>
              <div class="vg-model-card__copy">
                <h3>{model.title}</h3>
                <p class="vg-model-card__range">{model.range}</p>
                <p>{model.body}</p>
                <a class="vg-card-link" href={model.href}>{model.link}<span aria-hidden="true"> →</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="vg-section" id="value-factors" aria-labelledby="factors-heading">
      <div class="vg-inner">
        <p class="vg-kicker">Originality And Condition</p>
        <h2 class="vg-head" id="factors-heading">What Changes A Vintage Les Paul’s Value?</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-section-intro">The percentages below are practical estimates, not fixed deductions. Two guitars with the same repair can still sell for different amounts because rarity, finish, overall condition and buyer demand are different.</p>
        <div class="vg-factor-grid">
          {factors.map((factor) => (
            <article class="vg-factor-card">
              <h3>{factor.t}</h3>
              <p>{factor.b}</p>
            </article>
          ))}
        </div>

        <div class="vg-evidence-grid">
          <figure class="vg-evidence">
            <LicensedImage src={pafPhoto} alt="Original Gibson PAF humbucker with its Patent Applied For decal and factory solder" sizes="(max-width: 800px) calc(100vw - 28px), 536px" />
            <figcaption><strong>Original pickups matter.</strong> This PAF decal, baseplate and factory cover solder are part of the evidence. Do not remove a sealed cover just to inspect a valuable pickup. <a href="/post/gibson-paf-patent-number-pickup-guide/">Compare PAF and Patent Number pickups</a>.</figcaption>
          </figure>
          <figure class="vg-evidence">
            <LicensedImage src={electronicsPhoto} alt="Original 1954 Gibson Les Paul Goldtop control cavity with pots, capacitors and braided wiring" sizes="(max-width: 800px) calc(100vw - 28px), 536px" />
            <figcaption><strong>Untouched electronics support originality.</strong> Pot codes, capacitors, braided wire and solder should tell a consistent story. <a href="/gibson-pot-codes/">Learn how to read Gibson pot codes</a>.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="vg-section vg-section--alt" id="appraise-les-paul" aria-labelledby="appraise-heading">
      <div class="vg-inner">
        <p class="vg-kicker">A Repeatable Valuation Process</p>
        <h2 class="vg-head" id="appraise-heading">How I Estimate A Vintage Les Paul’s Value</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-section-intro">A useful appraisal is a chain of evidence. I work through these four steps before comparing a guitar with the market.</p>
        <ol class="vg-steps">
          {appraisalSteps.map((step, index) => (
            <li>
              <span class="vg-step-number" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <p class="vg-step-links">
                  {step.links.map(([label, href], linkIndex) => (
                    <><a href={href}>{label}</a>{linkIndex < step.links.length - 1 && <span aria-hidden="true"> · </span>}</>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ol>
        <div class="vg-appraisal-cta">
          <div>
            <p class="vg-kicker">Need A Number For Your Guitar?</p>
