<script>
import {lookupRickenbacker} from '../lib/rickenbacker-lookup';
const form=document.querySelector<HTMLFormElement>('#rickenbacker-lookup');
const input=document.querySelector<HTMLInputElement>('#jvg-sn-input');
const output=document.querySelector<HTMLDivElement>('#jvg-result');
form?.addEventListener('submit',event=>{event.preventDefault();if(!input||!output)return;const result=lookupRickenbacker(input.value);output.replaceChildren();const heading=document.createElement('strong');heading.textContent=result.title;const message=document.createElement('p');message.textContent=result.message;output.append(heading,message);const link=document.createElement('a');link.href=result.href;link.textContent=result.link;output.append(link);input.setAttribute('aria-invalid',result.invalid?'true':'false');});
input?.addEventListener('input',()=>{output?.replaceChildren();input.removeAttribute('aria-invalid')});
function revealLegacyAnchor(){let target:HTMLElement|null=null;try{target=document.getElementById(decodeURIComponent(location.hash.slice(1)))}catch{return}if(!target)return;let ancestor:HTMLElement|null=target;while(ancestor){if(ancestor instanceof HTMLDetailsElement)ancestor.open=true;ancestor=ancestor.parentElement;}requestAnimationFrame(()=>target?.scrollIntoView());}
revealLegacyAnchor();window.addEventListener('hashchange',revealLegacyAnchor);
</script>
