import RickenbackerGuideLayout from '../layouts/RickenbackerGuideLayout.astro';
import RickenbackerPhoto from '../components/RickenbackerPhoto.astro';
import LicensedImage from '../components/primitives/LicensedImage.astro';
import {resolveImage} from '../lib/images';
import {SITE_URL} from '../config/site';
const faqs=[{"q":"Where Is The Serial Number On A Rickenbacker?","a":"On many guitars and basses, the serial is stamped in two parts on the output jackplate. Some solidbody guitars have a bridge-plate stamp. Early steels and other early models use different locations and numbering systems."},{"q":"Can A Rickenbacker Serial Number Prove Authenticity?","a":"A serial identifies a numbering format and may provide a date. It does not prove that the instrument or its installed parts are original. A replacement jackplate can carry a number that belongs to another instrument."},{"q":"Why Does My JK Or JL Serial Need Another Check?","a":"JK and JL fit November and December 1970 in the regular two-letter system, but those prefixes are also associated with the late-1960 transition. Compare the instrument’s model and construction before choosing a decade."},{"q":"Can I Date A Rickenbacker Without A Serial Number?","a":"Pickups, tuners, knobs, inlays and construction may narrow the period. Use several features together, account for replacements and reissues, and avoid assigning an exact year from one part."},{"q":"Does The Serial Number Tell Me The Guitar’s Value?","a":"The model, condition, original parts, repairs and demand affect value. Once you have a likely date, send photos of the complete instrument for an appraisal."}];
const schema=[{'@context':'https://schema.org','@type':'WebApplication',name:'Rickenbacker Serial Number Lookup',url:SITE_URL+'/rickenbacker-serial-numbers/',applicationCategory:'UtilityApplication',operatingSystem:'All',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description:'Free lookup for common Rickenbacker guitar and bass serial formats, with guidance for early instruments and ambiguous plates.'},{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<RickenbackerGuideLayout title="Rickenbacker Serial Number Lookup And Dating Guide" metaTitle="Rickenbacker Serial Number Lookup & Dating Guide" description="Date your Rickenbacker guitar or bass with our free serial number lookup. Find the serial, read date codes, and compare vintage features in photos." canonical="/rickenbacker-serial-numbers/" structuredData={schema}>
 <section class="rk-hero" id="decoder"><div class="rk-wrap rk-hero-grid"><div><p class="rk-kicker">Rickenbacker Serial Numbers And Identification</p><h1>Rickenbacker Serial Number Lookup</h1><p class="rk-lede">Enter the serial from your guitar or bass, then compare its features with the photo guides. Start with the complete code, including letters stamped above the jack.</p>
        <p class="jvg-guide-context">If you're comparing conflicting dates, see <a class="underline underline-offset-4" href="/how-old-is-my-guitar/">how to establish a guitar's age</a> before choosing a year.</p><p class="rk-byline">By <a href="/about-me/">Joe Dampt</a> · Updated October 15, 2026</p><nav class="rk-toc" aria-label="Quick links"><a href="#serial-locations">Find Your Serial</a><a href="#dating-guides">Feature Guides</a><a href="#serial-charts">Serial Charts</a></nav><p><a href="/free-appraisal/rickenbacker/">Get A Free Rickenbacker Appraisal</a></p></div>
 <form class="rk-tool" id="rickenbacker-lookup" novalidate><span id="jvg-s-0-rickenbacker-serial-numbers"></span><h2 id="jvg-s-1-quick-decoder-tool">Find Your Rickenbacker’s Date</h2><label for="jvg-sn-input">Serial Number</label><input id="jvg-sn-input" name="serial" type="text" maxlength="24" autocomplete="off" spellcheck="false" placeholder="For example, GD1234" aria-describedby="rick-input-help" required /><small id="rick-input-help">Enter letters and digits from both parts of the stamp. Spaces and hyphens are accepted.</small><button class="rk-button" type="submit">Look Up Serial Number</button><div class="rk-result" id="jvg-result" role="status" aria-live="polite" aria-atomic="true"></div><small>For guitars and basses. Amplifiers and early lap steels use other sequences. A matching code does not prove authenticity.</small><noscript><p>JavaScript is off. Use the serial charts below.</p></noscript></form></div></section>
 <section class="rk-section" id="dating-guides"><div class="rk-wrap"><div class="rk-section-head"><p class="rk-kicker">Check The Instrument Behind The Number</p><h2 id="jvg-s-16-advanced-dating-by-specs-and-features">Rickenbacker Dating Photo Guides</h2><p>The serial gives you a starting point. Open the guide for the part you are inspecting, then compare several features with the same model and period.</p></div><div class="rk-cards"><article class="rk-card"><a href="/rickenbacker-pickup-dating-guide/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/rickenbacker-serial/rickenbacker-toaster-pickup-scaled.jpg")!} alt="Chrome Rickenbacker toaster pickup with two dark slots" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-pickup-dating-guide/">Pickups</a></h3><p>Compare horseshoe, toaster and Hi-Gain pickups, then check the version against the instrument’s serial date and model.</p><a href="/rickenbacker-pickup-dating-guide/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-17-pickups"><a href="/rickenbacker-pickup-dating-guide/#jvg-s-17-pickups">Pickups</a></li><li id="jvg-s-18-horseshoe-pickup-1932-to-1971"><a href="/rickenbacker-pickup-dating-guide/#jvg-s-18-horseshoe-pickup-1932-to-1971">Horseshoe Pickup: 1932 to 1971</a></li><li id="jvg-s-19-toaster-pickup-1957-to-1974"><a href="/rickenbacker-pickup-dating-guide/#jvg-s-19-toaster-pickup-1957-to-1974">Toaster Pickup: 1957 to 1974</a></li><li id="jvg-s-20-hi-gain-pickup-1968-to-present"><a href="/rickenbacker-pickup-dating-guide/#jvg-s-20-hi-gain-pickup-1968-to-present">Hi-Gain Pickup: 1968 to Present</a></li></ul></details></div></article>
<article class="rk-card"><a href="/rickenbacker-tuner-dating-guide/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/rickenbacker-serial/rickenbacker-kluson-tuners-scaled.jpg")!} alt="Kluson tuners on the back of a Rickenbacker headstock" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-tuner-dating-guide/">Tuners</a></h3><p>Identify Kluson, Grover and Schaller tuners by their housings, buttons and mounting patterns. Guitar and bass timelines differ.</p><a href="/rickenbacker-tuner-dating-guide/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-22-tuning-machines"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-22-tuning-machines">Tuning Machines</a></li><li id="jvg-s-23-grover-sta-tite-1956-to-1959-1960"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-23-grover-sta-tite-1956-to-1959-1960">Grover Sta-Tite: 1956 to 1959/1960</a></li><li id="jvg-s-24-kluson-deluxe-1954-to-1982"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-24-kluson-deluxe-1954-to-1982">Kluson Deluxe: 1954 to 1982</a></li><li id="jvg-s-25-grover-slimline-bass-1969-to-1974-and-1982-to-1983"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-25-grover-slimline-bass-1969-to-1974-and-1982-to-1983">Grover Slimline (Bass): 1969 to 1974 and 1982 to 1983</a></li><li id="jvg-s-26-grover-rotomatic-360-guitar-september-1971-to-early-1985"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-26-grover-rotomatic-360-guitar-september-1971-to-early-1985">Grover Rotomatic (360 Guitar): September 1971 to Early 1985</a></li><li id="jvg-s-27-schaller-m6-mini-m6-to-1985-to-1996"><a href="/rickenbacker-tuner-dating-guide/#jvg-s-27-schaller-m6-mini-m6-to-1985-to-1996">Schaller M6 / Mini M6 to 1985 to 1996</a></li></ul></details></div></article>
<article class="rk-card"><a href="/rickenbacker-knobs-and-controls/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/rickenbacker-dating/360-silver-top-knobs-and-bridge.jpg")!} alt="Silver-top controls and white pickguard on a Mapleglo Rickenbacker 360" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-knobs-and-controls/">Knobs And Controls</a></h3><p>Compare cooker knobs, black vintage knobs, silver tops and control layouts. Check the model before using a knob style as a date clue.</p><a href="/rickenbacker-knobs-and-controls/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-21-control-knobs"><a href="/rickenbacker-knobs-and-controls/#jvg-s-21-control-knobs">Control Knobs</a></li><li id="jvg-s-40-control-configurations"><a href="/rickenbacker-knobs-and-controls/#jvg-s-40-control-configurations">Control Configurations</a></li></ul></details></div></article>
<article class="rk-card"><a href="/rickenbacker-body-binding-and-inlays/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/rickenbacker-serial/rickenbacker-checklerboard-binding-scaled.jpg")!} alt="Close view of checkerboard binding on a Rickenbacker body" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-body-binding-and-inlays/">Body, Binding And Inlays</a></h3><p>Compare body edges, checkerboard binding, fingerboard inlays, soundholes, pickguards and headstock details with the serial date.</p><a href="/rickenbacker-body-binding-and-inlays/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-28-fingerboard-inlays"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-28-fingerboard-inlays">Fingerboard Inlays</a></li><li id="jvg-s-29-dot-inlays-standard-trim"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-29-dot-inlays-standard-trim">Dot Inlays: Standard Trim</a></li><li id="jvg-s-30-triangle-inlays-deluxe-trim-models"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-30-triangle-inlays-deluxe-trim-models">Triangle Inlays: Deluxe Trim Models</a></li><li id="jvg-s-31-body-styles-binding-and-construction"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-31-body-styles-binding-and-construction">Body Styles, Binding, and Construction</a></li><li id="jvg-s-32-thin-hollowbody-capri-body-styles"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-32-thin-hollowbody-capri-body-styles">Thin Hollowbody (Capri) Body Styles</a></li><li id="jvg-s-33-soundholes"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-33-soundholes">Soundholes</a></li><li id="jvg-s-34-pickguards"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-34-pickguards">Pickguards</a></li><li id="jvg-s-42-headstock-logo-and-spelling"><a href="/rickenbacker-body-binding-and-inlays/#jvg-s-42-headstock-logo-and-spelling">Headstock Logo and Spelling</a></li></ul></details></div></article>
<article class="rk-card"><a href="/rickenbacker-tailpiece-dating-guide/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/1968-rickenbacker-4005-azureglo-scaled.jpg")!} alt="R tailpiece and bridge on Joe’s blue 1968 Rickenbacker 4005 bass" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-tailpiece-dating-guide/">Bridges And Tailpieces</a></h3><p>Compare trapeze, Kauffman, Accent and R tailpieces. Look at the mounting pattern and the rest of the guitar before assigning a period.</p><a href="/rickenbacker-tailpiece-dating-guide/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-35-tailpieces"><a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-35-tailpieces">Tailpieces</a></li><li id="jvg-s-36-trapeze-tailpiece-1958-to-1965"><a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-36-trapeze-tailpiece-1958-to-1965">Trapeze Tailpiece: 1958 to 1965</a></li><li id="jvg-s-37-kauffman-vibrola-1958-to-1961"><a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-37-kauffman-vibrola-1958-to-1961">Kauffman Vibrola: 1958 to ~1961</a></li><li id="jvg-s-38-accent-vibrato-1961-onward"><a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-38-accent-vibrato-1961-onward">Accent Vibrato: ~1961 onward</a></li><li id="jvg-s-39-r-tailpiece-october-1964-to-present"><a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-39-r-tailpiece-october-1964-to-present">"R" Tailpiece: October 1964 to Present</a></li></ul></details></div></article>
<article class="rk-card"><a href="/rickenbacker-finish-colors/" tabindex="-1" aria-hidden="true"><LicensedImage src={resolveImage("images/rickenbacker-dating/360-12-fireglo-finish.jpg")!} alt="Red Fireglo finish on a Rickenbacker 360/12" width={600} loading="lazy" /></a><div class="rk-card-body"><h3><a href="/rickenbacker-finish-colors/">Finish Colors</a></h3><p>Identify Mapleglo, Fireglo, Jetglo and other finish names, and learn what color can tell you about a Rickenbacker’s age and originality.</p><a href="/rickenbacker-finish-colors/">Open The Guide</a><details class="rk-card-topics"><summary>Topics In This Guide</summary><ul><li id="jvg-s-41-finishes"><a href="/rickenbacker-finish-colors/#jvg-s-41-finishes">Finishes</a></li></ul></details></div></article></div></div></section>
 <section class="rk-section rk-section--tint" id="serial-locations"><div class="rk-wrap"><h2>Where To Find A Rickenbacker Serial Number</h2><p class="rk-hub-intro">Photograph the entire stamp before entering it. The letters above a jack and the digits below it belong to the same number. Some solidbody guitars use the <a href="/rickenbacker-tailpiece-dating-guide/#bridges-and-replacement-evidence">bridge plate</a>; early steel guitars may have a number on the headstock or another location.</p><div class="rk-photo-grid jvg-img2"><RickenbackerPhoto file="images/rickenbacker-serial/rickenbacker-output-jack-serial-number-two-letter-code.jpg" alt="Two-letter serial code and production digits on a Rickenbacker output jackplate" caption="Read both parts of the jackplate stamp. The two letters and the sequence digits belong together." /><RickenbackerPhoto file="images/rickenbacker-serial/rickenbacker-serial-number-on-bridge.jpg" alt="Rickenbacker serial number stamped on a bridge plate" caption="Some solidbody instruments carry the number on the bridge plate. Check this location if the jackplate has no stamp." /></div><div class="rk-note"><strong>A Number Can Travel With A Part</strong><p>A replacement jackplate or bridge can carry a serial that does not date the rest of the instrument. Compare the <a href="/rickenbacker-body-binding-and-inlays/">body and neck</a> and the installed <a href="/rickenbacker-pickup-dating-guide/">pickups</a> before deciding that a mismatch proves a particular date.</p></div></div></section>
 <section class="rk-section" id="serial-charts"><div class="rk-wrap rk-article"><h2>Rickenbacker Serial Number Formats</h2><p>Choose the format that matches the whole serial. The early model-specific systems overlap with later codes; the guitar’s construction is part of the identification.</p><nav class="rk-era-links" aria-label="Serial number eras"><a href="#jvg-s-2-era-guide-pre-1961-model-specific-numbers">Pre-1961 (Model-Specific Numbers)</a><a href="#jvg-s-6-era-guide-1961-to-1986-two-letter-code">1961 to 1986 (Two-Letter Code)</a><a href="#jvg-s-7-era-guide-1987-to-1998-letter-digit">1987 to 1998 (Letter + Digit)</a><a href="#jvg-s-10-era-guide-1999-to-present-year-week">1999 to Present (Year + Week)</a></nav><h2 id="jvg-s-2-era-guide-pre-1961-model-specific-numbers">Era Guide: Pre-1961 (Model-Specific Numbers)</h2>
      <p>Before November 1960, Rickenbacker used several separate serial schemes depending on the type of guitar. The lookup flags these for a model-specific check. Compare the formats below with the instrument’s construction. Expect exceptions throughout this entire era.</p>

      <h3 id="jvg-s-3-solidbody-combo-guitars-1954-to-late-1958">Solidbody Combo Guitars: 1954 To Late 1958</h3>
      <div class="era-badge">1954 to 1958</div>
      <RickenbackerPhoto file="images/rickenbacker-serial/rickenbacker-serial-number-on-bridge.jpg" alt="Rickenbacker serial number stamped on the bridge of a 1950s solidbody Combo guitar" caption="Serial number stamped on the bridge of a 1960s Rickenbacker Combo. Lower-end solid body models continued using the bridge stamp even after the jackplate became standard on higher-end guitars." />
      <p>The Combo 600 and 800 introduced Rickenbacker’s first modern serial format, later extended to the 400, 450, and 650/850. The first one to three characters identify the model and type, a single year digit follows, and the remaining digits are a production sequence.</p>
      <div class="rk-table-scroll" role="region" aria-label="Scrollable Rickenbacker Reference Table" tabindex="0">
        <table >
          <thead><tr><th scope="col">Format</th><th scope="col">Model</th><th scope="col">Example</th><th scope="col">Decodes As</th></tr></thead>
          <tbody>
            <tr><td>4C[Y]###</td><td>Combo 400</td><td>4C6123</td><td>1956 Combo 400, seq. 123</td></tr>
            <tr><td>4C[Y]####A</td><td>Combo 450</td><td>4C7234A</td><td>1957 Combo 450, seq. 234</td></tr>
            <tr><td>6C[Y]###</td><td>Combo 600</td><td>6C5456</td><td>1955 Combo 600, seq. 456</td></tr>
            <tr><td>8C[Y]###</td><td>Combo 800</td><td>8C6789</td><td>1956 Combo 800, seq. 789</td></tr>
            <tr><td>85C[Y]###</td><td>Combo 850</td><td>85C7001</td><td>1957 Combo 850, seq. 001</td></tr>
            <tr><td>65C[Y]###</td><td>Combo 650</td><td>65C7123</td><td>1957 Combo 650, seq. 123</td></tr>
            <tr><td>C####</td><td>650 / dual-toaster 850</td><td>C1234</td><td>No date info, special cases only</td></tr>
          </tbody>
        </table>
      </div>
      <div class="callout"><p><strong>Year digit key:</strong> The single digit after the type letter codes directly to the year: <em>4 = 1954, 5 = 1955, 6 = 1956, 7 = 1957, 8 = 1958.</em> This year information disappears at some point in late 1958, after which the serial simply reads as “4C” or “85C” followed by a production number with no date embedded.</p></div>

      <h3 id="jvg-s-4-hollowbody-capri-and-f-series-1958-to-october-1960">Hollowbody Capri And F-Series: 1958 To October 1960</h3>
      <div class="era-badge">1958 to 1960</div>
      <p>The full-scale Capris (models 330 to 375) and F-series launched in 1958 using a different scheme. The first character is the pickup count (2 or 3); the second is a <a href="/rickenbacker-tailpiece-dating-guide/#jvg-s-35-tailpieces">tailpiece/options code</a>. No date information is embedded. Compare the <a href="/rickenbacker-knobs-and-controls/#jvg-s-40-control-configurations">pickup and control layout</a> with the complete instrument.</p>
      <div class="rk-table-scroll" role="region" aria-label="Scrollable Rickenbacker Reference Table" tabindex="0">
        <table >
          <thead><tr><th scope="col">Format</th><th scope="col">Pickup Count</th><th scope="col">Tailpiece Code</th><th scope="col">Notes</th></tr></thead>
          <tbody>
            <tr><td>2T###</td><td>2</td><td>T = Trapeze</td><td>Standard non-vibrato models</td></tr>
            <tr><td>2V###</td><td>2</td><td>V = Vibrola / Accent</td><td>Vibrato-equipped models</td></tr>
            <tr><td>3T###</td><td>3</td><td>T = Trapeze</td><td>Three-pickup standard</td></tr>
            <tr><td>3V###</td><td>3</td><td>V = Vibrola / Accent</td><td>Three-pickup vibrato</td></tr>
            <tr><td>2R###</td><td>2</td><td>R = Rick-O-Sound stereo</td><td>Deluxe models only, from June 1960</td></tr>
          </tbody>
        </table>
      </div>
      <p>Short-scale Capris (models 310 to 325) initially used the solidbody “V###” short-scale format in 1958, then switched to the pickup/tailpiece format in 1959. Basses used <strong class="mono">B[Y]###</strong> with a year digit, which also disappeared in late 1958 to 1959.</p>

      <h3 id="jvg-s-5-the-jk-jl-transition-november-to-december-1960">The JK / JL Transition: November To December 1960</h3>
      <div class="era-badge">Nov to Dec 1960</div>
      <RickenbackerPhoto file="images/rickenbacker-serial/rickenbacker-fry-pan-serial-number.jpg" alt="Serial number stamped on the headstock of a Rickenbacker Frying Pan lap steel guitar" caption="Serial number stamped directly on the headstock of a Rickenbacker Frying Pan, the earliest Rickenbacker serial location." />
      <p>In November 1960, Rickenbacker briefly previewed the system that would become permanent. Serials from this two-month window begin with <strong>JK</strong> (November 1960) or <strong>JL</strong> (December 1960), followed by a production number. The same JK and JL prefixes also read as November and December 1970 in the regular two-letter sequence. A prefix alone cannot settle that decade. Compare the model, hardware and construction before accepting either date.</p>


<h2 id="jvg-s-6-era-guide-1961-to-1986-two-letter-code">Era Guide: 1961 To 1986 (Two-Letter Code)</h2>
      <div class="era-badge">1961 to 1986</div>
      <p>This is the most famous and longest-running Rickenbacker serial system. In this regular sequence, the first letter identifies the year and the second identifies the month. Replaced plates and unusual early numbers need a separate check. Letters appear above the output jack hole on the jackplate; digits appear below.</p>
      <RickenbackerPhoto file="images/rickenbacker-serial/rickenbacker-output-jack-serial-number-two-letter-code.jpg" alt="Rickenbacker output jack serial number showing the two-letter year and month code used from 1961 to 1986" caption="The two-letter code on a Rickenbacker output jackplate. The first letter gives the year, the second the month of production." />
      <p>From 1961 to 1965, production numbers ran 01 to 999 (resetting to 01 when they hit 999). From 1966 onward, the range expanded to 001 to 9999 and never needed to reset in a single year.</p>
      <div class="callout"><p><strong>Bridge-stamped serials on 1960s Combo models:</strong> While the output jackplate is the standard serial location from 1961 onward, some lower-end solidbody models, particularly the Combo series, continued to have their serials stamped directly on the bridge plate rather than the jackplate well into the 1960s. These bridge-stamped serials follow the same two-letter year/month coding system and decode identically. If you find no serial on the jackplate of a 1960s solidbody Rick, always check the bridge before assuming it’s missing.</p></div>

      <h4>First Letter = Year Of Production</h4>
      <div class="letter-grid">
        <div class="lg-cell"><span class="lg-letter">A</span><span class="lg-value">1961</span></div>
        <div class="lg-cell"><span class="lg-letter">B</span><span class="lg-value">1962</span></div>
        <div class="lg-cell"><span class="lg-letter">C</span><span class="lg-value">1963</span></div>
        <div class="lg-cell"><span class="lg-letter">D</span><span class="lg-value">1964</span></div>
        <div class="lg-cell"><span class="lg-letter">E</span><span class="lg-value">1965</span></div>
        <div class="lg-cell"><span class="lg-letter">F</span><span class="lg-value">1966</span></div>
        <div class="lg-cell"><span class="lg-letter">G</span><span class="lg-value">1967</span></div>
        <div class="lg-cell"><span class="lg-letter">H</span><span class="lg-value">1968</span></div>
        <div class="lg-cell"><span class="lg-letter">I</span><span class="lg-value">1969</span></div>
        <div class="lg-cell"><span class="lg-letter">J</span><span class="lg-value">1970</span></div>
        <div class="lg-cell"><span class="lg-letter">K</span><span class="lg-value">1971</span></div>
        <div class="lg-cell"><span class="lg-letter">L</span><span class="lg-value">1972</span></div>
        <div class="lg-cell"><span class="lg-letter">M</span><span class="lg-value">1973</span></div>
        <div class="lg-cell"><span class="lg-letter">N</span><span class="lg-value">1974</span></div>
        <div class="lg-cell"><span class="lg-letter">O</span><span class="lg-value">1975</span></div>
        <div class="lg-cell"><span class="lg-letter">P</span><span class="lg-value">1976</span></div>
        <div class="lg-cell"><span class="lg-letter">Q</span><span class="lg-value">1977</span></div>
        <div class="lg-cell"><span class="lg-letter">R</span><span class="lg-value">1978</span></div>
        <div class="lg-cell"><span class="lg-letter">S</span><span class="lg-value">1979</span></div>
        <div class="lg-cell"><span class="lg-letter">T</span><span class="lg-value">1980</span></div>
        <div class="lg-cell"><span class="lg-letter">U</span><span class="lg-value">1981</span></div>
        <div class="lg-cell"><span class="lg-letter">V</span><span class="lg-value">1982</span></div>
        <div class="lg-cell"><span class="lg-letter">W</span><span class="lg-value">1983</span></div>
        <div class="lg-cell"><span class="lg-letter">X</span><span class="lg-value">1984</span></div>
        <div class="lg-cell"><span class="lg-letter">Y</span><span class="lg-value">1985</span></div>
        <div class="lg-cell"><span class="lg-letter">Z</span><span class="lg-value">1986</span></div>
      </div>

      <h4>Second Letter = Month Of Production</h4>
      <div class="letter-grid" style="grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));">
        <div class="lg-cell"><span class="lg-letter">A</span><span class="lg-value">January</span></div>
        <div class="lg-cell"><span class="lg-letter">B</span><span class="lg-value">February</span></div>
        <div class="lg-cell"><span class="lg-letter">C</span><span class="lg-value">March</span></div>
        <div class="lg-cell"><span class="lg-letter">D</span><span class="lg-value">April</span></div>
        <div class="lg-cell"><span class="lg-letter">E</span><span class="lg-value">May</span></div>
        <div class="lg-cell"><span class="lg-letter">F</span><span class="lg-value">June</span></div>
        <div class="lg-cell"><span class="lg-letter">G</span><span class="lg-value">July</span></div>
        <div class="lg-cell"><span class="lg-letter">H</span><span class="lg-value">August</span></div>
        <div class="lg-cell"><span class="lg-letter">I</span><span class="lg-value">September</span></div>
        <div class="lg-cell"><span class="lg-letter">J</span><span class="lg-value">October</span></div>
        <div class="lg-cell"><span class="lg-letter">K</span><span class="lg-value">November</span></div>
        <div class="lg-cell"><span class="lg-letter">L</span><span class="lg-value">December</span></div>
      </div>
      <p><strong>Example:</strong> A serial reading <em>GD1234</em> decodes as: G = 1967, D = April → <strong>April 1967</strong>, production number 1234. Compare the date with the <a href="/rickenbacker-pickup-dating-guide/">installed pickup type</a> and <a href="/rickenbacker-tuner-dating-guide/">tuning machines</a> before judging originality.</p>


<h2 id="jvg-s-7-era-guide-1987-to-1998-letter-digit">Era Guide: 1987 To 1998 (Letter + Digit)</h2>
      <div class="era-badge">1987 to 1998</div>
      <p>With Z assigned to 1986 and the full alphabet exhausted, Rickenbacker redesigned the system. The letter and digit swap roles compared to the 1961 to 1986 scheme: the <em>letter</em> now indicates the month and the <em>digit</em> indicates the year. Two separate sub-eras use this structure, distinguished by the month letters used.</p>

      <h3 id="jvg-s-8-1987-to-1996-month-letters-a-to-l">1987 To 1996: Month Letters A To L</h3>
      <p>The same A to L = January to December month mapping as the second-position letters above, now moved to first position. The digit following indicates the year from a base of 1987.</p>
      <div class="spec-grid">
        <div class="sg-cell"><div class="sg-label">Month letter</div><div class="sg-value">A = Jan · B = Feb · C = Mar · D = Apr · E = May · F = Jun · G = Jul · H = Aug · I = Sep · J = Oct · K = Nov · L = Dec</div></div>
        <div class="sg-cell"><div class="sg-label">Year digit</div><div class="sg-value">0 = 1987 · 1 = 1988 · 2 = 1989 · 3 = 1990 · 4 = 1991 · 5 = 1992 · 6 = 1993 · 7 = 1994 · 8 = 1995 · 9 = 1996</div></div>
      </div>
      <p><strong>Example:</strong> <em>A01234</em> → January 1987. <em>L91234</em> → December 1996.</p>

      <h3 id="jvg-s-9-1997-to-1998-month-letters-m-to-y-skipping-o">1997 To 1998: Month Letters M To Z (Skipping O And Q)</h3><RickenbackerPhoto file="images/rickenbacker-dating/325-letter-digit-serial-plate.jpg" alt="N0 stamped above and 9130 below the output jack on a Rickenbacker 325" caption="Read both ends of the plate: N0 above the jack and 9130 below form N09130. In the 1997 to 1998 system, N indicates February and 0 indicates 1997." />
      <p>A new set of month letters was introduced to avoid confusion with the A to L block above. Both O and Q are omitted from this month sequence. The year digit resets: 0 = 1997, 1 = 1998. The guitar format uses one month letter, one year digit and four sequence digits. December Z-prefix numbers need individual confirmation because Z is also used on replacement plates.</p>
      <div class="spec-grid">
        <div class="sg-cell"><div class="sg-label">Month letter</div><div class="sg-value">M = Jan · N = Feb · P = Mar · R = Apr · S = May · T = Jun · U = Jul · V = Aug · W = Sep · X = Oct · Y = Nov · Z = Dec</div></div>
        <div class="sg-cell"><div class="sg-label">Year digit</div><div class="sg-value">0 = 1997 · 1 = 1998</div></div>
      </div>
      <p><strong>Example:</strong> <em>M01234</em> → January 1997. <em>Y11234</em> → November 1998.</p>


<h2 id="jvg-s-10-era-guide-1999-to-present-year-week">Era Guide: 1999 To Present (Year + Week)</h2><RickenbackerPhoto file="images/rickenbacker-dating/modern-numeric-serial-plate.jpg" alt="Numeric serial stamped at both ends of a two-jack Rickenbacker bass plate" caption="On this later plate, 15 is stamped at one end and the remaining digits at the other. Include both groups when entering the serial; the first two digits identify 2015." />
      <div class="era-badge">1999 to Present</div>
      <p>The regular modern guitar jackplate format contains seven digits. The serial number begins with the two-digit year, followed immediately by the two-digit production week, then a production sequence number.</p>
      <div class="callout">
        <p><strong>Format: YY + WW + [sequence]</strong><br />The first two digits are the year (99 = 1999, 00 = 2000, 01 = 2001 … 26 = 2026). The next two digits are the week of the year, running 01 through 52 in this format. The final three digits are the production sequence.</p>
        <p><strong>Examples:</strong> <em>9901001</em> → Week 1 of 1999. <em>2108001</em> → Week 8 of 2021. <em>2635001</em> → Week 35 of 2026.</p>
      </div>


<h2 id="jvg-s-11-exceptions-and-edge-cases">Exceptions And Edge Cases</h2>
      <h3 id="jvg-s-12-xx-replacement-jackplates">Replacement Jackplates And Z Prefixes</h3><p>A replacement serial plate may not identify the guitar’s production date. Z followed by digits needs an individual check; it can indicate a replacement plate. XX is not a valid regular guitar year-and-month pair because X is outside the A to L month range. Amplifiers have separate formats that can resemble guitar numbers.</p><h3 id="jvg-s-13-1965-headstock-sticker-serials">1965 Headstock Sticker Serials</h3>
      <p>A small number of guitars produced in 1965 carried a serial number sticker on the back of the headstock beneath the clear coat, in addition to or instead of the jackplate serial. These guitars used their own distinct numbering scheme separate from the standard 1961 to 1986 system.</p>
      <h3 id="jvg-s-14-vibrato-equipped-425-1965-to-1967">Vibrato-Equipped 425 (1965 To 1967)</h3>
      <p>The vibrato-equipped Combo 425 built between 1965 and 1967 used a serial number that was stamped directly onto the vibrato housing, not the jackplate. This number follows its own scheme and is unrelated to the standard two-letter format in use at the time.</p>
      <h3 id="jvg-s-15-pre-1961-numbers-without-date-information">Pre-1961 Numbers Without Date Information</h3>
      <p>As noted above, serial numbers from late 1958 through October 1960, on Combo, Capri, and bass instruments, provide model or configuration information but no reliable date. Dating these instruments requires a model-specific comparison of <a href="/rickenbacker-body-binding-and-inlays/#jvg-s-31-body-styles-binding-and-construction">body construction</a> and <a href="/rickenbacker-knobs-and-controls/#jvg-s-21-control-knobs">knob styles</a>.</p>
      <div class="callout callout-warn"><p><strong>A note on accuracy:</strong> The serial number date reflects when the jackplate was <em>stamped</em>, which is typically close to, but not always identical to, the completion date of the instrument. Factory inventory, back-order situations, and custom orders can place a guitar’s actual finish date days, weeks, or in rare cases months after the plate date. The serial establishes a production window; the feature guides can help check that window.</p></div>

      </div></section>
 <section class="rk-section rk-section--tint" id="jvg-s-43-quick-reference-dating-cheat-sheet"><div class="rk-wrap"><h2>Cross-Check The Serial Date</h2><div class="rk-table-scroll" role="region" aria-label="Scrollable Rickenbacker Reference Table" tabindex="0"><table><thead><tr><th scope="col">Detail</th><th scope="col">What To Compare</th><th scope="col">Guide</th></tr></thead><tbody><tr><th scope="row">Pickups</th><td>Compare horseshoe, toaster and Hi-Gain pickups, then check the version against the instrument’s serial date and model.</td><td><a href="/rickenbacker-pickup-dating-guide/">Pickups</a></td></tr><tr><th scope="row">Tuners</th><td>Identify Kluson, Grover and Schaller tuners by their housings, buttons and mounting patterns. Guitar and bass timelines differ.</td><td><a href="/rickenbacker-tuner-dating-guide/">Tuners</a></td></tr><tr><th scope="row">Knobs And Controls</th><td>Compare cooker knobs, black vintage knobs, silver tops and control layouts. Check the model before using a knob style as a date clue.</td><td><a href="/rickenbacker-knobs-and-controls/">Knobs And Controls</a></td></tr><tr><th scope="row">Body, Binding And Inlays</th><td>Compare body edges, checkerboard binding, fingerboard inlays, soundholes, pickguards and headstock details with the serial date.</td><td><a href="/rickenbacker-body-binding-and-inlays/">Body, Binding And Inlays</a></td></tr><tr><th scope="row">Bridges And Tailpieces</th><td>Compare trapeze, Kauffman, Accent and R tailpieces. Look at the mounting pattern and the rest of the guitar before assigning a period.</td><td><a href="/rickenbacker-tailpiece-dating-guide/">Bridges And Tailpieces</a></td></tr><tr><th scope="row">Finish Colors</th><td>Identify Mapleglo, Fireglo, Jetglo and other finish names, and learn what color can tell you about a Rickenbacker’s age and originality.</td><td><a href="/rickenbacker-finish-colors/">Finish Colors</a></td></tr></tbody></table></div><p>Later vintage-style models recreate earlier features. A <a href="/rickenbacker-pickup-dating-guide/#jvg-s-19-toaster-pickup-1957-to-1974">toaster pickup</a>, <a href="/rickenbacker-body-binding-and-inlays/#jvg-s-31-body-styles-binding-and-construction">checkerboard binding</a> or <a href="/rickenbacker-knobs-and-controls/#jvg-s-21-control-knobs">black vintage knob</a> can be correct on a newer instrument. Use the serial, model and several construction details together.</p></div></section>
