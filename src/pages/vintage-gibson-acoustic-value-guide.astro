---
// GAP 2 reference page. Index production while excluding branch previews.
import GuideHero from '../components/GuideHero.astro';
import Layout from '../layouts/Layout.astro';
import ValueGuidePhotos from '../components/ValueGuidePhotos.astro';
import { Content, getHeadings } from '../content/value-guides/vintage-gibson-acoustic-value-guide.md';
import data from '../data/value-guides/vintage-gibson-acoustic-value-guide.json';
import ogAsset from '../assets/blog/identify-vintage-gibson-j45-j50-sj/1950s-gibson-j-45-in-case-1024x683.jpg';
import { SITE_URL } from '../config/site';
const headings = getHeadings().filter(h => h.depth === 2);
const isPreview = import.meta.env.CF_PAGES_BRANCH
  ? import.meta.env.CF_PAGES_BRANCH !== 'main'
  : import.meta.env.DEV;
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: data.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
const structuredData = [faqSchema, {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: data.h1, description: data.description,
  image: SITE_URL + ogAsset.src,
  datePublished: data.date, dateModified: data.date, inLanguage: 'en-US',
  author: { '@id': SITE_URL + '/about-me/#person' },
  publisher: { '@id': SITE_URL + '/' }, mainEntityOfPage: SITE_URL + data.url
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: data.h1, item: SITE_URL + data.url }
  ]
}];
---
<Layout title={data.title} description={data.description} canonical={data.url}
  ogImage={SITE_URL + ogAsset.src} ogImageWidth={ogAsset.width} ogImageHeight={ogAsset.height} ogImageAlt={data.alt}
  ogType="article" structuredData={structuredData} publishedTime={data.date} modifiedTime={data.date}
  noIndex={isPreview} bodyClass="gavhub-page">
  <GuideHero title={data.h1} image={ogAsset} alt={data.alt} brand="Gibson" eyebrow="Joe's Vintage Guitars / Value Reference" byline="By Joe Dampt · October 2026" />
  <div class="gavhub-shell">
    <details class="gavhub-mobile-toc"><summary>On This Page</summary><nav aria-label="Article sections"><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></details>
    <aside class="gavhub-toc" aria-label="On this page"><p>On This Page</p><nav><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></aside>
    <article class="gavhub-article">
      <ValueGuidePhotos><Content /></ValueGuidePhotos>
      <section id="value-questions" class="gavhub-faq"><h2>Questions About {data.model} Value</h2>{data.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </div>
</Layout>
<style>
.gavhub-backdrop>div:first-child{height:54px;background:var(--color-brand-brown)}
.gavhub-backdrop>div:last-child{height:56px;background:var(--color-brand-brown);border-bottom:6px solid var(--color-brand-brown-tan)}
.gavhub-heading{background:var(--color-brand-parchment);border-bottom:1px solid var(--color-brand-brown-tan);padding:172px 28px 36px}
.gavhub-measure,.gavhub-shell{max-width:1280px;margin:0 auto}
.gavhub-heading h1{font-family:var(--font-display);font-weight:600;font-size:clamp(32px,4vw,48px);line-height:1.15;color:var(--color-brand-brown);max-width:860px;margin:12px 0 16px}
.gavhub-eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-brand-rust-dark);font-weight:700}
.gavhub-byline{color:var(--color-brand-brown-mid);font-size:14px}
.gavhub-byline span{padding:0 10px}
.gavhub-shell{padding:32px 28px 72px}
.gavhub-article,.gavhub-review{max-width:860px}
.gavhub-review{padding:18px 22px;border-left:4px solid var(--color-brand-rust);background:var(--color-brand-vanilla);margin-bottom:28px;color:var(--color-brand-brown)}
.gavhub-review strong{font-family:var(--font-display);font-size:20px}
.gavhub-review p{font-size:14px;line-height:1.65;margin:6px 0 0}
.gavhub-article{font-size:17px;line-height:1.85;color:var(--color-brand-charcoal)}
.gavhub-article :global(p){margin:0 0 20px}
.gavhub-article :global(h2){font-family:var(--font-display);font-size:clamp(26px,3vw,34px);line-height:1.25;color:var(--color-brand-brown);margin:48px 0 22px;scroll-margin-top:24px}
.gavhub-article :global(h2)::after{content:'';display:block;width:80px;height:3px;background:var(--color-brand-rust);margin-top:14px}
.gavhub-article :global(h3){font-family:var(--font-display);font-size:25px;line-height:1.3;color:var(--color-brand-brown);margin:32px 0 14px;scroll-margin-top:24px}
.gavhub-article :global(a),.gavhub-toc a,.gavhub-mobile-toc a{color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
.gavhub-article :global(a:hover){color:var(--color-brand-rust)}
/* Joe requested prominent model links above the summary table (2026-10-29).
   Keep the main card a native link; put the authentication link beside it, never inside it. */
.gavhub-article :global(.gavhub-model-grid){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:24px 0}
.gavhub-article :global(a.gavhub-model-card){display:flex;flex-direction:column;gap:14px;min-width:0;flex:1;padding:24px;border:0;border-radius:4px;background:var(--color-brand-parchment);color:var(--color-brand-charcoal);text-decoration:none;box-shadow:0 3px 10px rgb(62 42 20 / 6%);transition:background-color .15s,border-color .15s,box-shadow .15s}
.gavhub-article :global(a.gavhub-model-card:hover){background:var(--color-brand-vanilla);border-color:var(--color-brand-rust);box-shadow:0 5px 16px rgb(62 42 20 / 12%)}
.gavhub-article :global(a.gavhub-model-card:focus-visible){outline:3px solid var(--color-brand-rust-dark);outline-offset:4px}
.gavhub-article :global(.gavhub-model-group){display:flex;flex-direction:column;min-width:0;border:1px solid var(--color-brand-brown-tan);border-top:4px solid var(--color-brand-rust);border-radius:6px;background:var(--color-brand-parchment)}
.gavhub-article :global(.gavhub-model-auth){display:block;padding:14px 24px;min-height:48px;border-top:1px solid var(--color-brand-brown-tan);font-size:14px;font-weight:600;text-decoration:underline;text-underline-offset:4px}
.gavhub-article :global(.gavhub-model-auth:focus-visible){outline:3px solid var(--color-brand-rust-dark);outline-offset:3px}
.gavhub-article :global(.gavhub-sr-only){position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.gavhub-article :global(.gavhub-model-card h3){margin:0;font-size:25px;line-height:1.3}
.gavhub-article :global(.gavhub-model-card p){margin:0;font-size:16px;line-height:1.65}
.gavhub-article :global(.gavhub-model-card__cta){display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto;padding-top:4px;color:var(--color-brand-rust-dark);font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:4px}
.gavhub-article :global(.gavhub-model-card__cta [aria-hidden]){font-size:24px;line-height:1}
@media(max-width:600px){.gavhub-article :global(.gavhub-model-grid){grid-template-columns:minmax(0,1fr);gap:14px}.gavhub-article :global(a.gavhub-model-card){padding:20px}}
.gavhub-article :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:24px 0 28px;font-size:15px;line-height:1.6}
.gavhub-article :global(th){background:var(--color-brand-brown);color:white;text-align:left;font-weight:600}
.gavhub-article :global(th),.gavhub-article :global(td){padding:14px 16px;border:1px solid var(--color-brand-brown-tan);min-width:122px;vertical-align:top}
.gavhub-article :global(th:first-child),.gavhub-article :global(td:first-child){min-width:72px;font-weight:600}
.gavhub-article :global(tr:nth-child(even)){background:var(--color-brand-vanilla)}
.gavhub-article :global(figure){margin:32px 0;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.gavhub-article :global(figure p){margin:0}
.gavhub-article :global(figure img){display:block;max-width:100%;max-height:720px;width:100%;height:auto;object-fit:contain;margin:0 auto;background:var(--color-brand-brown)}
.gavhub-article :global(figcaption){font-size:14px;line-height:1.65;padding:14px 18px;color:var(--color-brand-brown-mid)}
.gavhub-faq details{border-top:1px solid var(--color-brand-brown-tan);padding:18px 0}
.gavhub-faq details:last-child{border-bottom:1px solid var(--color-brand-brown-tan)}
.gavhub-faq summary{font-family:var(--font-display);font-size:22px;line-height:1.4;color:var(--color-brand-brown);cursor:pointer}
.gavhub-faq details p{margin:16px 0 0;font-size:16px}
.gavhub-toc{display:none}
.gavhub-mobile-toc{max-width:860px;margin-bottom:28px;padding:14px 18px;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.gavhub-mobile-toc summary{font-family:var(--font-display);font-size:20px;color:var(--color-brand-brown);cursor:pointer}
.gavhub-mobile-toc ul{list-style:none;padding:12px 0 0;margin:0}
.gavhub-mobile-toc a{display:block;padding:7px 0;font-size:15px;line-height:1.5}
@media(min-width:1440px){
 .gavhub-toc{display:block;position:fixed;right:max(24px,calc((100vw - 1280px)/2));top:160px;width:270px;max-height:calc(100vh - 190px);overflow-y:auto;padding:20px;border:1px solid var(--color-brand-brown-tan);border-top:4px solid var(--color-brand-rust);background:white;z-index:20}
 .gavhub-toc>p{font-family:var(--font-display);font-size:19px;margin-bottom:12px;color:var(--color-brand-brown)}
 .gavhub-toc ul{list-style:none;padding:0;margin:0}
 .gavhub-toc a{display:block;font-size:13px;line-height:1.5;padding:6px 0;text-decoration:none}
 .gavhub-toc a:hover{text-decoration:underline}
 .gavhub-mobile-toc{display:none}
}
@media(max-width:1439px){.gavhub-measure,.gavhub-shell{max-width:916px}}
@media(max-width:767px){.gavhub-heading{padding:112px 20px 28px}.gavhub-shell{padding:24px 20px 48px}.gavhub-article{font-size:16px}.gavhub-article :global(h2){margin-top:36px}.gavhub-review{padding:15px 17px}}
@media(max-width:639px){.gavhub-heading{padding-top:46px}}
</style>

<style>
@media(min-width:1440px){.gavhub-shell{display:grid;grid-template-columns:minmax(0,860px) 270px;gap:40px;align-items:start}.gavhub-toc{position:sticky;top:24px;right:auto;grid-column:2;grid-row:1;width:auto;max-height:calc(100vh - 48px)}.gavhub-article{grid-column:1;grid-row:1;min-width:0}}
</style>
