---
// GAP 2 reference page. Index production while excluding branch previews.
import Layout from '../layouts/Layout.astro';
import { Content, getHeadings } from '../content/value-guides/vintage-fender-precision-bass-value-guide.md';
import data from '../data/value-guides/vintage-fender-precision-bass-value-guide.json';
import ogAsset from '../assets/blog/1952-fender-precision-bass-guide/1952-fender-precision-bass-with-bassman-amp-scaled.jpg';
import { SITE_URL } from '../config/site';
const headings = getHeadings().filter(h => h.depth === 2);
const isPreview = import.meta.env.CF_PAGES_BRANCH
  ? import.meta.env.CF_PAGES_BRANCH !== 'main'
  : import.meta.env.DEV;
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: data.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
const structuredData = [faqSchema, {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: data.h1, description: data.description,
  image: SITE_URL + ogAsset.src,
  datePublished: data.date, dateModified: data.date, inLanguage: 'en-US',
  author: { '@id': SITE_URL + '/about-me/#person' },
  publisher: { '@id': SITE_URL + '/' }, mainEntityOfPage: SITE_URL + data.url
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: data.h1, item: SITE_URL + data.url }
  ]
}];
---
<Layout title={data.title} description={data.description} canonical={data.url}
  ogImage={SITE_URL + ogAsset.src} ogImageWidth={ogAsset.width} ogImageHeight={ogAsset.height} ogImageAlt={data.alt}
  ogType="article" structuredData={structuredData} publishedTime={data.date} modifiedTime={data.date}
  noIndex={isPreview} bodyClass="fpbv-page">
  <div class="fpbv-backdrop" aria-hidden="true"><div></div><div></div></div>
  <div class="fpbv-heading">
    <div class="fpbv-measure">
      <p class="fpbv-eyebrow">Joe's Vintage Guitars / Value Reference</p>
      <h1>{data.h1}</h1>
      <p class="fpbv-byline">By Joe Dampt <span aria-hidden="true">·</span> October 2026</p>
    </div>
  </div>
  <div class="fpbv-shell">
    <details class="fpbv-mobile-toc"><summary>On This Page</summary><nav aria-label="Article sections"><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></details>
    <aside class="fpbv-toc" aria-label="On this page"><p>On This Page</p><nav><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></aside>
    <article class="fpbv-article">
      <Content />
      <section id="value-questions" class="fpbv-faq"><h2>Questions About {data.model} Value</h2>{data.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </div>
</Layout>
<style>
.fpbv-backdrop>div:first-child{height:54px;background:var(--color-brand-brown)}
.fpbv-backdrop>div:last-child{height:56px;background:var(--color-brand-brown);border-bottom:6px solid var(--color-brand-brown-tan)}
.fpbv-heading{background:var(--color-brand-parchment);border-bottom:1px solid var(--color-brand-brown-tan);padding:172px 28px 36px}
.fpbv-measure,.fpbv-shell{max-width:1280px;margin:0 auto}
.fpbv-heading h1{font-family:var(--font-display);font-weight:600;font-size:clamp(32px,4vw,48px);line-height:1.15;color:var(--color-brand-brown);max-width:860px;margin:12px 0 16px}
.fpbv-eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-brand-rust-dark);font-weight:700}
.fpbv-byline{color:var(--color-brand-brown-mid);font-size:14px}
.fpbv-byline span{padding:0 10px}
.fpbv-shell{padding:32px 28px 72px}
.fpbv-article,.fpbv-review{max-width:860px}
.fpbv-review{padding:18px 22px;border-left:4px solid var(--color-brand-rust);background:var(--color-brand-vanilla);margin-bottom:28px;color:var(--color-brand-brown)}
.fpbv-review strong{font-family:var(--font-display);font-size:20px}
.fpbv-review p{font-size:14px;line-height:1.65;margin:6px 0 0}
.fpbv-article{font-size:17px;line-height:1.85;color:var(--color-brand-charcoal)}
.fpbv-article :global(p){margin:0 0 20px}
.fpbv-article :global(h2){font-family:var(--font-display);font-size:clamp(26px,3vw,34px);line-height:1.25;color:var(--color-brand-brown);margin:48px 0 22px;scroll-margin-top:24px}
.fpbv-article :global(h2)::after{content:'';display:block;width:80px;height:3px;background:var(--color-brand-rust);margin-top:14px}
.fpbv-article :global(h3){font-family:var(--font-display);font-size:25px;line-height:1.3;color:var(--color-brand-brown);margin:32px 0 14px;scroll-margin-top:24px}
.fpbv-article :global(a),.fpbv-toc a,.fpbv-mobile-toc a{color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
.fpbv-article :global(a:hover){color:var(--color-brand-rust)}
.fpbv-article :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:24px 0 28px;font-size:15px;line-height:1.6}
.fpbv-article :global(th){background:var(--color-brand-brown);color:white;text-align:left;font-weight:600}
.fpbv-article :global(th),.fpbv-article :global(td){padding:14px 16px;border:1px solid var(--color-brand-brown-tan);min-width:122px;vertical-align:top}
.fpbv-article :global(th:first-child),.fpbv-article :global(td:first-child){min-width:72px;font-weight:600}
.fpbv-article :global(tr:nth-child(even)){background:var(--color-brand-vanilla)}
.fpbv-article :global(figure){margin:32px 0;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.fpbv-article :global(figure p){margin:0}
.fpbv-article :global(figure img){display:block;max-width:100%;max-height:720px;width:100%;height:auto;object-fit:contain;margin:0 auto;background:var(--color-brand-brown)}
.fpbv-article :global(figcaption){font-size:14px;line-height:1.65;padding:14px 18px;color:var(--color-brand-brown-mid)}
.fpbv-faq details{border-top:1px solid var(--color-brand-brown-tan);padding:18px 0}
.fpbv-faq details:last-child{border-bottom:1px solid var(--color-brand-brown-tan)}
.fpbv-faq summary{font-family:var(--font-display);font-size:22px;line-height:1.4;color:var(--color-brand-brown);cursor:pointer}
.fpbv-faq details p{margin:16px 0 0;font-size:16px}
.fpbv-toc{display:none}
.fpbv-mobile-toc{max-width:860px;margin-bottom:28px;padding:14px 18px;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.fpbv-mobile-toc summary{font-family:var(--font-display);font-size:20px;color:var(--color-brand-brown);cursor:pointer}
.fpbv-mobile-toc ul{list-style:none;padding:12px 0 0;margin:0}
.fpbv-mobile-toc a{display:block;padding:7px 0;font-size:15px;line-height:1.5}
@media(min-width:1440px){
 .fpbv-toc{display:block;position:fixed;right:max(24px,calc((100vw - 1280px)/2));top:160px;width:270px;max-height:calc(100vh - 190px);overflow-y:auto;padding:20px;border:1px solid var(--color-brand-brown-tan);border-top:4px solid var(--color-brand-rust);background:white;z-index:20}
 .fpbv-toc>p{font-family:var(--font-display);font-size:19px;margin-bottom:12px;color:var(--color-brand-brown)}
 .fpbv-toc ul{list-style:none;padding:0;margin:0}
 .fpbv-toc a{display:block;font-size:13px;line-height:1.5;padding:6px 0;text-decoration:none}
 .fpbv-toc a:hover{text-decoration:underline}
 .fpbv-mobile-toc{display:none}
}
@media(max-width:1439px){.fpbv-measure,.fpbv-shell{max-width:916px}}
@media(max-width:767px){.fpbv-heading{padding:112px 20px 28px}.fpbv-shell{padding:24px 20px 48px}.fpbv-article{font-size:16px}.fpbv-article :global(h2){margin-top:36px}.fpbv-review{padding:15px 17px}}
@media(max-width:639px){.fpbv-heading{padding-top:46px}}
</style>
