---
import Layout from "../layouts/Layout.astro";
import { contact, hrefs } from "../config/site";

const cityStateZip = `${contact.address.city}, ${contact.address.region} ${contact.address.postalCode}`;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Refund & Returns Policy", item: "https://www.joesvintageguitarsaz.com/refund_returns/" },
    ],
  },
];
---

<Layout
  title="Refund &amp; Returns Policy | Joe&rsquo;s Vintage Guitars"
  description="Joe's Vintage Guitars refund and returns policy: the 30-day return window, how refunds and exchanges work, and what to do if a refund is late."
  canonical="/refund_returns/"
  structuredData={structuredData}
>
  <section class="legal-title-bar">
    <div class="legal-inner"><h1>Refund &amp; Returns Policy</h1></div>
  </section>

  <section class="legal-body">
    <div class="legal-inner legal-prose">
      <h2>Overview</h2>
      <p>
        I run a 30-day return window. To qualify, an item has to be unused, in its original condition, and in its
        original packaging. A receipt or proof of purchase is required to complete a return. Please don&rsquo;t
        send items back to the manufacturer.
      </p>
      <p>
        A few things can&rsquo;t be returned: gift cards, downloadable software, and any item that is damaged or
        missing parts for reasons that aren&rsquo;t my error.
      </p>

      <h2>Partial Refunds</h2>
      <p>A partial refund may apply to:</p>
      <ul>
        <li>An item with obvious signs of use.</li>
        <li>An item that is damaged or missing parts for reasons that aren&rsquo;t my error.</li>
        <li>An item returned more than 30 days after delivery.</li>
      </ul>

      <h2>Refunds</h2>
      <p>
        Once your return arrives and I&rsquo;ve inspected it, I&rsquo;ll email you to let you know whether the refund
        is approved. If it&rsquo;s approved, I credit it to your original payment method within a few business days.
      </p>
      <p>
        <strong>Late or missing refunds:</strong> first check your bank account again, then contact your credit
        card company, since it often takes some time before a refund posts. If you&rsquo;ve done that and still
        haven&rsquo;t received it, email me at <a href={hrefs.mailto}>{contact.email}</a>.
      </p>
      <p>Only regular-priced items can be refunded. Sale items can&rsquo;t.</p>

      <h2>Exchanges</h2>
      <p>
        I only replace items if they&rsquo;re defective or damaged. If you need to exchange one for the same item,
        email me at <a href={hrefs.mailto}>{contact.email}</a> and send it to {contact.address.street},
        {cityStateZip}.
      </p>

      <h2>Gifts</h2>
      <p>
        If the item was marked as a gift when it was purchased and shipped to you, you&rsquo;ll receive store
        credit for the value of the return once it arrives.
      </p>

      <h2>Shipping a Return</h2>
      <p>
        You&rsquo;re responsible for the cost of return shipping. Shipping costs aren&rsquo;t refundable, and if
        you receive a refund, the cost of return shipping is deducted from it. For anything valuable, I&rsquo;d
        use a trackable service and add insurance, since I can&rsquo;t guarantee I&rsquo;ll receive an uninsured
        return.
      </p>

      <h2>Questions</h2>
      <p>
        If you have any questions about returns or refunds, email me at <a href={hrefs.mailto}>{contact.email}</a>
        or call or text <a href={hrefs.tel}>{contact.phone}</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal-inner { max-width: 820px; margin: 0 auto; padding: 0 24px; }
  .legal-title-bar {
    background: var(--color-brand-rust-dark, #682412);
    padding: 180px 24px 48px;
    text-align: center;
  }
  .legal-title-bar h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 52px);
    color: var(--color-brand-cream);
    line-height: 1.1;
  }
  .legal-body { background: #fff; padding: 48px 0 72px; }
  .legal-prose p,
  .legal-prose li {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-brand-charcoal);
  }
  .legal-prose p { margin: 0 0 18px; }
  .legal-prose h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    color: var(--color-brand-rust-dark);
    margin: 34px 0 12px;
  }
  .legal-prose ul { margin: 0 0 18px; padding-left: 22px; }
  .legal-prose li { margin-bottom: 8px; }
  .legal-prose a { color: var(--color-brand-rust); text-decoration: underline; }
  .legal-prose a:hover { color: var(--color-brand-rust-bright); }
  @media (max-width: 700px) {
    .legal-title-bar { padding: 120px 16px 36px; }
  }
</style>
