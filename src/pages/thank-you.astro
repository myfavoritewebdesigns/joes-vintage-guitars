---
import Layout from "../layouts/Layout.astro";
import { contact, hrefs } from "../config/site";
---

<Layout
  title="Thank You | Joe’s Vintage Guitars"
  description="Thanks for reaching out to Joe's Vintage Guitars. Send a few photos of your guitar for the fastest, most accurate answer."
  canonical="/thank-you/"
  noIndex={true}
>
  <section class="ty">
    <div class="ty__inner">
      <p class="ty__eyebrow">Message Sent</p>
      <h1 class="ty__title">Thank You!</h1>
      <div class="ty__rule" aria-hidden="true"></div>
      <p class="ty__lede">
        Thanks for reaching out. I got your message and I’ll get back to you shortly, usually the same day.
      </p>

      <!-- Part two: optional photo upload. Photos are the fastest way for Joe to value a guitar. -->
      <div class="pu-card">
        <h2 class="pu-card__title">Send Photos of Your Guitar</h2>
        <p class="pu-card__lede">
          Optional, but it is the fastest way for me to tell you what you’ve got. Add a few clear shots
          (front, back, headstock, and any labels or serial numbers) and send them straight over.
        </p>

        <form id="jvg-photo-form" class="pu-form" novalidate>
          <div class="pu-grid">
            <div class="pu-fields">
              <input id="pu-name" name="name" type="text" placeholder="Your name" aria-label="Your name" autocomplete="name" />
              <input id="pu-email" name="email" type="email" placeholder="Your email" aria-label="Your email" autocomplete="email" required />
              <input id="pu-phone" name="phone" type="tel" placeholder="Your phone (optional)" aria-label="Your phone (optional)" autocomplete="tel" />
            </div>
            <textarea id="pu-message" name="message" rows="2" placeholder="Anything I should know about the guitar? (optional)" aria-label="Anything I should know about the guitar? (optional)"></textarea>

            <div id="pu-dropzone" class="pu-dropzone" role="button" tabindex="0" aria-label="Add photos by clicking or dragging files here">
              <input id="pu-input" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif,.heic,.heif" multiple hidden />
              <svg class="pu-dropzone__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 16l4-4a2 2 0 012.8 0L15 16M14 14l1.5-1.5a2 2 0 012.8 0L21 15M4 6h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="9" cy="10" r="1.4" fill="currentColor"/>
              </svg>
              <p class="pu-dropzone__title">Drag photos here, or <span class="pu-dropzone__link">choose files</span></p>
              <p class="pu-dropzone__hint">Up to 10 photos &middot; JPG, PNG, GIF, WebP, or iPhone HEIC</p>
            </div>

            <ul id="pu-list" class="pu-list"></ul>

            <!-- honeypot: keep empty -->
            <input id="pu-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" class="pu-hp" aria-hidden="true" />
          </div>

          <button id="pu-submit" type="submit" class="pu-submit" disabled>Send Photos</button>
          <div id="pu-status" class="pu-status" role="status" aria-live="polite"></div>
        </form>
      </div>

      <p class="ty__lede ty__lede--small">
        In a hurry? Call or text me at <a href={hrefs.tel}>{contact.phone}</a>, or email
        <a href={hrefs.mailto}>{contact.email}</a>.
      </p>
      <div class="ty__ctas">
        <a href={hrefs.tel} class="ty__btn ty__btn--rust">Call or Text Joe</a>
        <a href="/" class="ty__btn ty__btn--outline">Back to Home</a>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/photo-upload.ts";
  </script>
</Layout>

<style>
  .ty {
    background: var(--color-brand-rust-dark, #682412);
    padding: 170px 24px 90px;
    text-align: center;
    min-height: 60vh;
  }
  .ty__inner { max-width: 760px; margin: 0 auto; }
  .ty__eyebrow {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 14px;
    color: var(--color-brand-gold, #c8983a);
    margin: 0 0 10px;
  }
  .ty__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(38px, 6vw, 64px);
    color: var(--color-brand-cream);
    line-height: 1.05;
  }
  .ty__rule { width: 80px; height: 3px; background: var(--color-brand-gold, #c8983a); margin: 22px auto 26px; }
  .ty__lede {
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    color: #f1e6cd;
    margin: 0 auto 18px;
    max-width: 60ch;
  }
  .ty__lede--small { font-size: 15px; margin-top: 30px; }
  .ty__lede a { color: var(--color-brand-gold, #c8983a); text-decoration: underline; }
  .ty__ctas { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 22px; }
  .ty__btn {
    display: inline-block; padding: 13px 28px; font-family: var(--font-display); font-weight: 700;
    font-size: 16px; letter-spacing: 0.03em; text-decoration: none; border-radius: 5px;
    transition: background 0.18s, color 0.18s;
  }
  .ty__btn--rust { background: var(--color-brand-rust-bright, #be4b25); color: #fff; }
  .ty__btn--rust:hover { background: var(--color-brand-rust, #a03a1e); }
  .ty__btn--outline { border: 2px solid var(--color-brand-cream, #eedfc0); color: var(--color-brand-cream, #eedfc0); }
  .ty__btn--outline:hover { background: var(--color-brand-cream, #eedfc0); color: var(--color-brand-rust-dark, #682412); }

  /* Photo upload card */
  .pu-card {
    background: var(--color-brand-cream, #eedfc0);
    border-radius: 10px;
    padding: 30px 28px 28px;
    margin: 32px auto 0;
    max-width: 620px;
    text-align: left;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }
  .pu-card__title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(22px, 3.4vw, 28px);
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 8px;
    text-align: center;
  }
  .pu-card__lede {
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-brand-brown, #3e2a14);
    margin: 0 auto 20px;
    text-align: center;
    max-width: 52ch;
  }
  .pu-grid { display: flex; flex-direction: column; gap: 12px; }
  .pu-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pu-fields input:first-child { grid-column: 1 / -1; }
  .pu-form input,
  .pu-form textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-sans);
    font-size: 15px;
    padding: 11px 13px;
    border: 1px solid #c9b78f;
    border-radius: 6px;
    background: #fffdf8;
    color: var(--color-brand-brown, #3e2a14);
  }
  .pu-form input:focus,
  .pu-form textarea:focus { outline: 2px solid var(--color-brand-rust, #a03a1e); outline-offset: 1px; border-color: var(--color-brand-rust, #a03a1e); }
  .pu-form textarea { resize: vertical; }
  .pu-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .pu-dropzone {
    border: 2px dashed #b9986a;
    border-radius: 8px;
    background: #fbf4e6;
    padding: 26px 18px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .pu-dropzone:hover,
  .pu-dropzone:focus-visible { border-color: var(--color-brand-rust, #a03a1e); background: #f7ecd6; outline: none; }
  .pu-dropzone[data-drag] { border-color: var(--color-brand-rust, #a03a1e); background: #f3e3c5; }
  .pu-dropzone__icon { width: 40px; height: 40px; color: var(--color-brand-rust, #a03a1e); margin-bottom: 6px; }
  .pu-dropzone__title { font-family: var(--font-sans); font-size: 15px; color: var(--color-brand-brown, #3e2a14); margin: 0 0 4px; }
  .pu-dropzone__link { color: var(--color-brand-rust, #a03a1e); font-weight: 700; text-decoration: underline; }
  .pu-dropzone__hint { font-family: var(--font-sans); font-size: 12.5px; color: #7a6a4c; margin: 0; }

  .pu-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .pu-item {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    background: #fffdf8; border: 1px solid #d9c9a4; border-radius: 6px; padding: 8px 10px 8px 12px;
  }
  .pu-item__name { font-family: var(--font-sans); font-size: 13.5px; color: var(--color-brand-brown, #3e2a14); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pu-item__remove {
    flex-shrink: 0; width: 24px; height: 24px; line-height: 1; border: none; border-radius: 50%;
    background: #e7d9bb; color: var(--color-brand-rust-dark, #682412); font-size: 18px; cursor: pointer;
  }
  .pu-item__remove:hover { background: var(--color-brand-rust, #a03a1e); color: #fff; }

  .pu-submit {
    margin-top: 16px; width: 100%;
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
    font-size: 16px; padding: 14px; border: none; border-radius: 6px;
    background: var(--color-brand-rust, #a03a1e); color: #fff; cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }
  .pu-submit:hover:not(:disabled) { background: var(--color-brand-rust-dark, #682412); }
  .pu-submit:disabled { opacity: 0.5; cursor: not-allowed; }

  .pu-status { font-family: var(--font-sans); font-size: 14.5px; margin-top: 12px; text-align: center; min-height: 1.2em; }
  .pu-status[data-state="error"] { color: #b4231a; font-weight: 600; }
  .pu-status[data-state="success"] { color: #2f7d32; font-weight: 700; }
  .pu-status[data-state="submitting"],
  .pu-status[data-state="info"] { color: var(--color-brand-brown, #3e2a14); }

  @media (max-width: 640px) {
    .ty { padding: 120px 14px 60px; }
    .pu-card { padding: 24px 18px 22px; }
    .pu-fields { grid-template-columns: 1fr; }
  }
</style>
