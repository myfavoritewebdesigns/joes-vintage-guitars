const HUB_HREF = "/fender-serial-hub-preview/";

// ---- Data ----
const pencilRows = [
  ["5-57", "May 1957"],
  ["11-62", "November 1962"],
];
const stampParts = [
  ["First 1 to 2 digits", "Model code. Ignore it for dating.", "1"],
  ["Next 1 to 2 digits", "Month, 01 to 12.", "APR"],
  ["Next 2 digits", "Year, the last two digits. 63 means 1963.", "63"],
  ["Final letter", "Neck width. A narrow, B standard, C wide, D extra wide.", "B"],
];
const modelRows = [
  ["1", "Jaguar, 1962 to 1965. It becomes 15 from 1966"],
  ["2", "Stratocaster, 1962 to 1965. It becomes 13 from 1966, so a 1965 neck reads 2MAY65B and a 1966 one reads 13MAY66B"],
  ["3", "Telecaster and Esquire, which shared this code, and the Custom Telecaster from 1959"],
  ["4", "Jazzmaster, 1962 to 1965. It moves to 19 in late 1965 or 1966, and turns up as 10 or 13 now and then"],
  ["5", "Precision Bass"],
  ["6", "Bass VI"],
  ["7", "Jazz Bass"],
  ["8", "Musicmaster II, Mustang, Duo-Sonic II, 1964 to 1965, 22 fret 24 inch scale"],
  ["9", "Musicmaster II, Mustang, Duo-Sonic II, 1964 to 1966, 21 fret 22 1/2 inch scale"],
  ["10", "Coronado 1 and 2, and the occasional 1966 Jazzmaster and Stratocaster neck"],
  ["11", "Bass V"],
  ["12", "Electric 12, and Maverick / Custom"],
  ["13", "Stratocaster, 1966 to 1968, and many 1966 Jazzmasters. This is the code that replaced 2"],
  ["14", "Coronado 12"],
  ["15", "Jaguar, 1966 to 1972"],
  ["16", "Musicmaster II, Mustang, Duo-Sonic II, and Bronco"],
  ["17", "Mustang Bass and Musicmaster Bass"],
  ["18", "Coronado Bass"],
  ["19", "Jazzmaster and Coronado 2"],
  ["22", "Stratocaster, 1968 to about 1973"],
  ["23", "Telecaster Bass"],
  ["27", "Villager 12"],
  ["28", "Shenandoah 12"],
];

const tocItems: [string, string][] = [
  ["#what", "What A Neck Date Is"],
  ["#find", "Where To Find It"],
  ["#step1", "Read A Pencil Date"],
  ["#step2", "Read An Ink Stamp"],
  ["#green", "The Green Stamp"],
