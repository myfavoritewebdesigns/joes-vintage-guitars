---
/**
 * Fender physical features spoke, preview build.
 *
 * Hub-and-spoke method page behind the condensed Fender serial rebuild
 * (see fender-serial-hub-preview.astro). Covers the visual/parts checks the
 * hub only summarizes, so the hub's feature chips resolve.
 *
 * MERGE DECISION 2026-07-20 (Joe's call): this ONE page replaces the five
 * separately planned feature spokes (logo evolution, pickguards, tuner
 * evolution, bridge saddles, fretboard inlays). Measured off the live guide
 * those five sections are only 172 / 207 / 214 / 345 / 341 words but carry 23
 * of Joe's photos, so merged they make one strong image-led page instead of
 * five thin ones. Each feature keeps its own H2 + anchor (#logo, #inlays,
 * #pickguards, #saddles, #tuners, #hardware) so deep links and per-feature
 * ranking survive. Finish dating stays its own page (its live section is
 * 5,531 words and overlaps the custom-color blog post).
 *
 * The live page's section boundaries were mis-scoped and are FIXED here:
 * "logo-evolution" bundled control knobs, switch tips and string trees, and
 * "adv-pickguards" bundled slab-vs-veneer fretboard construction. Those are
 * regrouped under the features they actually belong to.
 *
 * Noindex + sitemap-excluded + X-Robots-Tag (astro.config.mjs SITEMAP_EXCLUDE
 * and public/_headers), same preview pattern as the other spokes.
 *
 * TWO FACTS TAKEN FROM JOE OVER THE LIVE PAGE:
 * (1) Nitrate "mint" pickguards run to MID-1965, not "late 1964" as the live
 *     page says. Per Joe's custom-color house facts (2026-07-08), which are
 *     the standing position for all JVG Fender content. Same source gives the
 *     tortoise rule: tortoise was NEVER factory-paired with a custom color
 *     except Olympic White.
 * (2) The Kluson single-line to double-line date is a DOCUMENTED LIVE DISPUTE
 *     (guitarhq ~1964 vs es-335.com and others ~1958), flagged in
 *     joes-vintage-databases as verifyWithExpert. The page presents it as
 *     contested and never emits a single year from a Kluson stamp alone.
 */
import Layout from "../layouts/Layout.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { resolveImage, assetSrc } from "../lib/images";
import { contact, hrefs, SITE_URL } from "../config/site";

const meta = (file: string) => resolveImage("images/fender-sn/" + file)!;
const img = (file: string) => assetSrc("images/fender-sn/" + file);

const PAGE_PATH = "/fender-physical-features/";
const HUB_PATH = "/fender-guitars-serial-number-guide/";
// PREVIEW-ONLY. The condensed hub currently lives at its own preview URL, so the
// visible back/cross-check links point THERE and the spoke set clicks through end
// to end. HUB_PATH above stays canonical and still feeds the schema + breadcrumb.
// TODO(launch): set HUB_HREF = HUB_PATH and delete this comment, once the
// condensed hub replaces the live guide at /fender-guitars-serial-number-guide/.
const HUB_HREF = "/fender-serial-hub-preview/";

// ---- Data ----
const logoRows = [
  ["Spaghetti", "1950 to early 1964", "Thin, elegant script with a fine black outline. The one everybody wants"],
  ["Transition", "Mid-1964 to 1967", "Thicker and bolder, gold foil with a heavier black outline"],
  ["CBS, or TV", "1968 into the 1980s", "Heavy black script with a thin gold outline, drawn to read on television. Usually on the large headstock"],
];
const boardRows = [
  ["One-piece maple", "1950 to mid-1959, and again from the early 1970s", "No separate fretboard at all. The frets go straight into the neck, and a dark walnut skunk stripe runs down the back"],
  ["Slab rosewood", "Mid-1959 to mid-1962", "A thick, flat-bottomed slab glued on. At the nut the rosewood shows as a deep, curved band"],
  ["Veneer rosewood", "Mid-1962 onward", "A thin board with a curved underside following the neck radius. At the nut the rosewood line looks thin and flat"],
  ["Maple cap", "From about 1967", "A separate maple fingerboard glued onto a maple neck. The back is clean maple with no skunk stripe"],
];
const inlayRows = [
  ["Clay dots", "1959 to late 1964", "Not actually clay. Vulcanized fiberboard, dull and porous, aging to a dingy off-white or tan"],
  ["Pearloid dots", "Late 1964 into the 1970s", "Bright, with a swirled marble figure. They stay shiny because they don't drink up finger oil"],
  ["Block inlays", "1966 on. Jazzmaster, Jaguar, and the Jazz Bass", "Large rectangular pearloid blocks on a bound neck. The fastest way to call a post-1966 offset from across a room"],
];
const guardRows = [
  ["Single-ply black Bakelite", "1950 to mid-1954, Telecaster and Esquire", "Thick, heavy, and hard, with no layers visible at the edge. This is the guard the blackguard is named after"],
  ["Single-ply white vinyl", "Mid-1954 to 1959. Telecaster, Esquire, and the Stratocaster from its 1954 launch", "Smooth white styrene, still a single ply. On a Stratocaster it takes eight screws. This is the whiteguard era"],
  ["Cellulose nitrate, three-ply", "1959 to mid-1965", "White when it left the factory, and eleven screws on a Stratocaster. The mint green arrives over decades as the nitrate breaks down"],
  ["White PVC, three-ply", "Mid-1965 onward", "Chemically stable. It may go slightly cream, but it never reaches nitrate's mint green"],
];
const saddleRows = [
  ["Brass", "1950 to mid-1954, Telecaster", "Gold brown, settling into a dull patina. Roughly 5/16 inch across"],
  ["Steel, smooth flat-bottom", "Mid-1954 to 1958, Telecaster", "Bright silver, and prone to rust and pitting. Roughly 1/4 inch across"],
  ["Steel, threaded barrel", "1958 to 1968, Telecaster", "The same steel, now with a threaded barrel that the strings sit across"],
  ["Steel, smooth with grooves", "1968 onward, Telecaster", "Back to a smooth barrel, but with a groove cut for each string"],
  ["Stamped steel", "1954 to 1971, Stratocaster", "FENDER PAT. PEND. stamped into every one"],
  ["Die-cast zinc", "Late 1971 on, Stratocaster", "Thick, rectangular, unbranded blocks"],
];
const tunerRows = [
  ["Kluson, no line", "1950 to mid-1956", "The back of the housing is completely smooth, with no text at all"],
  ["Kluson, single line", "Mid-1956 to mid-1964", "KLUSON DELUXE stamped in one vertical line"],
  ["Kluson, double line", "Mid-1964 to late 1967", "The same words split across two parallel lines"],
  ["F-style, by Schaller", "Late 1965 to 1983", "Chrome plated, with a large stylized F stamped on the back. Not standard across the main lines until mid to late 1967"],
];

const tocItems: [string, string][] = [
  ["#top", "Start Here"],
  ["#logo", "Logo Evolution"],
  ["#inlays", "Neck And Fretboard"],
  ["#pickguards", "Pickguards"],
  ["#saddles", "Bridge Saddles"],
  ["#tuners", "Tuners"],
  ["#hardware", "Knobs And String Trees"],
  ["#limits", "What Features Can't Prove"],
  ["#cross", "Cross-Check The Date"],
  ["#faq", "Common Questions"],
  ["#appraisal", "Free Expert Appraisal"],
  ["#about-joe", "About Joe"],
];

const faqs = [
  {
    q: "Can I Date A Fender From The Logo Alone?",
    a: "You can get to an era, not a year. The three logo styles cover long stretches, and the transition logo in particular sits on guitars that still carry pre-CBS specs. A logo narrows the window and then the neck date, the pot codes, and the rest of the hardware close it.",
  },
  {
    q: "My Pickguard Is Mint Green. Does That Prove It's Original?",
    a: "It proves the guard is cellulose nitrate, which puts it in the 1959 to mid-1965 window, and nitrate is not something modern reproductions replicate convincingly. It doesn't prove the guard started life on that guitar. Read it with the screw holes, the fit, and the rest of the parts.",
  },
  {
    q: "What If The Features Disagree With The Serial Number?",
    a: "Trust the features. Serial numbers came off a bin and overlap year to year, but a spaghetti logo, clay dots, and stamped steel saddles all had to be fitted while Fender was still making them. When the parts say one era and the serial says another, the parts are usually telling the truth.",
  },
  {
    q: "Are Double-Line Klusons A Red Flag On A 1962?",
    a: "They're a reason to look harder. The exact year Kluson moved from one line to two is genuinely disputed among researchers, so I wouldn't condemn a guitar on that alone. Check it against the neck date and the pot codes before drawing a conclusion.",
  },
  {
    q: "Do Replaced Parts Ruin The Value?",
    a: "It depends entirely on the part and the guitar. A replaced string tree is nothing. A replaced pickguard, tuners, or saddles on a high-value pre-CBS guitar can move the number substantially. Send me three photos and I'll tell you what's original and what it means.",
  },
];

// ---- Schema ----
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Dating A Fender By Its Parts: Logos, Pickguards, Saddles, Tuners And Inlays",
  description:
    "Date a vintage Fender from the parts you can see. Logo styles, fretboard and inlay changes, pickguard materials, bridge saddles, tuners, knobs, and string trees, with the year each one changed.",
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  image: img("1967-fender-stratocaster-bridge-saddles.jpg"),
  inLanguage: "en-US",
  mainEntityOfPage: `${SITE_URL}${PAGE_PATH}`,
  isPartOf: { "@type": "WebPage", "@id": `${SITE_URL}${HUB_PATH}` },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Fender Serial Number Guide", item: `${SITE_URL}${HUB_PATH}` },
    { "@type": "ListItem", position: 3, name: "Fender Physical Features", item: `${SITE_URL}${PAGE_PATH}` },
  ],
};
---

<Layout
  title="Dating A Fender By Its Parts: Logos, Pickguards, Saddles And Tuners (Preview)"
  description="Date a vintage Fender from the parts you can see. Logo styles, inlays, pickguard materials, bridge saddles, tuners and string trees, with the year each one changed."
  canonical={PAGE_PATH}
  ogImage={`${SITE_URL}${img("1967-fender-stratocaster-bridge-saddles.jpg")}`}
  ogImageAlt="The bridge of a 1967 Fender Stratocaster showing stamped steel saddles marked FENDER PAT. PEND."
  ogType="article"
  noIndex={true}
  structuredData={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Archetype B header backdrop -->
  <div class="fspot-header-backdrop" aria-hidden="true">
    <div class="fspot-header-backdrop__dark"></div>
    <div class="fspot-header-backdrop__cream"></div>
  </div>

  <p class="fspot-preview-note">Internal preview of a Fender serial guide spoke. Noindexed and not linked.</p>

  <div class="fspot">
    <!-- HERO -->
    <section class="hero" id="top">
      <div class="measure stack">
        <a class="back" href={HUB_HREF}>Back To The Full Fender Serial Guide</a>
        <span class="eyebrow">Fender Dating Methods</span>
        <h1>Dating A Fender By Its Parts</h1>
        <p class="lead">You can get a vintage Fender inside a couple of years without ever picking up a screwdriver. Every logo, pickguard, saddle, tuner and inlay has a window when Fender was fitting it, and the place those windows overlap is your answer.</p>
        <div class="trust">
          <span>Joe Dampt</span><span>12 years buying vintage Fenders full-time</span><span>10,000+ appraised</span>
        </div>
        <figure class="sfig herofig">
          <LicensedImage src={meta("1967-fender-stratocaster-bridge-saddles.jpg")} alt="The bridge of a 1967 Fender Stratocaster, showing stamped steel saddles marked FENDER PAT. PEND." width={1600} loading="eager" />
          <figcaption>The bridge of a 1967 Stratocaster. Every saddle carries FENDER PAT. PEND. stamped into it, which is one of the quickest originality checks on the whole guitar.</figcaption>
        </figure>
      </div>
    </section>

    <div class="rule"></div>

    <!-- WHY -->
    <section id="why">
      <div class="measure stack">
        <span class="eyebrow">Start Here</span>
        <h2>Why The Parts Beat The Serial Number</h2>
        <p>Fender built in batches. Necks, bodies, and neck plates were made separately, thrown in bins, and pulled at random on the assembly line, so serial numbers overlap year to year and can't be read as a sequence. That's the whole reason a serial gives you a range instead of an answer.</p>
        <p>Parts work the other way round. Fender could only fit a spaghetti logo while it was still printing them, only fit clay dots while it still had them, only fit brass saddles while they were still being made. Each part carries the window it was current in, and when you line several windows up they overlap on a much narrower stretch of time than any serial number will give you.</p>
        <p>Best of all, you can read most of this with the guitar in your hands and a screwdriver you never pick up. No cavity, no neck off, no meter.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- LOGO -->
    <section id="logo">
      <div class="measure stack">
        <span class="eyebrow">The Headstock</span>
        <h2>Fender Logo Evolution</h2>
        <p>Three logo styles cover the vintage era, and the change points are the single most useful era markers on the whole guitar because you can see them from across a room.</p>
        <div class="tablewrap"><table>
          <thead><tr><th>Logo</th><th>Years</th><th>What it looks like</th></tr></thead>
          <tbody>{logoRows.map((r) => (<tr><td data-label="Logo">{r[0]}</td><td data-label="Years" class="yr">{r[1]}</td><td data-label="What it looks like">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("fender-spaghetti-logo-1950-1964-on-vintage-stratocaster-headstock.jpg")} alt="Fender spaghetti logo, 1950 to early 1964, thin elegant script" width={1100} /><figcaption>Spaghetti, 1950 to early 1964. Thin, elegant, with a fine black outline.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("transition-logo-64.jpg")} alt="Fender transition logo, mid-1964 to 1967, thicker bolder gold foil" width={1100} /><figcaption>Transition, mid-1964 to 1967. Thicker and bolder, in gold foil.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-cbs-tv-logo-1968-1980s-on-vintage-stratocaster-headstock.jpg")} alt="Fender CBS or TV logo, 1968 into the 1980s, heavy black script" width={1100} /><figcaption>CBS, or TV, 1968 into the 1980s. Heavy black script drawn to read on camera.</figcaption></figure>
        </div>
        <div class="tip">
          <p><b>Read the patent numbers, not just the font.</b> The patent numbers printed under the logo changed almost year to year on pre-CBS Fenders, which makes them far more precise than the logo style above them. A guitar sold to you as a 1962 should carry the numbers Fender was printing in 1962. This is the check that catches a good reproduction decal, because getting the script right is easy and getting the patent list right for one specific year is not.</p>
        </div>
        <p><b>The models didn't change together, and this catches people.</b> The Stratocaster moved to the transition logo in mid-1964, but the Telecaster and Esquire held onto the spaghetti logo about a year longer, into the middle or end of 1965. So a spaghetti logo on a 1965 Telecaster is correct and original. Read the Stratocaster timeline onto a Tele and you'll date the guitar a year or more too early, which is the kind of mistake that turns into a bad offer in either direction.</p>
        <p class="note-sm">One more trap: the transition logo sits on plenty of guitars that are otherwise pre-CBS in spec. A transition logo does not make a guitar a CBS guitar, and those crossover instruments are often underpriced because people read the logo and stop.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- FRETBOARD -->
    <section id="inlays">
      <div class="measure stack">
        <span class="eyebrow">The Neck</span>
        <h2>Neck And Fretboard Construction</h2>
        <p>The neck changed twice in ways you can see at a glance, and the dots in it changed again. Between them they cut the vintage era into slices.</p>

        <h3 id="board">Maple, Slab, And Veneer</h3>
        <p>Look at the joint right above the nut and see how thick the rosewood is.</p>
        <div class="tablewrap"><table>
          <thead><tr><th>Board</th><th>Years</th><th>What to look for</th></tr></thead>
          <tbody>{boardRows.map((r) => (<tr><td data-label="Board">{r[0]}</td><td data-label="Years" class="yr">{r[1]}</td><td data-label="What to look for">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("slabboard.jpg")} alt="A Fender slab rosewood fretboard, 1959 to mid-1962, showing a thick convex rosewood band at the headstock" width={1100} /><figcaption>Slab board, 1959 to mid-1962. The rosewood reads as a thick, curved band at the nut.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("veneer-board.jpg")} alt="A Fender veneer rosewood fretboard, mid-1962 onward, showing a thin flat rosewood line at the headstock" width={1100} /><figcaption>Veneer board, mid-1962 onward. The same view, but the rosewood is a thin, flat line.</figcaption></figure>
        </div>
        <div class="tip">
          <p><b>August 1962 is the month to know.</b> Fender changed from slab to veneer boards partway through that month, so both turn up on necks stamped August 1962. A slab board with an August 1962 neck date is a genuine transition guitar and worth more than either side of the change.</p>
        </div>

        <h3 id="skunk">One-Piece Maple Or A Maple Cap</h3>
        <p>Two maple necks can look identical from the playing side and be built completely differently, and the back of the neck gives it away in a second.</p>
        <p>On a one-piece maple neck there is no separate fretboard. The frets are cut straight into the neck itself, which means the truss rod has to go in from behind. Fender routed a channel up the back, dropped the rod in, and filled the channel with a strip of dark walnut. That strip is the <b>skunk stripe</b>, and there's a small walnut plug at the headstock end where the rod was fed in. It isn't decoration, it's the lid on the truss rod channel.</p>
        <p>A maple cap neck is built the other way round. A separate maple fingerboard is glued on top, so the truss rod drops in from the front before the board goes on and covers it. Nothing needs filling from behind, so the back is clean unbroken maple with <b>no skunk stripe and no plug</b>.</p>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("1959-fender-telecaster-skunk-stripe.jpg")} alt="The back of a 1959 Fender Telecaster one-piece maple neck showing the dark walnut skunk stripe running down the center" width={1280} /><figcaption>A 1959 Telecaster, one-piece maple. The dark walnut skunk stripe runs the length of the back, capping the truss rod channel.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("1970-fender-telecaster-maple-cap.jpg")} alt="The back of a 1970 Fender Telecaster maple cap neck, clean maple with no skunk stripe" width={1100} /><figcaption>A 1970 Telecaster, maple cap. Same wood, same look from the front, and no stripe at all because the truss rod went in from the other side.</figcaption></figure>
        </div>
        <p>Which matters because a maple neck on its own tells you almost nothing about the year. Fender dropped maple boards in 1959, brought maple back as a glued-on cap in the late 1960s, and returned to one-piece necks in the early 1970s. So the question is never just whether the board is maple. It's whether the back has a stripe.</p>
        <div class="tip">
          <p><b>A stripe on a claimed 1960s maple-board Fender is wrong.</b> Through the maple cap years the back should be clean. Equally, no stripe on a claimed 1950s maple neck is wrong, because every one-piece neck has to have one. This is one of the few checks on the page where the two answers point at genuinely different decades, and it takes one look at the back of the neck.</p>
        </div>

        <h3 id="dots">Clay Dots, Pearloid, And Blocks</h3>
        <div class="tablewrap"><table>
          <thead><tr><th>Inlay</th><th>Years</th><th>What to look for</th></tr></thead>
          <tbody>{inlayRows.map((r) => (<tr><td data-label="Inlay">{r[0]}</td><td data-label="Years" class="yr">{r[1]}</td><td data-label="What to look for">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("clay-dots-1959-1964.jpg")} alt="Fender clay dot fretboard inlays, 1959 to 1964, dull and matte" width={1100} /><figcaption>Clay dots, 1959 to late 1964. Dull, matte, and usually discolored by now.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("pearloid-dots-1964-1970.jpg")} alt="Fender pearloid dot inlays from late 1964 onward, bright and marbled" width={1100} /><figcaption>Pearloid dots, late 1964 onward. Bright, shiny, and visibly swirled.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("block-inaly-1966-1970.jpg")} alt="Fender large pearloid block inlays from 1966 on a Jazzmaster" width={1100} /><figcaption>Block inlays, 1966 on, on the Jazzmaster and Jaguar.</figcaption></figure>
        </div>
        <p>The blocks weren't only a guitar thing. The Jazz Bass got them in the middle of 1966 as well, on a bound neck, and for bass collectors that changeover is every bit the anchor the offset guitars are.</p>
        <div class="tip">
          <p><b>The side dots changed first.</b> In early 1964 Fender switched the little dots on the edge of the neck from clay to pearloid before it switched the ones on the face. So a neck from the first half of 1964 can show dull clay dots on top and bright pearloid dots on the side. That mismatch looks wrong to anyone who hasn't met it before, and it's one of the sharpest tells for the transition period there is.</p>
        </div>
      </div>
    </section>

    <div class="rule"></div>

    <!-- PICKGUARDS -->
    <section id="pickguards">
      <div class="measure stack">
        <span class="eyebrow">The Guard</span>
        <h2>Pickguard Materials</h2>
        <p>Four materials across the vintage era, and one of them ages in a way nothing else does, which is why the pickguard is often the first thing a dealer looks at.</p>
        <p>The first two matter enormously on a Telecaster, because collectors name whole eras after them. A <b>blackguard</b> is a Telecaster or Esquire from 1950 to the middle of 1954, wearing the thick single-ply black Bakelite guard. In mid-1954 Fender changed to a single-ply white guard, and everything from then to 1959 is a <b>whiteguard</b>. Those aren't nicknames for a color, they're the two halves of the early Telecaster, and the changeover is one of the sharpest value lines on the model. Get it the wrong way round and you've misdated the guitar by years.</p>
        <p><b>On a Stratocaster there's a faster version of the same check: count the screws.</b> The single-ply white guard the Strat wore from its 1954 launch takes eight of them. The three-ply nitrate guard that replaced it in 1959 takes eleven. You can do that from a photograph. Better still, count the holes in the body rather than the guard, because a guard can be swapped and the holes underneath it cannot. Eleven holes on a guitar sold as a 1956 means the body has worn a later guard, whatever is bolted to it now.</p>
        <div class="tablewrap"><table>
          <thead><tr><th>Material</th><th>Years</th><th>What to look for</th></tr></thead>
          <tbody>{guardRows.map((r) => (<tr><td data-label="Material">{r[0]}</td><td data-label="Years" class="yr">{r[1]}</td><td data-label="What to look for">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("fender-vintage-mint-cellulose-nitrate-pickguard.jpg")} alt="A vintage Fender cellulose nitrate mint green pickguard" width={1100} /><figcaption>Nitrate, gone mint green with age. It left the factory white.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-tortoise-pickguard-years.jpg")} alt="A vintage Fender tortoise shell nitrate pickguard on an offset guitar" width={1100} /><figcaption>Tortoise nitrate, on the Jazzmaster and Jaguar.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-telecaster-white-pickguard-1966.jpg")} alt="A white PVC Fender Telecaster pickguard from 1966" width={1100} /><figcaption>White PVC, from mid-1965. It ages cream at most, never mint.</figcaption></figure>
        </div>
        <div class="tip">
          <p><b>The tortoise rule catches more fakes than anything else here.</b> Fender never paired a tortoise guard with a custom color at the factory, with exactly one exception: Olympic White. So tortoise on a Fiesta Red, a Lake Placid Blue, or any other custom color means swapped parts or a respray, every time. That single rule has saved buyers more money than every logo comparison on this page.</p>
        </div>
        <p>There's also a smell test, and it genuinely works. Original cellulose nitrate has a faint sharp chemical smell, something like vinegar or camphor, because that's the material slowly breaking down. Modern plastic has no smell at all. It's not conclusive on a guard that's been bagged up for years, but on an untouched guitar it's a surprisingly quick check. Nitrate guards also shrink as they age, which is why old screw holes sometimes sit slightly off their screws.</p>

        <h3 id="gold">Gold Anodized Guards</h3>
        <p>The other guard worth knowing is not plastic at all. Fender also made pickguards from anodized aluminum, finished in a warm brushed gold, and they look like nothing else the company built.</p>
        <p>You'll meet them mainly on Precision Basses and Jazzmasters. They turn up very occasionally on other Fender models too, and when they do it's usually because somebody ordered one that way rather than because the model ever shipped with them as standard. So a gold guard on an unexpected model isn't automatically wrong, it just needs the rest of the guitar to back it up.</p>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("1959-fender-jazzmaster-gold-pickguard.jpg")} alt="A 1959 Fender Jazzmaster in sunburst with a gold anodized aluminum pickguard" width={1600} /><figcaption>A 1959 Jazzmaster with its gold anodized guard, and a clean one. The brushed grain runs the length of the metal and shifts as the light moves across it, which is how anodized aluminum reads next to plastic.</figcaption></figure>
        </div>
        <p>The gold is an anodized surface layer rather than the color of the metal underneath, which is worth knowing for two reasons. On a guitar that has seen hard use, the gold can thin toward bare silvery aluminum where a forearm or a picking hand has sat for decades, and that is honest wear rather than damage. And because the layer is thin, these guards should never be polished or scrubbed. You can take the gold off one and it does not come back.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- SADDLES -->
    <section id="saddles">
      <div class="measure stack">
        <span class="eyebrow">The Bridge</span>
        <h2>Bridge Saddles</h2>
        <p>Saddles are small, they're often overlooked, and they're one of the fastest era calls on the guitar.</p>
        <div class="tablewrap"><table>
          <thead><tr><th>Saddle</th><th>Years and model</th><th>What to look for</th></tr></thead>
          <tbody>{saddleRows.map((r) => (<tr><td data-label="Saddle">{r[0]}</td><td data-label="Years and model" class="yr">{r[1]}</td><td data-label="What to look for">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("brass-saddles-2.jpg")} alt="Brass Telecaster bridge saddles, 1950 to mid-1954, gold colored with a dull patina" width={1100} /><figcaption>Brass, 1950 to mid-1954. Gold colored, settling into a dull patina.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("steelsaddles.jpg")} alt="Steel Telecaster bridge saddles, mid-1954 to 1958, silver and prone to rust" width={1100} /><figcaption>Steel, mid-1954 to 1958. Silver, and these rust.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-stamped-saddles-1960s.jpg")} alt="Stamped steel Stratocaster saddles marked FENDER PAT. PEND." width={1100} /><figcaption>Stamped steel, 1954 to 1971. Every one reads FENDER PAT. PEND.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-die-cast-zinc-saddles.jpg")} alt="Die-cast zinc block Stratocaster saddles from late 1971 onward, thick and unbranded" width={1100} /><figcaption>Die-cast zinc, late 1971 on. Thick, blank, unmistakable.</figcaption></figure>
        </div>
        <p>Read the brass-to-steel change as the boundary, not the steel itself. Brass only ran to the middle of 1954, so brass saddles put a Telecaster in the first few years, and that's a genuinely narrow window. Steel is the opposite: once it arrived it never left, right through into the 1980s.</p>
        <p>What narrows it down is which steel. Smooth barrels with flat bottoms are the 1950s. Threaded barrels run from 1958 to 1968 and are the ones most people picture on a vintage Tele. From 1968 Fender went back to a smooth barrel, but with a groove cut for each string. So "steel saddles" on its own tells you almost nothing about the year, and knowing which of the three you're holding tells you a great deal.</p>
        <div class="tip">
          <p><b>Put calipers on a Telecaster's saddles.</b> The original brass ones run about 5/16 inch across and the steel ones that replaced them about 1/4 inch. Reproduction brass saddles are almost always made to the later 1/4 inch size, so brass saddles at 1/4 inch on a guitar sold as a 1952 are modern parts wearing the right color. On a Stratocaster the equivalent check is simpler: no FENDER PAT. PEND. stamp on a claimed 1960s guitar means the saddles are not original.</p>
        </div>
      </div>
    </section>

    <div class="rule"></div>

    <!-- TUNERS -->
    <section id="tuners">
      <div class="measure stack">
        <span class="eyebrow">The Tuners</span>
        <h2>Tuners</h2>
        <p>Fender fitted Kluson Deluxe tuners from 1950 until the CBS years, then moved to F-style tuners made by Schaller. The back of the housing tells you which era you're in.</p>
        <div class="tablewrap"><table>
          <thead><tr><th>Tuner</th><th>Years</th><th>What to look for</th></tr></thead>
          <tbody>{tunerRows.map((r) => (<tr><td data-label="Tuner">{r[0]}</td><td data-label="Years" class="yr">{r[1]}</td><td data-label="What to look for">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("kluson-deluxe-no-line-tuner.jpg")} alt="A no-line Kluson Deluxe tuner with a completely smooth housing back" width={1100} /><figcaption>No line. The housing back is smooth, with nothing stamped on it.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("kluson-deluxe-single-line-tuner-1956-1964-on-vintage-fender-telecaster.jpg")} alt="A single-line Kluson Deluxe tuner on a vintage Fender Telecaster" width={1100} /><figcaption>Single line. KLUSON DELUXE runs down the housing in one column.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("kluson-deluxe-double-line-tuner-1964-1967-on-fender-telecaster.jpg")} alt="A double-line Kluson Deluxe tuner on a Fender Telecaster" width={1100} /><figcaption>Double line. The same words, split into two columns.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("vintage-kluson-deluxe-tuner-casing-underside-showing-pat.jpg")} alt="The underside of a vintage Kluson Deluxe tuner casing stamped PAT. APPLD." width={1100} /><figcaption>The underside of a no-line Kluson, stamped PAT. APPLD. That marking gives way to a full patent number in 1954.</figcaption></figure>
        </div>
        <div class="tip">
          <p><b>Don't hang a year on a Kluson stamp.</b> The single-line to double-line changeover is genuinely disputed among researchers, with published dates ranging from the late 1950s to about 1964, and no one has settled it. Double lines on a claimed 1962 are a reason to check the neck date and the pot codes, not a reason to walk away. Anybody who quotes you a single confident year for that change is quoting one source and not telling you the others exist.</p>
        </div>
        <p><b>The F-style changeover was slow, and the dates in the table overlap for a reason.</b> Fender took the Schaller tuners on around late 1965, and they showed up first on the smaller models, the Mustang and Duo-Sonic. The Stratocaster and Telecaster carried on with double-line Klusons well into 1966 and early 1967, and F-tuners only became the standard across the main electric lines in the middle to end of 1967. So double-line Klusons on a 1966 Strat are correct, and F-tuners on one are the thing worth questioning.</p>
        <p>Two things that are not in dispute. PAT. APPLD. on the underside of a no-line Kluson points to a pre-1954 build, because a full patent number replaced it that year. And Klusons are nickel plated while the F-style Schallers are chrome, so Klusons tarnish to a soft silver grey with age and the Schallers keep a brighter, faintly blue shine. A set that looks too bright to be sixty years old usually is.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- SMALL HARDWARE -->
    <section id="hardware">
      <div class="measure stack">
        <span class="eyebrow">The Small Parts</span>
        <h2>Knobs, Switch Tips, And String Trees</h2>
        <p>The cheapest parts on the guitar are also the ones nobody thinks to fake, which is exactly what makes them useful.</p>

        <h3 id="knobs">Round Top And Flat Top Knobs</h3>
        <p>Up to the middle of 1956, Telecasters, Esquires, and early Precision Basses wore round-top Bakelite knobs with a domed crown and coarse, heavy knurling. From mid-1956 Fender moved to the flat-top skirted knob with finer knurling that most people picture. The switch tip changed in the same era: a plain round barrel tip until the end of 1954, then the top hat shape still fitted to Telecasters today.</p>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("fender-telecaster-round-top-control-knob-.jpg")} alt="A round-top Bakelite control knob on a vintage Fender Telecaster, used before mid-1956" width={1100} /><figcaption>Round top, before mid-1956. Domed crown, coarse knurling, Bakelite.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("top-hat.jpg")} alt="A top hat style switch tip on a vintage Fender Telecaster, from late 1954 onward" width={1100} /><figcaption>The top hat switch tip, from late 1954. The round barrel tip came before it.</figcaption></figure>
        </div>
        <div class="tip">
          <p><b>Turn a round barrel switch tip over.</b> Many of the originals were made by Daka-Ware in Chicago and carry that name molded into the underside. Reproductions are almost always blank. The originals are Bakelite too, so they feel harder, heavier, and more ceramic than a modern ABS tip, which feels slick and light by comparison. It's a two-second check on a part most people never remove.</p>
        </div>

        <h3 id="trees">String Trees</h3>
        <p>Before mid-1956 Fender used a small round metal string guide. From mid-1956 it changed to the wider butterfly, or wing, tree that holds a more consistent break angle over the nut. It's a small part and an easy one to replace, so treat it as supporting evidence rather than proof of anything.</p>
        <div class="figrow gallery">
          <figure class="sfig"><LicensedImage src={meta("fender-telecaster-vintage-round-string-tree-scaled.jpg")} alt="A round string guide on a vintage Fender Telecaster headstock, used before mid-1956" width={1100} /><figcaption>The round string guide, before mid-1956.</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("vintage-fender-butterfly-string-tree-1.jpg")} alt="A butterfly or wing string tree on a vintage Fender headstock, from mid-1956 onward" width={1100} /><figcaption>The butterfly tree, mid-1956 onward.</figcaption></figure>
        </div>
      </div>
    </section>

    <div class="rule"></div>

    <!-- LIMITS -->
    <section id="limits">
      <div class="measure stack">
        <span class="eyebrow">Keep It Honest</span>
        <h2>What Features Can't Prove</h2>
        <p>Every part on this page can be unscrewed. That's the limit of the whole method, and it cuts both ways.</p>
        <p>A correct part doesn't prove a guitar is original, because correct parts are exactly what somebody assembling a convincing guitar would fit. A wrong part doesn't prove a guitar is fake either, because sixty-year-old instruments get played, and tuners, string trees, and pickguards wear out and get changed by people who were just keeping a guitar working.</p>
        <p>What features do well is establish a floor and catch contradictions. A pearloid-dot neck cannot be from 1959. A guitar wearing a spaghetti logo, clay dots, and stamped steel saddles has three parts all pointing at the same stretch of years, and that agreement is worth far more than any one of them alone. When one part disagrees with the other four, that part is the story, not the guitar.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- CROSS-CHECK -->
    <section id="cross">
      <div class="measure stack">
        <span class="eyebrow">Put It All Together</span>
        <h2>Cross-Check With The Other Methods</h2>
        <p>Features get you the era without a screwdriver. To close it down to a date, pair them with the <a class="spoke" href="/fender-neck-dates/">neck heel date</a> and the <a class="spoke" href="/fender-pot-codes/">pot codes</a>, then confirm with the <a class="spoke" href="/fender-body-dates/">body date</a> and the <a class="spoke" href="/fender-pickup-dates/">pickup dates</a>. When the parts and the dates agree, you have a build you can stand behind.</p>
        <p class="note-sm">This guide is one of the dating methods behind the <a class="spoke" href={HUB_HREF}>full Fender serial number guide</a>, where the complete year-by-year serial charts live.</p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="pt0">
      <div class="measure stack">
        <span class="eyebrow">Expert Questions</span>
        <h2>Common Questions About Fender Parts And Features</h2>
        <div class="faqs">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <div class="faqbody"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- APPRAISAL -->
    <section>
      <div class="measure">
        <div class="appraise" id="appraisal">
          <span class="eyebrow">Free Expert Appraisal</span>
          <h2>Not Sure Which Parts Are Original?</h2>
          <p>Originality is where the money is on a vintage Fender, and it's the hardest thing to judge from a photo on a listing. Send Joe three clear photos, the front, the back, and the headstock, for a free, expert appraisal within 24 hours.</p>
          <div class="row">
            <a class="call" href={hrefs.tel}>Call Or Text Joe: {contact.phone}</a>
            <a class="send" href="/free-appraisal/">Or Send Photos Online</a>
          </div>
        </div>
      </div>
    </section>

    <!-- BIO -->
    <section class="pt0">
      <div class="measure"><div class="bio" id="about-joe">
        <LicensedImage src={meta("about-me-joe-1.jpg")} alt="Joe Dampt, owner of Joe's Vintage Guitars, holding a vintage guitar" width={150} />
        <div>
          <div class="who"><a href="/about-me/">Joe Dampt</a></div>
          <div class="cred">Owner, Joe's Vintage Guitars · Mesa, AZ · 12 years full-time · 10,000+ appraised · 2,100+ five-star reviews</div>
          <p class="biotext">Joe Dampt is the owner of Joe's Vintage Guitars in Mesa, Arizona, where he's spent more than twelve years buying, appraising, and authenticating vintage instruments full-time. He's personally valued over 10,000 guitars for sellers in all 50 states, served as a traveling appraiser for the Treasure Seekers Roadshow, and sourced instruments for Grammy Award-winning artists. Every method on this page comes from that bench work.</p>
        </div>
      </div></div>
    </section>
  </div>

