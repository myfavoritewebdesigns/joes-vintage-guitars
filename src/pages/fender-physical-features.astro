  .fspot .herofig{margin-top:.3rem;}
  .fspot .herofig figcaption{font-size:.82rem;color:var(--ink);}

  .fspot .videowrap{border:1px solid rgba(200,152,58,.35);border-radius:10px;overflow:hidden;background:#000;line-height:0;}
  .fspot .videowrap lite-youtube{max-width:none;width:100%;}
  .fspot .tip{background:linear-gradient(135deg,var(--darkbrown-2),var(--darkbrown));color:#f0e1c1;border-radius:10px;padding:1rem 1.15rem;font-size:.95rem;}
  .fspot .tip::before{content:"JOE'S TIP";display:block;font-family:var(--fd);font-weight:600;letter-spacing:.14em;color:var(--gold);font-size:.78rem;margin-bottom:.4rem;}
  .fspot .tip b{color:#e0be79;}
  .fspot .warnbox{background:#fbe9e6;border:1px solid #e4a99d;border-left:6px solid var(--rust);border-radius:10px;padding:1rem 1.2rem;box-shadow:var(--shadow);}
  .fspot .warnbox__head{display:inline-flex;align-items:center;gap:.45rem;font-family:var(--fd);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--rust);font-size:.85rem;margin-bottom:.4rem;}
  .fspot .warnbox__head svg{flex:0 0 auto;}
  .fspot .warnbox p{margin:0;color:var(--ink);font-size:.97rem;}

  .fspot .faqs{display:flex;flex-direction:column;gap:.6rem;}
  .fspot details.faq{border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden;box-shadow:var(--shadow);}
  .fspot details.faq>summary{cursor:pointer;list-style:none;padding:.85rem 1.05rem;font-family:var(--fd);font-weight:600;font-size:1rem;color:var(--ink-strong);display:flex;justify-content:space-between;align-items:center;gap:.8rem;}
  .fspot details.faq>summary::-webkit-details-marker{display:none;}
