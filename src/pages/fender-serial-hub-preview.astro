<script is:inline>
  (function () {
    // Floating TOC: clone list into the mobile sheet, wire FAB
    var list = document.querySelector('#fshub-toc .fshub-toc__list');
    var body = document.getElementById('fshub-toc-sheet-body');
    if (list && body) body.appendChild(list.cloneNode(true));
    var fab = document.getElementById('fshub-toc-fab'),
        sheet = document.getElementById('fshub-toc-sheet'),
        closeBtn = document.getElementById('fshub-toc-sheet-close');
    function setOpen(o) { if (!sheet) return; sheet.classList.toggle('fshub-toc-sheet--open', o); if (fab) fab.setAttribute('aria-expanded', o ? 'true' : 'false'); }
    if (fab) fab.addEventListener('click', function () { setOpen(!sheet.classList.contains('fshub-toc-sheet--open')); });
    if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('click', function (e) { if (sheet && fab && !sheet.contains(e.target) && !fab.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
    if (sheet) sheet.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href="#locate"]');
      if (a) { var d = document.getElementById('locate'); if (d && d.tagName === 'DETAILS') d.open = true; }
    });
  })();
</script>
