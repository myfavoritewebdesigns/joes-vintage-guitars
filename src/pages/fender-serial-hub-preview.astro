---
/**
 * Fender Serial Number hub, CONDENSED REBUILD, preview build.
 *
 * Noindex + sitemap-excluded + X-Robots-Tag (see astro.config.mjs and
 * public/_headers), same pattern as /fender-serial-tool-v2/. Renders inside the
 * real Layout (site Header, Footer, FloatingCTAs, global JSON-LD) so Joe can see
 * exactly how the condensed page looks in production chrome before it swaps into
 * the live /fender-guitars-serial-number-guide/ route.
 *
 * Content facts trace to VG_FACTS.md (joes-vintage-databases) per the writing
 * system; new Joe-sourced facts land in that registry via PR #1 (VG-0113..0116).
 */
import Layout from "../layouts/Layout.astro";
import FenderSerialTool from "../components/tools/FenderSerialTool.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { resolveImage, assetSrc, ogCardSize } from "../lib/images";
import { contact, hrefs, SITE_URL } from "../config/site";

const meta = (file: string) => resolveImage("images/fender-sn/" + file)!;
const img = (file: string) => assetSrc("images/fender-sn/" + file);

// TODO(launch): this page is the condensed rebuild of /fender-guitars-serial-number-guide/.
// To go live, in ONE pass: (1) set PAGE_PATH to "/fender-guitars-serial-number-guide/"
// (PAGE_PATH is the single source for canonical + every schema self-reference below,
// so this one line flips them all); (2) set noIndex={false} on <Layout>; (3) strip
// " (Preview)" from the <Layout title>; (4) remove the .fshub-preview-note banner;
// (5) confirm `grep -rn "fender-serial-hub-preview" src/` returns nothing.
const PAGE_PATH = "/fender-serial-hub-preview/";

// ---- Chart data ----
const bridgeRows = [
  ["Telecaster / Esquire", "0001 to 1300", "1950 to 1952", "Broadcaster, No-Caster, and early Tele"],
  ["Telecaster", "1300 to 3000", "1951 to 1954", "Telecaster name established around mid-1951"],
  ["Telecaster", "3000 to 5000s", "1952 to 1954", "Transition toward the neck plate"],
  ["Precision Bass", "100 to 600", "1951 to 1952", "Earliest P-Basses, serial on the bridge"],
  ["Precision Bass", "0001 to 0900", "1952 to 1953", "Second P-Bass sequence"],
  ["Precision Bass", "0900 to 2000", "1954", "Redesign year approaching"],
];
const neckPlateRows = [
  ["0001 to 8000", "1954"], ["6000 to 10000", "1955"], ["9000 to 16000", "1956"],
  ["16000 to 25000", "1957"], ["25000 to 30000", "1958"], ["30000 to 40000", "1959"],
  ["40000 to 58000", "1960"], ["55000 to 72000", "1961"], ["72000 to 93000", "1962"],
  ["93000 to 99999", "1963"],
];
const lSeriesRows = [
  ["L00001 to L20000", "1963", "Pre-CBS"], ["L20000 to L55000", "1964", "Pre-CBS"],
  ["L55000 to L99999", "1965", "Transition to CBS"],
];
const fPlateRows = [
  ["100000 to 110000", "1965", "Transition"], ["110000 to 200000", "1966", "CBS"],
  ["180000 to 210000", "1967", "CBS"], ["210000 to 250000", "1968", "CBS"],
  ["250000 to 280000", "1969", "CBS"], ["280000 to 300000", "1970", "CBS"],
  ["300000 to 330000", "1971", "CBS"], ["330000 to 370000", "1972", "CBS"],
  ["370000 to 520000", "1973", "CBS"], ["500000 to 580000", "1974", "CBS"],
  ["580000 to 690000", "1975", "CBS"], ["690000 to 750000", "1976", "CBS"],
];
const modernRows = [
  ["76XXXXX", "1976", "Starts with 76, overlaps the early S prefix", "76XXXXX = 1976"],
  ["S + digit", "1970s", "S means the 70s, next digit is the year", "S8XXXXX = 1978"],
  ["E + digit", "1980s", "E means the 80s, next digit is the year", "E4XXXXX = 1984"],
  ["N + digit", "1990s", "N means the 90s, next digit is the year", "N2XXXXXX = 1992"],
  ["Z + digit", "2000s", "Z means the 2000s, next digit is the year", "Z2XXXXXX = 2002"],
  ["US + digits", "2010s onward", "First two digits after US are the year", "US10XXXXXX = 2010"],
];
const rare80sRows = [
  ["CA", "Gold Stratocasters, the limited-run gold-hardware Strat from the early 1980s"],
  ["CB", "Precision Bass Specials and Gold Jazz Basses, both active-electronics basses with gold hardware"],
  ["CE", "Precision Bass Specials and Black & Gold Telecasters, another limited CBS-era run"],
];
const customShopRows = [
  ["CN + digit", "C means Custom Shop, N means the 90s, and the next digit is the year", "1990s", "CN6XXXXX = 1996"],
  ["CZ + digit", "C means Custom Shop, Z means the 2000s, and the next digit is the year", "2000s", "CZ3XXXXX = 2003"],
  ["R + digits", "No reliable decode", "See the tip below", "No year encoded"],
];
const mexicoRows = [
  ["MN", "1990s", "M means Mexico, N means the 90s; next digit is the year. MN0 = 1990"],
  ["MZ", "2000s", "M means Mexico, Z means the 2000s; next digit is the year. MZ0 = 2000"],
  ["MX", "2010s to 20s", "The one or two digits after MX are the year. MX12 = 2012, MX23 = 2023"],
  ["JV / SQ", "Japan, 1982 to 1984", "The earliest Made in Japan export models"],
  ["JD", "Japan, 2010s", "Japan Dyna, first two digits are the year. JD11XXXXXX = 2011"],
];
const mijRows = [
  ["JV", "5", "1982 to 1984"], ["SQ", "5", "1983 to 1984"], ["A", "5", "mid-1980s"],
  ["B", "6", "1985 to 1986"], ["F", "6", "1986 to 1987"], ["G", "6", "1987 to 1988"], ["H", "6", "1988 to 1989"],
  ["I or J", "6", "1989 to 1990"], ["K", "6", "1990 to 1991"], ["L", "6", "1991 to 1992"],
  ["M", "6", "1992 to 1993"], ["O, P, or Q", "6", "1993 to 1994"], ["S or T", "6", "1994 to 1995"],
  ["U or N", "6", "1995 to 1996"], ["V", "6", "1996 to 1997"],
];
const cijRows = [
  ["A", "6", "1997 to 1998"], ["B", "6", "1997 to 1999"], ["O", "6", "1997 to 2000"],
  ["P", "6", "1999 to 2002"], ["Q", "6", "2002 to 2004"], ["R", "6", "2004 to 2005"],
  ["S", "6", "2006 to 2008"], ["T", "6", "2007 to 2010"], ["U", "6", "2010 to 2011"],
];

const spokeSlugs = [
  "/fender-pot-codes/", "/fender-neck-dates/", "/fender-body-dates/",
  "/fender-pickup-dates/", "/fender-physical-features/",
];

const tocItems: [string, string, number][] = [
  ["#lookup", "Serial Number Lookup", 2],
  ["#locate", "Where To Find Your Serial #", 2],
  ["#cross-check", "Cross-Check Dating Features", 2],
  ["#charts", "Serial Numbers By Year", 2],
  ["#bridge-plate", "Bridge Plate (1950 To 1954)", 3],
  ["#neck-plate-serials", "4 & 5 Digit Neck Plate (1954 To 1963)", 3],
  ["#l-series", "L-Series (1963 To 1965)", 3],
  ["#f-plate", "F-Plate (1965 To 1976)", 3],
  ["#v-prefix", "V-Prefix Reissues", 3],
  ["#custom-shop", "Custom Shop (CN, CZ, R)", 3],
  ["#headstock-serials", "Headstock (1976 To Present)", 3],
  ["#import-serials", "Made In Mexico & Japan", 3],
  ["#appraisal", "Free Expert Appraisal", 2],
  ["#next", "Once You Know The Year", 2],
  ["#about-joe", "About Joe", 2],
];

const faqs = [
  { q: "Where Exactly Is My Fender's Serial Number?", a: "One of six spots depending on the year: the neck plate, the front or back of the headstock, the bridge plate, or the neck heel. On 1954 Stratocasters only, it is stamped into the plastic tremolo cover." },
  { q: "Can The Serial Alone Tell Me The Exact Year?", a: "It gives a range, not a single year. Fender pulled plates from bins out of order, so ranges overlap. Confirm the exact year with the neck heel date and pot codes." },
  { q: "My Serial Isn't In Fender's Official Lookup. Is It Fake?", a: "Almost never. Fender's official lookup only covers recent production, and plenty of genuine vintage serials never match a tidy pattern. Cross-date it by hand instead." },
  { q: "Are Custom Shop R Numbers A Reliable Date?", a: "No. R doesn't stand for Relic or Reissue, and there's no reliable dating scheme for it. Reference the Certificate of Authenticity, or check the neck heel dates and pot codes." },
  { q: "Do You Appraise Or Buy Vintage Fenders?", a: "Both. Free appraisals, and I buy outright with same-day payment. Send me three photos and I'll tell you the real story." },
];

const YT_ID = "PIRoB0KHEg0";
const YT_TITLE = "Where to Find Fender Serial Numbers, Neck Heel Dates & Pot Codes (Identification Guide)";

// ---- Schema ----
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Fender Serial Number Lookup: Free Decoder & Dating Guide",
  description: "Decode any Fender serial number, then confirm the year with neck heel dates and pot codes. Free lookup plus year-by-year charts from a vintage Fender appraiser.",
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  image: `${SITE_URL}${img("fender-bridge-plate-serial-number-scaled.jpg")}`,
  datePublished: "2026-07-22",
  dateModified: "2026-07-22",
  inLanguage: "en-US",
  mainEntityOfPage: `${SITE_URL}${PAGE_PATH}`,
  hasPart: spokeSlugs.map((s) => ({ "@type": "WebPage", "@id": `${SITE_URL}${s}` })),
  video: { "@id": `${SITE_URL}${PAGE_PATH}#video` },
};
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${SITE_URL}${PAGE_PATH}#video`,
  name: YT_TITLE,
  description: "Learn how to locate and decode vintage Fender serial numbers, neck heel dates, and potentiometer date codes to accurately date your vintage guitar.",
  thumbnailUrl: `https://img.youtube.com/vi/${YT_ID}/maxresdefault.jpg`,
  uploadDate: "2026-01-13",
  embedUrl: `https://www.youtube.com/embed/${YT_ID}`,
  contentUrl: `https://www.youtube.com/watch?v=${YT_ID}`,
  author: { "@id": `${SITE_URL}/about-me/#person` },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Fender Serial Number Lookup Tool",
  description: "Free interactive tool to decode any Fender guitar or bass serial number.",
  url: `${SITE_URL}${PAGE_PATH}`,
  applicationCategory: "ReferenceApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Fender Serial Number Lookup", item: `${SITE_URL}${PAGE_PATH}` },
  ],
};
---

<Layout
  title="Fender Serial Number Lookup: Free Decoder & Dating Guide (Preview)"
  description="Decode any Fender serial number, then confirm the year with neck heel dates and pot codes. Free lookup plus year-by-year charts from a vintage Fender appraiser."
  canonical={PAGE_PATH}
  ogImage={`${SITE_URL}${img("fender-bridge-plate-serial-number-1024x683.jpg")}`}
  {...ogCardSize("images/fender-sn/fender-bridge-plate-serial-number-1024x683.jpg")}
  ogImageAlt="The bridge plate serial number on a 1952 Fender Telecaster"
  ogType="article"
  noIndex={true}
  structuredData={[articleSchema, videoSchema, faqSchema, toolSchema, breadcrumbSchema]}
>
  <link slot="head" rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
  <script slot="head" is:inline src="/scripts/lite-yt-embed.js" defer></script>

  <!-- Archetype B header backdrop: solid bands the absolute site Header sits on -->
  <div class="fshub-header-backdrop" aria-hidden="true">
    <div class="fshub-header-backdrop__dark"></div>
    <div class="fshub-header-backdrop__cream"></div>
  </div>

  <p class="fshub-preview-note">Internal preview of the condensed serial page rebuild. Noindexed and not linked. Spoke links point at planned slugs that do not exist yet.</p>

  <div class="fshub">
    <!-- BLOCK 1: HERO + TOOL -->
    <section class="hero" id="lookup">
      <div class="measure stack">
        <span class="eyebrow">Fender Serial Number Lookup</span>
        <h1>Fender Serial Number Lookup: Free Decoder &amp; Dating Guide</h1>
        <p class="lead">Type your serial for an instant read on era and factory. Most lookups stop there. This page tells you what the number can and cannot prove, then walks you through the cross-checks that confirm the year, the same way I do it at the bench.</p>
        <div class="trust">
          <span>Joe Dampt</span><span>12 years buying vintage Fenders full-time</span><span>10,000+ appraised</span><span>All 50 states</span>
        </div>

        <div class="toolplate">
          <span class="bolt tl"></span><span class="bolt tr"></span><span class="bolt bl"></span><span class="bolt br"></span>
          <FenderSerialTool tablesHref="#charts" />
        </div>

        <div class="plate plate--locate" role="group" aria-label="Serial number locations">
          <span class="bolt tl"></span><span class="bolt tr"></span><span class="bolt bl"></span><span class="bolt br"></span>
          <details class="locate" id="locate">
            <summary>I Need Help Finding My Serial Number</summary>
            <div class="locimg">
              <LicensedImage src={meta("fender-serial-number-locator-chart.jpg")} alt="Fender serial number locator chart showing the neck heel, headstock, neck plate, bridge plate, and tremolo cover locations" width={760} />
              <p class="cap">Six possible spots: the neck plate, the bridge plate, the front or back of the headstock, the neck heel, and, on 1954 Strats only, stamped into the plastic tremolo cover. Where it sits already narrows the era.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- BLOCK 2: E-E-A-T BADGES -->
    <section class="pt0">
      <div class="measure">
        <div class="badges">
          <div class="badge">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M2 8.5 6 12.5 14 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="t">Verified Vintage Fender Appraiser<small>Joe Dampt, Mesa AZ</small></span>
          </div>
          <div class="badge">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6z" fill="currentColor"/></svg></span>
            <span class="t">10,000+ Instruments Valued<small>Personally, over 12 years full-time</small></span>
          </div>
          <div class="badge">
            <span class="ic" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 3h12v8H9.2L6 13.8V11H2z" fill="currentColor"/></svg></span>
            <span class="t">2,100+ Five-Star Reverb Reviews<small>Verified buyer and seller feedback</small></span>
          </div>
        </div>
      </div>
    </section>

    <div class="rule"></div>

    <!-- BLOCK 3: CROSS-CHECK -->
    <section id="cross-check">
      <div class="measure stack">
        <span class="eyebrow">The Serial Number Is Just Part Of The Story</span>
        <h2>Cross-Check With Other Dating Features</h2>
        <p class="note-sm">A serial gets you close, but serial numbers are not 100% reliable, so you have to cross-check to land on an exact year. The parts pin down the real date. There are five ways in, and each one is a full step-by-step guide:</p>
        <div class="cards3">
          <a class="mcard" href="/fender-pot-codes/">
            <span class="num">Path 1: Electronics</span>
            <h3>Potentiometer Date Codes</h3>
            <p>Decode the EIA codes on your volume and tone pots. A pot code sets the earliest date your guitar could've been built, a strong cross-check against the serial.</p>
            <span class="go">Decode Pot Codes</span>
          </a>
          <a class="mcard" href="/fender-neck-dates/">
            <span class="num">Path 2: The Neck</span>
            <h3>Neck-Heel Date Stamps</h3>
            <p>Locate the handwritten pencil dates and rubber-stamped codes on the butt end of the neck, the most reliable single tell.</p>
            <span class="go">Read Neck Dates</span>
          </a>
          <a class="mcard" href="/fender-body-dates/">
            <span class="num">Path 3: The Body</span>
            <h3>Body Dates</h3>
            <p>Locate the date markings Fender left on the body itself and what they look like from era to era.</p>
            <span class="go">Read Body Dates</span>
          </a>
          <a class="mcard" href="/fender-pickup-dates/">
            <span class="num">Path 4: The Pickups</span>
            <h3>Pickup Date Codes</h3>
            <p>Read the date on the base of a pickup, then use the pickup's own build, the pole pieces, the bobbin color, and the coil wire, to place it in an era.</p>
            <span class="go">Read Pickup Dates</span>
          </a>
          <a class="mcard" href="/fender-physical-features/">
            <span class="num">Path 5: The Parts</span>
            <h3>Logos, Guards, Saddles And Tuners</h3>
            <p>Everything you can check without picking up a screwdriver. The headstock logo, the pickguard material, the bridge saddles, the tuners, and the fretboard inlays all changed at known points.</p>
            <span class="go">Date It By Its Parts</span>
          </a>
        </div>

        <div class="videopanel">
          <h3>Serial Number Not Giving You The Full Picture?</h3>
          <p>Vintage Fender serial numbers are notoriously non-sequential because factory workers grabbed plates out of mixed bins. To close in on the real build date, you need the secondary indicators on this page.</p>
          <div class="videowrap">
            <lite-youtube videoid={YT_ID} params="rel=0&modestbranding=1" title={YT_TITLE}></lite-youtube>
          </div>
          <p class="vcap">Watch Joe walk through where the serial lives, how to check the neck heel date, and how to read potentiometer codes.</p>
        </div>

        <p class="note-sm mt">No single one of these is the answer on its own. Read two or three and look for agreement, because a guitar whose neck date, pot codes, and parts all point at the same stretch of months is telling you something a serial number never can. If the guitar wears a custom color, the <a class="spoke" href="/post/fender-custom-color-authentication-guide/">finish itself</a> is worth reading too.</p>
      </div>
    </section>

    <div class="rule"></div>

    <!-- BLOCK 4: CHARTS -->
    <section id="charts">
      <div class="measure stack">
        <span class="eyebrow">The Full Charts</span>
        <h2>Fender Serial Numbers By Year</h2>
        <p class="note-sm">The complete year-by-year ranges, right on this page. Serial number ranges are estimates, and Fender production was rarely perfectly sequential. Treat them as a starting point, then confirm with the <a class="spoke" href="/fender-neck-dates/">neck heel date</a> and <a class="spoke" href="/fender-pot-codes/">pot codes</a> above.</p>
      </div>

      <div class="measure mt2">
        <h3 class="tbl" id="bridge-plate"><span class="tag">A</span> Bridge-Plate Serials</h3>
        <p class="sub">1950 to 1954</p>
        <p class="secintro">On Fender's earliest electric instruments, the serial was stamped right onto the bridge plate. That covers the original Broadcaster, No-Caster, Telecaster, Esquire, and early Precision Bass, the rarest and most valuable Fenders ever made. Dating one from the bridge plate serial alone is difficult, so cross-reference the <a class="spoke" href="/fender-neck-dates/">neck heel dates</a>, <a class="spoke" href="/fender-pot-codes/">pot codes</a>, and <a class="spoke" href="/fender-body-dates/">body dates</a>.</p>
        <div class="figrow">
          <figure class="sfig"><LicensedImage src={meta("fender-bridge-plate-serial-number-scaled.jpg")} alt="Fender Telecaster bridge plate serial number, 1950 to 1954" width={420} /><figcaption>Telecaster bridge plate, stamped where the strings anchor</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-precision-bass-bridge-plate-serial-number-scaled.jpg")} alt="Fender Precision Bass bridge plate serial number, 1951 to 1954" width={420} /><figcaption>Precision Bass bridge plate, its own sequence</figcaption></figure>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>Model</th><th>Serial range</th><th>Year</th><th>Production details</th></tr></thead>
          <tbody>{bridgeRows.map((r) => (<tr><td data-label="Model">{r[0]}</td><td data-label="Serial range" class="code">{r[1]}</td><td data-label="Year" class="yr">{r[2]}</td><td data-label="Details">{r[3]}</td></tr>))}</tbody>
        </table></div>

        <h3 class="tbl" id="neck-plate-serials"><span class="tag">B</span> 4 And 5 Digit Neck Plate Serial Numbers</h3>
        <p class="sub">1954 to 1963, no letter prefix</p>
        <p class="secintro">From the mid-1950s into the early 1960s, Fender stamped 4 and 5 digit serial numbers onto the metal neck plate. This window covers nearly every landmark model: the original Stratocaster (1954), Jazzmaster (1958), Jazz Bass (1960), and Jaguar (1962). Fender pre-stamped large batches of neck plates and pulled them off the stack in no particular order during assembly, so a guitar carrying serial 58,000 could legitimately be a 1960 or a 1961. The <a class="spoke" href="/fender-neck-dates/">neck heel pencil date</a> is far more reliable for pinning down a specific year.</p>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("1957-fender-esquire-blonde.jpg")} alt="1957 Fender Esquire blonde neck plate showing the serial number stamped at the top edge" width={540} /><figcaption>A 1957 Esquire, five digits stamped into the plate</figcaption></figure>
        </div>
        <div class="tablewrap compact"><table>
          <thead><tr><th>Serial range</th><th>Year</th></tr></thead>
          <tbody>{neckPlateRows.map((r) => (<tr><td data-label="Serial range" class="code">{r[0]}</td><td data-label="Year" class="yr">{r[1]}</td></tr>))}</tbody>
        </table></div>
        <div class="tip">
          <p>This 1960 Stratocaster carries its serial along the <b>bottom edge of the neck plate</b>. The location makes people doubt the serial is authentic, but Fender really did stamp some plates this way. I have watched original guitars get called fakes over exactly this.</p>
          <div class="tipimg"><LicensedImage src={meta("1960-fender-stratocaster-neck-plate-code.jpg")} alt="1960 Fender Stratocaster neck plate with the serial number stamped along the bottom edge" width={540} /></div>
        </div>

        <h3 class="tbl" id="l-series"><span class="tag">C</span> L-Series Transition Plates</h3>
        <p class="sub">1963 to 1965, capital L prefix</p>
        <p class="secintro">When Fender's sequential neck plate numbers got close to 99999, the factory tacked on an L prefix instead of rolling over to a 6 digit number. These guitars, built from late 1962 through 1965, cover the final years of the pre-CBS era and rank among the most collectible Fenders ever made. The L-Series straddles the CBS acquisition in January 1965, which means some L prefix instruments are true pre-CBS and others are early CBS.</p>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("fender-l-plate-serial-number-guide-1-scaled-1.jpg")} alt="Fender L-series neck plate serial number, 1963 to 1965" width={540} /><figcaption>The L stamp is the giveaway, still a pre-CBS guitar</figcaption></figure>
        </div>
        <div class="tablewrap compact"><table>
          <thead><tr><th>Serial range</th><th>Year</th><th>Era</th></tr></thead>
          <tbody>{lSeriesRows.map((r) => (<tr><td data-label="Serial range" class="code">{r[0]}</td><td data-label="Year" class="yr">{r[1]}</td><td data-label="Era">{r[2]}</td></tr>))}</tbody>
        </table></div>

        <h3 class="tbl" id="f-plate"><span class="tag">D</span> CBS 6-Digit F-Plates</h3>
        <p class="sub">1965 to 1976, embossed F on the plate</p>
        <p class="secintro">After the CBS acquisition in early 1965, Fender brought in a new neck plate with a large stylized F logo and a 6 digit serial number. This system stayed in place until 1976, when Fender moved serials to the headstock. F-plate guitars are easy to spot: big headstocks on the Strats from 1966 onward, CBS-era styling throughout, and models like the Thinline Telecaster and Coronado that only existed in this period.</p>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("1967-fender-f-plate-serial-number.jpg")} alt="Serial number 204663 on the F plate of a 1967 Fender" width={540} /><figcaption>A 1967 F plate, serial 204663 above the big F</figcaption></figure>
        </div>
        <div class="tablewrap compact"><table>
          <thead><tr><th>Serial range</th><th>Year</th><th>Era</th></tr></thead>
          <tbody>{fPlateRows.map((r) => (<tr><td data-label="Serial range" class="code">{r[0]}</td><td data-label="Year" class="yr">{r[1]}</td><td data-label="Era">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <p class="expert"><b>Serial numbers aren't always reliable, especially on vintage instruments.</b> Confirm the year with the <a class="spoke" href="/fender-neck-dates/">neck heel date</a> and <a class="spoke" href="/fender-pot-codes/">pot codes</a>, or send me photos below and I will confirm it for you.</p>

        <h3 class="tbl" id="v-prefix"><span class="tag">E</span> V-Prefix Serial Numbers</h3>
        <p class="sub">American Vintage reissues, 1982 onward</p>
        <p class="secintro">When Fender launched its Vintage Reissue series in 1982, faithful recreations of classic 1950s and 1960s Strats, Teles, and Precision Basses, it put a separate V prefix serial on the neck plate. These aren't vintage instruments. They're modern reissues built to replicate the original specs.</p>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("fender-v-prefix-serial-number-reissue-scaled.jpg")} alt="Fender V prefix serial number on the neck plate of a Vintage Reissue guitar" width={540} /><figcaption>V prefix on a Vintage Reissue neck plate</figcaption></figure>
        </div>
        <p class="expert"><b>V prefix numbers have no reliable dating scheme.</b> Date a V-prefix guitar by the <a class="spoke" href="/fender-neck-dates/">neck heel date</a>, usually written in pencil.</p>

        <h3 class="tbl" id="custom-shop"><span class="tag">F</span> Custom Shop Serial Numbers</h3>
        <p class="sub">CN, CZ, and R prefixes on the neck plate</p>
        <p class="secintro">The Fender Custom Shop, established in 1987, runs its own neck plate serial number system. Three prefixes show up most often, and one of them gets widely misunderstood across forums and listings.</p>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("fender-cn-prefix-serial-number.jpg")} alt="Fender Custom Shop CN prefix serial number on a neck plate" width={540} /><figcaption>CN prefix on a Custom Shop neck plate</figcaption></figure>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>Prefix</th><th>How to decode</th><th>Era</th><th>Example</th></tr></thead>
          <tbody>{customShopRows.map((r) => (<tr><td data-label="Prefix" class="code">{r[0]}</td><td data-label="How to decode" class={r[0].startsWith("R") ? "warntxt" : ""}>{r[1]}</td><td data-label="Era">{r[2]}</td><td data-label="Example" class="code">{r[3]}</td></tr>))}</tbody>
        </table></div>
        <div class="tip">
          <p><b>R doesn't stand for Relic, and it doesn't stand for Reissue.</b> That is one of the most repeated myths in Fender Custom Shop collecting, and even a circulating Fender customer service email gets it wrong. The R prefix turned up on Custom Shop instruments with no consistent logic behind its assignment, and there's no reliable dating scheme for it. To date or authenticate one, reference the COA, which lists the model, construction date, specs, and builder, or check the <a class="spoke" href="/fender-neck-dates/">neck heel dates</a> and <a class="spoke" href="/fender-pot-codes/">pot codes</a>. If a seller leans on R = Relic as a selling point, that's a red flag about the seller, not the guitar. Always ask for the COA.</p>
          <p class="tipafter">The COA below is the proof: an R prefix Custom Deluxe Stratocaster that's neither a Relic nor a Reissue.</p>
          <div class="tipimg"><LicensedImage src={meta("fender-coa-proving-r-prefix-unreliability.jpg")} alt="Fender Custom Shop COA for a Custom Deluxe Stratocaster with an R prefix serial. Not a Relic, not a Reissue." width={540} /></div>
        </div>

        <h3 class="tbl" id="headstock-serials"><span class="tag">G</span> Alphanumeric Headstock Decals</h3>
        <p class="sub">1976 to present</p>
        <p class="secintro">In 1976 Fender moved serial numbers off the neck plate and onto a headstock decal, where the letter encodes the decade and the digit after it encodes the year. Some guitars from the final months of 1976 carry S prefix headstock serials even though the neck plate was still in use on certain models. An F-plate paired with an S prefix headstock serial marks a transition-period instrument, so confirm with <a class="spoke" href="/fender-pot-codes/">pot codes</a> and <a class="spoke" href="/fender-neck-dates/">neck stamps</a>.</p>
        <div class="figrow">
          <figure class="sfig"><LicensedImage src={meta("fender-76-prefix-serial-number.jpg")} alt="Fender 76 prefix serial number on the front of the headstock, 1976" width={300} /><figcaption>76 prefix, 1976</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-s-prefix-serial-number.jpg")} alt="Fender S prefix serial number on the front of the headstock, 1970s" width={300} /><figcaption>S prefix, the 1970s</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-e-prefix-serial-number.jpg")} alt="Fender E prefix serial number on the front of the headstock, 1980s" width={300} /><figcaption>E prefix, the 1980s</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-n-prefix-serial-number.jpg")} alt="Fender N prefix serial number on the front of the headstock, 1990s" width={300} /><figcaption>N prefix, the 1990s</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-z-prefix-serial-number.jpg")} alt="Fender Z prefix serial number on the back of the headstock, 2000s" width={300} /><figcaption>Z prefix, the 2000s, back of the headstock</figcaption></figure>
          <figure class="sfig"><LicensedImage src={meta("fender-us-prefix-serial-number.jpg")} alt="Fender US prefix serial number on the back of the headstock, 2010s onward" width={300} /><figcaption>US prefix, 2010s onward, back of the headstock</figcaption></figure>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>Prefix</th><th>Decade</th><th>How to read it</th><th>Example</th></tr></thead>
          <tbody>{modernRows.map((r) => (<tr><td data-label="Prefix" class="code">{r[0]}</td><td data-label="Decade" class="yr">{r[1]}</td><td data-label="How to read it">{r[2]}</td><td data-label="Example" class="code">{r[3]}</td></tr>))}</tbody>
        </table></div>
        <h3 class="tbl sub-h">Rare 1980s Prefixes</h3>
        <p class="note-sm">A small number of limited-edition CBS-era models used two-letter prefixes starting with C instead of the standard E. They follow the same decode formula (the first digit after the prefix equals the year), but each one ties to specific collectible models:</p>
        <div class="tablewrap compact"><table>
          <thead><tr><th>Prefix</th><th>Ties to</th></tr></thead>
          <tbody>{rare80sRows.map((r) => (<tr><td data-label="Prefix" class="code">{r[0]}</td><td data-label="Ties to">{r[1]}</td></tr>))}</tbody>
        </table></div>
        <div class="figrow single">
          <figure class="sfig"><LicensedImage src={meta("fender-ca-prefix-serial-number.jpg")} alt="Fender CA prefix serial number on a limited edition Gold Stratocaster headstock, early 1980s" width={540} /><figcaption>CA prefix on a Gold Stratocaster, early 1980s</figcaption></figure>
        </div>

        <h3 class="tbl" id="import-serials"><span class="tag">H</span> Made In Mexico And Made In Japan Serial Numbers</h3>
        <p class="sub">MIM, MIJ, and CIJ</p>
        <p class="secintro">Mexican-built Fenders from the Ensenada plant start with M plus a decade letter, the same decade logic as the American serials. Japanese Fenders work differently: the letter corresponds to a production year range rather than a specific year digit, so it narrows the window instead of naming the year. The Crafted in Japan label replaced Made in Japan in the late 1990s, and the letter codes were reused between the two eras, so always read the Made in Japan or Crafted in Japan wording on the guitar, not just the letter. The earliest JV-series guitars, built from 1982 to 1984, are serious collector pieces in their own right.</p>
        <div class="figrow">
          <figure class="sfig"><img src={img("mn-prefix.jpg")} alt="MN prefix serial number on a Mexican Fender Stratocaster" loading="lazy" decoding="async" /><figcaption>MN prefix, Mexico in the 1990s</figcaption></figure>
          <figure class="sfig"><img src={img("mz-prefix.jpg")} alt="MZ prefix serial number on a Mexican Fender Jazz Bass" loading="lazy" decoding="async" /><figcaption>MZ prefix, Mexico in the 2000s</figcaption></figure>
        </div>
        <div class="tablewrap"><table>
          <thead><tr><th>Prefix</th><th>Made in</th><th>Formula</th></tr></thead>
          <tbody>{mexicoRows.map((r) => (<tr><td data-label="Prefix" class="code">{r[0]}</td><td data-label="Made in">{r[1]}</td><td data-label="Formula">{r[2]}</td></tr>))}</tbody>
        </table></div>
        <details class="more"><summary>Show The Complete Japan MIJ And CIJ Letter Codes</summary>
          <div class="japan-grid">
            <div class="tablewrap compact m0"><table>
              <caption>Made in Japan (MIJ)</caption>
              <thead><tr><th>Code</th><th>Digits</th><th>Year range</th></tr></thead>
              <tbody>{mijRows.map((r) => (<tr><td data-label="Code" class="code">{r[0]}</td><td data-label="Digits">{r[1]}</td><td data-label="Year range" class="yr">{r[2]}</td></tr>))}</tbody>
            </table></div>
            <div class="tablewrap compact m0"><table>
              <caption>Crafted in Japan (CIJ)</caption>
              <thead><tr><th>Code</th><th>Digits</th><th>Year range</th></tr></thead>
              <tbody>{cijRows.map((r) => (<tr><td data-label="Code" class="code">{r[0]}</td><td data-label="Digits">{r[1]}</td><td data-label="Year range" class="yr">{r[2]}</td></tr>))}</tbody>
            </table></div>
          </div>
        </details>
      </div>
    </section>

    <!-- BLOCK 5: APPRAISAL -->
