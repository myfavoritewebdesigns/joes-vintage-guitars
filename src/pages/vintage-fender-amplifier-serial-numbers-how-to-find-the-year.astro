    background: #fff;
    padding: 92px 0 80px;
    color: var(--color-brand-brown);
  }
  @media (max-width: 640px) {
    .fas-page { padding-top: 44px; }
  }
  .fas-inner {
    max-width: 1144px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .fas-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.4vw, 42px);
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 24px;
    line-height: 1.25;
  }

  /* ===== Date-code decoder tool ===== */
  .fas-tool {
    background: var(--color-brand-cream, #eedfc0);
    border: 1px solid #e0cfa9;
    border-radius: 12px;
    padding: 26px 28px 28px;
    margin: 0 0 40px;
    box-shadow: 0 8px 26px rgba(62, 42, 20, 0.1);
  }
  .fas-tool__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--color-brand-rust-dark, #682412);
    margin: 0 0 6px;
  }
  .fas-tool__sub {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-brand-brown-warm, #4a3a24);
    max-width: 62ch;
  }
  .fas-tool__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .fas-tool__body { grid-template-columns: 1fr; gap: 22px; }
  }
  .fas-tool__label {
    display: block;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-brand-brown, #3e2a14);
    margin-bottom: 8px;
  }
  .fas-tool__row { display: flex; gap: 10px; }
  .fas-tool__input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-brand-brown, #3e2a14);
    background: #fff;
    border: 2px solid #d2b48c;
    border-radius: 6px;
    padding: 12px 14px;
  }
  .fas-tool__input:focus {
    outline: none;
    border-color: var(--color-brand-rust-bright, #be4b25);
    box-shadow: 0 0 0 3px rgba(190, 75, 37, 0.22);
  }
  .fas-tool__btn {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-brand-rust, #a03a1e);
    border: none;
    border-radius: 6px;
    padding: 0 24px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .fas-tool__btn:hover { background: var(--color-brand-rust-dark, #682412); }
  .fas-tool__examples {
    margin: 12px 0 0;
    font-size: 13px;
    color: var(--color-brand-brown-muted, #7a6a52);
  }
  .fas-tool__ex {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    color: var(--color-brand-rust, #a03a1e);
    background: #fff;
    border: 1px solid #d9c8a6;
    border-radius: 4px;
    padding: 2px 8px;
    cursor: pointer;
  }
  .fas-tool__ex:hover { background: #fff8f0; border-color: var(--color-brand-rust, #a03a1e); }
  .fas-tool__result {
    margin-top: 16px;
    min-height: 1px;
    font-size: 16px;
    line-height: 1.5;
  }
  .fas-tool__result.is-ok {
    padding: 14px 16px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid #cfe3c4;
    color: var(--color-brand-brown, #3e2a14);
    font-size: 19px;
  }
  .fas-tool__result.is-error {
    padding: 12px 14px;
    border-radius: 6px;
    background: #f6e0da;
    border: 1px solid #e3b3a6;
    color: #842012;
    font-size: 14px;
  }
  .fas-tool__code {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.15em;
    background: var(--color-brand-rust-dark, #682412);
    color: #fff;
    padding: 2px 10px;
    border-radius: 4px;
    margin-right: 4px;
  }
  .fas-tool__figure { margin: 0; }
  .fas-tool__figure img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #d2b48c;
    display: block;
  }
  .fas-tool__figure figcaption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-brand-brown-warm, #4a3a24);
  }

  /* Collapsible TOC */
  .fas-toc {
    padding-bottom: clamp(32px, 4%, 72px);
  }
  .fas-toc summary {
    list-style: none;
    cursor: pointer;
  }
  .fas-toc summary::-webkit-details-marker { display: none; }
  .fas-toc__title {
    background-color: var(--color-brand-rust-dark, #682412);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 12px 28px;
    margin-bottom: 0;
    gap: 20px;
