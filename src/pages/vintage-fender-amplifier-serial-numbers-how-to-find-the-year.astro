    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 4px 18px rgba(62, 42, 20, 0.18);
  }

  /* Tube chart codes: two-column letter list next to the tube-chart photo */
  .fas-amplifier-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    padding: 30px 20px;
