---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/primitives/PageHero.astro";
import Button from "../components/primitives/Button.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";
import { contact, hrefs } from "../config/site";
import { stratocasterYearGuides } from "../data/stratocasterValueYears";
import strat1955Sunburst from "../assets/images/sell-fender/1956-fender-stratocaster-sunburst-800x533.jpg";
import strat1962Sunburst from "../assets/blog/1962-fender-stratocaster-authentication-guide/1962-fender-stratocaster-sunburst-8-scaled.jpg";
import strat1962Headstock from "../assets/blog/1962-fender-stratocaster-authentication-guide/1962-fender-stratocaster-sunburst-spaghetti-logo-headstock-scaled.jpg";
import strat1962SlabBoard from "../assets/blog/1962-fender-stratocaster-authentication-guide/1962-fender-stratocaster-slab-board-example.jpg";
import strat1964FiestaRed from "../assets/images/sell-fender/1964-fiesta-red-stratocaster-17-1-1024x683.jpg";
import strat1963Electronics from "../assets/blog/what-a-serial-number-cant-tell-you/1963-fender-stratocaster-electronics.jpg";
import strat1963Sunburst from "../assets/blog/what-a-serial-number-cant-tell-you/1963-fender-stratocaster-sunburst-front.jpg";
import strat1965CandyAppleRed from "../assets/blog/what-a-serial-number-cant-tell-you/1965-fender-stratocaster-candy-apple-red-front.jpg";
import strat1965SilverUndercoat from "../assets/blog/what-a-serial-number-cant-tell-you/1965-fender-stratocaster-candy-apple-red-chip-silver-undercoat.jpg";

const canonicalUrl = "https://www.joesvintageguitarsaz.com/vintage-fender-stratocaster-value-guide/";
const articleDescription = "2026 Fender Stratocaster price guide with $12,000 to $220,000 values for 1954 to 1965 guitars by year, finish, condition, and originality.";
const articleImage = "https://www.joesvintageguitarsaz.com/images/og/vintage-fender-stratocaster-value-guide-v2.png";

const structuredData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://www.joesvintageguitarsaz.com/" },
      { "@type": "ListItem", position: 2, name: "Vintage Fender Stratocaster Value Guide", item: canonicalUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Vintage Fender Stratocaster Value Guide",
    description: articleDescription,
    image: articleImage,
    datePublished: "2026-06-09",
    dateModified: "2026-09-18",
    inLanguage: "en-US",
    author: { "@id": "https://www.joesvintageguitarsaz.com/about-me/#person" },
    publisher: { "@id": "https://www.joesvintageguitarsaz.com/" },
    mainEntityOfPage: canonicalUrl,
    about: [
      { "@type": "Thing", name: "Vintage Fender Stratocaster" },
      { "@type": "Thing", name: "Pre-CBS Fender guitars" },
      { "@type": "Thing", name: "Vintage guitar appraisal" },
    ],
  },
];

const drivers = [
  {
    t: "Year of Manufacture",
    b: "Earlier guitars bring the most. The 1954 debut year is the top of the market, but the neck, body, electronics, and hardware all need to agree with the claimed year.",
    image: strat1962Headstock,
    alt: "Small headstock and spaghetti logo on a 1962 Fender Stratocaster",
    caption: "A 1962 small headstock with the thin spaghetti logo.",
  },
  {
    t: "Color & Finish",
    b: "Sunburst was standard. Factory custom colors are scarcer, and the rarest original finishes can be worth more than twice a sunburst from the same year.",
    image: strat1964FiestaRed,
    alt: "Original 1964 Fender Stratocaster in Fiesta Red with its case",
    caption: "An original 1964 Fiesta Red Stratocaster.",
  },
  {
    t: "Originality",
    b: "Pickups, solder, pots, pickguard, tuners, bridge, and plastics all matter. One changed part does not make the guitar worthless, but every change has to be identified and priced honestly.",
    image: strat1963Electronics,
    alt: "Original pickups, wiring, pots, and pickguard on a 1963 Fender Stratocaster",
    caption: "The underside tells the story: pickups, pots, wiring, and solder.",
  },
  {
    t: "Condition",
    b: "Clean examples sit at the top, but honest play wear is not the same as damage. Structural repairs, overspray, extra routes, and an altered neck affect value more than ordinary checking and buckle wear.",
    image: strat1963Sunburst,
    alt: "Heavily played 1963 Fender Stratocaster in three-color sunburst",
    caption: "Honest wear on a 1963 Stratocaster can still be desirable.",
  },
];

const prices = stratocasterYearGuides.flatMap((guide) => guide.year === "1965"
  ? [
      { era: "1965, early small headstock", year: guide.year, sunburst: "$14,000 to $22,000", custom: "$18,000 to $44,000" },
      { era: "1965, late large headstock", year: guide.year, sunburst: "$12,000 to $20,000", custom: "$16,000 to $36,000" },
    ]
  : [{ era: guide.year === "1954" ? "1954, first year" : guide.year, year: guide.year, sunburst: guide.standardRange, custom: guide.customRange }]
);

const conditionBands = [
  { condition: "Excellent and all original", adjustment: "Use the headline range", detail: "Original finish, major parts, coherent dates, no structural changes, and the original case." },
  { condition: "Very good and largely original", adjustment: "About 75% to 90%", detail: "Honest wear, a professional refret, or minor reversible service work, with the finish and major parts intact." },
  { condition: "Professional refinish", adjustment: "Often about 45% to 60%", detail: "The result depends on the remaining original parts, quality of the work, and whether the body was altered." },
  { condition: "Major parts mismatch", adjustment: "Price component by component", detail: "Replacement neck or body, extra routes, mixed-year parts, or an assembled partscaster." },
];

const customColorTiers = [
  { tier: "Baseline", colors: "Two-color or three-color sunburst", effect: "Use the year table as the starting point." },
  { tier: "Frequent custom colors", colors: "Olympic White, Candy Apple Red, Lake Placid Blue", effect: "Often a meaningful premium when the factory finish is convincingly original." },
  { tier: "Scarce custom colors", colors: "Fiesta Red, Sonic Blue, Daphne Blue, Burgundy Mist, Shoreline Gold", effect: "Usually a stronger premium, but year, condition, and evidence still control the price." },
  { tier: "Exceptional", colors: "Shell Pink, Sherwood Green, Foam Green, unusual gold hardware", effect: "Authenticate and appraise individually; there is no safe fixed multiplier." },
];

const photoTimeline = [
  { label: "1954 to 1958", marker: "Maple neck and eight-screw guard", image: strat1955Sunburst, alt: "1955 Fender Stratocaster with maple neck and sunburst finish", caption: "A real 1955 Stratocaster shows the small headstock, one-piece maple neck, and mid-1950s appearance." },
  { label: "1959 to Aug. 1962", marker: "Thick slab rosewood board", image: strat1962SlabBoard, alt: "Thick slab rosewood fingerboard on a 1962 Fender Stratocaster", caption: "The thick slab board is easy to see at the nut and helps separate this period from later veneer boards." },
  { label: "1963 to mid-1964", marker: "L-series and veneer-board period", image: strat1963Sunburst, alt: "1963 Fender Stratocaster in sunburst", caption: "A 1963 sunburst Stratocaster from the L-series era, when small construction details matter more than the serial alone." },
  { label: "1965 transition", marker: "Early and late specifications", image: strat1965CandyAppleRed, alt: "1965 Fender Stratocaster in Candy Apple Red", caption: "A 1965 custom-color example must be classified by headstock, plate, guard, dates, and finish evidence." },
];

const appraisalExamples = [
  { year: "1962 sunburst", image: strat1962Sunburst, alt: "Original 1962 Fender Stratocaster in its case", summary: "Start with the 1962 sunburst range. Confirm the slab or veneer board transition, neck date, pots, pickups, solder, guard, and finish before moving within that band." },
  { year: "1964 Fiesta Red", image: strat1964FiestaRed, alt: "Original 1964 Fiesta Red Fender Stratocaster", summary: "First authenticate the Fiesta Red finish. If the L-series details, transition-era features, dates, and original parts agree, the scarce-color tier can justify a stronger premium than a routine custom color." },
  { year: "1965 Candy Apple Red", image: strat1965CandyAppleRed, alt: "Original 1965 Candy Apple Red Fender Stratocaster", summary: "Classify it as early, mid-year, or late 1965 before pricing it. Then verify the metallic undercoat, protected paint, guard material, plate style, headstock, and component dates." },
];

const dating = [
  "Serial on the bridge plate: roughly 1950 to 1954",
  "Serial on the neck plate: roughly 1954 to 1963",
  "Neck plate with an ‘L’ prefix: 1963 to 1965",
  "Neck plate, 6-digit number with a large ‘F’ logo: 1965 to 1976",
  "Serial on the headstock: 1977 to present",
  "Neck plate starting with ‘V’: 1982 and later (American Vintage reissues)",
];

const valueLosses = [
  { issue: "Refinished body or neck", effect: "Usually the largest single deduction. A full refinish can bring a guitar to roughly half the value of a comparable original-finish example." },
  { issue: "Changed pickups or disturbed solder", effect: "Original pickups and untouched connections carry a large share of a pre-CBS Stratocaster’s collector value." },
  { issue: "Extra body routes or wood removal", effect: "Permanent modification is more serious than a reversible hardware change because the original body cannot be restored." },
  { issue: "Replacement neck, body, or assembled parts", effect: "A guitar assembled from genuine vintage parts is a partscaster, not an all-original example, and should be valued component by component." },
  { issue: "Replaced pickguard, tuners, bridge, or plastics", effect: "The deduction depends on the part, its rarity, and whether the original part stays with the guitar." },
  { issue: "Professional refret or normal maintenance", effect: "Good maintenance can preserve playability. It normally hurts less than a refinish, structural damage, or non-original electronics." },
];

const faqs = [
  { q: "How much is a vintage Fender Stratocaster worth?", a: "It depends on the year, finish, and originality. An all-original 1954 to 1965 sunburst Stratocaster runs from about $12,000 to $220,000, and original custom-color finishes can be worth more than twice a sunburst from the same year." },
  { q: "What year Stratocaster is the most valuable?", a: "The 1954 debut year sits at the top of the market, and pre-CBS examples made before early 1965 bring the most. Values step down year by year from 1954, and a rare original custom color can outrun any sunburst of the same year." },
  { q: "How do I tell what year my Stratocaster is?", a: "Read the guitar before you read the serial. The headstock size and the logo put a Strat in a five-year window on sight, then the fingerboard, the dots, and the pickguard screw count narrow it to a year or two. My <a href=\"/fender-stratocaster-dating-guide/\">Stratocaster dating guide</a> runs all of it year by year. Confirm the answer with the neck date and pot codes, and run the number itself through my <a href=\"/fender-guitars-serial-number-guide/\">Fender serial number guide</a>." },
  { q: "Does a refinish or replaced parts hurt the value?", a: "Yes. A refinish can reduce a Stratocaster's value substantially, often by about half when compared with an equivalent all-original example. Replaced pickups, modified wiring, extra routes, tuners, pickguards, and other changed parts also affect value, but the deduction depends on the part, the quality of the work, and whether the original part is included." },
  { q: "What is a pre-CBS Stratocaster?", a: "Pre-CBS means a Stratocaster built before CBS bought Fender in early 1965. Collectors prize the pre-CBS years for their materials and build quality, and those guitars sit at the top of the value range." },
  { q: "Can a Fender serial number tell me what my Stratocaster is worth?", a: "No. A serial number can narrow the production period, but vintage Fender numbers overlap and they sit on replaceable parts. Value also depends on the finish, pickups, wiring, neck and body dates, hardware, condition, repairs, and whether the parts belong together." },
  { q: "Should I restore or clean a vintage Stratocaster before an appraisal?", a: "Do not refinish it, replace parts, or aggressively clean aged hardware before an expert sees it. Keep every loose part, screw, cover, receipt, and case item with the guitar. Reversible setup work is different from restoration, but document anything that has been done." },
  { q: "What photos do I need for a Stratocaster appraisal?", a: "Start with the full front and back, both sides of the headstock, the neck plate and serial number, pickups, bridge, controls, tuners, case, and every loose part. Do not remove the neck or pickguard unless you already know how to do it safely; clear exterior photos are enough to begin." },
];

// FAQPage schema mirrors the visible <FAQ> above. stripTags keeps the JSON-LD
// answer text plain even when an answer carries inline HTML (e.g. a link).
const stripTags = (s: string) => s.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: stripTags(f.a) },
  })),
};
structuredData.push(faqSchema);
---

<Layout
  title="Vintage Fender Stratocaster Value Guide (1954–1965)"
  description={articleDescription}
  canonical="/vintage-fender-stratocaster-value-guide/"
  ogImage={articleImage}
  ogImageAlt="Vintage Fender Stratocaster value guide covering pre-CBS guitars made from 1954 to 1965"
  structuredData={structuredData}
>
  <PageHero
    eyebrow="Value Guide"
    title="Vintage Fender Stratocaster Value Guide"
    subhead="2026 price ranges for 1954 to 1965 Stratocasters, plus the finish, originality, and condition details that move the number."
    subheadTag="p"
    subheadHtml={true}
    bgImage="/images/hero-background.jpg"
  >
    <Button slot="cta" href={hrefs.tel} variant="cream" size="lg">{contact.phone}</Button>
    <Button slot="cta" href="/free-appraisal/fender/" variant="cream" size="lg">Fender Appraisal</Button>
  </PageHero>

  <section class="vg-section" id="quick-answer">
    <div class="vg-inner vg-intro">
      <div class="vg-intro__copy">
        <p class="vg-eyebrow">The short answer</p>
        <h2 class="vg-head">How Much Is a Vintage Fender Stratocaster Worth?</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p class="vg-lede">
          An all-original 1954 to 1965 Fender Stratocaster in excellent condition can be worth about
          <strong>$12,000 to $220,000</strong>. Original custom colors can bring substantially more than
          sunburst, while a refinish, changed pickups, extra body routes, or assembled parts can cut the number
          dramatically.
        </p>
        <p>
          That spread is wide because a first-year 1954 Stratocaster and a late-1965 transition guitar do not
          occupy the same market. Start with the year, then verify the finish, parts, condition, and case before
          treating any price as meaningful. For an exact figure on your guitar,{" "}
          <a href="/free-appraisal/fender/">get a free Fender appraisal</a> and I’ll give you a straight answer.
        </p>
        <div class="vg-byline">
          <strong>Written and reviewed by <a href="/about-me/">Joe Dampt</a></strong>
          <span>Vintage guitar appraiser and buyer · 10,000+ instruments personally appraised</span>
          <span>Originally published June 9, 2026 · Updated September 18, 2026</span>
        </div>
        <nav class="vg-toc" aria-label="On this page">
          <strong>On this page</strong>
          <ul>
            <li><a href="#price-table">Values by year</a></li>
            <li><a href="#methodology">How values are built</a></li>
            <li><a href="#value-factors">What drives value</a></li>
            <li><a href="#custom-colors">Custom colors</a></li>
            <li><a href="#visual-timeline">Photo comparison</a></li>
            <li><a href="#cbs-values">1966 to 1981 CBS years</a></li>
            <li><a href="#deductions">Value deductions</a></li>
            <li><a href="#worked-examples">Worked examples</a></li>
          </ul>
        </nav>
      </div>
      <figure class="vg-feature">
        <LicensedImage
          src={strat1962Sunburst}
          alt="Original 1962 Fender Stratocaster in three-color sunburst resting in its case"
          width={1200}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          sizes="(max-width: 820px) 100vw, 48vw"
        />
        <figcaption>
          An original 1962 Stratocaster in three-color sunburst. The year, finish, parts, wear, and original case
          all contribute to its value.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="price-table">
    <div class="vg-inner">
      <p class="vg-eyebrow">Quick price guide</p>
      <h2 class="vg-head">Vintage Fender Stratocaster Values by Year (1954 to 1965)</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        These are current retail-value estimates for excellent, all-original guitars with the original case.
        Select a year to see its specifications, condition-dollar bands, authentication checks, and appraisal method.
      </p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of vintage Stratocaster values by year">
        <table class="vg-table">
          <caption>Estimated 2026 market values for excellent, all-original Fender Stratocasters with the original case</caption>
          <thead><tr><th>Year</th><th>Sunburst</th><th>Custom Color</th></tr></thead>
          <tbody>
            {prices.map((p) => (
              <tr>
                <th scope="row"><a href={`/vintage-fender-stratocaster-value-guide/${p.year}/`}>{p.era}</a></th>
                <td>{p.sunburst}</td>
                <td>{p.custom}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="vg-note vg-note--years">
        The year is only the starting point. Confirm the finish, neck, body, electronics, hardware, repairs, and case before applying a headline range.
        Read the <a href="/post/fender-custom-color-authentication-guide/">Fender custom-color authentication guide</a> before adding a finish premium.
      </p>
    </div>
  </section>

  <section class="vg-section" id="value-factors">
    <div class="vg-inner">
      <h2 class="vg-head">What Drives a Vintage Stratocaster’s Value?</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        I evaluate these in the same order every time: establish the production period, authenticate the finish,
        inventory the original parts, and then judge condition. A serial number is evidence, but it is never the
        appraisal by itself.
      </p>
      <div class="vg-grid">
        {drivers.map((d) => (
          <article class="vg-card">
            <figure class="vg-card__figure">
              <LicensedImage src={d.image} alt={d.alt} width={620} loading="lazy" decoding="async" sizes="(max-width: 640px) 100vw, 25vw" />
              <figcaption>{d.caption}</figcaption>
            </figure>
            <h3 set:html={d.t} />
            <p set:html={d.b} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="condition-adjustments">
    <div class="vg-inner">
      <h2 class="vg-head">Vintage Stratocaster Condition Adjustments</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        The headline ranges assume an excellent, all-original guitar. Use these broad bands only after matching the
        instrument to its correct year and finish. A changed part is not automatically the same as a refinish or a replacement body.
      </p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of vintage Stratocaster condition adjustments">
        <table class="vg-table vg-table--conditions">
          <caption>Broad condition and originality adjustments for vintage Fender Stratocasters</caption>
          <thead><tr><th>Condition</th><th>Adjustment</th><th>What It Assumes</th></tr></thead>
          <tbody>
            {conditionBands.map((row) => (
              <tr><th scope="row">{row.condition}</th><td><strong>{row.adjustment}</strong></td><td>{row.detail}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="vg-section vg-section--dark" id="methodology">
    <div class="vg-inner">
      <p class="vg-eyebrow vg-eyebrow--light">Transparent valuation</p>
      <h2 class="vg-head vg-head--light">How These Stratocaster Values Were Built</h2>
      <div class="vg-rule vg-rule--light" aria-hidden="true"></div>
      <p class="vg-section-intro vg-section-intro--light">
        A useful guide should show its method, not just publish a number. I combine firsthand appraisal experience
        with comparable market evidence, then normalize every comparison for year, finish, originality, and condition.
      </p>
      <div class="vg-method-grid">
        <article><strong>Completed sales before asking prices</strong><p>Public asking prices show seller expectations. Completed comparable transactions carry more weight when the guitar and sale conditions are genuinely comparable.</p></article>
        <article><strong>Firsthand inspection</strong><p>My baseline also reflects more than 10,000 instruments personally appraised, including the real Stratocasters and internal details photographed throughout this guide.</p></article>
        <article><strong>Like-for-like normalization</strong><p>I separate year, finish, originality, condition, repairs, case, and provenance instead of averaging clean originals with refinishes or mixed-part guitars.</p></article>
        <article><strong>Outliers kept out of the baseline</strong><p>Celebrity ownership, exceptional provenance, charity auctions, and bidding contests can be real results without representing the ordinary market.</p></article>
      </div>
      <p class="vg-method-note">
        Values were reviewed September 18, 2026. They are retail estimates for market orientation, not guaranteed sale prices,
        insurance replacement values, or automatic cash offers.
      </p>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="custom-colors">
    <div class="vg-inner vg-split">
      <div>
        <p class="vg-eyebrow">Finish and color</p>
        <h2 class="vg-head">Why Original Custom Colors Change the Price</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p>
          Sunburst was the standard Stratocaster finish. A factory custom color was the exception, so collectors
          pay for scarcity, but only when the finish is original. Fiesta Red, Candy Apple Red, Olympic White, Lake
          Placid Blue, and less common period colors do not all carry the same premium.
        </p>
        <p>
          Color names alone are not authentication. I look for the paint process used in that period: wear into
          the right undercoat, paint-stick shadows or nail holes where appropriate, finish in the cavities, the
          way checking crosses the surface, and whether the neck pocket tells the same story as the visible body.
          See the full <a href="/post/fender-custom-color-authentication-guide/">Fender custom-color authentication guide</a>.
        </p>
        <p>
          A convincing refinish can still be a good guitar. It simply belongs in a different price category from
          an untouched factory custom color.
        </p>
      </div>
      <div class="vg-photo-grid">
        <figure>
          <LicensedImage
            src={strat1965CandyAppleRed}
            alt="1965 Fender Stratocaster in original Candy Apple Red finish"
            width={900}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 820px) 100vw, 25vw"
          />
          <figcaption>An original 1965 Candy Apple Red finish.</figcaption>
        </figure>
        <figure>
          <LicensedImage
            src={strat1965SilverUndercoat}
            alt="Finish chip on a 1965 Candy Apple Red Fender Stratocaster revealing the silver undercoat"
            width={900}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 820px) 100vw, 25vw"
          />
          <figcaption>A small chip reveals the metallic silver undercoat beneath Candy Apple Red.</figcaption>
        </figure>
      </div>
    </div>
    <div class="vg-inner vg-color-table">
      <h3 class="vg-subhead">Custom-Color Scarcity Tiers</h3>
      <p class="vg-section-intro">
        This hierarchy is a starting point, not a price formula. A clean, fully documented frequent color can be worth
        more than a scarce color with weak finish evidence, changed parts, or structural damage.
      </p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of Fender custom-color scarcity tiers">
        <table class="vg-table">
          <caption>General pre-CBS Fender Stratocaster finish hierarchy</caption>
          <thead><tr><th>Tier</th><th>Typical Finishes</th><th>How It Affects Value</th></tr></thead>
          <tbody>
            {customColorTiers.map((row) => (
              <tr><th scope="row">{row.tier}</th><td>{row.colors}</td><td>{row.effect}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="vg-section" id="identify">
    <div class="vg-inner vg-split vg-split--identify">
      <div>
        <p class="vg-eyebrow">Date it before you price it</p>
        <h2 class="vg-head">Fender Stratocaster Value by Serial Number</h2>
        <div class="vg-rule" aria-hidden="true"></div>
        <p>
          A serial number helps place a Stratocaster in the right production window, but it does not determine value by itself.
          “Pre-CBS” usually means a Stratocaster built before CBS took control of Fender in early 1965. The market
          treats 1965 as a transition year, so the physical specification matters more than the calendar label.
          A small headstock, spaghetti or transition logo, clay dots, L-series plate, period pickguard, and matching
          component dates help place the guitar accurately.
        </p>
        <p>
          Every value in the table turns on the production period. The quickest visible check is the headstock:
          the small outline continues through 1965, while the larger CBS shape arrives late that year. The fingerboard
          is another strong clue: a thick slab rosewood board runs from 1959 to mid-1962, followed by a thinner veneer board.
        </p>
        <p>Serial-number location narrows the era, but it does not prove it:</p>
        <ul class="vg-list">
          {dating.map((d) => <li set:html={d}></li>)}
        </ul>
      </div>
      <figure class="vg-feature vg-feature--detail">
        <LicensedImage
          src={strat1962SlabBoard}
          alt="Thick slab rosewood fingerboard on a 1962 Fender Stratocaster"
          width={1000}
          loading="lazy"
          decoding="async"
          sizes="(max-width: 820px) 100vw, 42vw"
        />
        <figcaption>
          The thick rosewood slab board at the nut is one of the defining 1959 to mid-1962 Stratocaster features.
        </figcaption>
      </figure>
    </div>
    <div class="vg-inner vg-guide-box">
      <h3>Cross-check the whole guitar</h3>
      <div class="vg-guide-links">
        <a href="/fender-stratocaster-dating-guide/"><strong>Stratocaster dating guide</strong><span>Year-by-year body, neck, logo, guard, and pickup changes</span></a>
        <a href="/fender-guitars-serial-number-guide/"><strong>Fender serial numbers</strong><span>Decode the number and understand the overlapping ranges</span></a>
        <a href="/fender-neck-dates/"><strong>Neck dates</strong><span>Pencil dates, ink stamps, and neck-heel formats</span></a>
        <a href="/fender-body-dates/"><strong>Body dates</strong><span>Where Fender hid dates in routes and cavities</span></a>
        <a href="/fender-pot-codes/"><strong>Pot codes</strong><span>Read manufacturer and week-year EIA codes</span></a>
        <a href="/fender-pickup-dates/"><strong>Pickup dates</strong><span>Pencil, ink, bobbin, and construction clues</span></a>
      </div>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="visual-timeline">
    <div class="vg-inner">
      <p class="vg-eyebrow">Annotated photo comparison</p>
      <h2 class="vg-head">Four Visual Eras of the Pre-CBS Stratocaster</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        These real guitars show how the model changes across the period. Use the label on each photo as a visual
        checkpoint, then confirm the date with the internal evidence. No outside feature authenticates a guitar by itself.
      </p>
      <div class="vg-timeline-grid">
        {photoTimeline.map((item) => (
          <figure class="vg-timeline-card">
            <div class="vg-timeline-card__image">
              <LicensedImage src={item.image} alt={item.alt} width={720} loading="lazy" decoding="async" sizes="(max-width: 680px) 100vw, 25vw" />
              <span>{item.label}</span>
            </div>
            <figcaption><strong>{item.marker}</strong>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="vg-section" id="cbs-values">
    <div class="vg-inner">
      <p class="vg-eyebrow">Later vintage Strats</p>
      <h2 class="vg-head">1966 to 1981 CBS-Era Stratocaster Values</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        Do not carry the pre-CBS table forward to a 1970 or 1976 Stratocaster. CBS-era guitars occupy a different market,
        and value depends on the exact year, finish, originality, weight, pickups, neck, routing, hardware, and case.
        The serial number establishes a window; it does not establish the price.
      </p>
      <div class="vg-cbs-grid">
        <article><h3>1966 to 1971</h3><p>Large headstock, transition details, four-bolt neck construction, and late-1960s pickup and finish changes. Earlier, cleaner examples generally receive the strongest CBS-era interest.</p></article>
        <article><h3>1972 to 1976</h3><p>Three-bolt necks, bullet truss rods, die-cast bridges, and changing finishes define this period. A 1976 Stratocaster must be compared with guitars of the same specification rather than with a pre-CBS example.</p></article>
        <article><h3>1977 to 1981</h3><p>The serial moves to the headstock, but overlapping prefixes still require component dates and physical features. Weight, routing, finish, pickups, and originality create a wide spread.</p></article>
      </div>
      <p class="vg-note vg-note--years">
        Start with the <a href="/fender-stratocaster-dating-guide/">year-by-year Stratocaster dating guide</a> and
        <a href="/fender-guitars-serial-number-guide/">Fender serial number guide</a>. For a current figure on a specific CBS-era guitar,
        <a href="/free-appraisal/fender/">request a free Fender appraisal</a> rather than borrowing a pre-CBS range.
      </p>
    </div>
  </section>

  <section class="vg-section" id="deductions">
    <div class="vg-inner">
      <h2 class="vg-head">What Lowers a Vintage Stratocaster’s Value?</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        The biggest deductions come from changes that remove original material or make the guitar’s history hard to
        verify. Ordinary play wear is visible; replaced wood, finish, and electronics change what the guitar actually is.
      </p>
      <div class="vg-table-wrap" tabindex="0" aria-label="Scrollable table of issues that lower vintage Stratocaster value">
        <table class="vg-table vg-table--deductions">
          <caption>Common originality and condition issues that affect vintage Fender Stratocaster values</caption>
          <thead><tr><th>Issue</th><th>Why It Matters</th></tr></thead>
          <tbody>
            {valueLosses.map((row) => (
              <tr><th scope="row">{row.issue}</th><td>{row.effect}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="vg-note vg-note--years">
        Keep every removed part with the guitar. An original pickup, guard, tuner, bridge cover, tremolo arm, or case
        still has value even if it is no longer installed.
      </p>
    </div>
  </section>

  <section class="vg-section" id="appraisal-process">
    <div class="vg-inner">
      <p class="vg-eyebrow">Joe’s appraisal process</p>
      <h2 class="vg-head">How I Estimate the Value of a Vintage Stratocaster</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        A useful appraisal has to explain the number. I do not price a vintage Fender from the serial plate alone;
        I build the answer from independent details that should agree with one another.
      </p>
      <ol class="vg-steps">
        <li><span>01</span><div><strong>Identify the year and production period</strong><p>Serial range, neck date, body date, pot codes, pickup dates, headstock, fingerboard, logo, and hardware should tell one consistent story.</p></div></li>
        <li><span>02</span><div><strong>Authenticate the finish and color</strong><p>I separate standard sunburst, genuine factory custom colors, overspray, touch-up, and full refinishes before applying any color premium.</p></div></li>
        <li><span>03</span><div><strong>Inventory the original parts</strong><p>Pickups, pots, solder, pickguard, tuners, bridge, saddles, knobs, switch, jack, neck, and body all affect the result.</p></div></li>
        <li><span>04</span><div><strong>Grade condition and repairs</strong><p>Honest wear, refrets, cracks, extra routes, structural work, and replaced parts do not carry the same deduction.</p></div></li>
        <li><span>05</span><div><strong>Compare the correct market</strong><p>I compare the guitar with examples of the same year band, finish, originality, and condition, not simply the highest asking price online.</p></div></li>
      </ol>
      <aside class="vg-cta-panel">
        <div>
          <strong>Want the number for your guitar?</strong>
          <span>Send clear photos for a free, no-obligation appraisal. You do not need to take the guitar apart to get started.</span>
        </div>
        <a href="/free-appraisal/fender/">Request a Free Fender Appraisal</a>
      </aside>
    </div>
  </section>

  <section class="vg-section vg-section--alt" id="worked-examples">
    <div class="vg-inner">
      <p class="vg-eyebrow">The method in practice</p>
      <h2 class="vg-head">Three Worked Stratocaster Appraisal Examples</h2>
      <div class="vg-rule" aria-hidden="true"></div>
      <p class="vg-section-intro">
        These examples use real guitars photographed for this site to show the reasoning process. They are illustrative
        appraisals, not claimed public sale records, and no value is assigned until the internal evidence is reviewed.
      </p>
      <div class="vg-example-grid">
        {appraisalExamples.map((example) => (
          <article class="vg-example-card">
