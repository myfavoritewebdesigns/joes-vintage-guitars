---
import Layout from "../../layouts/Layout.astro";
import BlogArchive from "../../components/BlogArchive.astro";
import { SITE_URL } from "../../config/site";
import { getPublishedPosts, getCategories, paginate } from "../../lib/blog";

const allPosts = await getPublishedPosts();
const categories = getCategories(allPosts);
const pages = paginate(allPosts);
const posts = pages[0];
const total = pages.length;

const HEADING = "Vintage Guitar Resource Center: Authentication & Selling Guides";
const INTRO =
  "Model-by-model authentication guides, serial-number dating help, and honest advice on valuing and selling vintage guitars, written by Joe Dampt from real instruments handled at the shop.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
  ],
};
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE_URL}/blog/`,
  url: `${SITE_URL}/blog/`,
  name: "Joe's Vintage Guitars Blog",
  description: INTRO,
  publisher: { "@id": `${SITE_URL}/` },
};
---

<Layout
  title="Vintage Guitar Authentication & Selling Guides | Joe's Vintage Guitars Blog"
  description="Vintage guitar authentication guides, serial-number dating help, and honest advice on valuing and selling Fender, Gibson, Martin and more, from Joe's Vintage Guitars."
  canonical="/blog/"
  structuredData={[breadcrumbSchema, blogSchema]}
>
  <BlogArchive
    heading={HEADING}
    intro={INTRO}
    posts={posts}
    current={1}
    total={total}
    basePath="/blog"
    categories={categories}
  />
</Layout>
