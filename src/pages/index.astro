---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ValueProp from "../components/ValueProp.astro";
import AboutJoe from "../components/AboutJoe.astro";
import WhatWeBuy from "../components/WhatWeBuy.astro";
import Testimonials from "../components/Testimonials.astro";
import MoreThanGuitar from "../components/MoreThanGuitar.astro";
import ClientStories from "../components/ClientStories.astro";
import Guide from "../components/Guide.astro";
import Collections from "../components/Collections.astro";
import MeetJoe from "../components/MeetJoe.astro";
import RecentPurchases from "../components/RecentPurchases.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";

// FAQPage structured data (drives Google rich results)
// Source: live site JSON-LD #4 (jsonld-4.json in /reference)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What Are The Considerations You Have To Determine A Guitar's Price & Value?",
      acceptedAnswer: { "@type": "Answer", text: "When appraising a guitar, there are several things that you need to take into consideration in order to determine its value. This includes the make and model of the guitar, its age, condition, and any unique features or history that it might have. This can be rather tricky, so don't hesitate to contact me for a FREE appraisal! I offer appraisals across the U.S. and Canada." },
    },
    {
      "@type": "Question",
      name: "Can I Sell My Guitar On Consignment Or Trade It For Another One?",
      acceptedAnswer: { "@type": "Answer", text: "I'm always happy to listen to your trade offers. We do offer consignment!" },
    },
    {
      "@type": "Question",
      name: "How Do I Receive The Money For My Vintage Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "I can often travel to you and pay cash in person for your guitar. I am always out and about buying guitars all over the U.S. If coming to you is not possible, I can pay via money order, Venmo, PayPal, Cashapp, Zelle, bank transfer, etc." },
    },
    {
      "@type": "Question",
      name: "Will I Have To Pay For Shipping To Sell A Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "If meeting to sell your guitar is not possible, I can arrange a professional, prepaid packing and shipping service." },
    },
    {
      "@type": "Question",
      name: "How Do You Estimate The Value Of A Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "Estimating the value of a vintage guitar involves a meticulous assessment of multiple factors. First, I examine the brand, model, and production year, as these characteristics significantly influence worth. Condition is paramount, assessing wear, modifications, and originality, as pristine, all-original guitars tend to fetch higher prices. Historical significance, provenance, and documented authenticity can also elevate value. Market demand and recent comparable sales provide essential context, while consulting experienced appraisers and fellow collectors is crucial for a precise valuation that considers the unique attributes of each vintage guitar." },
    },
    {
      "@type": "Question",
      name: "How Can I Tell When A Guitar Was Made?",
      acceptedAnswer: { "@type": "Answer", text: "As a vintage guitar collector, determining the age of a guitar is an exciting part of the hobby. There are several key techniques I rely on to establish a guitar's age. Firstly, I scrutinize the serial number, a critical piece of information. For many vintage guitars, manufacturers have a serial number system that can be traced back to production dates. It's essential to consult reliable resources and reference books specific to the brand or model to decode these serial numbers accurately. Secondly, I thoroughly examine the guitar's features and hardware. Changes in design, materials, and logo styles over the years can provide valuable clues about its production era. Thirdly, I inspect the label inside the guitar, which often includes the date of manufacture. However, labels can sometimes be missing or misleading, so additional research is usually necessary. Finally, I rely on the collective knowledge of the vintage guitar community. Online forums, collector groups, and expert opinions can provide invaluable insights and help corroborate the guitar's age." },
    },
    {
      "@type": "Question",
      name: "Do You Sell Instruments Via Reverb?",
      acceptedAnswer: { "@type": "Answer", text: "Yes, as a guitar dealer, I sell instruments on Reverb. If you're interested in purchasing a guitar or have any questions about our inventory, please feel free to ask, and I'll be happy to assist you." },
    },
    {
      "@type": "Question",
      name: "What Other Brands Of Guitars Does Joe's Vintage Guitars Buy?",
      acceptedAnswer: { "@type": "Answer", text: "I'm always on the lookout for a wide range of guitar brands to add to my collection. While I have a particular interest in renowned names like Fender, Gibson, Martin, and Rickenbacker, I'm also keen on discovering unique and rare pieces from various makers. I buy and sell across the U.S. and Canada, so if you have a guitar you're considering selling, feel free to reach out to me directly at 602-900-6635. I'd love to hear about what you have and discuss whether it could be a great addition to my collection." },
    },
  ],
};
---

<Layout
  title="Joe's Vintage Guitars | We Buy Vintage Guitars Nationwide"
  description="Sell your vintage guitar the easy way with Joe's Vintage Guitars. Get a free evaluation and get top dollar for your guitar today! Same day payment!"
  ogImage="https://www.joesvintageguitarsaz.com/wp-content/uploads/2025/07/homepage-featured-image.jpg"
  ogImageAlt="Buying and Collecting Vintage Guitars and Stringed Instruments"
  structuredData={faqSchema}
>
  <Hero />
  <ValueProp />
  <AboutJoe />
  <WhatWeBuy />
  <Testimonials />
  <MoreThanGuitar />
  <ClientStories />
  <Guide />
  <Collections />
  <MeetJoe />
  <RecentPurchases />
  <FAQ />
  <ContactSection />
</Layout>
