---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ValueProp from "../components/ValueProp.astro";
import AboutJoe from "../components/AboutJoe.astro";
import WhatWeBuy from "../components/WhatWeBuy.astro";
import Testimonials from "../components/Testimonials.astro";
import MoreThanGuitar from "../components/MoreThanGuitar.astro";
import ClientStories from "../components/ClientStories.astro";
import Guide from "../components/Guide.astro";
import Collections from "../components/Collections.astro";
import MeetJoe from "../components/MeetJoe.astro";
import RecentPurchases from "../components/RecentPurchases.astro";
import FAQ from "../components/FAQ.astro";
import ContactSection from "../components/ContactSection.astro";

// FAQPage structured data (drives Google rich results)
// Source: live site JSON-LD #4 (jsonld-4.json in /reference)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What Are The Considerations You Have To Determine A Guitar's Price & Value?",
      acceptedAnswer: { "@type": "Answer", text: "A few things go into a guitar's value: the make and model, its age, its condition, and any unusual features or history. It can get tricky, so contact me for a free appraisal and I'll sort it out. I appraise guitars across the U.S. and Canada." },
    },
    {
      "@type": "Question",
      name: "Can I Sell My Guitar On Consignment Or Trade It For Another One?",
      acceptedAnswer: { "@type": "Answer", text: "I'm always happy to listen to your trade offers. We do offer consignment!" },
    },
    {
      "@type": "Question",
      name: "How Do I Receive The Money For My Vintage Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "I can often travel to you and pay cash in person for your guitar. I am always out and about buying guitars all over the U.S. If coming to you is not possible, I can pay via money order, Venmo, PayPal, Cashapp, Zelle, bank transfer, etc." },
    },
    {
      "@type": "Question",
      name: "Will I Have To Pay For Shipping To Sell A Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "If meeting to sell your guitar is not possible, I can arrange a professional, prepaid packing and shipping service." },
    },
    {
      "@type": "Question",
      name: "How Do You Estimate The Value Of A Guitar?",
      acceptedAnswer: { "@type": "Answer", text: "A few things drive the value. First I look at the brand, model, and year, since those set the baseline. Then condition, which matters a lot: wear, any modifications, and how original it is, because clean all-original guitars bring the most. History and documented provenance can add to it too. After that I check current demand and what comparable guitars have actually sold for recently to land on a real number." },
    },
    {
      "@type": "Question",
      name: "How Can I Tell When A Guitar Was Made?",
      acceptedAnswer: { "@type": "Answer", text: "I use a few things to date a guitar. First the serial number, checked against the brand's reference charts, since most makers ran a numbering system tied to production dates. Then the features and hardware, because changes in design, materials, and logo styles over the years are good clues to the era. I also check the label inside the guitar, which often has a date, though labels can be missing or misleading so I don't rely on them alone. When something doesn't add up, the wider collector community and good reference books help confirm it." },
    },
    {
      "@type": "Question",
      name: "Do You Sell Instruments Via Reverb?",
      acceptedAnswer: { "@type": "Answer", text: "Yes, I sell on Reverb. If you want to buy a guitar or have a question about my inventory, just ask and I'll help you out." },
    },
    {
      "@type": "Question",
      name: "What Other Brands Of Guitars Does Joe's Vintage Guitars Buy?",
      acceptedAnswer: { "@type": "Answer", text: "I buy a wide range of brands. Fender, Gibson, Martin, and Rickenbacker are the ones I chase most, but I'm always interested in rare or unusual pieces from other makers too. I buy and sell across the U.S. and Canada, so if you've got a guitar you're thinking about selling, call or text me directly at 602-900-6635. I'd be glad to hear what you have." },
    },
  ],
};
---

<Layout
  title="Joe's Vintage Guitars | We Buy Vintage Guitars Nationwide"
  description="Sell your vintage guitar the easy way with Joe's Vintage Guitars. Get a free evaluation, top dollar for your guitar, and same-day payment."
  ogImage="https://www.joesvintageguitarsaz.com/wp-content/uploads/2025/07/homepage-featured-image.jpg"
  ogImageAlt="Buying and Collecting Vintage Guitars and Stringed Instruments"
  structuredData={faqSchema}
>
  <Hero />
  <ValueProp />
  <AboutJoe />
  <WhatWeBuy />
  <Testimonials />
  <MoreThanGuitar />
  <ClientStories />
  <Guide />
  <Collections />
  <MeetJoe />
  <RecentPurchases />
  <FAQ />
  <ContactSection />
</Layout>
