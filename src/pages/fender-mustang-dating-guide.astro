// Readable across a room or from a photograph. These give a WINDOW.
const fastRows: [string, string, string, string][] = [
  ["Headstock size and logo colour", "Small and gold is 1964 to 1965, large and gold is late 1965 to 1967, large and black is 1967 to 1968 onward", "Read the two together. Either one alone leaves you with several years.", "#headstock"],
  ["The Offset Contour Body line", "Present before about 1967, gone after", "A small line of text under the logo on the decal. Its absence dates the decal, not the guitar, so pair it with the logo.", "#headstock"],
  ["The vibrato engraving", "Pat. Pend. is about 1964 to 1966, a patent number is 1967 and later", "Engraved on the plate at the bridge. This part exists on no other vintage Fender.", "#vibrato"],
  ["Pickguard colour against body colour", "Not a date. An originality check", "Tortoiseshell belongs on Olympic White, white pearloid on Dakota Red and Daphne Blue, pearloid on Competition. A mismatch means a swapped guard or a refinish.", "#guard"],
  ["Competition stripe and headstock", "Wrap-around stripe is 1968, painted headstock runs to about 1969 or 1970, natural headstock after", "Two features that move independently, so together they narrow a Competition guitar to a couple of years.", "#competition"],
];

// What the standard pre-CBS checklist gets wrong here.
const tooLateRows: [string, string][] = [
  [
    "A slab fingerboard",
    "Fender moved from the flat slab board to the curved veneer board in mid-1962, two years before the Mustang existed. Every vintage Mustang board is the veneer type, so a slab board means the neck came off something else.",
  ],
  [
    "A spaghetti logo",
    "That era had closed by the launch. The Mustang wore the gold transition logo from day one and the bold black script from about 1967. A spaghetti logo on a Mustang is wrong for the model.",
  ],
  [
    "Clay dots",
    "Pearloid dots are correct on effectively every Mustang. Clay is a possibility only on the very earliest 1964 examples, which makes it a narrow claim rather than a general pre-CBS tell.",
  ],
  [
    "The custom colour chart",
    "The Mustang was a student model with three standard colours: Dakota Red, Daphne Blue and Olympic White. The wider Fender custom colour list does not apply, and the Competition finishes are their own package rather than custom colours.",
  ],
];

const competitionRows: [string, string, string][] = [
  ["The stripe", "Wraps around the body on the earliest 1968 examples, front only from late 1968", "Check the edge of the body, not the face."],
  ["The headstock", "Painted to match from the introduction into about 1969 or 1970, natural afterwards", "The painted one is the early one, which catches people out."],
  ["The colours", "Competition Red, Competition Blue and Competition Orange", "Fender's catalogue called the blue one Competition Burgundy. The guitars are blue, so that is a catalogue label rather than a fourth colour."],
  ["The guard", "Pearloid throughout the Competition run", "A tortoiseshell guard on a Competition body is a swap."],
];

const reissueRows: [string, string][] = [
  [
    "Japanese reissues, from 1990",
    "Modelled on the 1969 Competition look and built in 24 inch scale only, with names like MG-69 and MG-73. The neck or serial carries Made in Japan or Crafted in Japan, and the pots and serial format are modern.",
  ],
  [
    "Kurt Cobain Signature Mustang, 2012",
    "An alder body, an angled single coil at the neck and a Seymour Duncan humbucker direct-mounted at the bridge, an Adjusto-Matic bridge over the Dynamic Vibrato, and Cobain's journal art on the neck plate, usually in Fiesta Red.",
  ],
  [
    "Jag-Stang",
    "Cobain's early-1990s hybrid of the Jaguar and the Mustang, reissued since. A basswood body, a Jaguar-ish outline, a single coil at the neck and a humbucker at the bridge. A separate model rather than a Mustang.",
  ],
  [
    "Modern American and Mexican lines",
    "American Performer, Player and Player II, and Vintera. Modern fingerboard radii, updated switching and current serial formats set all of them apart at a glance.",
  ],
];

const tocItems: [string, string][] = [
  ["#start", "Start Here"],
  ["#toolate", "Born After The Tells"],
  ["#fast", "The Five Fastest Checks"],
  ["#years", "Mustang Year By Year"],
  ["#headstock", "The Headstock And The Logo"],
  ["#vibrato", "The Dynamic Vibrato"],
  ["#guard", "Guard Against Finish"],
  ["#competition", "The Competition Finishes"],
  ["#scale", "Two Scales And A Nut Code"],
  ["#board", "The Board And The Dots"],
  ["#switches", "The Slide Switches"],
  ["#heel", "The Neck Heel Date"],
  ["#serial", "What The Serial Number Adds"],
  ["#reissue", "Vintage Or Reissue"],
  ["#limits", "What Features Can't Prove"],
  ["#cross", "Confirm It From The Inside"],
