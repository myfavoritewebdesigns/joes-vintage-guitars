---
import MartinGuideLayout from '../layouts/MartinGuideLayout.astro';
import LicensedImage from '../components/primitives/LicensedImage.astro';
import MartinPhoto from '../components/MartinPhoto.astro';
import MartinPhotoViewer from '../components/MartinPhotoViewer.astro';
import { guitarData, lxData, mandolinData, navSolidData, navHplData, navSoData, backpackerData } from '../data/martin-serials';
import { martinGuides, martinImage, reverb1967 } from '../data/martin-guides';
import { SITE_URL } from '../config/site';
const title = 'Martin Serial Number Lookup: Year Charts And Dating Guides';
const description = 'Find your Martin guitar’s year with the serial number lookup and official charts through 2025. Compare logos, tuners, neck-block stamps and construction photos.';
const canonical = '/martin-serial-and-model-numbers/';
const socialImage = martinImage('images/martin-serial/Model-Name-Serial-Number-Martin.jpg');
const otherCharts = [
  {id:'little-martin-lx-serial-numbers',title:'Little Martin LX Serial Numbers',note:'LX instruments use a separate sequence. Martin’s first published year-end total is 41279 for 2005, so lower numbers may be from 2005 or an earlier year.',rows:lxData},
  {id:'backpacker-serial-numbers',title:'Backpacker Serial Numbers',note:'Backpackers have their own sequence. The first entry covers 1992 to 2006, so it won’t give you an exact year.',rows:backpackerData},
  {id:'martin-mandolin-serial-numbers',title:'Martin Mandolin Serial Numbers',note:'These are the early mandolin year-end totals. Gaps in the table can only give a range of years. Martin also used 259996 to 260020 for mandolins in 1976. From 1991, mandolins shared the guitar sequence, including 509122; production ended in 2002.',rows:mandolinData},
  {id:'navojoa-solid-wood-ukulele-serial-numbers',title:'Navojoa Solid Wood Ukulele Serial Numbers',note:'Use this sequence for the Mexico-made solid wood ukuleles covered by Martin’s table.',rows:navSolidData},
  {id:'navojoa-hpl-ukulele-serial-numbers',title:'Navojoa HPL Ukulele Serial Numbers',note:'HPL means high-pressure laminate. This sequence is separate from solid wood ukuleles and the regular guitar chart.',rows:navHplData},
  {id:'navojoa-so-ukulele-serial-numbers',title:'Navojoa SO Ukulele Serial Numbers',note:'The first entry covers 2000 to 2006. A number in that group won’t give you an exact year.',rows:navSoData},
];
const faqs = [
  {q:'How Do I Read A Martin Serial Number?',a:'Find the serial on the neck block and select the correct instrument type. In the regular guitar chart, each year ends with the listed number. For example, 224411 falls between 217216 and 230095, which dates it to 1967.'},
  {q:'Where Is The Serial Number On A Martin Guitar?',a:'On most Martin acoustic guitars, look through the soundhole toward the neck joint. The serial is on the neck block. Many guitars made from late 1930 onward also have the model stamped above it.'},
  {q:'What If My Martin Has No Serial Number?',a:'The regular guitar sequence began in 1898. An earlier guitar needs to be identified from its maker’s stamps, construction and provenance. Some other Martin instrument types use different markings or no regular guitar serial. Photograph the entire instrument before drawing a conclusion.'},
  {q:'Can A Martin Serial Number Tell Me The Model Or Value?',a:'The serial dates the guitar within its numbering system. Read the separate model stamp to identify the model, then check condition, repairs and replaced parts when assessing value.'},
  {q:'Does This Lookup Include 2025 And 2026?',a:'The regular guitar chart includes Martin’s published 2025 last serial, 3043480. It doesn’t estimate a 2026 range. Ask Martin to confirm a higher number.'},
  {q:'Why Does My Little Martin Show The Wrong Year?',a:'Little Martin LX guitars use a separate serial sequence. Select Little Martin LX in the tool instead of the regular guitar sequence. Backpackers and Mexico-made ukuleles also have separate charts.'},
  {q:'What Does Prewar Mean For A Martin Guitar?',a:'Collectors use prewar somewhat differently, sometimes including wartime production with earlier construction features. Use the actual year, model and specifications instead of treating the word as one precise serial cutoff.'},
];
const schema: Record<string,unknown>[] = [
  {'@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/#organization'},dateModified:'2026-10-03'},
  {'@context':'https://schema.org','@type':'WebApplication',name:'Martin Serial Number Lookup',url:SITE_URL+canonical,applicationCategory:'UtilityApplication',operatingSystem:'All',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description:'Free year lookup for Martin guitars, Little Martin LX, Backpackers, mandolins and selected ukulele sequences using published serial tables.'},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
  {'@context':'https://schema.org','@type':'VideoObject','@id':SITE_URL+canonical+'#video',name:'Where To Find The Serial Number On A Martin Guitar',description:'Joe shows where to find the serial number on a Martin guitar neck block.',thumbnailUrl:'https://img.youtube.com/vi/WGF-pL6GB38/maxresdefault.jpg',uploadDate:'2026-01-13T13:11:42-08:00',embedUrl:'https://www.youtube.com/embed/WGF-pL6GB38',contentUrl:'https://www.youtube.com/watch?v=WGF-pL6GB38',author:{'@id':SITE_URL+'/about-me/#person'}}
];
---
<MartinGuideLayout title={title} description={description} canonical={canonical} structuredData={schema} ogImage={`${SITE_URL}${socialImage.src}`} ogImageWidth={socialImage.width} ogImageHeight={socialImage.height} ogImageAlt="Martin model and serial stamp on a neck block">
  <section class="mtn-hero" id="decoder"><div class="mtn-wrap mtn-hero-grid">
    <div><p class="mtn-kicker">Martin Serial Numbers And Identification</p><h1>Martin Serial Number Lookup</h1><p class="mtn-lede">Enter the serial stamped on your Martin’s neck block to find its year. Then use the photo guides to compare the model stamp, logo, tuners and construction.</p><p class="mtn-byline">By <a href="/about-me/">Joe Dampt</a> · Updated October 3, 2026</p><nav class="mtn-toc" aria-label="Quick links"><a href="#where-to-find-your-martin-guitar-model-and-serial-number">Find Your Serial</a><a href="#martin-chart-title">Year Charts</a><a href="#in-depth-dating-and-specs">Photo Guides</a></nav></div>
    <form class="mtn-tool" id="martin-lookup" novalidate>
      <h2>Find Your Martin’s Year</h2><label for="martin-type">Instrument Type</label>
      <select id="martin-type" name="instrument"><option value="guitar">Regular Martin Guitar / Nazareth Ukulele</option><option value="lx">Little Martin LX</option><option value="backpacker">Backpacker</option><option value="mandolin">Martin Mandolin</option><option value="nav-solid">Mexico-Made Solid Wood Ukulele</option><option value="nav-hpl">Mexico-Made HPL Ukulele</option><option value="nav-so">Mexico-Made SO Ukulele</option></select>
      <label for="search-serial">Serial Number</label><input id="search-serial" name="serial" type="text" inputmode="numeric" autocomplete="off" placeholder="For example, 224411" aria-describedby="martin-input-help" required />
      <small id="martin-input-help">Enter the serial, not the model name. Commas are accepted.</small><button class="mtn-button" id="btn-find-year" type="submit">Find Year</button>
      <div id="show-search" class="mtn-result" role="status" aria-live="polite" aria-atomic="true"></div>
      <small>The lookup uses published year-end tables through 2025 where available.</small>
      <noscript><p>JavaScript is off. Use the serial tables below to find your year.</p></noscript>
    </form>
  </div></section>
  <section class="mtn-section" id="in-depth-dating-and-specs"><div class="mtn-wrap"><div class="mtn-section-head"><p class="mtn-kicker">Martin Logos, Tuners And Construction</p><h2>Martin Dating Photo Guides</h2><p>Compare your guitar with dated examples from Joe’s archive and Reverb listings. Captions point out the visible details and known replacement parts.</p></div><div class="mtn-cards">{martinGuides.map(guide=><article class="mtn-card"><LicensedImage src={martinImage(guide.cardImage)} alt={`${guide.shortTitle} detail from Joe’s Martin photo collection`} width={600} loading="lazy" /><div class="mtn-card-body"><h3><a href={`/${guide.slug}/`}>{guide.shortTitle}</a></h3><p>{guide.cardText}</p><a href={`/${guide.slug}/`}>Open The {guide.shortTitle} Guide</a></div></article>)}</div></div></section>
  <section class="mtn-section mtn-section--tint" id="where-to-find-your-martin-guitar-model-and-serial-number"><div class="mtn-wrap"><div class="mtn-section-head"><h2>Where To Find Your Martin’s Serial Number</h2><p>Look through the soundhole toward the neck. The serial is usually below the model name on the thick wooden neck block. Guitars made before model stamping became routine around October 1930 may have a serial alone.</p></div><div class="mtn-split"><MartinPhoto src={socialImage} title="Model And Serial Number Locations" alt="Annotated Martin neck-block photo with arrows identifying the D-28 model stamp and serial number 216614" caption="The arrows identify D-28 as the model and 216614 as the serial number. Enter the serial number in the lookup." /><div><lite-youtube videoid="WGF-pL6GB38" title="Where To Find The Serial Number On A Martin Guitar" params="rel=0&start=20"></lite-youtube><p>Watch Joe locate the neck-block number. Use a light and photograph the whole stamp, including any letters.</p><p><a href="/martin-neck-block-stamps/">Compare Serial-Only, Model And Maker’s Stamps</a></p></div></div></div></section>
  <section class="mtn-section" id="read-a-martin-serial"><div class="mtn-wrap"><h2>How To Date A Martin</h2><div class="mtn-steps"><div><strong>1. Read The Number</strong><p>Copy every digit from the neck block. Check the instrument type before selecting a chart.</p></div><div><strong>2. Match The Year</strong><p>Serial 224411 falls after 217215, the last number for 1966, and before 230095, the last for 1967. That puts it in 1967.</p></div><div><strong>3. Check The Guitar</strong><p>Compare the model, logo, tuners and construction. Replaced parts don’t change the original serial date.</p></div></div><div class="mtn-note" id="what-is-my-martin-guitar-worth"><strong>Model, Condition And Martin Guitar Value</strong><p>Two Martins from the same year can have different models, repairs and originality. Use the <a href="/martin-d-28-d-18-d-45-dreadnought-value-guide/">Martin dreadnought value guide</a> or <a href="/free-appraisal/martin/">send Joe photos</a> after you identify the guitar.</p></div></div></section>
  <section class="mtn-section mtn-section--tint" id="martin-chart-title"><div class="mtn-wrap"><h2>Martin Guitar Serial Number Chart</h2><p>The regular guitar sequence starts at 8001 in 1898. Each row shows the first and last serial for that year, calculated from <a href="https://www.martinguitar.com/support-serial-number-lookup.html" target="_blank" rel="noopener noreferrer">Martin’s published year-end totals</a>.</p><p>Use the separate charts below for LX, Backpacker, mandolin and Mexico-made ukulele sequences.</p>
    <div class="mtn-table-scroll">
      <table>
        <caption class="sr-only">Martin Guitar Serial Ranges, 1898 To 2025</caption>
        <thead><tr><th scope="col">Year</th><th scope="col">First Serial</th><th scope="col">Last Serial</th></tr></thead>
        <tbody>{guitarData.map(row=><tr><th scope="row">{row.y}</th><td>{row.a.toLocaleString('en-US')}</td><td>{row.b.toLocaleString('en-US')}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="mtn-note"><strong>Sigma-Martin Exception</strong><p>Numbers 900001 to 902908 were used for Sigma-Martins in 1981 to 1982 and are excluded from regular 2002 production. The lookup handles that exception separately.</p></div>
    <div class="mtn-note" id="martin-2025-and-2026-serial-numbers"><h3>Martin Serial Numbers For 2025 And 2026</h3><p>Martin’s actual 2025 guitar range is <strong>2,935,988 to 3,043,480</strong>. For a higher serial, ask Martin to confirm the production year. The chart doesn’t estimate a 2026 cutoff from past production rates.</p></div>
  </div></section>
  <section class="mtn-section" id="other-instrument-charts"><div class="mtn-wrap"><h2>Other Martin Instrument Serial Charts</h2><p>These tables list the last serial for each year or group of years. Where Martin groups or skips years, the table can only narrow the date to that interval.</p><div id="martin-navojoa-ukulele-serial-numbers"></div>{otherCharts.map(chart=><details id={chart.id}><summary>{chart.title}</summary><p>{chart.note}</p><div class="mtn-table-scroll"><table><caption class="sr-only">{chart.title}</caption><thead><tr><th scope="col">Year Or Interval</th><th scope="col">Last Serial</th></tr></thead><tbody>{chart.rows.map(row=><tr><th scope="row">{row.y}</th><td>{row.b.toLocaleString('en-US')}</td></tr>)}</tbody></table></div></details>)}</div></section>
  <section class="mtn-section mtn-section--tint" id="historical-timeline"><div class="mtn-wrap"><h2>Use Features To Check The Serial Date</h2><p>A replacement bridge, a tuner change or neck work can leave a guitar with parts from different periods. Compare the details with the same model and year, and ask about its repair history.</p><div class="mtn-table-scroll"><table><thead><tr><th scope="col">Detail</th><th scope="col">What To Compare</th><th scope="col">Photo Guide</th></tr></thead><tbody>
    <tr id="logo-guide"><th scope="row">Headstock Logos</th><td>Blank face, rear stamp, gold outline and pearl lettering.</td><td><a href="/martin-headstock-logo-chronology/">Logo Evolution</a></td></tr>
    <tr id="tuner-guide"><th scope="row">Tuners</th><td>Gears, baseplates, buttons, bushings and old screw holes.</td><td><a href="/martin-tuner-dating-guide/">Tuner Evolution</a></td></tr>
    <tr><th scope="row">Neck-Block Stamps</th><td>Serial alone, model plus serial and separate maker’s marks.</td><td><a href="/martin-neck-block-stamps/">Stamp Guide</a></td></tr>
    <tr id="trim-guide"><th scope="row">Binding And Purfling</th><td>Body-edge material, herringbone and pearl borders.</td><td><a href="/martin-physical-features-dating-guide/#trim-and-inlays">Trim Comparisons</a></td></tr>
    <tr id="inlay-guide"><th scope="row">Fingerboard Inlays</th><td>Pattern and model; account for later recreations.</td><td><a href="/martin-physical-features-dating-guide/#trim-and-inlays">Inlay Comparisons</a></td></tr>
    <tr id="tonewood-guide"><th scope="row">Woods</th><td>Model, production period and documented wood selection.</td><td><a href="/martin-physical-features-dating-guide/#tonewoods">Wood Comparisons</a></td></tr>
    <tr><th scope="row">Bridge And Bracing</th><td>Bridge shape, saddle slot, interior braces and repairs.</td><td><a href="/martin-physical-features-dating-guide/#bridges-and-saddles">Construction Guide</a></td></tr>
  </tbody></table></div></div></section>
  <section class="mtn-section" id="martin-faq"><div class="mtn-wrap"><h2>Frequently Asked Questions</h2>{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
  <section class="mtn-section mtn-section--tint" id="unearth-the-history-of-your-vintage-martin-with-joes-vintage-guitars"><div class="mtn-wrap mtn-split"><div><h2>Get Help With Your Martin</h2><p>Send a full front and back photo, both sides of the headstock, the neck-block stamp, bridge and any known repair information. I can help you identify the guitar and discuss its condition and value.</p><p><a class="mtn-button" href="/free-appraisal/martin/">Get A Free Martin Appraisal</a></p><p>If you’re ready to sell, read about <a href="/sell-my-martin-guitar/">selling your Martin to Joe</a>.</p><ul><li><a href="/post/martin-0-00-000-history-authentication-value-guide/">Martin 0, 00 And 000 Guide</a></li><li><a href="/martin-d-28-d-18-d-45-dreadnought-value-guide/">Martin Dreadnought Values</a></li><li><a href="/how-to-spot-a-fake-martin/">Martin Counterfeit Identification</a></li></ul></div><div><h2>Serial Data And Photo Sources</h2><p>The year-end tables were checked against Martin’s published data on October 2, 2026. Photos come from Joe’s shop archive and linked Reverb listings. Captions identify known repairs and details that the photos don’t show clearly.</p><ul><li><a href="https://www.martinguitar.com/support-serial-number-lookup.html" target="_blank" rel="noopener noreferrer">Martin’s Official Serial Number Tables</a></li><li><a href="https://vintagemartin.com/numbers.html" target="_blank" rel="noopener noreferrer">Early Martin Serial And Production Records</a></li><li><a href={reverb1967} target="_blank" rel="noopener noreferrer">Photographed 1967 D-28, Serial 224411</a></li></ul></div></div></section>
  <MartinPhotoViewer />
</MartinGuideLayout>
<script>
import { lookupMartin, type MartinInstrument } from '../lib/martin-lookup';
const form = document.querySelector<HTMLFormElement>('#martin-lookup');
const input = document.querySelector<HTMLInputElement>('#search-serial');
const type = document.querySelector<HTMLSelectElement>('#martin-type');
const output = document.querySelector<HTMLDivElement>('#show-search');
form?.addEventListener('submit', event => {
  event.preventDefault(); if (!input || !type || !output) return;
  const result = lookupMartin(input.value, type.value as MartinInstrument);
  output.replaceChildren();
  const yearLabel = result.year?.replace(/\b[a-z]/g, letter => letter.toUpperCase());
  const heading = document.createElement('strong'); heading.textContent = yearLabel ? `Production Year: ${yearLabel}` : 'Check Your Serial Number';
  const text = document.createElement('p'); text.textContent = result.message;
  output.append(heading,text);
  if(result.year){const p=document.createElement('p');const a=document.createElement('a');a.href='/martin-neck-block-stamps/';a.textContent='Compare The Model And Stamp';p.append(a);output.append(p);}
});
type?.addEventListener('change',()=>output?.replaceChildren());
input?.addEventListener('input',()=>output?.replaceChildren());
// Preserve incoming links to chart headings when their details panel is closed.
function revealHash(){const target=document.getElementById(decodeURIComponent(location.hash.slice(1)));if(!target)return;let parent:HTMLElement|null=target;while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}}
revealHash();window.addEventListener('hashchange',revealHash);
</script>
