// Helper: compute the start serial for last-serial-of-year tables for display
function formatLastSerial(data: { y: string; b: number }[]) {
  return data.map((row, i) => ({
    year: row.y,
    rangeStart: i === 0 ? 0 : data[i - 1].b + 1,
    rangeEnd: row.b,
    last: row.b,
  }));
}

// Format guitar range for display (e.g., "0000 to 8348")
const guitarTableRows = guitarData.map((r) => ({
  year: r.y,
  range: `${r.a === 0 ? "0000" : r.a} to ${r.b}`,
}));
const lxTableRows = lxData;
const mandolinTableRows = mandolinData;
const navSolidTableRows = navSolidData;
const navHplTableRows = navHplData;
