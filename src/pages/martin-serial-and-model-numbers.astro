<!-- Tool data + lookup logic — ported VERBATIM from live's inline script.
     Wrapped in IIFE to scope variables. Uses Astro's `define:vars` to receive
     the same datasets used to render the static tables above (single source
     of truth). The lookup behaviour mirrors live exactly:
       - 'guitar'      → inclusive a/b range match (most precise)
       - 'lx', 'mandolin', 'nav-solid', 'nav-hpl' → "last serial of year" walk
       - 'nav-so'      → a/b range with `approximate` flag for 2000–2006
     Per-type result notes also match live verbatim. -->
<script
  is:inline
  define:vars={{ guitarData, lxData, mandolinData, navSolidData, navHplData, navSoData }}
>
(function() {
  'use strict';
  let currentType = 'guitar';

  const mcsSelected = document.getElementById('mcs-selected');
  const mcsOptions = document.getElementById('mcs-options');
  const mcsOptionEls = mcsOptions.querySelectorAll('.mcs-option');
  const input = document.getElementById('search-serial');
  const btn = document.getElementById('btn-find-year');
  const display = document.getElementById('show-search');

  // Custom dropdown
  mcsSelected.addEventListener('click', function(e) {
    mcsOptions.classList.toggle('open');
    e.stopPropagation();
  });
  mcsOptionEls.forEach(function(opt) {
    opt.addEventListener('click', function() {
      currentType = this.getAttribute('data-value');
      mcsSelected.textContent = this.textContent;
      mcsOptionEls.forEach(function(o) { o.classList.remove('active'); });
      this.classList.add('active');
      mcsOptions.classList.remove('open');
    });
  });
  document.addEventListener('click', function() {
    mcsOptions.classList.remove('open');
  });

  function lookupLastSerial(data, num) {
    let prev = 0;
    for (let i = 0; i < data.length; i++) {
      if (num > prev && num <= data[i].b) return data[i].y;
      prev = data[i].b;
    }
    return null;
  }

  function runLookup() {
    const val = input.value.replace(/\D/g, '');
    const num = parseInt(val);
    display.style.display = 'block';

    if (isNaN(num)) {
      display.innerHTML = 'Please enter a valid numeric serial number.';
      return;
    }

    let year = null;
    let note = '';
    const appraisalLink = '<br><br>If you need more information or want to find your guitar’s current market value, <a href="/free-appraisal/" class="appraisal-link">GET A FREE APPRAISAL HERE</a>.';

    if (currentType === 'guitar') {
      const match = guitarData.find(function(r){ return num >= r.a && num <= r.b; });
      year = match ? match.y : null;
    } else if (currentType === 'lx') {
      year = lookupLastSerial(lxData, num);
      note = year ? '<br><small>Little Martin (LX Series) — made in Navojoa, Mexico.</small>' : '';
    } else if (currentType === 'mandolin') {
      year = lookupLastSerial(mandolinData, num);
      if (year) {
        note = (year === '1991' || year === '1993')
          ? '<br><small>Note: From 1991, Martin mandolin serials merged with the standard guitar sequence. Mandolins were custom order only from 1994–2002. Martin ceased mandolin production in 2002.</small>'
          : '<br><small>Martin mandolins use a separate serial number system from guitars (pre-1991).</small>';
      }
    } else if (currentType === 'nav-solid') {
      year = lookupLastSerial(navSolidData, num);
      note = year ? '<br><small>Navojoa Solid Wood Ukulele — made in Navojoa, Sonora, Mexico.</small>' : '';
    } else if (currentType === 'nav-hpl') {
      year = lookupLastSerial(navHplData, num);
      note = year ? '<br><small>Navojoa HPL Ukulele — made in Navojoa, Sonora, Mexico. HPL = High Pressure Laminate.</small>' : '';
    } else if (currentType === 'nav-so') {
      const match = navSoData.find(function(r){ return num >= (r.a || 0) && num <= r.b; });
      if (match) {
        year = match.y;
        note = match.approximate
          ? '<br><small><strong>Note:</strong> Serial numbers in this range (up to 9972) are attributed to the 2000–2006 production period. Year-by-year records are not available, so an exact year cannot be confirmed.</small>'
          : '<br><small>Navojoa SO Ukulele — made in Navojoa, Sonora, Mexico.</small>';
      }
    }

    if (year) {
      display.innerHTML = '<strong>Your Martin was built in: ' + year + '</strong>.' + note + appraisalLink;
    } else {
      display.innerHTML = 'Serial number not found for the selected instrument type. Please double-check the number and the instrument type selected.';
    }
  }

  btn.addEventListener('click', runLookup);
  input.addEventListener('keyup', function(e) {
    if (e.key === 'Enter') runLookup();
  });
})();
</script>

