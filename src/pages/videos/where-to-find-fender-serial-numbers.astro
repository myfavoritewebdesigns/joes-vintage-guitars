<script is:inline define:vars={{ ytId: YT_ID, ytParams: YT_PARAMS }}>
  (function () {
    var player = document.getElementById("fvw-player");
    if (!player) return;
    var base = "https://www.youtube.com/embed/" + ytId + "?" + ytParams;

    // Clip URLs in the schema are this page with ?t=NNN. Honor them by starting
    // the player at that second.
    var t = parseInt(new URLSearchParams(location.search).get("t") || "", 10);
    if (t > 0) player.src = base + "&start=" + t;

    function send(msg) {
      if (player.contentWindow) player.contentWindow.postMessage(JSON.stringify(msg), "*");
    }
    // Tell the embed to accept postMessage commands (enablejsapi=1 is in the src).
    player.addEventListener("load", function () {
      send({ event: "listening", id: "fvw-player", channel: "widget" });
    });

    document.addEventListener("click", function (e) {
      var link = e.target.closest && e.target.closest("a[data-seek]");
      if (!link) return;
      e.preventDefault();
      var s = parseInt(link.getAttribute("data-seek"), 10) || 0;
      // Repeat the handshake in case the embed finished loading before this script ran.
      send({ event: "listening", id: "fvw-player", channel: "widget" });
      send({ event: "command", func: "seekTo", args: [s, true] });
      send({ event: "command", func: "playVideo", args: [] });
      player.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  })();
</script>
