const title='Guild Serial Number Lookup: How To Date A Guild Guitar';
const description='Look up your Guild serial number with vintage charts and a date-code decoder. Compare labels, factory eras, model prefixes and detailed guitar photos.';
const faqs=[
 {q:'How Do I Read A Guild Serial Number?',a:`<p>Find the serial number first, then match it to the right era. Guild used early numeric sequences, model-specific prefixes in 1965 to 1969 and again from late 1979, and Julian codes for Tacoma and New Hartford production. Match your number against the <a href="#part1">numeric charts</a> or <a href="/guild-model-prefix-serial-number-charts/">model charts</a>. Later imports and other factories may need different records.</p>`},
 {q:'Where Is The Serial Number On A Guild Guitar?',a:`<p>It depends on the era. Look on the back of the headstock, on a label inside the soundhole or body, or stamped on the neck block. Electric and acoustic models can differ, so check all three spots. The <a href="/guild-labels-and-serial-number-locations/">label and serial-location guide</a> shows examples.</p>`},
 {q:'How Do I Date A Guild Without A Serial Number?',a:`<p>Physical features can help when a serial is worn or missing. The headstock logo, tuner brand, pickup type, and bridge or binding details all narrow the year, and the build location (Hoboken versus Westerly) helps confirm the era. Compare the <a href="/guild-acoustic-guitar-identification/">acoustic</a> or <a href="/guild-electric-guitar-identification/">electric model guide</a>, allowing for replacement parts and later reissues. An exact year may remain unresolved.</p>`},
 {q:'What Is A Westerly Guild?',a:`<p>A Westerly Guild was built during the Rhode Island factory era. Guild’s own history dates the relocation to 1967, and production moved to Corona in late 2001. The modern Westerly Collection is a separate series name. The <a href="/guild-factory-eras/#westerly">factory-era guide</a> explains the distinction. I buy vintage Westerly Guilds across the country.</p>`},
 {q:'How Much Is My Vintage Guild Worth?',a:`<p>Value depends on the model, year, condition, and originality. Repairs and replacement parts affect which instruments make useful comparisons. Send me photos and the serial number for a <a href="/free-appraisal/guild/">free Guild appraisal</a>.</p>`}
];
const structuredData:Record<string,unknown>[]=[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},{'@context':'https://schema.org','@type':'WebApplication',name:'Guild Serial Number Decoder',applicationCategory:'UtilityApplication',operatingSystem:'All',url:SITE_URL+'/guild-serial-number-lookup/#gsl-tool',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},description:'Check supported vintage Guild numeric and model ranges, and Tacoma or New Hartford Julian serial formats.'}];
const eras=[['part1','1953 To 1969'],['part2','1970 To 1979'],['part3','1979 To 1983'],['part4','1984 To 1989'],['part5','1990 To 1993'],['part6','1994 To 1996'],['part7','1997 Records'],['part8','Julian Codes'],['guild-faq','Questions']];
const howToSteps=[{name:'Locate Your Serial Number',text:'Find the serial number on the back of the headstock, on an interior label, or stamped on the neck block.'},{name:'Enter Your Serial Number',text:'Type your Guild serial number into the decoder field and submit it.'},{name:'Match The Era',text:'Choose the serial system and model when known. Use the full model charts when the decoder cannot resolve the number.'},{name:'Review Your Result',text:'Compare the result with the label, country marking and physical features. Keep an approximate or unresolved date when the records do not support an exact year.'}];
