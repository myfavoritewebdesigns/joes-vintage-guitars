---
// GAP 2 Type C preview. Uses the reference-page header bands and fixed TOC.
// Existing authentication pages stay untouched; unresolved pricing keeps this draft noindex.
import Layout from '../layouts/Layout.astro';
import { Content, getHeadings } from '../content/value-guides/vintage-gibson-sg-special-value-guide.md';
import data from '../data/value-guides/vintage-gibson-sg-special-value-guide.json';
import { assetSrc, ogCardSize } from '../lib/images';
import { SITE_URL } from '../config/site';
const headings = getHeadings().filter(h => h.depth === 2);
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: data.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
};
---
<Layout title={data.title} description={data.description} canonical={data.url}
  ogImage={SITE_URL + assetSrc(data.ogImage)} {...ogCardSize(data.ogImage)} ogImageAlt={data.alt}
  ogType="article" structuredData={faqSchema} publishedTime={data.date} modifiedTime={data.date}
  noIndex={true} bodyClass="spvg-page">
  <div class="spvg-backdrop" aria-hidden="true"><div></div><div></div></div>
  <div class="spvg-heading">
    <div class="spvg-measure">
      <p class="spvg-eyebrow">Joe's Vintage Guitars / Value Reference</p>
      <h1>{data.h1}</h1>
      <p class="spvg-byline">By Joe Dampt <span aria-hidden="true">·</span> October 2026</p>
    </div>
  </div>
  <div class="spvg-shell">
    <div class="spvg-review" role="note"><strong>Editorial Preview</strong><p>Price evidence is incomplete. Unsupported ranges are omitted, and this draft is excluded from search indexing. Review the copy and layout before publication.</p></div>
    <details class="spvg-mobile-toc"><summary>On This Page</summary><nav aria-label="Article sections"><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></details>
    <aside class="spvg-toc" aria-label="On this page"><p>On This Page</p><nav><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#value-questions">Value Questions</a></li></ul></nav></aside>
    <article class="spvg-article">
      <Content />
      <section id="value-questions" class="spvg-faq"><h2>Questions About {data.model} Value</h2>{data.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </div>
</Layout>
<style>
.spvg-backdrop>div:first-child{height:54px;background:var(--color-brand-brown)}
.spvg-backdrop>div:last-child{height:56px;background:var(--color-brand-brown);border-bottom:6px solid var(--color-brand-brown-tan)}
.spvg-heading{background:var(--color-brand-parchment);border-bottom:1px solid var(--color-brand-brown-tan);padding:172px 28px 36px}
.spvg-measure,.spvg-shell{max-width:1280px;margin:0 auto}
.spvg-heading h1{font-family:var(--font-display);font-weight:600;font-size:clamp(32px,4vw,48px);line-height:1.15;color:var(--color-brand-brown);max-width:860px;margin:12px 0 16px}
.spvg-eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--color-brand-rust-dark);font-weight:700}
.spvg-byline{color:var(--color-brand-brown-mid);font-size:14px}
.spvg-byline span{padding:0 10px}
.spvg-shell{padding:32px 28px 72px}
.spvg-article,.spvg-review{max-width:860px}
.spvg-review{padding:18px 22px;border-left:4px solid var(--color-brand-rust);background:var(--color-brand-vanilla);margin-bottom:28px;color:var(--color-brand-brown)}
.spvg-review strong{font-family:var(--font-display);font-size:20px}
.spvg-review p{font-size:14px;line-height:1.65;margin:6px 0 0}
.spvg-article{font-size:17px;line-height:1.85;color:var(--color-brand-charcoal)}
.spvg-article :global(p){margin:0 0 20px}
.spvg-article :global(h2){font-family:var(--font-display);font-size:clamp(26px,3vw,34px);line-height:1.25;color:var(--color-brand-brown);margin:48px 0 22px;scroll-margin-top:24px}
.spvg-article :global(h2)::after{content:'';display:block;width:80px;height:3px;background:var(--color-brand-rust);margin-top:14px}
.spvg-article :global(h3){font-family:var(--font-display);font-size:25px;line-height:1.3;color:var(--color-brand-brown);margin:32px 0 14px;scroll-margin-top:24px}
.spvg-article :global(a),.spvg-toc a,.spvg-mobile-toc a{color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
.spvg-article :global(a:hover){color:var(--color-brand-rust)}
.spvg-article :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:24px 0 28px;font-size:15px;line-height:1.6}
.spvg-article :global(th){background:var(--color-brand-brown);color:white;text-align:left;font-weight:600}
.spvg-article :global(th),.spvg-article :global(td){padding:14px 16px;border:1px solid var(--color-brand-brown-tan);min-width:150px;vertical-align:top}
.spvg-article :global(tr:nth-child(even)){background:var(--color-brand-vanilla)}
.spvg-article :global(figure){margin:32px 0;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.spvg-article :global(figure p){margin:0}
.spvg-article :global(figure img){display:block;max-width:100%;max-height:720px;width:100%;height:auto;object-fit:contain;margin:0 auto;background:var(--color-brand-brown)}
.spvg-article :global(figcaption){font-size:14px;line-height:1.65;padding:14px 18px;color:var(--color-brand-brown-mid)}
.spvg-faq details{border-top:1px solid var(--color-brand-brown-tan);padding:18px 0}
.spvg-faq details:last-child{border-bottom:1px solid var(--color-brand-brown-tan)}
.spvg-faq summary{font-family:var(--font-display);font-size:22px;line-height:1.4;color:var(--color-brand-brown);cursor:pointer}
.spvg-faq details p{margin:16px 0 0;font-size:16px}
.spvg-toc{display:none}
.spvg-mobile-toc{max-width:860px;margin-bottom:28px;padding:14px 18px;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.spvg-mobile-toc summary{font-family:var(--font-display);font-size:20px;color:var(--color-brand-brown);cursor:pointer}
.spvg-mobile-toc ul{list-style:none;padding:12px 0 0;margin:0}
.spvg-mobile-toc a{display:block;padding:7px 0;font-size:15px;line-height:1.5}
@media(min-width:1440px){
 .spvg-toc{display:block;position:fixed;right:max(24px,calc((100vw - 1280px)/2));top:160px;width:270px;max-height:calc(100vh - 190px);overflow-y:auto;padding:20px;border:1px solid var(--color-brand-brown-tan);border-top:4px solid var(--color-brand-rust);background:white;z-index:20}
 .spvg-toc>p{font-family:var(--font-display);font-size:19px;margin-bottom:12px;color:var(--color-brand-brown)}
 .spvg-toc ul{list-style:none;padding:0;margin:0}
 .spvg-toc a{display:block;font-size:13px;line-height:1.5;padding:6px 0;text-decoration:none}
 .spvg-toc a:hover{text-decoration:underline}
 .spvg-mobile-toc{display:none}
}
@media(max-width:1439px){.spvg-measure,.spvg-shell{max-width:916px}}
@media(max-width:767px){.spvg-heading{padding:112px 20px 28px}.spvg-shell{padding:24px 20px 48px}.spvg-article{font-size:16px}.spvg-article :global(h2){margin-top:36px}.spvg-review{padding:15px 17px}}
@media(max-width:639px){.spvg-heading{padding-top:46px}}
</style>
