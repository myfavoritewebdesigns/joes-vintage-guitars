/**
 * Fender pickup dates spoke, CONDENSED REBUILD.
 *
 * Hub-and-spoke method page behind the condensed Fender serial rebuild
 * (see fender-guitars-serial-number-guide.astro). Deep-dives the pickup-date method the
 * hub only summarizes, so the hub's "/fender-pickup-dates/" card resolves. The
 * pot-codes and body-dates spokes already cross-link to this slug.
 *
 * Content and photos come from Joe's live serial page (the "Pickup Dates &
 * Codes" section of /fender-guitars-serial-number-guide/): the date sits on the
 * base of the pickup; two systems, a handwritten or stamped date pre-1969
 * (rubber stamp in yellow ink around 1964 then black ink later, or penciled or
 * inked by hand; month/year or just the year) and a 3 to 6 digit numeric stamp
 * from 1969 whose last one or
 * two digits are the year (1139 -> 1969, 161377 -> 1977). Pickup dates are less
 * consistent than pot codes but corroborate them. The hero is Joe's clean shot
 * of a 1966 Stratocaster pickguard underside, all three pickups dated on the
 * base within a day of each other in November 1966 (1966-fender-stratocaster-
 * pickup-dates.jpg, resized to 2560px). The three live-page example photos
 * (fender-pickup-date-ink.jpg 9-8-65, fender-pickup-pencil-dates.jpg 1-27-66,
 * fender-1970s-pickup-code.jpg 1140 = 1970) carry Joe's baked-in call-out
 * annotations and are grouped in one examples gallery; Joe kept them as-is.
 *
 * A "How The Pickups Changed Over The Years" section expands the live page's
 * "Pickup Specifications by Era" content: flat vs staggered poles by model
 * (Tele flat to mid-1955; Jazzmaster always flat; Jaguar staggered ~1964),
 * black-vs-grey bobbin/back color, and Strat Alnico 3 vs 5, with the Telecaster
 * flat-pole transition photo (telecaster-pickup-transition.jpg, native 988px).
 *
 * No walkthrough video here: the lite-youtube clip the pot-codes and neck-dates
 * spokes embed does not cover pickup dating.
 *
 * Pickup-date facts are not yet carried in VG_FACTS with VG-#### ids; flagged
 * to log.
 */
import Layout from "../layouts/Layout.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { resolveImage, assetSrc, ogCardSize } from "../lib/images";
import { contact, hrefs, SITE_URL } from "../config/site";

const meta = (file: string) => resolveImage("images/fender-sn/" + file)!;
const img = (file: string) => assetSrc("images/fender-sn/" + file);

const PAGE_PATH = "/fender-pickup-dates/";
const HUB_PATH = "/fender-guitars-serial-number-guide/";
const HUB_HREF = HUB_PATH;

// ---- Data ----
const codeRows = [
  ["1159", "Trailing 9", "1969"],
  ["1139", "Trailing 9", "1969"],
  ["1140", "Trailing 0", "1970"],
  ["161377", "Trailing 77", "1977"],
  ["171578", "Trailing 78", "1978"],
  ["202378", "Trailing 78", "1978"],
];
const eraRows = [
  ["1950 to early 1964", "No date at all", "Fender did not date pickups in this era"],
  ["Early 1964", "A rubber stamp in yellow ink, month spelled out", "JAN 11 64, APR 11 64"],
  ["Mid-1964 into the late 1960s", "Handwritten in pencil or marker, numbers only", "1-15-64, 12-6-65"],
  ["About 1969 to 1979", "A black stamped code, three to six digits", "1139, 161377"],
  ["1980 on", "No date. A one-piece black plastic bobbin carrying a part number", "016730"],
];
const featureRows = [
  ["Telecaster poles", "Flush and even from 1950 until late 1955, when Fender raised the D and G poles together", "Flat poles mean either a pre-late-1955 Telecaster or a 1981 and later reissue"],
  ["Stratocaster poles", "Staggered from 1954, flat from about 1974, with 1972 to 1974 mixed", "Flat poles on a claimed 1960s Strat are wrong"],
  ["Jazzmaster poles", "Never staggered at the factory, sitting level or very slightly curved", "The cover has no pole holes, so this one needs the pickup lifted out", "/post/fender-jazzmaster-evolution-guide-1958-1971/"],
  ["Jaguar poles", "Flat in 1962 and 1963, staggered from 1964, settled by 1965", "The 1963 to 1964 window is genuinely mixed, so a flat-pole 1964 is not wrong on its own", "/post/vintage-fender-jaguar-guide/"],
  ["Bobbin color", "Black from 1950, light grey from March 1964, darker grey from about 1968, then black again through 1973 and 1974", "Grey on a claimed 1950s pickup is a red flag. Black on its own proves nothing"],
  ["Coil wire color", "Formvar, a golden orange, until 1964. Plain enamel, a dark burgundy, from 1964 on", "Readable at the edge of the coil without taking anything apart"],
  ["Magnet tops", "Sand cast, rough and pitted early on, smoother and squarer from the mid-1960s. The bevelled top edge on the staggered poles runs until the flat-pole change around 1974", "A crisp, clean, unbevelled magnet on a claimed 1950s pickup is wrong"],
  ["Lead wire", "Cloth covered pushback until about 1967, plastic from about 1968", "Cloth leads run well into 1968, so a cloth-lead 1968 pickup is fine"],
  ["Potting", "Dipped in hot wax early on, lacquered from the late 1960s, back to wax in late 1981", "A hard, shiny, lacquer-set coil on a claimed 1950s pickup is wrong"],
];

const tocItems: [string, string][] = [
  ["#what", "What A Pickup Date Is"],
  ["#find", "Where To Find It"],
  ["#pencil", "Handwritten And Stamped Dates"],
  ["#codes", "Numeric Codes"],
  ["#features", "How The Pickups Changed"],
  ["#golden", "The Golden Rule"],
  ["#limits", "What It Can't Prove"],
  ["#cross", "Cross-Check The Date"],
  ["#faq", "Common Questions"],
  ["#appraisal", "Free Expert Appraisal"],
  ["#about-joe", "About Joe"],
];

const faqs = [
  {
    q: "Do I Have To Take The Pickups Out To Read The Date?",
    a: "Yes. The date is on the base of the pickup, the flat bottom, so the pickup has to come out to see it. That means pulling the pickguard or the control plate the pickup hangs from and lifting the pickup clear. The coil is wound with hair-thin wire and the cloth leads go brittle with age, so go slow. If you aren't comfortable doing that, don't force it. Get in touch and I'll help, or bring the guitar by and I'll read it for you.",
  },
  {
    q: "My Pickup Has No Date. Does That Mean It Isn't Original?",
    a: "Not on its own. Pickup dating was never as consistent as the pot codes, so plenty of original pickups never got a clear date, and a faint pencil mark can be almost impossible to read. A rewind can also wipe the old date off. Treat a missing date as no information, not as proof of anything, and lean on the pot codes and the neck date instead.",
  },
  {
    q: "My Pickup Date Is Older Than My Serial Number. Is That A Problem?",
    a: "Usually not. Like a pot, a pickup was made on or before the day the guitar was assembled, so a pickup dated a little earlier than the build is exactly right. A pickup dated well after the rest of the guitar is the red flag, because that points to a replacement or a rewind.",
  },
  {
    q: "One Of My Pickups Reads A Different Date. What Does That Mean?",
    a: "On a two or three pickup guitar the pickups should date within a few months of each other. When one sits well off from the others, that odd one out is usually a replacement or a rewind, not the build date. Majority rules, the same way it does with the pot codes.",
  },
  {
    q: "Does A Pickup Date Prove My Guitar Is All Original?",
    a: "No. It dates that pickup. Originality is a whole-guitar judgment that weighs the pot codes, the neck date, the body date, the hardware, and the finish together. Send me three photos and I'll give you the real story for free.",
  },
];

// ---- Schema ----
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "How To Read Fender Pickup Date Codes And Date Your Guitar",
  description:
    "Read the pencil, ink, or numeric date on the base of your Fender's pickups to date the guitar, then cross-check it against the pot codes. A step-by-step pickup dating guide from a vintage Fender appraiser.",
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  image: `${SITE_URL}${img("1966-fender-stratocaster-pickup-dates.jpg")}`,
  datePublished: "2026-07-23",
  dateModified: "2026-07-23",
  inLanguage: "en-US",
