---
import GuideActions from '../components/GuideActions.astro';
import Layout from '../layouts/Layout.astro';
import LicensedImage from '../components/primitives/LicensedImage.astro';
import { getImage } from 'astro:assets';
import { Content } from '../content/value-guides/vintage-gibson-value-guide.md';
import data from '../data/value-guides/vintage-gibson-value-guide.json';
import { resolveImage } from '../lib/images';
import { SITE_URL } from '../config/site';

// Joe requested a photo-led model directory on October 21, 2026.
// Prices belong on the linked model guides; keep this hub free of value tables.
const hero = resolveImage(data.ogImage)!;
const og = await getImage({ src: hero, width: 1200 });
const models = data.models.map(model => ({ ...model, photo: resolveImage(model.image)! }));
const isPreview = import.meta.env.CF_PAGES_BRANCH
  ? import.meta.env.CF_PAGES_BRANCH !== 'main'
  : import.meta.env.DEV;
const structuredData = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  '@id': SITE_URL + data.url, name: data.h1, description: data.description,
  image: SITE_URL + og.src, datePublished: data.date, dateModified: data.modified,
  author: { '@id': SITE_URL + '/about-me/#person' },
  mainEntity: { '@type': 'ItemList', itemListElement: models.map((model, i) => ({
    '@type': 'ListItem', position: i + 1, name: model.name + ' Value Guide', url: SITE_URL + model.url
  })) }
}, {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: data.faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: data.h1, item: SITE_URL + data.url }
  ]
}];
---
<Layout title={data.title} description={data.description} canonical={data.url}
  ogImage={SITE_URL + og.src} ogImageWidth={og.attributes.width} ogImageHeight={og.attributes.height} ogImageAlt={data.alt}
  structuredData={structuredData} publishedTime={data.date} modifiedTime={data.modified}
  noIndex={isPreview} bodyClass="gvhub-page">
  <section class="gvhub-hero" aria-labelledby="gvhub-title">
    <div class="gvhub-hero-inner">
      <div class="gvhub-hero-copy">
        <p class="gvhub-eyebrow">From My Guitar Archive</p>
        <h1 id="gvhub-title">Vintage Gibson <br /><span>Value Guide</span></h1>
        <GuideActions brand="Gibson" />
        <p class="gvhub-intro">Choose your Gibson model to find its value guide. I've gathered the solidbody, ES, archtop and acoustic guides here so you can go straight to the year and condition that match yours.</p>
        <a class="gvhub-button" href="#vintage-gibson-values-by-model">Find Your Model <span aria-hidden="true">↓</span></a>
        <p class="gvhub-byline">By Joe Dampt <span aria-hidden="true">·</span> Updated October 2026</p>
      </div>
      <figure class="gvhub-hero-photo">
        <LicensedImage src={hero} alt={data.alt} width={1600} loading="eager" fetchpriority="high"
          sizes="(max-width: 900px) calc(100vw - 40px), (max-width: 1360px) 54vw, 710px" />
        <figcaption>A Goldtop Les Paul beside a pink-lined case. From my own photo archive.</figcaption>
      </figure>
    </div>
  </section>

  <nav class="gvhub-jump-links" aria-label="Gibson guide sections">
    <div>{data.groups.map(group => <a href={'#' + group.id}>{group.label}</a>)}<a href="#value-questions">Common Questions</a></div>
  </nav>

  {data.groups.map(group => (
    <section class="gvhub-models gvhub-container" id={group.id} aria-labelledby={group.key + '-heading'}>
      <div class="gvhub-section-heading">
        <p class="gvhub-eyebrow">Find Your Gibson Model</p>
        <h2 id={group.key + '-heading'}>{group.heading}</h2>
        <p>{group.intro}</p>
        {group.overviewUrl && <p class="gvhub-overview">{group.overviewText} <a href={group.overviewUrl}>{group.overviewLabel}</a>.</p>}
      </div>
      <div class:list={['gvhub-model-grid', { 'gvhub-model-grid-three': group.key === 'solidbody' }]}>
        {models.filter(model => model.group === group.key).map(model => (
          <div class="gvhub-card-wrap"><LicensedImage schemaOnly src={model.photo} alt={model.alt} width={900} /><a class="gvhub-model-card" href={model.url} aria-label={`${model.name} value guide`}>
            <div class="gvhub-card-photo"><LicensedImage emitSchema={false} src={model.photo} alt={model.alt} width={900} loading="lazy"
              style={'object-position:' + model.imagePosition}
              sizes={group.key === 'solidbody' ? '(max-width: 600px) calc(100vw - 40px), (max-width: 1100px) 45vw, 410px' : '(max-width: 600px) calc(100vw - 40px), (max-width: 1100px) 45vw, 300px'} /></div>
            <div class="gvhub-card-copy">
              <p class="gvhub-card-family">{model.family}</p>
              <h3>{model.name}</h3>
              <p class="gvhub-card-description">{model.description}</p>
              <span class="gvhub-card-link">Explore The Value Guide <span aria-hidden="true">→</span></span>
            </div>
          </a></div>
        ))}
      </div>
    </section>
  ))}

  <section class="gvhub-help" id="before-you-choose-a-range">
    <div class="gvhub-container gvhub-help-inner">
      <div class="gvhub-help-copy"><Content /></div>
      <aside class="gvhub-appraisal">
        <p class="gvhub-eyebrow">Your Guitar, Your Questions</p>
        <h2>Not Sure Which Gibson You Have?</h2>
        <p>Send me clear photos of the front, back, headstock and case, plus any history you know. I'll help you identify the model and work through an appraisal.</p>
        <a class="gvhub-button" href="/free-appraisal/">Ask Joe About Your Gibson <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section id="value-questions" class="gvhub-faq gvhub-container" aria-labelledby="gvhub-faq-heading">
    <p class="gvhub-eyebrow">Using The Guides</p>
    <h2 id="gvhub-faq-heading">Questions About Gibson Values</h2>
    <div class="gvhub-faq-list">{data.faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
</Layout>

<style>
  .gvhub-hero{background:var(--color-brand-brown);color:var(--color-brand-cream);padding:276px 28px 70px;border-bottom:5px solid var(--color-brand-rust)}
  .gvhub-hero-inner{max-width:1360px;margin:auto;display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:54px;align-items:center}
  .gvhub-eyebrow{font-size:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;line-height:1.5;margin:0 0 16px;color:var(--color-brand-rust-dark)}
  .gvhub-hero .gvhub-eyebrow{color:var(--color-brand-cream)}
  .gvhub-hero h1{font-family:var(--font-display);font-size:clamp(42px,4.2vw,66px);line-height:1.08;font-weight:600;margin:0 0 24px;color:white}
  .gvhub-hero h1 span{color:var(--color-brand-cream)}
  .gvhub-intro{font-size:18px;line-height:1.75;max-width:510px;margin:0 0 28px}
  .gvhub-button{display:inline-flex;align-items:center;justify-content:space-between;gap:26px;padding:14px 22px;background:var(--color-brand-cream);color:var(--color-brand-brown);font-weight:700;font-size:14px;line-height:1.5;text-decoration:none;border:1px solid var(--color-brand-cream);transition:background .18s,color .18s}
  .gvhub-button:hover{background:white;color:var(--color-brand-rust-dark)}
  .gvhub-button span{font-size:20px;line-height:1}
  .gvhub-byline{font-size:12px;line-height:1.6;margin:23px 0 0;color:var(--color-brand-cream)}
  .gvhub-byline span{padding:0 7px}
  .gvhub-hero-photo{margin:0;border:1px solid var(--color-brand-brown-tan);background:var(--color-brand-brown);box-shadow:0 20px 50px #0004}
  .gvhub-hero-photo :global(img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}
  .gvhub-hero-photo figcaption{padding:13px 18px;font-size:12px;line-height:1.6;color:var(--color-brand-cream)}
  .gvhub-jump-links{background:var(--color-brand-parchment);border-bottom:1px solid var(--color-brand-brown-tan)}
  .gvhub-jump-links>div{display:flex;gap:35px;max-width:1280px;margin:auto;padding:18px 28px;flex-wrap:wrap}
  .gvhub-jump-links a{font-size:13px;font-weight:700;color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:5px}
  .gvhub-container{max-width:1336px;margin:0 auto;padding-left:28px;padding-right:28px}
  .gvhub-models{padding-top:68px;padding-bottom:56px;scroll-margin-top:24px}.gvhub-models+.gvhub-models{padding-top:36px;border-top:1px solid var(--color-brand-brown-tan)}.gvhub-model-grid-three{grid-template-columns:repeat(3,minmax(0,1fr))!important}.gvhub-overview{font-size:15px;line-height:1.8;margin:18px 0 0;color:var(--color-brand-charcoal)}.gvhub-overview a{color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
  .gvhub-section-heading{max-width:720px;margin-bottom:34px}
  h2{font-family:var(--font-display);font-size:clamp(30px,3vw,40px);line-height:1.2;font-weight:600;color:var(--color-brand-brown);margin:0 0 20px}
  .gvhub-section-heading>p:last-child{font-size:17px;line-height:1.8;color:var(--color-brand-charcoal);margin:0}
  .gvhub-model-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
  .gvhub-card-wrap{display:flex;min-width:0}.gvhub-model-card{display:flex;flex:1;flex-direction:column;border:1px solid var(--color-brand-brown-tan);background:white;color:var(--color-brand-brown);text-decoration:none;transition:border-color .18s,box-shadow .18s;min-width:0}
  .gvhub-model-card:hover{border-color:var(--color-brand-rust);box-shadow:0 8px 24px #36241614}
  .gvhub-card-photo{overflow:hidden;background:var(--color-brand-brown)}
  .gvhub-card-photo :global(img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}
  .gvhub-card-copy{display:flex;flex-direction:column;flex:1;padding:23px 22px 21px}
  .gvhub-card-family{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--color-brand-rust-dark);margin:0 0 9px}
  .gvhub-card-copy h3{font-family:var(--font-display);font-size:29px;font-weight:600;line-height:1.15;margin:0 0 14px}
  .gvhub-card-description{font-size:14px;line-height:1.75;color:var(--color-brand-charcoal);margin:0 0 24px}
  .gvhub-card-link{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:auto;padding-top:16px;border-top:1px solid var(--color-brand-brown-tan);font-size:12px;font-weight:700;color:var(--color-brand-rust-dark)}
  .gvhub-card-link span{font-size:21px;font-weight:400}
  .gvhub-model-card:hover .gvhub-card-link{text-decoration:underline;text-underline-offset:3px}
  a:focus-visible,summary:focus-visible{outline:3px solid var(--color-brand-rust);outline-offset:5px}
  .gvhub-help{background:var(--color-brand-parchment);padding:64px 0;scroll-margin-top:24px;border-top:1px solid var(--color-brand-brown-tan);border-bottom:1px solid var(--color-brand-brown-tan)}
  .gvhub-help-inner{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:80px;align-items:start}
  .gvhub-help-copy :global(h2){font-family:var(--font-display);font-size:32px;line-height:1.25;color:var(--color-brand-brown);font-weight:600;margin:0 0 22px}
  .gvhub-help-copy :global(p){font-size:16px;line-height:1.85;color:var(--color-brand-charcoal);margin:0 0 20px}
  .gvhub-help-copy :global(a){color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
  .gvhub-appraisal{background:var(--color-brand-brown);padding:34px;color:var(--color-brand-cream);border-top:4px solid var(--color-brand-rust)}
  .gvhub-appraisal .gvhub-eyebrow,.gvhub-appraisal h2{color:var(--color-brand-cream)}
  .gvhub-appraisal h2{font-size:30px}
  .gvhub-appraisal>p:not(.gvhub-eyebrow){font-size:15px;line-height:1.85;margin:0 0 25px}
  .gvhub-faq{padding-top:68px;padding-bottom:80px;scroll-margin-top:24px}
  .gvhub-faq-list{max-width:900px;margin-top:30px}
  .gvhub-faq details{border-top:1px solid var(--color-brand-brown-tan);padding:22px 0}
  .gvhub-faq details:last-child{border-bottom:1px solid var(--color-brand-brown-tan)}
  .gvhub-faq summary{font-family:var(--font-display);font-size:23px;line-height:1.4;color:var(--color-brand-brown);cursor:pointer;padding-right:15px}
  .gvhub-faq details p{font-size:16px;line-height:1.8;max-width:760px;margin:16px 0 0;color:var(--color-brand-charcoal)}
  @media(min-width:1620px){.gvhub-hero{padding-top:210px}}
  @media(max-width:1100px){.gvhub-model-grid-three{grid-template-columns:repeat(2,minmax(0,1fr))!important}.gvhub-model-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.gvhub-hero-inner{gap:32px}.gvhub-help-inner{gap:40px}}
  @media(max-width:900px){.gvhub-hero{padding-top:210px}.gvhub-hero-inner{grid-template-columns:1fr;gap:36px;max-width:700px}.gvhub-hero-copy{max-width:620px}.gvhub-hero h1 br{display:none}.gvhub-hero h1 span::before{content:' '}.gvhub-intro{max-width:620px}.gvhub-help-inner{grid-template-columns:1fr;gap:30px}.gvhub-appraisal{max-width:620px}}
  @media(max-width:639px){.gvhub-model-grid-three{grid-template-columns:1fr!important}.gvhub-hero{padding:160px 20px 38px}.gvhub-hero h1{font-size:43px}.gvhub-intro{font-size:16px;line-height:1.8}.gvhub-jump-links>div{gap:20px;padding:17px 20px}.gvhub-jump-links a{font-size:12px}.gvhub-container{padding-left:20px;padding-right:20px}.gvhub-models,.gvhub-faq{padding-top:42px;padding-bottom:46px}.gvhub-model-grid{grid-template-columns:1fr;gap:24px}.gvhub-section-heading{margin-bottom:26px}.gvhub-card-copy{padding:22px}.gvhub-help{padding:42px 0}.gvhub-appraisal{padding:27px}.gvhub-faq summary{font-size:21px}}
  @media(prefers-reduced-motion:reduce){.gvhub-button,.gvhub-model-card{transition:none}}
</style>
