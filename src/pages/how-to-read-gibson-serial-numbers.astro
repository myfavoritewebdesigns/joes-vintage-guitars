const IMG = "/images/gibson-serial";

// Floating in-page nav (matches live's jvg-nav). Two labeled groups + a top link.
const navEras = [
  { href: "#fon", label: "Factory Order Numbers (1902–1945)" },
  { href: "#white-label", label: "White Label Era (1947–1961)" },
  { href: "#a-prefix", label: "A-Prefix Era (1947–1961)" },
  { href: "#ink-stamp", label: "Ink Stamp Era (1952–1960)" },
  { href: "#reused", label: "Reused Numbers Era (1961–1970)" },
  { href: "#norlin", label: "Norlin Era (1970–1975)" },
  { href: "#present", label: "Modern Serialization (1977–Present)" },
  { href: "#classic", label: "Les Paul Classic (1989–2014)" },
