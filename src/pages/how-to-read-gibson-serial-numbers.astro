              <tr><td>7</td><td>1957 Les Paul Standard, Les Paul Custom, Les Paul Jr Single Cut, Les Paul Special Single Cut</td></tr>
              <tr><td>8</td><td>1958 Les Paul Standard, Les Paul Jr Double Cut, Korina Flying V, Korina Explorer</td></tr>
