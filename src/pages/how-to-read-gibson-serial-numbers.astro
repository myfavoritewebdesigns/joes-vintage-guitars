---
import GibsonGuideLayout from '../layouts/GibsonGuideLayout.astro';
import '../styles/serial-hero.css';
import SerialPhotos from '../components/SerialPhotos.astro';
import SerialGuideLinks from '../components/SerialGuideLinks.astro';
import SerialCrossCheckHub from '../components/SerialCrossCheckHub.astro';
import LicensedImage from '../components/LicensedImage.astro';
import locationLabel from '../assets/serial-locations/interior-label.jpg';
import locationInk from '../assets/serial-locations/ink-stamp.jpg';
import locationWood from '../assets/serial-locations/wood-stamp.jpg';
import PhotoViewer from '../components/PhotoViewer.astro';
import SpecialFormatGuides from '../components/SpecialFormatGuides.astro';
import {
  whiteLabelRows, aPrefixRows, reusedRows, reusedRangeData, earlyFonRows, suffixFonRows,
  wartimeFonRows, prefixFonRows, specialRows, faqs,
} from '../data';

const siteUrl = 'https://www.joesvintageguitarsaz.com';
const canonicalUrl = `${siteUrl}/how-to-read-gibson-serial-numbers/`;
const pageTitle = 'Gibson Serial Number Lookup: Free Decoder & Year Charts';
const pageDescription = 'Free Gibson serial number lookup. Decode serials and FONs from 1902 to today, including reused 1960s ranges and Custom Shop, Historic and Classic formats.';
const ogImage = `${siteUrl}/images/og/1955-gibson-les-paul-custom-ink-stamp-serial-number-scaled.jpg`;
const personId = `${siteUrl}/about-me/#person`;
const organizationId = `${siteUrl}/#organization`;
const whiteLabelSplit = Math.ceil(whiteLabelRows.length / 2);
const whiteLabelPairs = Array.from({ length: whiteLabelSplit }, (_, index) => ({
  left: whiteLabelRows[index],
  right: whiteLabelRows[index + whiteLabelSplit],
}));
const aPrefixPairs = Array.from({ length: 8 }, (_, index) => ({
  left: aPrefixRows[index],
  right: aPrefixRows[index + 8],
}));
const reusedSplit = Math.ceil(reusedRows.length / 2);
const reusedPairs = Array.from({ length: reusedSplit }, (_, index) => ({
  left: reusedRows[index],
  right: reusedRows[index + reusedSplit],
}));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: "Joe's Vintage Guitars",
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/joes-vintage-guitars-logo.jpg`,
        width: 1440,
        height: 1440,
        creditText: "Joe Dampt, Joe's Vintage Guitars",
        copyrightNotice: "© Joe's Vintage Guitars. All rights reserved.",
        license: `${siteUrl}/photo-license/#brand-assets`,
        acquireLicensePage: `${siteUrl}/photo-license/#brand-assets`,
      },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Joe Dampt',
      url: `${siteUrl}/about-me/`,
      jobTitle: 'Owner and Lead Appraiser',
      image: { '@type': 'ImageObject', url: `${siteUrl}/images/about-me-joe-1.jpg`, width: 587, height: 587 },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Arizona State University', url: 'https://www.asu.edu/' },
      sameAs: [
        'https://www.youtube.com/@joesvintageguitars',
        'https://www.instagram.com/joesvintageguitarsaz/',
        'https://www.facebook.com/joesvintageguitars/',
        'https://reverb.com/shop/joe-s-gear-emporium-4',
      ],
      worksFor: { '@id': organizationId },
    },
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      headline: pageTitle,
      description: pageDescription,
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      image: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 2560,
        height: 1707,
      },
      author: { '@id': personId },
      publisher: { '@id': organizationId },
      datePublished: '2026-03-12T20:06:33+00:00',
      dateModified: '2026-09-16T00:00:00-07:00',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Gibson Serial Number Lookup', item: canonicalUrl },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': `${canonicalUrl}#lookup`,
      name: 'Gibson Serial Number Lookup',
      url: canonicalUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      description: 'A free Gibson guitar serial number and Factory Order Number decoder with reference charts.',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      author: { '@id': personId },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question', name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
    {
      '@type': 'VideoObject',
      '@id': `${canonicalUrl}#serial-location-video`,
      name: 'Where to Find the Serial Number on a Gibson Guitar',
      description: 'Joe Dampt shows where to find serial numbers on Gibson electric and acoustic guitars.',
      thumbnailUrl: ['https://i.ytimg.com/vi/oxvMHi23bZc/maxresdefault.jpg'],
      uploadDate: '2026-01-13T13:25:56-08:00',
      duration: 'PT1M48S',
      embedUrl: 'https://www.youtube-nocookie.com/embed/oxvMHi23bZc',
      contentUrl: 'https://www.youtube.com/watch?v=oxvMHi23bZc',
      author: { '@id': personId },
    },
  ],
};
---

<GibsonGuideLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt="Ink-stamped serial number on a 1955 Gibson Les Paul Custom headstock"
  ogImageWidth={2560}
  ogImageHeight={1707}
  publishedTime="2026-03-12T20:06:33+00:00"
  modifiedTime="2026-09-16T00:00:00-07:00"
  structuredData={schema}
  bodyClass="gibson-serial-page"
  youtubeLite
>
    <a href="#decoder" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-cream focus:px-4 focus:py-2">Skip to decoder</a>

    <div>
      <section class="relative overflow-hidden bg-ink text-paper" id="decoder">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-light to-transparent"></div>
        <div class="serial-hero-layout mx-auto grid max-w-[88rem] gap-12 px-5 pb-12 pt-40 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:px-10 lg:pb-20 lg:pt-60">
          <div class="serial-hero-heading relative max-w-2xl">
            <p class="mb-5 flex items-center gap-3 text-xs font-extrabold uppercase tracking-[0.24em] text-gold-light"><span class="h-px w-10 bg-gold-light"></span>Free reference tool</p>
            <h1 class="font-display text-[clamp(2.8rem,6vw,5.9rem)] leading-[0.91] tracking-[-0.045em] text-white">Gibson Serial <br /><em class="font-normal text-gold-light">Number Lookup</em></h1>
          </div>

          <div class="tool-card relative rounded-[1.75rem] border border-gold/45 bg-wine-dark p-3 sm:p-5">
            <div class="rounded-[1.25rem] border border-white/10 bg-[#4a3828] p-5 sm:p-8">
              <div class="mb-7 flex items-start justify-between gap-5">
                <div><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-gold-light">Start here</p><h2 class="mt-2 font-display text-3xl leading-tight text-white sm:text-4xl">What Number Do You Have?</h2></div>
              </div>

              <form id="lookup-form" novalidate>
                <fieldset>
                  <legend class="mb-3 text-sm font-bold text-paper/70">Choose a number type</legend>
                  <div class="grid grid-cols-2 gap-2 rounded-2xl bg-black/20 p-1.5">
                    <button type="button" class="mode-button rounded-xl border border-transparent px-3 py-3 text-sm font-extrabold text-paper/70 transition" data-mode="serial" role="radio" aria-checked="true">Serial number</button>
                    <button type="button" class="mode-button rounded-xl border border-transparent px-3 py-3 text-sm font-extrabold text-paper/70 transition" data-mode="fon" role="radio" aria-checked="false">Factory Order No.</button>
                  </div>
                  <a href="#serial-vs-fon" class="mt-3 inline-block text-sm font-bold text-gold-light underline underline-offset-4">The Difference Between Serial Number and FON</a>
                </fieldset>

                <div id="location-wrap" class="mt-5">
                  <label for="location-select" class="mb-2 block text-sm font-bold text-paper">Where is the number?</label>
                  <select id="location-select" class="w-full rounded-xl border border-white/15 bg-[#3e2a14] px-4 py-3 text-paper">
                    <option value="unknown">Not sure</option><option value="label">On an interior paper label</option><option value="ink">Ink-stamped on the headstock</option><option value="wood-no-usa">Pressed into wood, no “Made in USA”</option><option value="wood-usa">Pressed into wood, with “Made in USA”</option><option value="decal">On a rear-headstock decal</option>
                  </select>
                </div>

                <label id="number-label" for="serial-input" class="mt-5 block text-sm font-bold text-paper">Enter your serial number</label>
                <a id="serial-location-link" href="#find-number" class="mt-2 inline-flex text-sm font-bold text-gold-light underline decoration-gold/50 underline-offset-4">Where Do I Find the Serial Number?</a>
                <div class="mt-2 flex flex-col gap-3 sm:flex-row">
                  <input id="serial-input" name="serial" class="serial-input min-h-14 min-w-0 flex-1 rounded-xl border border-white/15 bg-black/25 px-5 font-mono text-xl tracking-[0.12em] text-white uppercase focus:border-gold-light" placeholder="e.g. 70108276" autocomplete="off" inputmode="text" />
                  <button type="submit" class="min-h-14 rounded-xl bg-gold-light px-6 font-extrabold text-wine-dark transition hover:bg-[#e0c38e]">Decode <span aria-hidden="true">→</span></button>
                </div>

                <button type="button" id="special-toggle" class="mt-5 flex w-full items-center justify-between rounded-xl border border-white/12 px-4 py-3 text-left text-sm text-paper/68 transition hover:border-gold/50 hover:text-white" aria-expanded="false" aria-controls="special-panel">
                  <span><strong class="block text-paper">Custom Shop, Reissue, or Limited Edition?</strong><span class="text-sm">Choose a model-specific format</span></span><span aria-hidden="true" class="text-gold-light">+</span>
                </button>
                <div id="special-panel" class="special-panel mt-3 rounded-xl border border-white/10 bg-black/15 p-3" hidden>
                  <label for="model-select" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-paper/60">Special format</label>
                  <select id="model-select" class="w-full rounded-xl border border-white/15 bg-[#3e2a14] px-4 py-3 text-paper">
                    <option value="">Standard serial or help choosing a format</option>
                    <option value="cs">CS-prefix Custom Shop</option>
                    <option value="lp-reissue">Historic Les Paul Reissue, 1954 to 1960</option>
                    <option value="korina-reissue">Historic 1958 Korina Flying V or Explorer</option>
                    <option value="sg-reissue">Impressed SG, Firebird or Other Reissue</option>
                    <option value="es-61-64">1961 or 1964 ES Reissue</option>
                    <option value="es-63">1963 ES-335 Reissue</option>
                    <option value="es-58">1958 ES-335 Reissue</option>
                    <option value="es-59">1959 ES Reissue</option>
                    <option value="carved-top">Carved-top Custom Shop</option>
                    <option value="lp-classic">Les Paul Classic, 1989 to 2014</option>
                    <option value="artist">Artist Signature Edition</option>
                    <option value="collectors-choice">Collector’s Choice</option>
                    <option value="centennial">1994 Centennial Collection Limited Edition</option>
                    <option value="early-reissue">Guitar Trader or Other Early Les Paul Reissue</option>
                    <option value="heritage-80">Heritage Standard 80 or 80 Elite</option>
                    <option value="heritage-v">Early-1980s Heritage Korina Flying V</option>
                    <option value="heritage-explorer">Early-1980s Heritage Korina Explorer</option>
                    <option value="anniversary-25-50">Les Paul 25/50 Anniversary</option>
                    <option value="unknown-special">My Model or Format Is Not Listed</option>
                  </select>
                  <p id="model-hint" class="mt-2 text-xs leading-relaxed text-paper/55"></p>
                </div>

              <div id="result-panel" class="result-panel mt-5 rounded-2xl border border-gold/35 bg-[#3e2a14] p-5" tabindex="-1" aria-live="polite" aria-atomic="true" hidden>
                <div class="flex items-center justify-between gap-4"><p class="text-xs font-extrabold uppercase tracking-[0.18em] text-gold-light">Lookup result</p><span id="confidence-badge" class="rounded-full border border-white/15 px-2.5 py-1 text-[0.65rem] font-extrabold uppercase tracking-[0.12em] text-paper/65"></span></div>
                <h3 id="result-title" class="mt-3 font-display text-3xl leading-tight text-white"></h3><div id="result-copy" class="mt-2 text-sm leading-relaxed text-paper/70"></div>
                <a id="result-cross-check-link" href="#dating-hub" class="group mt-5 flex w-full items-center justify-between gap-4 rounded-xl border border-gold-light/70 bg-gold-light px-5 py-3.5 font-extrabold text-wine-dark no-underline transition hover:border-[#e0c38e] hover:bg-[#e0c38e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-light">
                  <span>Cross-Check With Other Features</span><span class="text-xl leading-none transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
                <a id="result-chart-link" href="#charts" class="mt-4 inline-flex text-sm font-bold text-gold-light underline decoration-gold/50 underline-offset-4">Check the matching chart ↓</a><button id="reset-button" type="button" class="ml-5 mt-4 text-sm font-bold text-paper/60 underline decoration-white/20 underline-offset-4">Start over</button>
              </div>
                <div id="followup-panel" class="lookup-followup" hidden>
                  <h3>Check These Details</h3>
                  <p>Answer what you can confirm. A preliminary vintage-chart result can change when you identify a reissue or another format.</p>
                  <div id="followup-fields"></div>
                  <button type="submit" class="mt-4 rounded-xl bg-gold-light px-5 py-3 font-bold text-wine-dark">Update Result</button>
                </div>
                <p id="form-error" class="mt-3 text-sm text-[#f2b8b5]" role="alert"></p>
              </form>
            </div>
            <p class="px-4 pb-1 pt-4 text-center text-xs leading-relaxed text-paper/52">Serial ranges are estimates. Cross-check valuable instruments before buying or selling.</p>
          </div>
          <div class="serial-hero-intro relative max-w-2xl">
            <p class="max-w-xl text-lg leading-relaxed text-paper/74 md:text-xl">Use our comprehensive tool to decode your Gibson serial number. Make sure to cross-reference features and parts using our <a class="font-bold text-gold-light underline decoration-gold/50 underline-offset-4" href="#dating-hub">advanced dating guides below</a>, since serial numbers are not always 100 percent accurate. As always, feel free to <a class="font-bold text-gold-light underline decoration-gold/50 underline-offset-4" href="https://www.joesvintageguitarsaz.com/contact-me/">reach out to us</a> if you need help dating a guitar.</p>
            <a href="#charts" class="mt-4 inline-block font-bold text-gold-light underline decoration-gold/50 underline-offset-4">Jump straight to the charts</a>
            <div class="mt-8 flex flex-wrap gap-x-7 gap-y-3 border-t border-white/12 pt-5 text-sm text-paper/62"><span><strong class="text-white">1902 to today</strong> systems</span><span><strong class="text-white">FON</strong> support</span><span><strong class="text-white">No signup</strong></span></div>
            <p class="mt-6 text-sm text-paper/58">Written and reviewed by <a class="font-bold text-gold-light underline decoration-gold/50 underline-offset-4" href="https://www.joesvintageguitarsaz.com/about-me/">Joe Dampt</a><span class="mx-2 text-paper/30">•</span>Updated September 16, 2026</p>
          </div>
        </div>
      </section>

      <section id="digit-count-formats" class="border-b border-rule bg-cream py-8" aria-labelledby="digit-count-heading">
        <div class="mx-auto grid max-w-[88rem] gap-6 px-5 lg:grid-cols-[19rem_minmax(0,1fr)] lg:items-center lg:px-10">
          <div>
            <p class="eyebrow">Quick Format Guide</p>
            <h2 id="digit-count-heading" class="font-display text-3xl leading-tight text-wine-dark">Find Your Format By Digit Count</h2>
          </div>
          <div class="table-card">
            <table class="dense-table">
              <thead><tr><th>Number</th><th>Likely Systems</th><th>Compare</th></tr></thead>
              <tbody>
                <tr><td data-label="Number">3 to 6 digits</td><td data-label="Likely Systems">Vintage labels, FONs, ink stamps and reused ranges</td><td class="format-compare-actions" data-label="Compare"><a class="format-compare-link" href="#fon">Vintage Charts</a></td></tr>
                <tr><td data-label="Number">8 digits</td><td data-label="Likely Systems">1970s decals or modern date codes</td><td class="format-compare-actions" data-label="Compare"><a class="format-compare-link" href="#norlin">Decals</a><a class="format-compare-link" href="#modern">Modern</a></td></tr>
                <tr><td data-label="Number">9 digits</td><td data-label="Likely Systems">Modern batch or 2014 to mid-2019 model-year format</td><td class="format-compare-actions" data-label="Compare"><a class="format-compare-link" href="#modern">9-Digit Charts</a></td></tr>
                <tr><td data-label="Number">Letter prefixes</td><td data-label="Likely Systems">A-prefix, FON, Custom Shop or special formats</td><td class="format-compare-actions" data-label="Compare"><a class="format-compare-link" href="#a-prefix">A-Prefix</a><a class="format-compare-link" href="#special">Special Formats</a></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <SerialCrossCheckHub />

      <section id="find-number" class="border-y border-rule bg-ink py-16 text-paper">
        <div class="mx-auto max-w-[88rem] px-5 lg:px-10">
          <div class="max-w-3xl">
            <p class="eyebrow !text-gold-light">Need Help Finding the Number?</p>
            <h2 class="section-title !text-white">Where to Find a Gibson Serial Number</h2>
            <p class="mt-4 text-lg text-paper/65">The location and application method of a Gibson serial number will tell you which numbering system to use. Some Gibson guitars do not have a serial number. If yours does not, check for a <a class="font-bold text-gold-light underline decoration-gold/50 underline-offset-4" href="#fon">Factory Order Number instead</a>.</p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <article class="location-card"><LicensedImage src={locationLabel} widths={[180, 360]} sizes="(max-width: 767px) min(360px, calc(100vw - 40px)), 360px" alt="Gibson serial number on an interior paper label" /><div><h3>Interior Label</h3><p>Look through the soundhole or f-hole. Note the label color and whether the number begins with a letter.</p></div></article>
            <article class="location-card"><LicensedImage src={locationInk} widths={[180, 360]} sizes="(max-width: 767px) min(360px, calc(100vw - 40px)), 360px" alt="Ink-stamped Gibson serial number on a headstock" /><div><h3>Ink Stamp</h3><p>Common on 1950s solidbodies. The digits sit on top of the finish rather than being pressed into the wood.</p></div></article>
            <article class="location-card"><LicensedImage src={locationWood} widths={[180, 360]} sizes="(max-width: 767px) min(360px, calc(100vw - 40px)), 360px" alt="Gibson serial number pressed into the headstock wood" /><div><h3>Pressed Into Wood</h3><p>Check whether “Made in USA” appears below it. That detail separates many 1960s and 1970s sequences.</p></div></article>
          </div>

          <div class="mt-8 grid gap-6 lg:grid-cols-2 lg:items-stretch">
            <article class="answer-card">
              <p class="eyebrow">Quick answer</p>
              <h3 class="mt-2">Where Is the Serial Number on a Gibson Guitar?</h3>
              <p>Most Gibson solidbody and semi-hollow guitars have a serial number on the back of the headstock. Vintage acoustics and hollow-body electrics may have it on an interior paper label visible through the soundhole or f-holes. Older instruments can also have a Factory Order Number stamped on bare wood inside the body.</p>
            </article>

            <aside class="video-card" aria-labelledby="video-heading">
              <div class="video-card__copy">
                <p class="eyebrow !text-gold-light">Video guide</p>
                <h3 id="video-heading">Watch Joe Show You Where to Look</h3>
                <p>Joe points out the serial number locations on Gibson electric and acoustic guitars.</p>
              </div>
              <div class="video-card__embed">
                <lite-youtube videoid="oxvMHi23bZc" params="rel=0&modestbranding=1" playlabel="Play: Where to Find the Serial Number on a Gibson Guitar"></lite-youtube>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section id="serial-vs-fon" class="scroll-mt-5 border-b border-rule bg-cream py-12" aria-labelledby="serial-vs-fon-heading" tabindex="-1">
        <div class="mx-auto max-w-[88rem] px-5 lg:px-10">
          <h2 id="serial-vs-fon-heading" class="max-w-4xl font-display text-3xl leading-tight text-wine-dark lg:text-4xl">What’s the Difference Between a Gibson Serial Number and a Factory Order Number?</h2>
          <dl class="mt-7 grid gap-6 md:grid-cols-2 md:gap-10">
            <div>
              <dt class="font-display text-2xl text-wine-dark">Serial Number</dt>
              <dd class="mt-2 text-base leading-relaxed text-ink">A serial number is assigned to an individual guitar. Look for it either on an interior paper label or on the back of the headstock. Gibson reused some serial ranges, so the number alone may not identify one year.</dd>
            </div>
            <div>
              <dt class="font-display text-2xl text-wine-dark">Factory Order Number (FON)</dt>
              <dd class="mt-2 text-base leading-relaxed text-ink">A FON tracked a batch of instruments through the factory. Look for it written or stamped directly on the bare wood inside the guitar, rather than on a paper label. It may include a year code, a batch number, and the guitar’s position within that batch. The format varies by era.</dd>
            </div>
          </dl>
          <div class="mt-7"><SerialPhotos section="number-types" /></div>
          <p class="mt-7 border-t border-rule pt-5 text-base leading-relaxed text-ink"><strong>Some older Gibsons have both numbers; others have only a FON.</strong> On older models carrying both, the FON was assigned at the start of production and the serial recorded later, before shipping. Check both against the guitar’s features rather than treating either as an exact completion date.</p>
          <p class="mt-3 text-base leading-relaxed text-ink">In the <a href="#lookup-form" class="font-bold text-wine-dark underline underline-offset-4">lookup tool</a>, choose “Serial number” for the serial or “Factory Order No.” for the FON. If you have both, enter each separately.</p>
        </div>
      </section>

      <section id="charts" class="border-b border-rule bg-cream">
        <div class="mx-auto flex max-w-[88rem] flex-col gap-5 px-5 py-7 lg:flex-row lg:items-center lg:justify-between lg:px-10">
          <div><p class="text-xs font-extrabold uppercase tracking-[0.18em] text-wine">The full reference</p><h2 class="font-display text-2xl text-ink md:text-3xl">Gibson Serial Number Charts by Year</h2></div>
          <nav aria-label="Chart shortcuts" class="flex flex-wrap gap-2 text-sm font-bold"><a href="#fon" class="chart-chip">FON</a><a href="#white-label" class="chart-chip">White label</a><a href="#a-prefix" class="chart-chip">A-prefix</a><a href="#reused" class="chart-chip">1960s</a><a href="#modern" class="chart-chip">Modern</a></nav>
        </div>
      </section>

      <section class="mx-auto max-w-[88rem] px-5 py-16 lg:px-10">
        <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
          <aside class="hidden lg:block">
            <div class="sticky top-6 rounded-2xl border border-rule bg-cream p-5">
              <p class="eyebrow">Jump to an era</p>
              <ol class="mt-4 space-y-1 text-sm font-bold text-ink/68">
                <li><a href="#fon" class="toc-link">Factory Order Numbers</a></li><li><a href="#white-label" class="toc-link">White label, 1903 to 47</a></li><li><a href="#a-prefix" class="toc-link">A-prefix, 1947 to 61</a></li><li><a href="#ink-stamp" class="toc-link">Ink stamp, 1953 to 61</a></li><li><a href="#reused" class="toc-link">Reused, 1961 to 70</a></li><li><a href="#norlin" class="toc-link">Norlin, 1970 to 77</a></li><li><a href="#modern" class="toc-link">Modern, 1977 to today</a></li><li><a href="#special" class="toc-link">Special formats</a></li>
              </ol>
              <div class="mt-6 border-t border-rule pt-5 text-sm leading-relaxed text-ink/60">Not sure which chart applies? Set the number location in the lookup tool. It is often the deciding clue.</div>
            </div>
          </aside>

          <div class="min-w-0 space-y-8">
            <div class="max-w-3xl"><p class="eyebrow">Serial number charts</p><h2 class="section-title">How to Read Gibson Serial Numbers and FONs</h2><p class="mt-4 text-lg text-ink/65">Gibson changed numbering systems repeatedly, and some ranges overlap. Match the number’s format, location, and application method before choosing a chart.</p></div>

            <article id="fon" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1902 to 1961</p><h2 class="mt-1 font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-none tracking-[-0.025em]">Gibson Factory Order Numbers, 1902 to 1961</h2></div><p>Usually stamped inside the body. A FON may identify a production batch even when the guitar has no serial number.</p></div>
              <SerialPhotos section="fon" />
              <div class="grid gap-5 xl:grid-cols-2">
                <div class="table-card"><h4>Early Numeric Series</h4><table><thead><tr><th>Period</th><th>FON range</th><th>Note</th></tr></thead><tbody>{earlyFonRows.map(row => <tr>{row.map((cell, index) => <td data-label={['Period', 'FON Range', 'Note'][index]}>{cell}</td>)}</tr>)}</tbody></table></div>
                <div class="table-card"><h4>1935 to 1942 Suffix Letters</h4><table><thead><tr><th>Suffix</th><th>Year</th></tr></thead><tbody>{suffixFonRows.map(row => <tr>{row.map((cell, index) => <td data-label={['Suffix', 'Year'][index]}>{cell}</td>)}</tr>)}</tbody></table></div>
                <div class="table-card"><h4>Wartime and Postwar Ranges</h4><table><thead><tr><th>Year</th><th>Approximate FON</th></tr></thead><tbody>{wartimeFonRows.map(row => <tr>{row.map((cell, index) => <td data-label={['Year', 'Approximate FON'][index]}>{cell}</td>)}</tr>)}</tbody></table></div>
                <div class="table-card"><h4>1952 to 1961 Prefix Letters</h4><table><thead><tr><th>Prefix</th><th>Year</th></tr></thead><tbody>{prefixFonRows.map(row => <tr>{row.map((cell, index) => <td data-label={['Prefix', 'Year'][index]}>{cell}</td>)}</tr>)}</tbody></table></div>
              </div>
              <p class="chart-note"><strong>Use the first suffix letter:</strong> If the FON has two letters as a suffix rather than one, use the first of the two letters to date the guitar. For example, if the FON is 1247CG, the C is used for dating, so the guitar dates to 1937.</p>
            <p class="chart-note">For a J-200 with an interior FON, compare the number with the <a href="https://www.joesvintageguitarsaz.com/post/gibson-j200-model-history-authentication-guide/">J-200 model history</a> and its construction changes.</p>
            </article>

            <article id="white-label" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1903 to 1947</p><h3>Gibson White-Label Serial Numbers, 1903 to 1947</h3></div><p>Sequential serials printed or written on the oval white label. Ranges are approximate and should be read with the instrument’s features. Some later white-label serial numbers have an A prefix. If yours does, continue to the <a href="#a-prefix">A-prefix chart</a>.</p></div>
              <SerialPhotos section="white-label" />
              <div class="table-card"><table class="dense-table"><thead><tr><th>Year</th><th>Serial range</th><th>Year</th><th>Serial range</th></tr></thead><tbody>{whiteLabelPairs.map(({ left, right }) => <tr><td data-label="Year">{left?.[0]}</td><td data-label="Serial Range">{left?.[1]}</td><td data-label="Year">{right?.[0]}</td><td data-label="Serial Range">{right?.[1]}</td></tr>)}</tbody></table></div>
            <p class="chart-note">For hollowbody electrics, use the <a href="https://www.joesvintageguitarsaz.com/post/gibson-es-125-guide/">ES-125 guide</a> or <a href="https://www.joesvintageguitarsaz.com/post/gibson-es-175-evolution-and-specifications/">ES-175 guide</a> to check whether the model and features agree with the label.</p>
            </article>

            <article id="a-prefix" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1947 to 1961</p><h3>Gibson A-Prefix Serial Numbers, 1947 to 1961</h3></div><p>A-prefix serial numbers are found on white or orange interior labels. On rare occasions, I have seen factory Gibson acoustic guitars from the late 1960s and early 1970s with an impressed A-prefix serial number on the back of the headstock. These impressed A-prefix numbers have no known dating system. The chart below refers only to serial numbers on an interior label.</p></div>
              <SerialPhotos section="a-prefix" />
              <div class="table-card"><table><thead><tr><th>Year</th><th>Serial range</th><th>Year</th><th>Serial range</th></tr></thead><tbody>{aPrefixPairs.map(({ left, right }) => <tr><td data-label="Year">{left?.[0]}</td><td data-label="Serial Range">{left?.[1]}</td><td data-label="Year">{right?.[0]}</td><td data-label="Serial Range">{right?.[1]}</td></tr>)}</tbody></table></div>
            <p class="chart-note">Match the serial to the right model: the <a href="https://www.joesvintageguitarsaz.com/post/gibson-byrdland-authentication-guide/">Byrdland</a>, <a href="https://www.joesvintageguitarsaz.com/post/gibson-es-225-guide/">ES-225</a> and <a href="https://www.joesvintageguitarsaz.com/post/1959-gibson-es-335-authentication-guide/">1959 ES-335</a> guides explain different construction and hardware clues within this period.</p>
            </article>

            <article id="ink-stamp" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1953 to 1961</p><h3>Gibson Ink-Stamped Serial Numbers, 1953 to 1961</h3></div><p>A five- or six-digit number inked on the back of the headstock. The first digit gives the year. In rare instances, a four-digit ink stamp appears on late-1958 Les Paul Juniors and Specials. These typically fall in the 6000 to 7000 range.</p></div>
              <SerialPhotos section="ink-stamp" />
              <div class="digit-strip" aria-label="Ink-stamped first digit to year">{[['3','1953'],['4','1954'],['5','1955'],['6','1956'],['7','1957'],['8','1958'],['9','1959'],['0','1960'],['1','1961, rare']].map(([digit, year]) => <div><b>{digit}</b><span>{year}</span></div>)}</div>
              <p class="chart-note">Original 1952 Les Pauls normally have no serial. Do not date a 2-leading ink stamp as 1952 without individual verification. Rare 1961 instruments can have a 1-leading ink stamp; confirm the model and construction.</p>
            <p class="chart-note">Use the <a href="/gibson-les-paul-dating-guide/">Les Paul family dating guide</a> for model-specific changes. The <a href="https://www.joesvintageguitarsaz.com/post/gibson-les-paul-junior-guide/">Les Paul Junior</a> and <a href="https://www.joesvintageguitarsaz.com/post/gibson-les-paul-tv-model-guide/">TV model</a> guides give closer comparisons for those instruments.</p>
            </article>

            <article id="reused" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1961 to 1970</p><h3>Gibson Serial Numbers, 1961 to 1970: Reused Ranges</h3></div><p>Numbers were stamped directly into the wood, then finished. These numbers can sometimes be hard to see, especially on darker finishes. Guitars made before 1970 do not have a “Made in USA” stamp underneath the serial number. Numbers from this era were often reused, so <a href="#dating-hub">cross-check them with other dating features</a>.</p></div>
              <SerialPhotos section="reused" />
              <details class="range-details" open><summary><span>Show all {reusedRows.length} documented ranges</span><span aria-hidden="true">+</span></summary><div class="table-card rounded-t-none border-t-0"><table class="dense-table"><thead><tr><th>Serial range</th><th>Possible year(s)</th><th>Serial range</th><th>Possible year(s)</th></tr></thead><tbody>{reusedPairs.map(({ left, right }) => <tr><td data-label="Serial Range">{left?.[0]}</td><td data-label="Possible Year(s)">{left?.[1]}</td><td data-label="Serial Range">{right?.[0]}</td><td data-label="Possible Year(s)">{right?.[1]}</td></tr>)}</tbody></table></div></details>
              <p class="chart-note"><strong>The leading zero matters.</strong> 018875 is a different serial number than 18875.</p>
            <p class="chart-note">Original <a href="/gibson-pot-codes/">pot codes</a> and <a href="https://www.joesvintageguitarsaz.com/post/gibson-paf-patent-number-pickup-guide/">PAF or Patent Number pickups</a> can help separate overlapping years. For an ES-335, compare the <a href="https://www.joesvintageguitarsaz.com/post/1962-gibson-es-335-guide/">1962</a>, <a href="https://www.joesvintageguitarsaz.com/post/1966-gibson-es-335-authentication-guide/">1966</a> and <a href="https://www.joesvintageguitarsaz.com/post/1968-gibson-es-335-guide/">1968 ES-335 guides</a>.</p>
            </article>

            <article id="norlin" class="chart-section scroll-mt-5">
              <div class="chart-heading"><div><p class="eyebrow">1970 to 1977</p><h3>Gibson Serial Numbers, 1970 to 1977: USA Stamps and Decals</h3></div><p>Most 1970s examples have “Made in USA” below a six-digit impressed serial. Short-lived eight-digit decals followed before the modern format.</p></div>
              <SerialPhotos section="norlin" />
              <div class="grid gap-5 xl:grid-cols-2">
                <div class="table-card"><h4>Impressed Serials</h4><table><thead><tr><th>Serial block</th><th>Possible year(s)</th></tr></thead><tbody><tr><td data-label="Serial Block">000001 to 099999</td><td data-label="Possible Year(s)">1970 transition / 1973</td></tr><tr><td data-label="Serial Block">100000 to 199999</td><td data-label="Possible Year(s)">1970 to 1975</td></tr><tr><td data-label="Serial Block">200000 to 299999</td><td data-label="Possible Year(s)">1973 to 1975</td></tr><tr><td data-label="Serial Block">300000 to 599999</td><td data-label="Possible Year(s)">1974 to 1975</td></tr><tr><td data-label="Serial Block">600000 to 699999</td><td data-label="Possible Year(s)">1970 to 72 or 1974 to 75</td></tr><tr><td data-label="Serial Block">700000 to 799999</td><td data-label="Possible Year(s)">1970 to 1972</td></tr><tr><td data-label="Serial Block">800000 to 899999</td><td data-label="Possible Year(s)">1973 to 1975</td></tr><tr><td data-label="Serial Block">900000 to 999999</td><td data-label="Possible Year(s)">1970 to 1972</td></tr></tbody></table></div>
                <div class="table-card"><h4>Eight-Digit Decal Prefixes</h4><table><thead><tr><th>Prefix</th><th>Year</th><th>Look for</th></tr></thead><tbody><tr><td data-label="Prefix">99</td><td data-label="Year">1975</td><td data-label="Look For">Decal</td></tr><tr><td data-label="Prefix">00</td><td data-label="Year">1976</td><td data-label="Look For">Decal</td></tr><tr><td data-label="Prefix">06</td><td data-label="Year">1977</td><td data-label="Look For">Decal</td></tr></tbody></table><p class="p-4 text-sm text-ink/60">A 99-prefix can resemble a 1990s modern number. The physical decal is the deciding clue.</p></div>
              </div>
            <p class="chart-note">Check the <a href="/gibson-physical-features-hardware-guide/">physical features and hardware guide</a> alongside these ranges. A claimed 1971 limited edition needs the model checks in the <a href="https://www.joesvintageguitarsaz.com/post/gibson-flying-v-medallion-guide/">Flying V Medallion guide</a>; a serial range alone does not identify that edition.</p>
            </article>

            <article id="modern" class="chart-section scroll-mt-5">
              <span id="present" class="legacy-anchor" aria-hidden="true"></span>
              <div class="chart-heading"><div><p class="eyebrow">1977 to present</p><h3>Modern Gibson Serial Numbers, 1977 to Today</h3></div><p>Most regular-production Gibson guitars use an eight- or nine-digit code. The first and fifth digits give the last two digits of the year. From 2014 to mid-2019, Gibson used a different format, explained below.</p></div>
              <SerialPhotos section="modern" />
              <div class="modern-code">
                <p class="eyebrow">Format</p><div class="mt-4 flex flex-wrap items-end gap-2 font-mono text-3xl font-bold sm:text-5xl" aria-label="Y D D D Y production rank"><span class="code-year">Y</span><span class="code-day">D</span><span class="code-day">D</span><span class="code-day">D</span><span class="code-year">Y</span><span class="code-rank">R</span><span class="code-rank">R</span><span class="code-rank">R</span></div>
                <div class="mt-6 grid gap-4 sm:grid-cols-3"><div><b class="text-wine">Y + Y</b><span>First and fifth digits form the year.</span></div><div><b class="text-gold">DDD</b><span>Digits 2 to 4 are the day of the year, from 001 to 365 in a standard year or 366 in a leap year.</span></div><div><b class="text-ink/55">RRR / B RRR</b><span>The last three digits are the daily ranking. In a straight sequence, 021 means the 21st instrument made that day. Factory blocks can change where the count starts. Nine-digit date codes add a batch digit before the rank.</span></div></div>
                <div class="mt-6 border-t border-rule pt-5">
                  <h4 class="font-display text-xl text-wine-dark">Gibson’s Eight-Digit Serial Examples</h4>
                  <p class="mt-3 text-base text-ink/80">Although Gibson operated in both Kalamazoo and Nashville from 1974 to 1984, this eight-digit serial format began in 1977. Within the format, Kalamazoo used rankings 001 to 499 and Nashville used 500 to 999. A serial ending in 501 does not mean it was the 501st guitar made in Kalamazoo. It identifies the first Nashville guitar stamped that day.</p>
                  <ul class="mt-3 list-disc space-y-3 pl-5 text-base text-ink/80">
                    <li><strong>70108276:</strong> the first and fifth digits give 78; day 010 is January 10. Gibson identifies it as the 276th instrument stamped that day in Kalamazoo in <strong>1978</strong>.</li>
                    <li><strong>82765501:</strong> the first and fifth digits give 85; day 276 is October 3. Gibson identifies it as the first instrument stamped that day in Nashville in <strong>1985</strong>. The 501 suffix reflects Nashville’s ranking block, not the 501st guitar.</li>
                  </ul>
                  <p class="chart-note">These worked examples appear in <a href="https://www.gibson.com/pages/serial-number-search">Gibson’s serial-number reference</a>.</p>
                </div>
                <div class="mt-6 border-t border-rule pt-5">
                  <h4 class="font-display text-xl text-wine-dark">How Gibson’s Daily Ranking Changed</h4>
                  <div class="mt-4 grid gap-4 md:grid-cols-2">
                    <article class="rounded-xl border border-rule bg-white p-4"><h5 class="font-display text-lg text-wine-dark">1984 to 1989: Post-Kalamazoo</h5><p class="mt-2 text-sm leading-relaxed text-ink/75">After Kalamazoo closed, Nashville continued using rankings 500 to 999 through 1989. The lower 001 to 499 block was left unused until the Bozeman system began. That is why 501 can mean the first Nashville instrument stamped that day rather than the 501st instrument overall.</p></article>
                    <article class="rounded-xl border border-rule bg-white p-4"><h5 class="font-display text-lg text-wine-dark">1989 to 2005: The Bozeman Split</h5><p class="mt-2 text-sm leading-relaxed text-ink/75">Bozeman acoustic rankings start each day at 001. Gibson electrics can begin in the 300s, so the final three digits still combine a daily ranking with a plant designation.</p></article>
                    <article class="rounded-xl border border-rule bg-white p-4"><h5 class="font-display text-lg text-wine-dark">July 2005 to 2014: Nine-Digit Batch Codes</h5><p class="mt-2 text-sm leading-relaxed text-ink/75">Gibson USA expanded to <strong>YDDDYBRRR</strong>. The sixth digit is the batch number. Batch 0 begins the day, and after ranking 699 the batch number advances to 1.</p></article>
                    <article class="rounded-xl border border-rule bg-white p-4"><h5 class="font-display text-lg text-wine-dark">Mid-2019 to Today: The Batch Format Returns</h5><p class="mt-2 text-sm leading-relaxed text-ink/75">After the model-year system below, Gibson USA returned to the nine-digit <strong>YDDDYBRRR</strong> format. This is a dated batch system, not a simplified eight-digit counter.</p></article>
                  </div>
                </div>
                <p class="chart-note">Gibson used a unique serial-number system for most of its production line during its centennial year, 1994. Most instruments from 1994 begin with 94 followed by six ranking digits. Exceptions include guitars made in early 1994, Custom Shop guitars and reissues. The special Centennial Collection uses a separate system below.</p>
              </div>
            <section id="model-year-serials" class="mt-6 rounded-xl border border-rule bg-cream p-5" aria-labelledby="model-year-heading">
                <h4 id="model-year-heading" class="font-display text-2xl text-wine-dark">Gibson USA Model-Year Serials, 2014 to Mid-2019</h4>
                <p class="mt-3 text-base text-ink/80">This nine-digit format is <strong>YYRRRRRRR</strong>: the first two digits give the model year and the remaining seven give the sequence. It does not encode a day of the year.</p>
                <p class="mt-3 text-base text-ink/80">For example, <strong>150000123</strong> reads as <strong>2015 model year, sequence 0000123</strong>. This example applies <a href="https://www.gibson.com/pages/serial-number-search">Gibson’s published model-year rule</a>. A 2015-model instrument may have been built late in 2014, so the model year is not necessarily its calendar build year.</p>
                <p class="mt-3 text-base text-ink/80">Choose the standard serial option in the decoder. Do not read digits 2 to 4 as a production day for this format. Custom Shop, Historic and Classic instruments need their own rules below.</p>
              </section>
            </article>

            <article id="special" class="chart-section scroll-mt-5">
              <span id="csri" class="legacy-anchor" aria-hidden="true"></span>
              <div class="chart-heading"><div><p class="eyebrow">Custom and Model-Specific</p><h2 class="mt-1 font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-none tracking-[-0.025em]">Gibson Custom Shop, Historic and Special Serial Formats</h2></div><p>Confirm the model before reading these numbers. A reissue year identifies the guitar being recreated; it is not the year that reissue was built.</p></div>
              <p class="mb-4 text-sm leading-relaxed text-ink/75"><strong>Reading the patterns:</strong> Y is a single year digit; YY is a two-digit year; M identifies the reissue model. DDD is the day of the year, counted from January 1. “Sequence” means the production or edition number, not a date.</p>
              <SpecialFormatGuides />
              <div class="table-card"><h4>Anniversary, Artist and Other Special Formats</h4><table><thead><tr><th scope="col">Pattern</th><th scope="col">Applies to</th><th scope="col">What It Tells You and How to Date It</th></tr></thead><tbody>{specialRows.slice(9).map(([pattern, model, reading, dating]) => <tr><td data-label="Pattern">{pattern}</td><td data-label="Applies To">{model}</td><td data-label="How To Date It"><p class="font-normal text-ink/80"><strong>Number:</strong> {reading}</p><p class="mt-2 font-normal text-ink/80"><strong>Dating:</strong> {dating}</p></td></tr>)}</tbody></table></div>
              <p class="chart-note"><strong>Single year digits repeat.</strong> A Historic or CS year digit cannot establish the decade. Gibson’s earlier serial FAQ gives 7 5123 as a 1957 reissue made in 2005, so five digits do not mean “1990s.” Match the model and serial to dated factory records. A sale date or undated COA may not settle the build year.</p>
              <p class="chart-note"><strong>Vintage-looking numbers need a model check.</strong> Gibson-made Guitar Trader reissues have a separate eight-digit serial on the control-cavity rim, but other early reissues do not all have it. The regular 1983 to early 1993 Les Paul Reissue instead uses its first headstock digit as the build-year digit. Numeric Memphis 1963 ES-335 reissues and unlisted artist editions still need individual verification.</p>
              <details class="range-details mt-5">
                <summary>Artist Edition Numbering <span aria-hidden="true">+</span></summary>
                <div class="table-card"><table><thead><tr><th>Artist or edition</th><th>Documented examples</th><th>Date information</th></tr></thead><tbody>
                  <tr><td data-label="Artist Or Edition">Jimmy Page Number One</td><td data-label="Documented Examples">PAGE, JPP, or hand-numbered signed edition</td><td data-label="Date Information">No build date in the run number. The 2004 launch account reports public signed numbers 2 to 26, with 1 kept by Page; older serial FAQs say 1 to 25. Verify the number and provenance. Earlier Gibson USA Page models can have a normal serial.</td></tr>
                  <tr><td data-label="Artist Or Edition">Ace Frehley Custom</td><td data-label="Documented Examples">ACE plus sequence</td><td data-label="Date Information">The sequence does not date the guitar. Confirm the 1997 Custom edition and its records; USA and Budokan editions use different rules.</td></tr>
                  <tr><td data-label="Artist Or Edition">Slash Custom</td><td data-label="Documented Examples">SL plus sequence</td><td data-label="Date Information">No encoded year. Both the 1997 cranberry and 2004-introduced models used SL; identify the edition, then check its build records.</td></tr>
                  <tr><td data-label="Artist Or Edition">Joe Perry</td><td data-label="Documented Examples">JP or BONE plus sequence</td><td data-label="Date Information">JP identifies the 1996 Custom Shop trans-black edition; BONE identifies the Boneyard edition. Neither sequence encodes a build date. USA Perry models with normal serials use the standard date formula after model confirmation.</td></tr>
                  <tr><td data-label="Artist Or Edition">Peter Frampton</td><td data-label="Documented Examples">PF sequence; PF Y sequence on the Special</td><td data-label="Date Information">The Custom’s PF sequence has no date. On the Special, the digit after PF is a build-year digit; confirm the model and production period from matching records.</td></tr>
                  <tr><td data-label="Artist Or Edition">Billy Gibbons Pearly Gates</td><td data-label="Documented Examples">BG VOS; GIBBONS reported on an aged example</td><td data-label="Date Information">No build date in the edition sequence. Aged-and-signed guitars need individual verification; no universal signed prefix is established here. A signed COA does not mean the guitar itself was signed. Later Collector’s Editions use separate rules.</td></tr>
                  <tr><td data-label="Artist Or Edition">Duane Allman Cherry Sunburst</td><td data-label="Documented Examples">DA 59 sequence or ALLMAN sequence</td><td data-label="Date Information">No encoded build date; 59 refers to the replicated guitar, not the reissue’s manufacture year. Use matching build records. Hot ’Lanta is a separate run.</td></tr>
                  <tr><td data-label="Artist Or Edition">Eric Clapton Beano</td><td data-label="Documented Examples">EC, CLAPTON, or Eric Clapton # plus number</td><td data-label="Date Information">The prefix and number identify the VOS, aged or signed edition and sequence. No build year is encoded; use matching build-year records.</td></tr>
                </tbody></table></div>
              </details>
              <p class="mt-4 text-sm leading-relaxed text-ink/70"><strong>What counts as dating evidence?</strong> Look for factory paperwork or Gibson confirmation that matches the full serial and states the build year. A certificate of authenticity (COA) may identify the edition without dating it. An inspection, shipping or sale date is not automatically the manufacture date. If no build-year evidence exists, leave the exact year unresolved.</p>
              <p class="mt-4 text-sm leading-relaxed text-ink/70">These are documented patterns, not an authenticity test or a list of every special run. If your model is not listed, keep the complete prefix and compare the guitar, labels and matching paperwork. The tool labels a year you supply from a record separately from a year decoded from the number.</p>
            <p class="chart-note">Confirm the model against the <a href="/gibson-sg-dating-guide/">SG family</a>, <a href="/gibson-les-paul-dating-guide/">Les Paul family</a> or <a href="/gibson-es-335-345-355-dating-guide/">ES-335, ES-345 and ES-355 dating guide</a> before treating a vintage-looking stamp as an original production date.</p>
            </article>
          </div>
        </div>
      </section>

      <SerialGuideLinks />

      <section class="border-t border-rule bg-white/35 py-16"><div class="mx-auto grid max-w-[88rem] gap-12 px-5 lg:grid-cols-[0.7fr_1.3fr] lg:px-10">
        <div><p class="eyebrow">Common Questions</p><h2 class="section-title">Gibson Serial Number Lookup FAQ</h2><p class="mt-5 max-w-md leading-relaxed text-ink/70">Questions about value, player-grade condition, repairs or selling belong in the <a class="font-bold text-wine-dark underline underline-offset-4" href="https://www.joesvintageguitarsaz.com/sell-my-gibson-guitar/">Sell My Gibson Guitar guide</a>.</p></div>
