              <tr><td>1</td><td>1961 SG Standard</td></tr>
              <tr><td>2</td><td>1962 SG Standard, SG Custom</td></tr>
              <tr><td>3</td><td>1963 SG Custom, SG Special, SG Junior, Firebird</td></tr>
              <tr><td>4</td><td>1964 SG Standard</td></tr>
              <tr><td>5</td><td>1965 Non-Reverse Firebird</td></tr>
