// The checks that place a Tele in an era without tools. These give a WINDOW.
const fastRows: [string, string, string][] = [
  ["The pickguard", "Black to mid-1954, single-ply white to 1959, three-ply nitrate to mid-1965, white plastic after", "The blackguard line is the one that moves the money. Nitrate ages mint green; the plastic that replaced it only ever goes cream."],
  ["The bridge", "Strings through the body, except from about mid-1958 to mid-1959 when they anchored at the back of the plate", "Turn the guitar over and look for string ferrules. A 1959 transition plate can carry both sets of holes at once."],
