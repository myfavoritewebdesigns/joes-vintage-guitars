  /* ===== Header backdrop ===== */
  /* The site Header is position:absolute. This block sits behind it so the
     top nav row reads on dark-brown and the secondary nav row reads as a
     "white-pill" against a cream band — matches the live site layout. */
  .fsn-header-backdrop {
    position: relative;
    isolation: isolate;
    z-index: 0;
  }
  .fsn-header-backdrop__dark {
    background: var(--color-brand-brown, #3e2a14);
