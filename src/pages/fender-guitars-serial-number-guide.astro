  /* H1 + intro H2 in lede region (left-aligned to match live) */
  .fsn-intro { text-align: left; }
  .fsn-intro .fsn-lede,
  .fsn-intro .fsn-byline { text-align: left; max-width: none; }
  .fsn-h1 {
