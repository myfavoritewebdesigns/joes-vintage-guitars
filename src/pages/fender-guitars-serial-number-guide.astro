    <div class="fsn-tool-layout__inner">
      <div class="fsn-tool-layout__main">
        <div set:html={fsnToolHtml} />
      </div>
    </div>
  </section>
  <script src="/scripts/fsn-tool.js" is:inline></script>

  <!-- Fixed-position TOC sidebar — floats on the right of the viewport for the
       whole scroll on desktop. Hidden on narrow screens (handled in styles). -->
  <aside class="fsn-toc" id="fsn-toc" aria-label="Table of contents">
    <p class="fsn-toc__label">Table of Contents</p>
    <ul class="fsn-toc__list">
      <li><a href="#locations" class="fsn-toc__h2">Where to Find Your Serial #</a></li>
      <li><a href="#eras" class="fsn-toc__h2">Serial Formats by Era</a></li>
      <li><a href="#bridge-plate" class="fsn-toc__h3">Bridge Plate (1950 to 1954)</a></li>
      <li><a href="#neck-plate-serials" class="fsn-toc__h3">4 & 5 Digit Neck Plate (1954 to 1963)</a></li>
      <li><a href="#l-series" class="fsn-toc__h3">L-Series (1963 to 1965)</a></li>
      <li><a href="#f-plate" class="fsn-toc__h3">F-Plate (1965 to 1976)</a></li>
      <li><a href="#v-prefix" class="fsn-toc__h3">V-Prefix Reissues</a></li>
      <li><a href="#custom-shop" class="fsn-toc__h3">Custom Shop (CN, CZ, R)</a></li>
      <li><a href="#headstock-serials" class="fsn-toc__h3">Headstock (1976 to Present)</a></li>
      <li><a href="#import-serials" class="fsn-toc__h3">Japanese & Mexican</a></li>
      <li><a href="#auth" class="fsn-toc__h2">Authentication Guide</a></li>
      <li><a href="#advanced-dating" class="fsn-toc__h2">Advanced Dating Methods</a></li>
      <li><a href="#adv-neck-heel" class="fsn-toc__h3">Neck Heel Dates</a></li>
      <li><a href="#adv-body-dates" class="fsn-toc__h3">Body Date Codes</a></li>
