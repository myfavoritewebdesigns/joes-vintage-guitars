  .fsn-toggle__icon::before { width: 10px; height: 2px; }
  .fsn-toggle__icon::after  { width: 2px; height: 10px; transition: transform 0.2s; }
  .fsn-toggle[open] .fsn-toggle__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .fsn-toggle__body {
