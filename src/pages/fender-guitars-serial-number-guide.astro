  @media (max-width: 600px) {
    .fsn-table-wrap { overflow-x: visible; box-shadow: none; border-radius: 0; }
    .fsn-table { min-width: 0; font-size: 14px; display: block; }
    .fsn-table thead { display: none; }
    .fsn-table tbody { display: block; }
    .fsn-table tbody tr {
      display: block;
      background: #fff !important;
