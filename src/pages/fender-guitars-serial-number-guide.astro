    line-height: 1.7;
    color: var(--color-brand-brown-warm, #4a3520);
  }

  /* Related Guides grid (after sell-card) */
  .fsn-related-title {
    margin-top: 40px !important;
    color: var(--color-brand-brown) !important;
    border-bottom: 2px solid var(--color-brand-rust);
    padding-bottom: 8px;
