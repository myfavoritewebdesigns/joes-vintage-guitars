<!-- Mark <body> so the header-override CSS above can target this page. -->
<script is:inline>
  document.body.classList.add("fender-sn-page");

  /* Label each table cell from its <thead> headers so the mobile card layout
     (max-width:600px) can show "Header: value" per cell. */
  (function () {
    function labelTables() {
      document.querySelectorAll("table.fsn-table").forEach(function (tbl) {
        var headers = Array.prototype.map.call(
          tbl.querySelectorAll("thead th"),
          function (th) { return th.textContent.trim(); }
        );
        if (!headers.length) return;
        tbl.querySelectorAll("tbody tr").forEach(function (tr) {
          Array.prototype.forEach.call(tr.children, function (cell, i) {
            if (cell.tagName === "TD" && headers[i]) {
              cell.setAttribute("data-label", headers[i]);
            }
          });
        });
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", labelTables);
    } else {
      labelTables();
    }
  })();

  /* Hide the fixed TOC sidebar once the contact section is in view so it
     doesn't overlap the "Talk With Joe Today" form at the bottom. */
  (function () {
    function initTocHide() {
      var toc = document.getElementById("fsn-toc");
      var contact = document.getElementById("contact");
      if (!toc || !contact || !("IntersectionObserver" in window)) return;
      var obs = new IntersectionObserver(function (entries) {
        toc.classList.toggle("fsn-toc--hidden", entries[0].isIntersecting);
      }, { rootMargin: "0px 0px -10% 0px" });
      obs.observe(contact);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTocHide);
    } else {
      initTocHide();
    }
  })();

  /* Mobile "Jump to a Section" button: clone the sidebar TOC links into the
     panel and wire up open/close. */
  (function () {
    function initMobileToc() {
      var fab = document.getElementById("fsn-toc-fab");
      var sheet = document.getElementById("fsn-toc-sheet");
      var body = document.getElementById("fsn-toc-sheet-body");
      var closeBtn = document.getElementById("fsn-toc-sheet-close");
      var srcList = document.querySelector(".fsn-toc .fsn-toc__list");
      if (!fab || !sheet || !body || !srcList) return;
      body.appendChild(srcList.cloneNode(true));
      function open() { sheet.classList.add("fsn-toc-sheet--open"); fab.setAttribute("aria-expanded", "true"); }
      function close() { sheet.classList.remove("fsn-toc-sheet--open"); fab.setAttribute("aria-expanded", "false"); }
      fab.addEventListener("click", function (e) {
        e.stopPropagation();
        sheet.classList.contains("fsn-toc-sheet--open") ? close() : open();
      });
      if (closeBtn) closeBtn.addEventListener("click", close);
      body.addEventListener("click", function (e) { if (e.target.closest("a")) close(); });
      document.addEventListener("click", function (e) {
        if (!sheet.contains(e.target) && !fab.contains(e.target)) close();
      });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMobileToc);
    } else {
      initMobileToc();
    }
  })();
</script>
