 *
 * Hub-and-spoke method page behind the condensed Fender serial rebuild
 * (see fender-serial-hub-preview.astro). Deep-dives the body-date method the
 * hub only summarizes, so the hub's "/fender-body-dates/" card resolves. This
 * is the specific slug Joe wants for the body-date page; it replaces the earlier
 * placeholder "/fender-physical-dating/" the sibling spokes linked to (that slug
 * is now retired across the hub, /fender-pot-codes/, and /fender-neck-dates/).
 *
 * Noindex + sitemap-excluded + X-Robots-Tag (astro.config.mjs SITEMAP_EXCLUDE
 * and public/_headers), same preview pattern as the hub, /fender-pot-codes/,
 * and /fender-neck-dates/.
 *
 * Core content and photos come from Joe's live serial page (the "Body Date
 * Codes" section of /fender-guitars-serial-number-guide/): the four body-date
 * locations (neck pocket, pickup cavities, rear tremolo cavity, control cavity),
 * the rule that the date records when the BODY was completed weeks to months
 * before final assembly, and the Stratocaster example (a claimed 1959 Strat
 * should read 1958 or early 1959; a 1962 body date means a swapped body).
 *
 * Photos: three Joe supplied for this page (resized to 2560px into
 * images/fender-sn/) plus the two the live serial page's Body Date Codes section
 * already uses. Joe's set: the neck pocket of an early-1950s Precision Bass
 * penciled 3-17-53 with the initials T.G. (hero), a 1956 Stratocaster pickup
 * route penciled 6-56, and the rear spring cavity of a 1955 Stratocaster with
 * the date hidden behind the tremolo springs. The live-page pair: a 1956
 * Telecaster with the date penciled in the bridge pickup route, and one with the
 * date on a masking-tape strip (next to a worker's name) in the control cavity.
 * The builder-name detail (a name like "Eddie" or "Davis" in place of a date)
 * traces to Joe's 1952 Telecaster authentication guide.
 *
 * No walkthrough video on this page, per Joe; the pot-codes and neck-dates
 * spokes embed the lite-youtube clip, this one does not.
 *
 * Body-date facts are not yet carried in VG_FACTS with VG-#### ids; flagged to
 * log, same as the neck-dates green-stamp and model-code detail.
 */
import Layout from "../layouts/Layout.astro";
import LicensedImage from "../components/primitives/LicensedImage.astro";
import { resolveImage, assetSrc } from "../lib/images";
import { contact, hrefs, SITE_URL } from "../config/site";

const meta = (file: string) => resolveImage("images/fender-sn/" + file)!;
const img = (file: string) => assetSrc("images/fender-sn/" + file);

const PAGE_PATH = "/fender-body-dates/";
const HUB_PATH = "/fender-guitars-serial-number-guide/";
// PREVIEW-ONLY. The condensed hub currently lives at its own preview URL, so the
// visible back/cross-check links point THERE and the spoke set clicks through end
// to end. HUB_PATH above stays canonical and still feeds the schema + breadcrumb.
// TODO(launch): set HUB_HREF = HUB_PATH and delete this comment, once the
// condensed hub replaces the live guide at /fender-guitars-serial-number-guide/.
const HUB_HREF = "/fender-serial-hub-preview/";

// ---- Data ----
const locationRows = [
  ["Neck pocket", "The most common spot. A pencil or ink date on the bare wood, sometimes on a strip of masking tape stuck in the pocket.", "The neck"],
  ["Pickup cavities", "A pencil date on the raw wood inside a routed pickup cavity.", "The pickguard"],
  ["Rear tremolo cavity", "On a Stratocaster, the bare wood in the spring cavity, hidden under the back plate.", "The back plate"],
  ["Control cavity", "Behind the metal control plate on a Telecaster, Jaguar, or Jazz Bass, or under the pickguard on a Stratocaster, Precision Bass, or Jazzmaster.", "The plate or guard"],
];
const formRows = [
  ["Pencil date", "A handwritten month and year in graphite, the most common form on a Fender body."],
  ["Ink stamp", "A date pressed into the wood with a rubber stamp instead of written by hand."],
  ["Masking-tape date", "On 1950s Fenders, a date, sometimes with a worker's name, written on a strip of masking tape stuck inside a cavity."],
  ["A name or initials", "Sometimes a worker wrote a name or initials, like Eddie or Davis, next to the date or in place of one."],
];

const tocItems: [string, string][] = [
  ["#what", "What A Body Date Is"],
  ["#find", "Where To Find It"],
  ["#read", "How To Read It"],
  ["#stops", "Why It Stops In 1963"],
  ["#stamps", "Cavity Stamps"],
  ["#tape", "Masking Tape Names"],
  ["#golden", "The Golden Rule"],
  ["#limits", "What It Can't Prove"],
  ["#cross", "Cross-Check The Date"],
  ["#faq", "Common Questions"],
  ["#appraisal", "Free Expert Appraisal"],
  ["#about-joe", "About Joe"],
];

const faqs = [
  {
    q: "Do I Have To Take My Fender Apart To Find The Body Date?",
    a: "Usually yes. The most common spot is the neck pocket, which means taking the neck off, and the other dates sit in cavities you reach by pulling the pickguard, the control plate, or the tremolo back plate. Vintage screws and finishes chip easily, so if you aren't comfortable doing that, don't force it. Get in touch and I'll help, or bring the guitar by and I'll read it for you.",
  },
  {
    q: "My Body Date Doesn't Match My Neck Date. Is That A Problem?",
    a: "A small gap is normal and original. Fender made bodies and necks in separate batches and pulled both from bins, so a body and neck a few months apart is exactly what you'd expect. A body dated well after the rest of the guitar is the red flag, because that usually means the body was replaced.",
  },
  {
    q: "There's No Date In My Neck Pocket. Why?",
    a: "Body dating was never as consistent as neck dating, so plenty of real Fenders never got one, and pencil dating was largely phased out by 1965, when the CBS-era factory moved to color-coded inspection stamps or no body mark at all. A pencil mark can also wear off or get sanded away in a refinish, or the date is in a different cavity. Check the pickup routes and, on a Strat, the spring cavity before you decide it's missing.",
  },
  {
    q: "The Body Date Is Older Than My Serial Number. Is That Right?",
    a: "That's the normal direction. Fender prepped and dated bodies weeks or months before final assembly, so the body date sitting a little earlier than the build is exactly what you want to see. A body date that lands later than the rest of the guitar is the one to question.",
  },
  {
    q: "Does The Body Date Prove My Guitar Is All Original?",
    a: "No. It dates the body. Originality is a whole-guitar judgment that weighs the neck date, the pot codes, the pickups, the hardware, and the finish together. Send me three photos and I'll give you the real story for free.",
  },
];

// ---- Schema ----
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "How To Read Fender Body Dates And Date Your Guitar",
  description:
    "Find the pencil or ink date Fender wrote inside your guitar's body, in the neck pocket or the cavities, and turn it into a real build date, then cross-check it against the neck date. A step-by-step body-date guide from a vintage Fender appraiser.",
  author: { "@id": `${SITE_URL}/about-me/#person` },
  publisher: { "@id": `${SITE_URL}/` },
  image: img("1952-fender-precision-bass-body-date.jpg"),
  inLanguage: "en-US",
  mainEntityOfPage: `${SITE_URL}${PAGE_PATH}`,
  isPartOf: { "@type": "WebPage", "@id": `${SITE_URL}${HUB_PATH}` },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Fender Serial Number Guide", item: `${SITE_URL}${HUB_PATH}` },
