---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import LeadForm from '../components/LeadForm.astro';
import LicensedImage from '../components/primitives/LicensedImage.astro';
import { getImage } from 'astro:assets';
import { SITE_URL, contact, hrefs } from '../config/site';
import sheraton from '../assets/images/model-guides-2/sheraton-1961-case.jpg';
import sheratonBody from '../assets/images/model-guides-2/sheraton-1961-body.jpg';
import crestwood from '../assets/images/model-guides-2/crestwood-1964-body.jpg';
import triumph from '../assets/images/model-guides-2/triumph-1946-body.jpg';
import emperor from '../assets/images/model-guides-2/emperor-1950s-body.jpg';
import olympic from '../assets/images/model-guides-2/olympic-1960s-case.jpg';
import '../styles/rickenbacker-selling.css';

const title = "Sell My Vintage Epiphone Guitar | Joe's Vintage Guitars";
const description = "Sell your vintage Epiphone guitar to Joe. Send photos for a free appraisal and cash offer, with prepaid insured shipping. Based in Mesa, buying nationwide.";
const url = `${SITE_URL}/sell-my-epiphone-guitar/`;
const shareImage = await getImage({ src: sheraton, width: sheraton.width });
const faqs = [
  { q: 'Where Can I Sell My Vintage Epiphone Guitar?', a: "I buy vintage Epiphones directly from owners across the US. Send photos for a free appraisal and a cash offer. You can compare that offer with selling the guitar yourself or arranging consignment." },
  { q: 'Which Epiphone Years Are You Most Interested In?', a: "My main interest is the Gibson-era Kalamazoo line, from 1958 to 1970. I also buy earlier New York and Philadelphia archtops. Send the model, any known year and clear photos so I can review your guitar." },
  { q: "Can You Help If I Don't Know The Model?", a: "Yes. Send the front, back, headstock and any label or serial number you can see. Leave uncertain model and year fields blank. A full photo often tells me more than an isolated serial number." },
  { q: 'Should I Repair My Epiphone Before Selling It?', a: "Send photos before paying for repairs or replacement parts. Include cracks, loose binding, changed hardware and any playing problems. Keep removed parts and service receipts with the guitar so I can assess it as it stands." },
  { q: 'Do I Pay For Packing And Shipping?', a: "There's no shipping cost to you when we use my agreed shipping arrangements. My account covers the box, professional packing, fully insured shipping and tracking through a FedEx Office Print & Ship Center. I'll confirm the location and handoff details before you take the guitar in." },
  { q: 'When Will I Be Paid For My Epiphone?', a: "I offer same-day payment in most cases. We'll agree on the payment method and confirm the timing before your instrument leaves you. Call me to arrange an in-person sale or discuss the shipping handoff." },
];
const structuredData = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description, about: { '@id': `${SITE_URL}/` }, mainEntity: { '@id': `${url}#service` } },
  { '@type': 'Service', '@id': `${url}#service`, name: 'Vintage Epiphone Guitar Buying', serviceType: 'Vintage Epiphone guitar buying', areaServed: { '@type': 'Country', name: 'United States' }, provider: { '@id': `${SITE_URL}/` } },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` }, { '@type': 'ListItem', position: 2, name: 'Sell Your Epiphone', item: url } ] },
  { '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Layout bodyClass="smr-selling-page" title={title} description={description} canonical="/sell-my-epiphone-guitar/" ogImage={SITE_URL + shareImage.src} ogImageAlt="1961 Epiphone Sheraton in its blue-lined case" ogImageWidth={sheraton.width} ogImageHeight={sheraton.height} modifiedTime="2026-10-30T00:00:00-07:00" structuredData={structuredData}>
  <div class="smr-header-backdrop" aria-hidden="true"></div>
  <div class="smr-remodel epi-selling">
    <section class="sell-hero">
      <div class="hero-copy">
        <p class="eyebrow">Mesa, Arizona · Buying Nationwide</p>
        <h1>Sell Your Vintage Epiphone Guitar</h1>
        <p class="hero-lede">I buy vintage Epiphone guitars across the US, with a particular interest in the Gibson-era Kalamazoo models. Send me photos for a free appraisal and a cash offer.</p>
        <p>If you've inherited an Epiphone or aren't sure which model you have, include the whole guitar and its markings. I'll help identify it and explain the offer.</p>
        <div class="buttons"><a class="button primary" href="#appraisal">Get An Epiphone Offer</a><a class="button outline" href={hrefs.sms}>Text Joe Photos</a></div>
        <p class="hero-phone">Or call <a href={hrefs.tel}>{contact.phone}</a></p>
      </div>
      <figure class="hero-photo"><LicensedImage src={sheraton} width={Math.min(1800, sheraton.width)} alt="1961 Epiphone Sheraton in a blue-lined case, with two mini-humbuckers and a Bigsby" loading="eager" fetchpriority="high" sizes="(max-width: 760px) 92vw, 560px" /><figcaption>1961 Epiphone Sheraton from Joe's photo archive.</figcaption></figure>
    </section>
    <div class="service-strip"><span>Free Photo Appraisals</span><span>Prepaid, Insured Shipping</span><span>Single Guitars &amp; Collections</span></div>
    <section class="top-offer" id="appraisal" aria-labelledby="epiphone-offer-title">
      <div class="wrap section top-offer-grid">
        <div class="top-offer-intro"><p class="eyebrow">Talk With Me</p><h2 id="epiphone-offer-title">Tell Me About Your Epiphone</h2><p>Tell me what you know about the guitar, where you're located and whether it's had repairs. You can leave the model and year blank if you're unsure.</p><p class="top-offer-note">Have photos ready? <a href="#photos">See which photos to send.</a> You can upload them after submitting the form.</p><a class="button primary" href={hrefs.tel}>Call Joe: {contact.phone}</a></div>
        <LeadForm formId="sell-epiphone-top" instrumentMode="model-only" submitLabel="Send My Epiphone Details" />
      </div>
    </section>
    <nav class="toc wrap" aria-label="On This Page"><span>On This Page</span><a href="#models">Models I Buy</a><a href="#value">Value &amp; Condition</a><a href="#photos">Photos To Send</a><a href="#selling">Selling Process</a><a href="#shipping">Shipping</a><a href="#questions">Questions</a></nav>

    <section class="wrap section" id="models">
      <div class="section-intro"><p class="eyebrow">Kalamazoo Electrics And American Archtops</p><h2>Epiphone Models I Buy</h2><p>The Gibson-era guitars made in Kalamazoo from 1958 to 1970 are my main interest. I also buy the earlier New York and Philadelphia instruments. Send photos of the label and hardware along with the model name so I can place yours in the right group.</p></div>
      <div class="model-grid">
        <article class="model"><figure><LicensedImage src={sheratonBody} width={Math.min(1200, sheratonBody.width)} alt="1961 Epiphone Sheraton body with gold-colored hardware and two mini-humbuckers" /><figcaption>1961 Sheraton. The body, pickups and tailpiece are visible together.</figcaption></figure><h3>Kalamazoo Hollow And Semi-Hollow Guitars</h3><p>I buy the <a href="/post/epiphone-casino-authentication-guide/">Casino</a>, <a href="/post/epiphone-sheraton-history-value/">Sheraton</a>, <a href="/post/epiphone-sorrento-authentication-guide/">Sorrento</a> and <a href="/post/epiphone-windsor-authentication-guide/">Windsor</a>, along with the Kalamazoo <a href="/post/epiphone-broadway-authentication-guide/">Broadway</a> and <a href="/post/epiphone-zephyr-authentication-guide/">Zephyr</a>. Include a side view so I can see the body's depth. Rivieras are welcome too.</p></article>
        <article class="model"><figure><LicensedImage src={crestwood} width={Math.min(1200, crestwood.width)} alt="1964 Epiphone Crestwood Custom body with green finish, two mini-humbuckers and Tremotone" /><figcaption>1964 Crestwood Custom from Joe's archive.</figcaption></figure><h3>Kalamazoo Solidbodies And Carved Archtops</h3><p>I'm interested in <a href="/post/vintage-epiphone-crestwood-value-history-guide/">Crestwoods</a>, the solidbody <a href="/post/epiphone-olympic-authentication-guide/">Olympic</a>, Coronets and Wilshires. I also review the Kalamazoo versions of the <a href="/post/epiphone-emperor-authentication-guide/">Emperor</a>, <a href="/post/epiphone-deluxe-authentication-guide/">Deluxe</a> and <a href="/post/epiphone-triumph-authentication-guide/">Triumph</a>. A model name can span different body styles, so send a complete front photo.</p></article>
        <article class="model"><figure><LicensedImage src={triumph} width={Math.min(1200, triumph.width)} alt="1946 Epiphone Triumph sunburst archtop with an added DeArmond pickup" /><figcaption>1946 Triumph with an added DeArmond pickup.</figcaption></figure><h3>New York And Philadelphia Acoustic Archtops</h3><p>I buy earlier Emperors, Deluxes, Triumphs, Broadways and Olympic archtops, including cutaway Regent versions. Photograph the neck joint and the bridge from the side. If a pickup was added later, include its mounting and any holes or wiring changes.</p></article>
        <article class="model"><figure><LicensedImage src={emperor} width={Math.min(1200, emperor.width)} alt="1950s Epiphone Zephyr Emperor Regent with three pickups, push-button controls and Bigsby" /><figcaption>1950s Zephyr Emperor Regent, serial 68191, from Joe's archive.</figcaption></figure><h3>Early Epiphone Electric Archtops</h3><p>Zephyrs, Zephyr Regents, Zephyr De Luxe models and Zephyr Emperor Regents are also worth sending in for a review. Include a close photo of the controls and the label. Keep any old pickups, tailpieces or other removed parts with the guitar.</p></article>
      </div>
      <p class="note">These photos show instruments from Joe's archive. They aren't a current inventory list.</p>
    </section>

    <section class="value-band" id="value"><div class="wrap section">
      <div class="section-intro"><p class="eyebrow">Appraisal &amp; Offer</p><h2>What Is My Epiphone Worth?</h2><p>The model, factory period, finish, parts and repairs determine which examples I compare with yours. An older archtop and a Kalamazoo solidbody can share a name without sharing a value range.</p></div>
      <div class="value-layout"><figure><LicensedImage src={sheratonBody} width={Math.min(1200, sheratonBody.width)} alt="Close view of a 1961 Sheraton showing its mini-humbuckers, bridge, controls and Bigsby" /><figcaption>1961 Sheraton. A clear body photo helps document the hardware and finish.</figcaption></figure><div class="value-factors"><h3>Epiphone Appraisal Details</h3><dl><div><dt>Model And Factory Period</dt><dd>Send the serial number, label and full headstock. I'll compare those markings with the body style and hardware.</dd></div><div><dt>Parts And Finish</dt><dd>Tell me about changed pickups, tuners, bridges, tailpieces or refinishing. Include removed parts even if they no longer work.</dd></div><div><dt>Repairs And Playability</dt><dd>Show cracks, repaired breaks, loose binding and the strings' height above the fingerboard. Mention problems that don't show in a photo.</dd></div><div><dt>Case And Records</dt><dd>Include the case, repair receipts and any dated ownership documents. Those help me separate a recorded history from an uncertain family recollection.</dd></div></dl></div></div>
      <div class="price-note"><h3>Compare Your Guitar With Its Model Guide</h3><p>For Kalamazoo thinlines, see the <a href="/post/epiphone-casino-value-guide/">Casino values</a>, <a href="/post/epiphone-sorrento-value-guide/">Sorrento values</a> and <a href="/post/epiphone-windsor-value-guide/">Windsor values</a>. Each chart separates the configurations it covers.</p><p>The <a href="/post/epiphone-emperor-value-guide/">Emperor</a>, <a href="/post/epiphone-deluxe-value-guide/">Deluxe</a>, <a href="/post/epiphone-triumph-value-guide/">Triumph</a> and <a href="/post/epiphone-broadway-value-guide/">Broadway value guides</a> distinguish the older archtops from their Kalamazoo counterparts. Use the <a href="/post/epiphone-olympic-value-guide/">Olympic value guide</a> to separate acoustic and solidbody examples, and the <a href="/post/epiphone-zephyr-value-guide/">Zephyr value guide</a> for the Zephyr and Zephyr Regent families.</p><p>Those estimates describe market value, not a cash offer for your guitar. An offer also accounts for its condition and the work involved in preparing it for resale. Send photos for a <a href="/free-appraisal/">free appraisal</a> of your specific instrument.</p></div>
      <p>Before replacing parts, read <a href="/what-lowers-vintage-guitar-value/">what lowers vintage guitar value</a> and <a href="/should-i-restore-my-guitar-before-selling/">whether to restore a guitar before selling</a>. Photos of its current condition are the best starting point for our conversation.</p>
    </div></section>

    <section class="wrap section" id="photos"><div class="photo-layout"><div><p class="eyebrow">Start With Your Phone</p><h2>Photos To Send For An Epiphone Offer</h2><p>Use even light and leave filters off. Take complete front and back views, then move closer for the label and hardware. Please don't take the guitar apart for the initial appraisal.</p><p>For a Kalamazoo instrument, the <a href="/how-to-read-gibson-serial-numbers/">Gibson serial number guide</a> explains the later shared serial systems. Early hollowbody A-prefix labels need the Epiphone-specific sequence discussed in the model guides. A number needs to agree with the guitar's features before it establishes a date.</p><a class="button primary" href={hrefs.sms}>Text Photos To {contact.phone}</a></div><ol class="photo-list"><li><strong>Whole Guitar And Back</strong><span>Show the complete instrument, its back and the neck joint.</span></li><li><strong>Headstock Front And Back</strong><span>Include the logo, tuners and the full serial stamp.</span></li><li><strong>Label And Interior Markings</strong><span>Photograph the label and any factory order number visible through the f-hole. Don't remove parts to find one.</span></li><li><strong>Pickups And Tailpiece</strong><span>Show the pickup count, controls, bridge and tailpiece together, then photograph any changes more closely.</span></li><li><strong>Case, Repairs And Loose Parts</strong><span>Include the open case, damage, repair receipts and any hardware kept from earlier work.</span></li></ol></div></section>

    <section class="process-band" id="selling"><div class="wrap section"><p class="eyebrow">Online Or In Person</p><h2>How To Sell Your Epiphone To Joe</h2><p class="process-intro">You'll work directly with me through the appraisal, offer and payment.</p><ol class="steps"><li><span class="step-number">01</span><h3>Send Me Photos</h3><p>Text the front, back, headstock, serial number and case. Include your location and any repair history. Leave cleaning and repairs until we've talked.</p></li><li><span class="step-number">02</span><h3>I'll Appraise Your Epiphone</h3><p>I'll identify the model and check its condition, parts and finish. The appraisal is free, and I'll ask for more photos if I need a closer look.</p></li><li><span class="step-number">03</span><h3>I'll Make A Cash Offer</h3><p>If it's an instrument I can buy, I'll tell you what I can pay and explain the offer. You can accept or decline it.</p></li><li><span class="step-number">04</span><h3>Agree On Shipping And Payment</h3><p>We'll choose the payment method and go over the prepaid FedEx Office Print &amp; Ship Center arrangements before your guitar leaves you.</p></li></ol><div class="local-copy"><h3>Sell An Epiphone In Mesa Or From Another State</h3><p>I'm based at {contact.address.street} in {contact.address.city}, Arizona, and buy instruments from sellers across the US. Call to arrange an in-person visit or discuss a sale from another state.</p><h3>Selling An Epiphone Guitar Collection</h3><p>For several guitars, start with an overview photo and a list of the models you know. Include cases and loose parts. My <a href="/sell-a-guitar-collection/">guitar collection buying service</a> covers collections as well as single instruments.</p></div></div></section>

    <section class="shipping-band" id="shipping"><div class="wrap section shipping-layout"><figure class="shipping-photo"><LicensedImage src={olympic} width={Math.min(1400, olympic.width)} alt="1960s Epiphone Olympic Double resting in a later SKB hardshell case" /><figcaption>1960s Olympic Double in a later SKB case. We'll discuss its case and packing before shipping.</figcaption></figure><div class="shipping-copy"><p class="eyebrow">Prepaid Nationwide Shipping</p><h2>Shipping Your Epiphone Through A FedEx Office Print &amp; Ship Center</h2><p>I explain the shipping process when I make the offer. There's no shipping cost to you: my account covers the box, professional packing, fully insured shipping and tracking.</p><p>Once we've agreed on the sale, I'll arrange the FedEx Office Print &amp; Ship Center handoff and explain where to take your guitar. The box and professional packing are provided through my account.</p><h3>How You'll Be Paid</h3><p>I offer same-day payment in most cases. We'll agree on your payment method and confirm the timing for your sale before you take your instrument in.</p><p>You can contact me throughout the process if you have a question about the drop-off or payment.</p><a class="button primary" href="#contact">Send Joe Your Epiphone Details</a></div></div></section>

    <section class="wrap section trust"><div class="section-intro"><p class="eyebrow">Joe's Vintage Guitars</p><h2>Meet Vintage Guitar Expert, Joe Dampt</h2><p>I'm a guitarist, collector and buyer based in Mesa. My interest in old guitars grew out of the music I listened to and played, from country and swing to rock and roll. You can <a href="/about-me/">read about Joe and the shop</a> before getting in touch.</p></div></section>
    <section class="wrap section faq-section" id="questions"><h2>Questions About Selling An Epiphone</h2>{faqs.map((f,i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
  </div>
  <ContactSection />
</Layout>
