---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import {rickenbackerGuides} from '../data/rickenbacker-guides';
import {SITE_URL} from '../config/site';
import '../styles/rickenbacker-guides.css';
interface Props { title:string;metaTitle?:string;description:string;canonical:string; structuredData?:Record<string,unknown>[]; }
const {title,metaTitle=title,description,canonical,structuredData=[]}=Astro.props;
const hub='/rickenbacker-serial-numbers/';
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE_URL+'/'},{'@type':'ListItem',position:2,name:'Rickenbacker Serial Number Lookup',item:SITE_URL+hub},...(canonical!==hub?[{'@type':'ListItem',position:3,name:title,item:SITE_URL+canonical}]:[])]};
const article={'@context':'https://schema.org','@type':'TechArticle',headline:title,description,url:SITE_URL+canonical,mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/#organization'},datePublished:canonical===hub?'2026-04-02':'2026-10-15',dateModified:'2026-10-15',image:SITE_URL+'/images/og/1960s-rickenbacker-360-2-scaled.jpg'};
---
<Layout footerSellLink={canonical !== hub ? {label: 'Sell My Rickenbacker', href: '/sell-my-rickenbacker-guitar/'} : undefined} title={metaTitle} description={description} canonical={canonical} ogType="article" ogImage={SITE_URL+'/images/og/1960s-rickenbacker-360-2-scaled.jpg'} ogImageWidth={2560} ogImageHeight={1707} bodyClass="rickenbacker-guide-page" structuredData={[breadcrumbs,article,...structuredData]}>
 <div class="rk-header-space" aria-hidden="true"></div>
 <div class="rk-series"><div class="rk-wrap"><a class="rk-series-title" href={hub}>Rickenbacker Dating Library</a><nav aria-label="Rickenbacker dating guides"><a href={hub} aria-current={canonical===hub?'page':undefined}>Serial Lookup</a>{rickenbackerGuides.map(g=><a href={`/${g.slug}/`} aria-current={canonical===`/${g.slug}/`?'page':undefined}>{g.label}</a>)}</nav></div></div>
 <div class="rk-content"><slot /></div><ContactSection />
</Layout>
