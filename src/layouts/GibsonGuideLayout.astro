---
import Layout from "./Layout.astro";
import "../styles/gibson-guides.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  youtubeLite?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  publishedTime,
  modifiedTime,
  structuredData,
  bodyClass = "",
  youtubeLite = false,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
  bodyClass={`gibson-guide ${bodyClass}`.trim()}
>
  {youtubeLite && (
    <Fragment slot="head">
      <link rel="stylesheet" href="/styles/lite-yt-embed.css" media="print" onload="this.media='all'" />
      <script is:inline src="/scripts/lite-yt-embed.js" defer></script>
    </Fragment>
  )}
  <slot />
</Layout>
