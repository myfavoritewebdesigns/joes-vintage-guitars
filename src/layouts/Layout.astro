---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingCTAs from "../components/FloatingCTAs.astro";
import { SITE_URL, SITE_NAME, LEGAL_NAME, contact, socialSameAs, imageLicense } from "../config/site";

interface Props {
  /** Page title (defaults to homepage title). Sets <title> and og:title. */
  title?: string;
  /** Meta description. Sets <meta name="description">, og:description, and twitter:description. */
  description?: string;
  /** Path or full URL for the canonical link. Defaults to `${SITE_URL}${Astro.url.pathname}`. */
  canonical?: string;
  /** Open Graph image URL. Defaults to the homepage featured image. */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /**
   * MIME type of ogImage. Leave unset — it is derived from the file extension.
   * Was hardcoded to image/jpeg, which made /sell-my-fender-guitar/ declare JPEG
   * while serving a PNG, and forced the Reverb card to be converted off webp.
   */
  ogImageType?: string;
  /** OG type. Defaults to "website". Use "article" for blog posts. */
  ogType?: "website" | "article" | "product";
  /** Hide from search engines (set noindex). */
  noIndex?: boolean;
  /** Page-specific JSON-LD schema(s) to inject in addition to the global Organization schema. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** ISO date string for article:modified_time (defaults to build time). */
  modifiedTime?: string;
  /** ISO date string for article:published_time. */
  publishedTime?: string;
}

const {
  title = "Joe's Vintage Guitars | We Buy Vintage Guitars Nationwide",
  description = "Sell your vintage guitar the easy way with Joe's Vintage Guitars. Get a free evaluation and get top dollar for your guitar today! Same day payment!",
  canonical,
  ogImage = `${SITE_URL}/images/homepage-featured-image.jpg`,
  ogImageAlt = "Joe's Vintage Guitars, buying and collecting vintage guitars nationwide",
  ogImageWidth = 1200,
  ogImageHeight = 1200,
  ogImageType,
  ogType = "website",
  noIndex = false,
  structuredData,
  modifiedTime,
  publishedTime,
} = Astro.props;

const canonicalUrl = canonical
  ? (canonical.startsWith("http") ? canonical : `${SITE_URL}${canonical}`)
  : `${SITE_URL}${Astro.url.pathname}`;

// og:image:type was hardcoded to image/jpeg, so /sell-my-fender-guitar/ told
// crawlers "JPEG" while serving a PNG. Derive it from the actual extension;
// pages can still override explicitly via the ogImageType prop.
const resolvedOgImageType =
  ogImageType ??
  (/\.png(\?|$)/i.test(ogImage) ? "image/png"
    : /\.webp(\?|$)/i.test(ogImage) ? "image/webp"
    : /\.avif(\?|$)/i.test(ogImage) ? "image/avif"
    : /\.gif(\?|$)/i.test(ogImage) ? "image/gif"
    : "image/jpeg");

// Global Organization / ProfessionalService schema — appears on every page.
// Source: live site JSON-LD #2 (jsonld-2.json in /reference)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  // One business, one node. The former separate LocalBusiness and MusicStore
  // nodes are folded in here via additionalType so the same entity is not
  // duplicated across three @ids. aggregateRating was removed on purpose: a
  // self-placed rating on a LocalBusiness earns no star rich result (those come
  // from the Google Business Profile) and a self-serving / cross-source number
  // risks a "spammy structured markup" manual action. openingHoursSpecification
  // (a 24/7 claim) was removed: this is a one-person, by-appointment business.
  additionalType: ["LocalBusiness", "MusicStore"],
  "@id": `${SITE_URL}/`,
  url: `${SITE_URL}/`,
  sameAs: socialSameAs,
  // ImageObject with real dimensions satisfies Google's Article publisher-logo
  // guidance for every post from one edit. The file is the live site's logo,
  // downloaded to the exact path this URL always pointed at.
  logo: {
    "@type": "ImageObject",
    url: `${SITE_URL}/images/joes-vintage-guitars-logo.jpg`,
    width: 1440,
    height: 1440,
    // Brand mark — RESTRICTIVE terms. `license` + `acquireLicensePage` point at
    // the brand-assets section of /photo-license/ (all rights reserved; "email
    // me to inquire"), NOT the permissive photo license Joe's content photos
    // use. This populates the optional Rich Results "license"/"acquireLicensePage"
    // fields (clearing the "Image metadata" notices sitewide) WITHOUT telling
    // anyone they may freely reuse the logo. `creator` reuses the shared Person
    // @id (same node the blog's BlogPosting.image.creator references).
    license: imageLicense.brandAssetsUrl,
    acquireLicensePage: imageLicense.brandAssetsUrl,
    copyrightNotice: imageLicense.copyrightNotice,
    creditText: imageLicense.creditText,
    creator: { "@id": `${SITE_URL}/about-me/#person` },
  },
  image: `${SITE_URL}/images/joes-vintage-guitars-logo.jpg`,
  name: SITE_NAME,
  legalName: LEGAL_NAME,
  description:
    "Joe's Vintage Guitars specializes in purchasing and collecting vintage guitars and other stringed instruments. With years of expertise, Joe Dampt offers top cash for renowned brands like Fender and Gibson.",
  numberOfEmployees: { "@type": "QuantitativeValue", value: 1 },
  priceRange: "$$$$",
  telephone: contact.telDashed,
  address: {
    "@type": "PostalAddress",
    streetAddress: contact.address.street,
    addressLocality: contact.address.city,
    addressRegion: contact.address.region,
    postalCode: contact.address.postalCode,
    addressCountry: contact.address.country,
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: contact.telDashed,
    contactType: "Customer Support",
    email: contact.email,
    areaServed: ["US", "CA"],
    availableLanguage: ["English"],
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: contact.address.lat,
    longitude: contact.address.lng,
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "United States" },
    { "@type": "AdministrativeArea", name: "Canada" },
  ],
  founder: { "@id": `${SITE_URL}/about-me/#person` },
};

// WebSite schema (also global). The live site's SearchAction was removed on
// purpose: it targeted WordPress's /?s= endpoint, which does not exist on the
// static rebuild, and Google retired the sitelinks search box in late 2024.
const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  url: `${SITE_URL}/`,
  name: SITE_NAME,
  alternateName: "Joe's Vintage Guitars",
  publisher: { "@id": `${SITE_URL}/` },
  inLanguage: "en-US",
};

// MusicStore, LocalBusiness, and Place were previously separate nodes for the
// same business. They are now folded into the single ProfessionalService node
// above (additionalType: LocalBusiness, MusicStore) to stop fragmenting the
// entity across multiple @ids.

// Shared Person node for Joe (SEO v2 Prompt 6). Promoted from the Gibson
// serial guide's page-level node and enriched with sameAs + ImageObject so
// every BlogPosting and Article author reference resolves to one
// authoritative entity (~47 pages of author E-E-A-T from one node).
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/about-me/#person`,
  name: "Joe Dampt",
  givenName: "Joe",
  familyName: "Dampt",
  jobTitle: "Vintage Guitar Expert, Appraiser, and Owner",
  description:
    "Vintage guitar expert and appraiser specializing in Golden Era Gibson electrics and archtops from the 1920s through the 1960s. Over 12 years of professional experience and 10,000+ vintage instruments personally appraised.",
  url: `${SITE_URL}/about-me/`,
  image: {
    "@type": "ImageObject",
    url: `${SITE_URL}/images/about-me-joe-1.jpg`,
    width: 587,
    height: 587,
  },
  sameAs: [
    "https://www.youtube.com/@joesvintageguitars",
    "https://www.instagram.com/joesvintageguitarsaz/",
    "https://www.facebook.com/joesvintageguitars/",
  ],
  alumniOf: { "@type": "CollegeOrUniversity", name: "Arizona State University", url: "https://www.asu.edu/" },
  knowsAbout: [
    "Vintage Gibson guitars",
    "Gibson serial number dating",
    "Vintage guitar authentication",
    "Golden era Gibson archtops",
    "Pre-war Martin guitars",
    "Vintage Fender custom color guitars",
    "Vintage guitar appraisal",
    "Vintage guitar repair and restoration",
  ],
  worksFor: { "@id": `${SITE_URL}/` },
};

// Service schemas — what Joe offers
const serviceSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Vintage guitar appraisal",
    provider: { "@id": `${SITE_URL}/` },
    areaServed: { "@type": "AdministrativeArea", name: "United States" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Vintage guitar purchasing",
    provider: { "@id": `${SITE_URL}/` },
    areaServed: { "@type": "AdministrativeArea", name: "United States" },
  },
];

const allSchemas: Record<string, unknown>[] = [
  orgSchema,
  siteSchema,
  personSchema,
  ...serviceSchemas,
];
if (structuredData) {
  if (Array.isArray(structuredData)) allSchemas.push(...structuredData);
  else allSchemas.push(structuredData);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- WhatConverts, loaded directly instead of through GTM.
         GTM-TKN5P7S was a ~420 KB container parsed on every page load before a
         single tag fired. GA4, Google Ads, Meta Pixel and Bing UET all move to
         Cloudflare Zaraz (edge-side, zero browser cost). WhatConverts is the one
         tag that cannot: no Zaraz component exists, and it needs the real browser
         session to set wc_client / wc_visitor. So it loads here, at idle.

         ⚠️ ORDER OF OPERATIONS — retiring GTM has two prerequisites:
           1. Meta Pixel (934500208412401) added to Zaraz. JVG's Zaraz already has
              GA4 + Google Ads + Bing; Meta is the gap. Retire GTM before that and
              Meta stops firing entirely.
           2. This block deployed, and the WhatConverts tags removed from the GTM
              container. Do the GTM removal FIRST: a brief gap is far safer than a
              brief overlap, because WhatConverts loading twice risks double-binding
              and duplicate leads. The guard below makes an overlap a no-op, but do
              not rely on it to win a race.

         `dataLayer` is kept alive as a no-op array because FenderSerialTool.astro
         pushes guarded analytics events into it (fender_serial_decode /
         fender_serial_report_request). Zaraz reads dataLayer, so those keep working.

         Attribution note: idle-deferral is SAFE here — we still fire on the landing
         page with the gclid in the URL and the real referrer, so `wc_client` records
         the correct source. Do NOT move these to a first-interaction trigger: that
         can fire on page 2, where the gclid is gone and the referrer is internal. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        var PROD_HOST = "joesvintageguitarsaz.com";
        var host = window.location.hostname;
        if (host !== PROD_HOST && host.indexOf("." + PROD_HOST) === -1) return;

        // ONLY WhatConverts lives here. Everything else that GTM used to fire —
        // GA4, Google Ads, Meta Pixel, Bing UET — belongs in Zaraz, where it runs
        // edge-side at zero browser cost. WhatConverts cannot move: it has no Zaraz
        // component and needs the real browser session to set wc_client/wc_visitor.
        //
        // Do NOT "complete the set" by adding fbevents.js / bat.js here. Loading
        // those libraries without their init snippets means they download and fire
        // NOTHING — presence without capture, the same trap as the form selector.
        var TAGS = [
          // Phone profile, then form profile. LOAD-BEARING: 97950 is what captures
          // every web-form lead (see the CLAUDE.md decision log, 2026-07-20).
          "https://scripts.iconnode.com/97949.js",
          "https://scripts.iconnode.com/97950.js",
        ];

        function load() {
          TAGS.forEach(function (src) {
            // Skip anything GTM already put on the page, so an overlap window
            // degrades to "no change" rather than a double-load.
            if (document.querySelector('script[src="' + src + '"]')) return;
            var s = document.createElement("script");
            s.async = true;
            s.src = src;
            document.head.appendChild(s);
          });
        }
        // After load, then at idle: never competes with render or LCP.
        var start = function () {
          if (window.requestIdleCallback) requestIdleCallback(load, { timeout: 3000 });
          else setTimeout(load, 1200);
        };
        if (document.readyState === "complete") start();
        else window.addEventListener("load", start, { once: true });
      })();
    </script>

    <!-- WhatConverts form capture. The site's fetch() forms match no selector
         WhatConverts auto-captures, so we post each lead ourselves. Do NOT
         "simplify" this to $wc_leads.track.form() — that silently captures
         ZERO leads here. Full rationale + live proof: CLAUDE.md decision log,
         2026-07-20 "WhatConverts form capture". -->
    <script is:inline>
      (function () {
        var WC_PROFILE_ID = "97950";   // Form Tracking (NOT 97949 = Phone)
        var WC_FORM_SET_ID = "65952";  // the one form set on profile 97950
        var WC_ENDPOINT = "https://p.ksrndkehqnwntyxlhgto.com/lead/form";
        var PROD_HOST = "joesvintageguitarsaz.com";
        /** Field-name prettifier: WC shows these labels in the lead detail. */
        var NICE = {
          "your-name": "Name", name: "Name", "last-name": "Last Name",
          "your-email": "Email", email: "Email",
          "your-phone": "Phone", phone: "Phone",
          "your-message": "Message", message: "Message", comments: "Message",
          instrument: "Instrument Make/Model", model: "Model", year: "Year",
          "serial-number": "Serial Number Format",
          "appraisal-type": "Appraisal Type", "best-reply": "Best Reply Method",
        };
        var SKIP = {
          _gotcha: 1, formId: 1, submittedAt: 1,
          "h-captcha-response": 1, "g-recaptcha-response": 1,
        };
        function cookie(name) {
          var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
          return m ? decodeURIComponent(m[1]) : "";
        }
        window.jvgWcTrack = function (payload, formLabel) {
          try {
            var host = window.location.hostname;
            if (host !== PROD_HOST && host.indexOf("." + PROD_HOST) === -1) return;

            var enc = encodeURIComponent;
            var kv = [enc("Form") + "=" + enc(formLabel)];
            for (var k in payload) {
              // Underscore-prefixed keys are plumbing, never lead content.
              if (SKIP[k] || k.charAt(0) === "_") continue;
              var v = payload[k];
              if (typeof v === "string" && v.trim()) {
                kv.push(enc(NICE[k] || k) + "=" + enc(v.trim()));
              }
            }
            if (kv.length < 2) return; // nothing but the label — not a lead

            var wcClient = cookie("wc_client");
            kv.push("wc_profile_id=" + WC_PROFILE_ID);
            kv.push("wc_form_set_id=" + WC_FORM_SET_ID);
            kv.push("wc_client=" + enc(wcClient));
            kv.push("wc_client_current=" + enc(wcClient));
            kv.push("wc_page=" + enc(window.location.href));
            var body = kv.join("&");

            // sendBeacon survives the immediate navigation to /thank-you/;
            // fetch+keepalive is the fallback where it is unavailable.
            if (navigator.sendBeacon) {
              var blob = new Blob([body], {
                type: "application/x-www-form-urlencoded; charset=UTF-8",
              });
              if (navigator.sendBeacon(WC_ENDPOINT, blob)) return;
            }
            fetch(WC_ENDPOINT, {
              method: "POST",
              keepalive: true,
              headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
              body: body,
            }).catch(function () {});
          } catch (e) { /* tracking must never break a submit */ }
        };
      })();
    </script>

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
    }
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/images/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Font preloads (Oswald is used everywhere; Margi is only loaded on demand via @font-face) -->
    <link rel="preload" href="/fonts/Oswald-SemiBold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content={resolvedOgImageType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- RSS alternates (real feed generated by src/pages/feed.xml.ts; /feed/ 301s here) -->
    <link rel="alternate" type="application/rss+xml" title="Joe's Vintage Guitars » Feed" href={`${SITE_URL}/feed.xml`} />

    <!-- JSON-LD structured data -->
    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Per-page <head> additions (CDN links, custom-element scripts, page-specific
         meta, etc.). Pages add via `<link slot="head" ...>` or `<script slot="head" ...>` -->
    <slot name="head" />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <!-- The GTM <noscript> iframe was removed with the container. It only ever
         served no-JS visitors, and every tag it fronted is JS-dependent anyway. -->

    <!-- Skip to content link for keyboard / screen reader users -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <FloatingCTAs />

    <!-- Shared submit handler for any <form data-jvg-contact-form>. -->
    <!-- One place to wire Mailgun when the CF Pages Function is added. -->
    <script src="../scripts/contact-form.ts"></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 8px;
    top: -40px;
    z-index: 100;
    padding: 8px 16px;
    background: var(--color-brand-rust-dark);
    color: #fff;
    font-family: "Oswald", sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 4px 4px;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0;
    outline: 3px solid var(--color-brand-gold);
  }
</style>
