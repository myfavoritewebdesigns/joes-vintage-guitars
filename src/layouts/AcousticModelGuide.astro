---
import type { ImageMetadata, MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import GuideHero from '../components/GuideHero.astro';
import GuideActions from '../components/GuideActions.astro';
import ValueGuidePhotos from '../components/ValueGuidePhotos.astro';
import { SITE_URL } from '../config/site';
interface Props {
  data: {title:string;description:string;h1:string;url:string;date:string;model:string;kind:string;alt:string;caption:string;faqs:{q:string;a:string}[]};
  headings: MarkdownHeading[];
  image?: ImageMetadata;
}
const {data,headings:allHeadings,image}=Astro.props;
const headings=allHeadings.filter(h=>h.depth===2);
const isPreview=import.meta.env.CF_PAGES_BRANCH !== 'main';
const structuredData=[{
  '@context':'https://schema.org','@type':'Article',headline:data.h1,description:data.description,
  ...(image?{image:SITE_URL+image.src}:{}),datePublished:data.date,dateModified:data.date,inLanguage:'en-US',
  author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/'},mainEntityOfPage:SITE_URL+data.url
},{
  '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'Home',item:SITE_URL+'/'},
    {'@type':'ListItem',position:2,name:'Gibson Acoustic Values',item:SITE_URL+'/vintage-gibson-acoustic-value-guide/'},
    {'@type':'ListItem',position:3,name:data.h1,item:SITE_URL+data.url}
  ]
},{
  '@context':'https://schema.org','@type':'FAQPage',mainEntity:data.faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))
}];
---
<Layout title={data.title} description={data.description} canonical={data.url}
  {...(image?{ogImage:SITE_URL+image.src,ogImageWidth:image.width,ogImageHeight:image.height,ogImageAlt:data.alt}:{})}
  ogType="article" structuredData={structuredData} publishedTime={data.date} modifiedTime={data.date} noIndex={isPreview}>
  {image ? <GuideHero title={data.h1} image={image} alt={data.alt} caption={data.caption} brand="Gibson"
    eyebrow={"Joe's Vintage Guitars / "+(data.kind==='value'?'Value Reference':'Model Authentication')} byline="By Joe Dampt · October 2026" />
    : <section class="amg-text-hero"><div><p>Joe's Vintage Guitars / Gibson Acoustics</p><h1>{data.h1}</h1><p>By Joe Dampt · October 2026</p><GuideActions brand="Gibson" /></div></section>}
  <div class="amg-shell">
    <details class="amg-mobile-toc"><summary>On This Page</summary><nav aria-label="Article sections"><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#guide-questions">Common Questions</a></li></ul></nav></details>
    <aside class="amg-toc" aria-label="On this page"><p>On This Page</p><nav><ul>{headings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}<li><a href="#guide-questions">Common Questions</a></li></ul></nav></aside>
    <article class="amg-article">
      <ValueGuidePhotos><slot /></ValueGuidePhotos>
      <section id="guide-questions" class="amg-faq"><h2>Common Questions About {data.model}</h2>{data.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    </article>
  </div>
</Layout>
<style>
.amg-text-hero{background:var(--color-brand-brown);color:var(--color-brand-cream);padding:284px 28px 48px;border-bottom:6px solid var(--color-brand-brown-tan)}
.amg-text-hero>div{max-width:1280px;margin:auto}.amg-text-hero h1{font-family:var(--font-display);font-size:clamp(32px,4vw,48px);line-height:1.2;margin:20px 0}.amg-text-hero p{font-size:14px}
.amg-shell{max-width:1280px;margin:auto;padding:32px 28px 72px}
.amg-article{max-width:860px;min-width:0;font-size:17px;line-height:1.85;color:var(--color-brand-charcoal)}
.amg-article :global(p){margin:0 0 20px}
.amg-article :global(h2){font-family:var(--font-display);font-size:clamp(26px,3vw,34px);line-height:1.25;color:var(--color-brand-brown);margin:48px 0 22px;scroll-margin-top:24px}
.amg-article :global(h2)::after{content:'';display:block;width:80px;height:3px;background:var(--color-brand-rust);margin-top:14px}
.amg-article :global(h3){font-family:var(--font-display);font-size:25px;line-height:1.3;color:var(--color-brand-brown);margin:32px 0 14px;scroll-margin-top:24px}
.amg-article :global(a),.amg-toc a,.amg-mobile-toc a{color:var(--color-brand-rust-dark);text-decoration:underline;text-underline-offset:3px}
.amg-article :global(a:hover){color:var(--color-brand-rust)}
.amg-article :global(a:focus-visible),.amg-toc a:focus-visible,.amg-mobile-toc a:focus-visible{outline:3px solid var(--color-brand-rust);outline-offset:4px}
.amg-article :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:24px 0 28px;font-size:15px;line-height:1.6}
.amg-article :global(th){background:var(--color-brand-brown);color:white;text-align:left;font-weight:600}
.amg-article :global(th),.amg-article :global(td){padding:14px 16px;border:1px solid var(--color-brand-brown-tan);min-width:122px;vertical-align:top}
.amg-article :global(th:first-child),.amg-article :global(td:first-child){min-width:100px;font-weight:600}
.amg-article :global(tr:nth-child(even)){background:var(--color-brand-vanilla)}
.amg-article :global(figure){margin:32px 0;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.amg-article :global(figure p){margin:0}
.amg-article :global(figure img){display:block;max-width:100%;max-height:650px;width:100%;height:auto;object-fit:contain;margin:0 auto;background:var(--color-brand-brown)}
.amg-article :global(figcaption){font-size:14px;line-height:1.65;padding:14px 18px;color:var(--color-brand-brown-mid)}
.amg-article :global(.amg-related){display:flex;flex-wrap:wrap;gap:12px;margin:28px 0;padding:20px;background:var(--color-brand-parchment);border-left:4px solid var(--color-brand-rust)}
.amg-article :global(.amg-related a){display:flex;align-items:center;min-height:44px;font-size:15px;line-height:1.5;font-weight:600;padding:8px 12px;border:1px solid var(--color-brand-brown-tan);background:white;border-radius:4px}
.amg-faq details{border-top:1px solid var(--color-brand-brown-tan);padding:18px 0}
.amg-faq details:last-child{border-bottom:1px solid var(--color-brand-brown-tan)}
.amg-faq summary{font-family:var(--font-display);font-size:22px;line-height:1.4;color:var(--color-brand-brown);cursor:pointer}
.amg-faq details p{margin:16px 0 0;font-size:16px}
.amg-toc{display:none}
.amg-mobile-toc{max-width:860px;margin-bottom:28px;padding:14px 18px;background:var(--color-brand-parchment);border:1px solid var(--color-brand-brown-tan)}
.amg-mobile-toc summary{font-family:var(--font-display);font-size:20px;color:var(--color-brand-brown);cursor:pointer}
.amg-mobile-toc ul{list-style:none;padding:12px 0 0;margin:0}
.amg-mobile-toc a{display:block;padding:7px 0;font-size:15px;line-height:1.5}
@media(min-width:1440px){.amg-shell{display:grid;grid-template-columns:minmax(0,860px) 270px;gap:40px;align-items:start}.amg-toc{display:block;position:sticky;top:24px;grid-column:2;grid-row:1;max-height:calc(100vh - 48px);overflow-y:auto;padding:20px;border:1px solid var(--color-brand-brown-tan);border-top:4px solid var(--color-brand-rust);background:white}.amg-toc>p{font-family:var(--font-display);font-size:19px;margin-bottom:12px;color:var(--color-brand-brown)}.amg-toc ul{list-style:none;padding:0;margin:0}.amg-toc a{display:block;font-size:13px;line-height:1.5;padding:6px 0;text-decoration:none}.amg-toc a:hover{text-decoration:underline}.amg-mobile-toc{display:none}.amg-article{grid-column:1;grid-row:1}}
@media(max-width:1439px){.amg-shell{max-width:916px}}
@media(max-width:1023px){.amg-text-hero{padding-top:212px}}
@media(max-width:767px){.amg-shell{padding:24px 20px 48px}.amg-article{font-size:16px}.amg-article :global(h2){margin-top:36px}}
@media(max-width:639px){.amg-text-hero{padding:156px 20px 32px}.amg-article :global(th),.amg-article :global(td){padding:12px 10px;min-width:92px;font-size:14px}.amg-article :global(.amg-related){padding:14px}.amg-article :global(.amg-related a){width:100%}}
</style>
