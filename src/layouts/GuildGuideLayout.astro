---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import {guildGuides} from '../data/guild-guides';
import {SITE_URL} from '../config/site';
import {getImage} from 'astro:assets';
import {resolveImage} from '../lib/images';
import {guildPhotos} from '../data/guild-photos';
import '../styles/guild-guides.css';
interface Props { title:string;metaTitle?:string;description:string;canonical:string; structuredData?:Record<string,unknown>[]; }
const {title,metaTitle=title,description,canonical,structuredData=[]}=Astro.props;
const hub='/guild-serial-number-lookup/';
const guide=guildGuides.find(g=>canonical===`/${g.slug}/`);
const photo=guide?.photo||'f48Front';
const imageSource=resolveImage(guildPhotos[photo])!;
const socialImage=await getImage({src:imageSource,width:Math.min(1200,imageSource.width),format:'jpg',quality:85});
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE_URL+'/'},{'@type':'ListItem',position:2,name:'Guild Serial Number Lookup',item:SITE_URL+hub},...(canonical!==hub?[{'@type':'ListItem',position:3,name:title,item:SITE_URL+canonical}]:[])]};
const article={'@context':'https://schema.org','@type':'TechArticle',headline:title,description,url:SITE_URL+canonical,mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/'},datePublished:canonical===hub?'2026-03-12':'2026-10-15',dateModified:'2026-10-15',image:SITE_URL+socialImage.src};
---
<Layout title={metaTitle} description={description} canonical={canonical} ogType="article" ogImage={SITE_URL+socialImage.src} ogImageAlt={guide?.alt||'Vintage Guild F48 Acoustic Guitar From Joe’s Photo Archive'} ogImageWidth={Number(socialImage.attributes.width)} ogImageHeight={Number(socialImage.attributes.height)} publishedTime={canonical===hub?'2026-03-12T00:00:00Z':'2026-10-15T00:00:00Z'} modifiedTime="2026-10-15T00:00:00Z" bodyClass="guild-guide-page" structuredData={[breadcrumbs,article,...structuredData]}>
 <div class="gu-header-space" aria-hidden="true"></div>
 <div class="gu-series"><div class="gu-wrap"><a class="gu-series-title" href={hub}>Guild Dating Library</a><nav aria-label="Guild dating guides"><a href={hub} aria-current={canonical===hub?'page':undefined}>Serial Lookup</a>{guildGuides.map(g=><a href={`/${g.slug}/`} aria-current={canonical===`/${g.slug}/`?'page':undefined}>{g.label}</a>)}</nav></div></div>
 <div class="gu-content"><slot /></div><ContactSection />
</Layout>
