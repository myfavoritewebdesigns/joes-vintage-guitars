---
import Layout from './Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import {gretschGuides} from '../data/gretsch-guides';
import {SITE_URL} from '../config/site';
import {getImage} from 'astro:assets';
import {resolveImage} from '../lib/images';
import {gretschPhotos} from '../data/gretsch-photos';
import '../styles/gretsch-guides.css';
interface Props { title:string;metaTitle?:string;description:string;canonical:string; structuredData?:Record<string,unknown>[]; }
const {title,metaTitle=title,description,canonical,structuredData=[]}=Astro.props;
const hub='/gretsch-serial-number-lookup/';
const photo=gretschGuides.find(g=>canonical===`/${g.slug}/`)?.photo||'orangeFront';
const imageSource=resolveImage(gretschPhotos[photo])!;
const socialImage=await getImage({src:imageSource,width:Math.min(1200,imageSource.width),format:'jpg',quality:85});
const breadcrumbs={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE_URL+'/'},{'@type':'ListItem',position:2,name:'Gretsch Serial Number Lookup',item:SITE_URL+hub},...(canonical!==hub?[{'@type':'ListItem',position:3,name:title,item:SITE_URL+canonical}]:[])]};
const article={'@context':'https://schema.org','@type':'TechArticle',headline:title,description,url:SITE_URL+canonical,mainEntityOfPage:SITE_URL+canonical,author:{'@id':SITE_URL+'/about-me/#person'},publisher:{'@id':SITE_URL+'/'},datePublished:canonical===hub?'2026-04-13':'2026-10-15',dateModified:'2026-10-15',image:SITE_URL+socialImage.src};
---
<Layout footerSellLink={canonical !== hub ? {label: 'Sell My Gretsch', href: '/sell-my-gretsch-guitar/'} : undefined} title={metaTitle} description={description} canonical={canonical} ogType="article" ogImage={SITE_URL+socialImage.src} ogImageWidth={Number(socialImage.attributes.width)} ogImageHeight={Number(socialImage.attributes.height)} bodyClass="gretsch-guide-page" structuredData={[breadcrumbs,article,...structuredData]}>
 <div class="gr-header-space" aria-hidden="true"></div>
 <div class="gr-series"><div class="gr-wrap"><a class="gr-series-title" href={hub}>Gretsch Dating Library</a><nav aria-label="Gretsch dating guides"><a href={hub} aria-current={canonical===hub?'page':undefined}>Serial Lookup</a>{gretschGuides.map(g=><a href={`/${g.slug}/`} aria-current={canonical===`/${g.slug}/`?'page':undefined}>{g.label}</a>)}</nav></div></div>
 <div class="gr-content"><slot /></div><ContactSection />
</Layout>
